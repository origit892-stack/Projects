{
  "manifest_version": 3,
  "name": "Lumio MOE Sync",
  "version": "2.0.0",
  "description": "כל פעם שפותחים את משו״ב / אופק / פטל, לומיו סונכרן אוטומטי מהחשבון שלך במשרד החינוך — בלי לשמור סיסמאות בלומיו.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.cet.ac.il/*",
    "*://*.matan.co.il/*",
    "https://web.mashov.info/*",
    "https://zijinurzzwkuqxwhkiuw.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.cet.ac.il/*", "*://*.matan.co.il/*", "https://web.mashov.info/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.cet.ac.il/*", "*://*.matan.co.il/*", "https://web.mashov.info/*"],
      "js": ["map.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
