        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local TOKEN_SECONDS = Config.Network.InteractionTokenLifetimeSeconds
local MAX_DISTANCE = Config.Network.InteractionMaximumDistance

local ACTIONS_BY_KIND = {
	farm_plot = { "FarmHarvest", "FarmPlant" },
	food_processor = { "ProcessorStart" },
	shop = { "ShopBuy" },
	storage = { "StorageTransfer" },
	power = { "PowerActivate" },
	scrap_exchange = { "ScrapExchange" },
	upgrade = { "UpgradeBuy" },
}

local INTENT_KIND_TO_INTERACTION_KIND = {
	FarmPlant = "farm_plot",
	FarmHarvest = "farm_plot",
	ProcessorStart = "food_processor",
	ShopBuy = "shop",
	StorageTransfer = "storage",
	PowerActivate = "power",
	ScrapExchange = "scrap_exchange",
	UpgradeBuy = "upgrade",
}

local InteractionService = {}
InteractionService.__index = InteractionService

local function livingRoot(player: Player): (Model?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid == nil or humanoid.Health <= 0 or root == nil or not root:IsA("BasePart") then
		return character, nil
	end
	return character, root
end

local function visible(character: Model, target: Instance, origin: Vector3, destination: Vector3): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.IgnoreWater = true
	local result = workspace:Raycast(origin, destination - origin, parameters)
	return result == nil or result.Instance:IsDescendantOf(target)
end

function InteractionService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_world = nil,
		_playerData = nil,
		_inventory = nil,
		_farming = nil,
		_economy = nil,
		_bunker = nil,
		_events = nil,
		_definitions = nil,
		_sessionsByPlayer = {} :: { [Player]: any },
		_sessionsByToken = {} :: { [string]: any },
		_connections = {},
		_sessionGeneration = 0,
	}, InteractionService)
end

function InteractionService.Init(self, bag)
	if self._initialized then
		return
	end
	self._world = bag:Get("WorldService")
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._farming = bag:Get("FarmingService")
	self._economy = bag:Get("EconomyService")
	self._bunker = bag:Get("BunkerService")
	self._events = bag:Get("DomainEvents")
	self._definitions = bag.Context.Definitions
	self._initialized = true
end

function InteractionService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "InteractionService must initialize before Start")
	self._started = true
	self._sessionGeneration += 1
	local generation = self._sessionGeneration
	for _, interaction in ipairs(self._world:GetInteractions()) do
		table.insert(self._connections, interaction.Prompt.Triggered:Connect(function(player)
			self:HandlePrompt(player, interaction.Id)
		end))
	end
	table.insert(self._connections, self._events:On("CharacterDied", function(player)
		self:InvalidatePlayer(player)
	end))
	task.spawn(function()
		while self._started and self._sessionGeneration == generation do
			for player, session in pairs(self._sessionsByPlayer) do
				local interaction = session.Interaction
				local character, root = livingRoot(player)
				if workspace:GetServerTimeNow() > session.ExpiresAt
					or character == nil
					or root == nil
					or interaction.Instance.Parent == nil
					or interaction.Anchor.Parent == nil
					or (root.Position - interaction.Anchor.Position).Magnitude > MAX_DISTANCE
					or not visible(character, interaction.Instance, root.Position, interaction.Anchor.Position)
				then
					self:InvalidatePlayer(player)
				end
			end
			task.wait(0.25)
		end
	end)
end

function InteractionService:_view(player: Player, interaction)
	local profile = self._playerData:GetView(player)
	assert(profile ~= nil, "interaction view requires a ready profile")
	if interaction.Kind == "farm_plot" then
		return {
			Kind = "farm_plot",
			Plot = self._farming:GetPlotView(interaction.Id, player),
			SeedQuantity = profile.Inventory.seed_wheat or 0,
		}
	elseif interaction.Kind == "food_processor" then
		return {
			Kind = "food_processor",
			IsPowered = self._bunker:IsPowered(),
			CropQuantity = profile.Inventory.crop_wheat or 0,
			Job = self._farming:GetProcessorJobView(player),
		}
	elseif interaction.Kind == "shop" then
		return {
			Kind = "shop",
			Credits = profile.Currencies.credits,
			Offers = self._economy:GetOffersView(),
		}
	elseif interaction.Kind == "storage" then
		return {
			Kind = "storage",
			Inventory = self._inventory:GetItemQuantities(profile.Inventory),
			Storage = self._inventory:GetItemQuantities(profile.Storage),
			StorageUsed = self._inventory:GetStorageUsed(profile),
			StorageCapacity = self._inventory:GetStorageCapacity(profile),
		}
	elseif interaction.Kind == "power" then
		local power = self._bunker:GetView()
		return {
			Kind = "power",
			IsActive = power.IsActive,
			EndsAt = power.EndsAt,
			BatteryQuantity = profile.Inventory.battery_cell or 0,
		}
	elseif interaction.Kind == "scrap_exchange" then
		return {
			Kind = "scrap_exchange",
			ScrapQuantity = profile.Inventory.scrap or 0,
			Credits = profile.Currencies.credits,
			CreditsPerScrap = 5,
		}
	elseif interaction.Kind == "upgrade" then
		local upgradeId = interaction.UpgradeId
		local definition = self._definitions.Upgrades[upgradeId]
		assert(definition ~= nil, string.format("upgrade interaction %s has invalid UpgradeId", interaction.Id))
		return {
			Kind = "upgrade",
			UpgradeId = upgradeId,
			Tier = profile.Upgrades[upgradeId],
			CreditCost = definition.CreditCost,
			Credits = profile.Currencies.credits,
			IsPowered = self._bunker:IsPowered(),
		}
	end
	error(string.format("unknown interaction kind %s", tostring(interaction.Kind)))
end

function InteractionService:HandlePrompt(player: Player, interactionId: string): (boolean, string, any)
	if not self._playerData:IsReady(player) then
		return false, "PROFILE_NOT_READY", nil
	end
	local interaction = self._world:GetInteraction(interactionId)
	if interaction == nil or interaction.Instance.Parent == nil then
		return false, "WRONG_INTERACTION", nil
	end
	local character, root = livingRoot(player)
	if character == nil or root == nil then
		return false, "PLAYER_DEAD", nil
	end
	if (root.Position - interaction.Anchor.Position).Magnitude > MAX_DISTANCE then
		return false, "OUT_OF_RANGE", nil
	end
	if not visible(character, interaction.Instance, root.Position, interaction.Anchor.Position) then
		return false, "LINE_OF_SIGHT_BLOCKED", nil
	end
	self:InvalidatePlayer(player)
	local token = string.lower(HttpService:GenerateGUID(false):gsub("%-", ""))
	local expiresAt = workspace:GetServerTimeNow() + TOKEN_SECONDS
	local session = {
		Player = player,
		Token = token,
		ExpiresAt = expiresAt,
		Interaction = interaction,
	}
	self._sessionsByPlayer[player] = session
	self._sessionsByToken[token] = session
	local actions = table.clone(ACTIONS_BY_KIND[interaction.Kind])
	table.sort(actions)
	local payload = {
		InteractionId = interaction.Id,
		InteractionKind = interaction.Kind,
		Token = token,
		ExpiresAt = expiresAt,
		Actions = actions,
		View = self:_view(player, interaction),
	}
	self._events:Emit("InteractionOpened", player, payload)
	return true, "OK", payload
end

function InteractionService:ValidateToken(player: Player, interactionId: string, token: string, intentKind: string): (boolean, string, any)
	local session = self._sessionsByToken[token]
	if session == nil or session.Player ~= player then
		return false, "INVALID_TOKEN", nil
	end
	if workspace:GetServerTimeNow() > session.ExpiresAt then
		self:InvalidatePlayer(player)
		return false, "TOKEN_EXPIRED", nil
	end
	local interaction = session.Interaction
	if interaction.Id ~= interactionId or INTENT_KIND_TO_INTERACTION_KIND[intentKind] ~= interaction.Kind then
		return false, "WRONG_INTERACTION", nil
	end
	if interaction.Instance.Parent == nil or interaction.Anchor.Parent == nil then
		self:InvalidatePlayer(player)
		return false, "WRONG_INTERACTION", nil
	end
	local character, root = livingRoot(player)
	if character == nil or root == nil then
		self:InvalidatePlayer(player)
		return false, "PLAYER_DEAD", nil
	end
	if (root.Position - interaction.Anchor.Position).Magnitude > MAX_DISTANCE then
		self:InvalidatePlayer(player)
		return false, "OUT_OF_RANGE", nil
	end
	if not visible(character, interaction.Instance, root.Position, interaction.Anchor.Position) then
		self:InvalidatePlayer(player)
		return false, "LINE_OF_SIGHT_BLOCKED", nil
	end
	return true, "OK", interaction
end

function InteractionService:RouteIntent(player: Player, payload): (boolean, string, any)
	local valid, code, interaction = self:ValidateToken(player, payload.InteractionId, payload.Token, payload.Kind)
	if not valid then
		return false, code, nil
	end
	if payload.Kind == "FarmPlant" then
		return self._farming:Plant(player, interaction.Id, payload.CropId)
	elseif payload.Kind == "FarmHarvest" then
		return self._farming:Harvest(player, interaction.Id)
	elseif payload.Kind == "ProcessorStart" then
		return self._farming:StartProcessor(player, payload.RecipeId)
	elseif payload.Kind == "ShopBuy" then
		return self._economy:BuyOffer(player, payload.OfferId, payload.Count)
	elseif payload.Kind == "StorageTransfer" then
		return self._economy:TransferStorage(player, payload.Direction, payload.ItemId, payload.Count)
	elseif payload.Kind == "PowerActivate" then
		return self._bunker:TryActivatePower(player)
	elseif payload.Kind == "ScrapExchange" then
		return self._economy:ExchangeScrap(player, payload.Count)
	elseif payload.Kind == "UpgradeBuy" then
		if interaction.UpgradeId ~= payload.UpgradeId then
			return false, "WRONG_INTERACTION", nil
		end
		return self._economy:BuyUpgrade(player, payload.UpgradeId)
	end
	return false, "UNKNOWN_REQUEST", nil
end

function InteractionService:InvalidatePlayer(player: Player)
	local session = self._sessionsByPlayer[player]
	if session == nil then
		return
	end
	self._sessionsByPlayer[player] = nil
	if self._sessionsByToken[session.Token] == session then
		self._sessionsByToken[session.Token] = nil
	end
end

function InteractionService:CloseSession(player: Player, token: string): boolean
	local session = self._sessionsByPlayer[player]
	if session == nil or session.Token ~= token then
		return false
	end
	self:InvalidatePlayer(player)
	return true
end

function InteractionService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	self._sessionGeneration += 1
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	table.clear(self._sessionsByPlayer)
	table.clear(self._sessionsByToken)
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict

local ITEM_IDS = {
	"axe_basic",
	"rifle_basic",
	"ammo_rifle",
	"wood",
	"scrap",
	"battery_cell",
	"seed_wheat",
	"crop_wheat",
	"food_ration",
}

local InventoryService = {}
InventoryService.__index = InventoryService

function InventoryService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_bag = nil,
		_playerData = nil,
		_events = nil,
		_definitions = nil,
	}, InventoryService)
end

function InventoryService.Init(self, bag)
	if self._initialized then
		return
	end
	self._bag = bag
	self._playerData = bag:Get("PlayerDataService")
	self._events = bag:Get("DomainEvents")
	self._definitions = bag.Context.Definitions
	assert(type(self._definitions) == "table" and type(self._definitions.Items) == "table", "Definitions.Items is required")
	for _, itemId in ipairs(ITEM_IDS) do
		local definition = self._definitions.Items[itemId]
		assert(type(definition) == "table" and type(definition.StackCap) == "number", string.format("missing item definition %s", itemId))
	end
	self._initialized = true
end

function InventoryService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "InventoryService must initialize before Start")
	self._started = true
end

function InventoryService:_definition(itemId: string)
	return self._definitions.Items[itemId]
end

function InventoryService:_reserved(player: Player, itemId: string, exemption): number
	local farming = self._bag:Get("FarmingService")
	if type(farming.GetReservedCapacity) ~= "function" then
		return 0
	end
	return farming:GetReservedCapacity(player, itemId, exemption)
end

function InventoryService:GetItemQuantities(container): { [string]: number }
	local result = {}
	for _, itemId in ipairs(self._definitions.ItemIds) do
		result[itemId] = container[itemId] or 0
	end
	return result
end

function InventoryService:GetStorageUsed(profile): number
	local used = 0
	for _, quantity in pairs(profile.Storage) do
		used += quantity
	end
	return used
end

function InventoryService:GetStorageCapacity(profile): number
	return self._definitions.GetStorageCapacity(profile.Upgrades.storage)
end

function InventoryService:CanAddToProfile(player: Player, profile, itemId: string, count: number, exemption): (boolean, string?)
	local definition = self:_definition(itemId)
	if definition == nil or type(count) ~= "number" or count % 1 ~= 0 or count < 1 then
		return false, "INVALID_PAYLOAD"
	end
	local current = profile.Inventory[itemId] or 0
	local reserved = self:_reserved(player, itemId, exemption)
	if current + reserved + count > definition.StackCap then
		return false, "INVENTORY_FULL"
	end
	return true, nil
end

function InventoryService:CanRemoveFromProfile(profile, itemId: string, count: number): (boolean, string?)
	if self:_definition(itemId) == nil or type(count) ~= "number" or count % 1 ~= 0 or count < 1 then
		return false, "INVALID_PAYLOAD"
	end
	if (profile.Inventory[itemId] or 0) < count then
		return false, "NOT_ENOUGH_ITEMS"
	end
	return true, nil
end

function InventoryService:CanApplyDeltas(player: Player, profile, deltas, exemption): (boolean, string?)
	for itemId, delta in pairs(deltas) do
		if type(delta) ~= "number" or delta % 1 ~= 0 or self:_definition(itemId) == nil then
			return false, "INVALID_PAYLOAD"
		end
		if delta > 0 then
			local ok, code = self:CanAddToProfile(player, profile, itemId, delta, exemption)
			if not ok then
				return false, code
			end
		elseif delta < 0 then
			local ok, code = self:CanRemoveFromProfile(profile, itemId, -delta)
			if not ok then
				return false, code
			end
		end
	end
	return true, nil
end

function InventoryService:ApplyDeltas(profile, deltas)
	for itemId, delta in pairs(deltas) do
		local quantity = (profile.Inventory[itemId] or 0) + delta
		if quantity == 0 then
			profile.Inventory[itemId] = nil
		else
			profile.Inventory[itemId] = quantity
		end
	end
end

function InventoryService:CanAdd(player: Player, itemId: string, count: number, exemption): (boolean, string?)
	local profile = self._playerData:GetView(player)
	if profile == nil then
		return false, "PROFILE_NOT_READY"
	end
	return self:CanAddToProfile(player, profile, itemId, count, exemption)
end

function InventoryService:CanRemove(player: Player, itemId: string, count: number): (boolean, string?)
	local profile = self._playerData:GetView(player)
	if profile == nil then
		return false, "PROFILE_NOT_READY"
	end
	return self:CanRemoveFromProfile(profile, itemId, count)
end

function InventoryService:Add(player: Player, itemId: string, count: number, operation: string?, exemption): (boolean, string, any)
	local success, code, payload = self._playerData:Transact(player, operation or "InventoryAdd", function(profile)
		local canAdd, reason = self:CanAddToProfile(player, profile, itemId, count, exemption)
		if not canAdd then
			return false, reason
		end
		profile.Inventory[itemId] = (profile.Inventory[itemId] or 0) + count
		return true, { Quantity = profile.Inventory[itemId] }
	end)
	if success then
		self._events:Emit("ItemAdded", player, itemId, count, payload.Quantity)
	end
	return success, code, payload
end

function InventoryService:Remove(player: Player, itemId: string, count: number, operation: string?, allowSettlement: boolean?): (boolean, string, any)
	return self._playerData:Transact(player, operation or "InventoryRemove", function(profile)
		local canRemove, reason = self:CanRemoveFromProfile(profile, itemId, count)
		if not canRemove then
			return false, reason
		end
		local quantity = profile.Inventory[itemId] - count
		profile.Inventory[itemId] = if quantity == 0 then nil else quantity
		return true, { Quantity = quantity }
	end, allowSettlement)
end

function InventoryService:ProvisionStarter(player: Player): (boolean, string, any)
	local grant = self._definitions.StarterGrant
	local success, code, payload = self._playerData:Transact(player, "ProvisionStarter", function(profile)
		if profile.StarterGrantVersions[grant.Id] == true then
			return true, { Granted = false }
		end
		for itemId, quantity in pairs(grant.Items) do
			local definition = self:_definition(itemId)
			if definition == nil or (profile.Inventory[itemId] or 0) + quantity > definition.StackCap then
				return false, "INVENTORY_FULL"
			end
		end
		for itemId, quantity in pairs(grant.Items) do
			profile.Inventory[itemId] = (profile.Inventory[itemId] or 0) + quantity
		end
		profile.StarterGrantVersions[grant.Id] = true
		return true, { Granted = true }
	end)
	if success and payload.Granted then
		for itemId, quantity in pairs(grant.Items) do
			self._events:Emit("ItemAdded", player, itemId, quantity)
		end
	end
	return success, code, payload
end

function InventoryService:TransferStorage(player: Player, direction: string, itemId: string, count: number): (boolean, string, any)
	local definition = self:_definition(itemId)
	if definition == nil or not definition.StorageAllowed then
		return false, "INVALID_PAYLOAD", nil
	end
	local success, code, payload = self._playerData:Transact(player, "TransferStorage", function(profile)
		if type(count) ~= "number" or count % 1 ~= 0 or count < 1 or count > 50 then
			return false, "INVALID_PAYLOAD"
		end
		if direction == "deposit" then
			if (profile.Inventory[itemId] or 0) < count then
				return false, "NOT_ENOUGH_ITEMS"
			end
			if self:GetStorageUsed(profile) + count > self:GetStorageCapacity(profile) then
				return false, "STORAGE_FULL"
			end
			if (profile.Storage[itemId] or 0) + count > definition.StackCap then
				return false, "STORAGE_FULL"
			end
			local inventoryQuantity = profile.Inventory[itemId] - count
			profile.Inventory[itemId] = if inventoryQuantity == 0 then nil else inventoryQuantity
			profile.Storage[itemId] = (profile.Storage[itemId] or 0) + count
		elseif direction == "withdraw" then
			if (profile.Storage[itemId] or 0) < count then
				return false, "NOT_ENOUGH_ITEMS"
			end
			local canAdd, reason = self:CanAddToProfile(player, profile, itemId, count, nil)
			if not canAdd then
				return false, reason
			end
			local storageQuantity = profile.Storage[itemId] - count
			profile.Storage[itemId] = if storageQuantity == 0 then nil else storageQuantity
			profile.Inventory[itemId] = (profile.Inventory[itemId] or 0) + count
		else
			return false, "INVALID_PAYLOAD"
		end
		return true, {
			Direction = direction,
			ItemId = itemId,
			Count = count,
			StorageUsed = self:GetStorageUsed(profile),
			StorageCapacity = self:GetStorageCapacity(profile),
		}
	end)
	if success then
		self._events:Emit("StorageChanged", player, itemId, direction, count)
	end
	return success, code, payload
end

function InventoryService.Stop(self)
	self._started = false
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">NetworkService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local CHANNELS = {
	GetSnapshot = { Burst = 2, Refill = 0.5 },
	ToolIntent = { Burst = 12, Refill = 6 },
	InteractionIntent = { Burst = 6, Refill = 3 },
	InteractionCloseIntent = { Burst = 6, Refill = 3 },
	UseItemIntent = { Burst = 3, Refill = 1 },
}

local REMOTE_CLASSES = {
	GetSnapshot = "RemoteFunction",
	StateDelta = "RemoteEvent",
	ActionResult = "RemoteEvent",
	InteractionOpened = "RemoteEvent",
	ToolIntent = "RemoteEvent",
	InteractionIntent = "RemoteEvent",
	InteractionCloseIntent = "RemoteEvent",
	UseItemIntent = "RemoteEvent",
}

local NetworkService = {}
NetworkService.__index = NetworkService

local function printable(value: any, maximum: number): boolean
	return type(value) == "string" and #value >= 1 and #value <= maximum and value:match("^[ -~]+$") ~= nil
end

local function requestId(value: any): boolean
	return type(value) == "string" and #value >= 1 and #value <= 36 and value:match("^[A-Za-z0-9_-]+$") ~= nil
end

local function aim(value: any): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	if value.X ~= value.X or value.Y ~= value.Y or value.Z ~= value.Z then
		return false
	end
	if math.abs(value.X) == math.huge or math.abs(value.Y) == math.huge or math.abs(value.Z) == math.huge then
		return false
	end
	return value.Magnitude >= 0.99 and value.Magnitude <= 1.01
end

local function exactKeys(payload, keys): boolean
	if type(payload) ~= "table" or getmetatable(payload) ~= nil then
		return false
	end
	local count = 0
	for key in pairs(payload) do
		if type(key) ~= "string" or not keys[key] then
			return false
		end
		count += 1
	end
	local expected = 0
	for key in pairs(keys) do
		expected += 1
		if payload[key] == nil then
			return false
		end
	end
	return count == expected
end

function NetworkService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_accepting = true,
		_remotes = nil,
		_playerData = nil,
		_equipment = nil,
		_interaction = nil,
		_replication = nil,
		_events = nil,
		_config = nil,
		_netTypes = nil,
		_connections = {},
		_players = {} :: { [Player]: any },
	}, NetworkService)
end

function NetworkService.Init(self, bag)
	if self._initialized then
		return
	end
	self._remotes = bag.Context.Remotes
	self._playerData = bag:Get("PlayerDataService")
	self._equipment = bag:Get("EquipmentService")
	self._interaction = bag:Get("InteractionService")
	self._replication = bag:Get("ReplicationService")
	self._events = bag:Get("DomainEvents")
	self._config = bag.Context.Config
	self._netTypes = bag.Context.NetTypes
	assert(type(self._remotes) == "table", "source-authored remotes are required")
	local remotesValid, remotesError = self._netTypes.ValidateRemoteContainer(bag.Context.RemotesFolder)
	assert(remotesValid, remotesError)
	for name, className in pairs(REMOTE_CLASSES) do
		assert(self._remotes[name] ~= nil and self._remotes[name].ClassName == className, string.format("ReplicatedStorage.Remotes.%s must be %s", name, className))
	end
	self._initialized = true
end

function NetworkService:_state(player: Player)
	local state = self._players[player]
	if state == nil then
		state = {
			Buckets = {},
			Results = {},
			ResultOrder = {},
			Seen = {},
			SeenOrder = {},
			LastRateLimitAt = {},
		}
		self._players[player] = state
	end
	return state
end

function NetworkService:_consume(player: Player, channel: string): (boolean, number)
	local fallback = CHANNELS[channel]
	local shared = self._config.Network.RateLimits[channel]
	local config = { Burst = shared.Burst or fallback.Burst, Refill = shared.RefillPerSecond or fallback.Refill }
	local state = self:_state(player)
	local now = workspace:GetServerTimeNow()
	local bucket = state.Buckets[channel]
	if bucket == nil then
		bucket = { Tokens = config.Burst, UpdatedAt = now }
		state.Buckets[channel] = bucket
	else
		bucket.Tokens = math.min(config.Burst, bucket.Tokens + (now - bucket.UpdatedAt) * config.Refill)
		bucket.UpdatedAt = now
	end
	if bucket.Tokens < 1 then
		local retryAfter = math.clamp((1 - bucket.Tokens) / config.Refill, 0.5, 5)
		return false, retryAfter
	end
	bucket.Tokens -= 1
	return true, 0
end

function NetworkService:_prune(state)
	local now = workspace:GetServerTimeNow()
	while #state.ResultOrder > 0 do
		local id = state.ResultOrder[1]
		local entry = state.Results[id]
		if entry ~= nil and now - entry.CreatedAt <= self._config.Network.ResultCacheLifetimeSeconds and #state.ResultOrder <= self._config.Network.ResultCacheSizePerPlayer then
			break
		end
		table.remove(state.ResultOrder, 1)
		if entry ~= nil and (now - entry.CreatedAt > self._config.Network.ResultCacheLifetimeSeconds or #state.ResultOrder >= self._config.Network.ResultCacheSizePerPlayer) then
			state.Results[id] = nil
		end
	end
	while #state.SeenOrder > 0 do
		local id = state.SeenOrder[1]
		local seenAt = state.Seen[id]
		if seenAt ~= nil and now - seenAt <= self._config.Network.ResultCacheLifetimeSeconds then
			break
		end
		table.remove(state.SeenOrder, 1)
		if seenAt ~= nil and now - seenAt > self._config.Network.ResultCacheLifetimeSeconds then
			state.Seen[id] = nil
		end
	end
end

function NetworkService:_cached(player: Player, id: string)
	local state = self:_state(player)
	self:_prune(state)
	local entry = state.Results[id]
	if entry ~= nil then
		return entry.Result, false
	end
	if state.Seen[id] ~= nil then
		return nil, true
	end
	return nil, false
end

function NetworkService:_remember(player: Player, id: string, result)
	local state = self:_state(player)
	local now = workspace:GetServerTimeNow()
	if state.Seen[id] == nil then
		state.Seen[id] = now
		table.insert(state.SeenOrder, id)
	end
	if state.Results[id] == nil then
		table.insert(state.ResultOrder, id)
	end
	state.Results[id] = { CreatedAt = now, Result = result }
	self:_prune(state)
end

function NetworkService:SendResult(player: Player, id: string, success: boolean, code: string, payload, remember: boolean?)
	local result = {
		RequestId = id,
		Success = success,
		Code = code,
		Revision = self._replication:GetRevision(player),
		Payload = if success then payload else nil,
	}
	local valid, validationError = self._netTypes.ValidateActionResult(result)
	assert(valid, validationError)
	if remember ~= false then
		self:_remember(player, id, result)
	end
	self._remotes.ActionResult:FireClient(player, result)
	return result
end

function NetworkService:_sendRateLimited(player: Player, id: string, channel: string)
	local state = self:_state(player)
	local shared = self._config.Network.RateLimits[channel]
	local fallback = CHANNELS[channel]
	local refill = shared.RefillPerSecond or fallback.Refill
	local now = workspace:GetServerTimeNow()
	local last = state.LastRateLimitAt[channel] or -math.huge
	if now - last >= 1 / refill then
		state.LastRateLimitAt[channel] = now
		self:SendResult(player, id, false, "RATE_LIMITED", nil)
	end
end

function NetworkService:_beginRequest(player: Player, payload, channel: string): (boolean, string, any)
	local hasRequestId = type(payload) == "table" and requestId(payload.RequestId)
	local id = if hasRequestId then payload.RequestId else HttpService:GenerateGUID(false)
	if hasRequestId then
		local cached, replayed = self:_cached(player, id)
		if cached ~= nil then
			self._remotes.ActionResult:FireClient(player, cached)
			return false, id, nil
		end
		if replayed then
			self:SendResult(player, id, false, "REPLAYED", nil, false)
			return false, id, nil
		end
	end
	local allowed = self:_consume(player, channel)
	if not allowed then
		self:_sendRateLimited(player, id, channel)
		return false, id, nil
	end
	if not self._accepting then
		self:SendResult(player, id, false, "PROFILE_NOT_READY", nil)
		return false, id, nil
	end
	return true, id, payload
end

function NetworkService:_finish(player: Player, id: string, request, success: boolean, code: string, payload)
	if success and payload ~= nil then
		payload.Kind = request.Kind
	end
	self:SendResult(player, id, success, code, payload)
end

function NetworkService:_validateTool(payload): (boolean, string)
	local contractValid = self._netTypes.ValidateToolIntent(payload)
	if contractValid then
		return true, "OK"
	end
	if type(payload) ~= "table" or not requestId(payload.RequestId) or not printable(payload.Kind, 16) then
		return false, "INVALID_PAYLOAD"
	end
	if payload.Kind == "Equip" then
		return false, "INVALID_PAYLOAD"
	elseif payload.Kind == "Primary" then
		if exactKeys(payload, { RequestId = true, Kind = true, AimDirection = true }) and not aim(payload.AimDirection) then
			return false, "INVALID_AIM"
		end
		return false, "INVALID_PAYLOAD"
	end
	return false, "UNKNOWN_REQUEST"
end

function NetworkService:_validateUseItem(payload): (boolean, string)
	local contractValid = self._netTypes.ValidateUseItemIntent(payload)
	if contractValid then
		return true, "OK"
	end
	if type(payload) == "table" and requestId(payload.RequestId) and printable(payload.Kind, 16) and payload.Kind ~= "UseItem" then
		return false, "UNKNOWN_REQUEST"
	end
	return false, "INVALID_PAYLOAD"
end

function NetworkService:_validateInteraction(payload): (boolean, string)
	local contractValid = self._netTypes.ValidateInteractionIntent(payload)
	if contractValid then
		return true, "OK"
	end
	if type(payload) ~= "table" or not requestId(payload.RequestId) or not printable(payload.Kind, 24) then
		return false, "INVALID_PAYLOAD"
	end
	if payload.Kind == "FarmPlant"
		or payload.Kind == "FarmHarvest"
		or payload.Kind == "ProcessorStart"
		or payload.Kind == "ShopBuy"
		or payload.Kind == "StorageTransfer"
		or payload.Kind == "PowerActivate"
		or payload.Kind == "ScrapExchange"
		or payload.Kind == "UpgradeBuy"
	then
		return false, "INVALID_PAYLOAD"
	end
	return false, "UNKNOWN_REQUEST"
end

function NetworkService:_handleTool(player: Player, payload)
	local proceed, id = self:_beginRequest(player, payload, "ToolIntent")
	if not proceed then
		return
	end
	local valid, validationCode = self:_validateTool(payload)
	if not valid then
		self:SendResult(player, id, false, validationCode, nil)
		return
	end
	if not self._playerData:IsReady(player) then
		self:SendResult(player, id, false, "PROFILE_NOT_READY", nil)
		return
	end
	local success, code, result
	if payload.Kind == "Equip" then
		success, code, result = self._equipment:EquipSlot(player, payload.Slot)
	else
		success, code, result = self._equipment:HandlePrimary(player, payload.AimDirection)
	end
	self:_finish(player, id, payload, success, code, result)
end

function NetworkService:_handleUseItem(player: Player, payload)
	local proceed, id = self:_beginRequest(player, payload, "UseItemIntent")
	if not proceed then
		return
	end
	local valid, validationCode = self:_validateUseItem(payload)
	if not valid then
		self:SendResult(player, id, false, validationCode, nil)
		return
	end
	if not self._playerData:IsReady(player) then
		self:SendResult(player, id, false, "PROFILE_NOT_READY", nil)
		return
	end
	local success, code, result = self._equipment:UseRation(player)
	self:_finish(player, id, payload, success, code, result)
end

function NetworkService:_handleInteraction(player: Player, payload)
	local proceed, id = self:_beginRequest(player, payload, "InteractionIntent")
	if not proceed then
		return
	end
	local valid, validationCode = self:_validateInteraction(payload)
	if not valid then
		self:SendResult(player, id, false, validationCode, nil)
		return
	end
	if not self._playerData:IsReady(player) then
		self:SendResult(player, id, false, "PROFILE_NOT_READY", nil)
		return
	end
	local success, code, result = self._interaction:RouteIntent(player, payload)
	self:_finish(player, id, payload, success, code, result)
end

function NetworkService:_handleInteractionClose(player: Player, payload)
	if not self._accepting or not self._playerData:IsReady(player) then
		return
	end
	local allowed = self:_consume(player, "InteractionCloseIntent")
	if not allowed then
		return
	end
	local valid = self._netTypes.ValidateInteractionCloseIntent(payload)
	if not valid then
		return
	end
	self._interaction:CloseSession(player, payload.Token)
end

function NetworkService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "NetworkService must initialize before Start")
	self._started = true
	self._accepting = true
	self._remotes.GetSnapshot.OnServerInvoke = function(player, ...)
		local allowed, retryAfter = self:_consume(player, "GetSnapshot")
		if select("#", ...) ~= 0 or not allowed or not self._accepting then
			local response = { Success = false, Code = "RATE_LIMITED", RetryAfter = if allowed then 0.5 else retryAfter }
			local valid, validationError = self._netTypes.ValidateGetSnapshotResponse(response)
			assert(valid, validationError)
			return response
		end
		local success, code, snapshot = self._replication:GetSnapshot(player)
		if success then
			local response = { Success = true, Code = "OK", Snapshot = snapshot }
			local valid, validationError = self._netTypes.ValidateGetSnapshotResponse(response)
			assert(valid, validationError)
			return response
		end
		local response = { Success = false, Code = code, RetryAfter = 0.5 }
		local valid, validationError = self._netTypes.ValidateGetSnapshotResponse(response)
		assert(valid, validationError)
		return response
	end
	table.insert(self._connections, self._remotes.ToolIntent.OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then
			self:_handleTool(player, nil)
			return
		end
		self:_handleTool(player, ...)
	end))
	table.insert(self._connections, self._remotes.InteractionIntent.OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then
			self:_handleInteraction(player, nil)
			return
		end
		self:_handleInteraction(player, ...)
	end))
	table.insert(self._connections, self._remotes.InteractionCloseIntent.OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then
			return
		end
		self:_handleInteractionClose(player, ...)
	end))
	table.insert(self._connections, self._remotes.UseItemIntent.OnServerEvent:Connect(function(player, ...)
		if select("#", ...) ~= 1 then
			self:_handleUseItem(player, nil)
			return
		end
		self:_handleUseItem(player, ...)
	end))
	table.insert(self._connections, self._events:On("InteractionOpened", function(player, payload)
		local valid, validationError = self._netTypes.ValidateInteractionOpened(payload)
		assert(valid, validationError)
		self._remotes.InteractionOpened:FireClient(player, payload)
	end))
	table.insert(self._connections, Players.PlayerRemoving:Connect(function(player)
		self:RemovePlayer(player)
	end))
end

function NetworkService:RejectNewRequests()
	self._accepting = false
end

function NetworkService:RemovePlayer(player: Player)
	self._players[player] = nil
end

function NetworkService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	self._accepting = false
	self._remotes.GetSnapshot.OnServerInvoke = nil
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	table.clear(self._players)
end

return NetworkService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">OnboardingService</string>
            <string name="Source"><![CDATA[--!strict

local TRANSITIONS = {
	wake_in_bunker = "harvest_first_wood",
	harvest_first_wood = "plant_first_crop",
	-- The FoodProcessor rejects work without main power. Guide the player to
	-- restore the bunker before presenting the processing objective.
	plant_first_crop = "restore_bunker_power",
	restore_bunker_power = "process_first_food",
	process_first_food = "survive_first_night",
	survive_first_night = "onboarding_complete",
}

local OnboardingService = {}
OnboardingService.__index = OnboardingService

function OnboardingService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_playerData = nil,
		_events = nil,
		_bunker = nil,
		_connections = {},
	}, OnboardingService)
end

function OnboardingService.Init(self, bag)
	if self._initialized then
		return
	end
	self._playerData = bag:Get("PlayerDataService")
	self._bunker = bag:Get("BunkerService")
	self._events = bag:Get("DomainEvents")
	self._initialized = true
end

function OnboardingService:_advance(player: Player, expectedStep: string)
	if not self._playerData:IsReady(player) then
		return
	end
	local success, _, payload = self._playerData:Transact(player, "AdvanceOnboarding", function(profile)
		if profile.Onboarding.Completed or profile.Onboarding.Step ~= expectedStep then
			return false, "UNKNOWN_REQUEST"
		end
		local nextStep = TRANSITIONS[expectedStep]
		if nextStep == nil then
			return false, "UNKNOWN_REQUEST"
		end
		profile.Onboarding.Step = nextStep
		profile.Onboarding.Completed = nextStep == "onboarding_complete"
		return true, {
			Version = 1,
			Step = nextStep,
			Completed = profile.Onboarding.Completed,
		}
	end)
	if success then
		self._events:Emit("OnboardingChanged", player, payload)
	end
end

function OnboardingService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "OnboardingService must initialize before Start")
	self._started = true
	table.insert(self._connections, self._events:On("CharacterSpawned", function(player)
		self:_advance(player, "wake_in_bunker")
	end))
	table.insert(self._connections, self._events:On("TreeHarvested", function(player)
		self:_advance(player, "harvest_first_wood")
	end))
	table.insert(self._connections, self._events:On("PlotPlanted", function(player)
		self:_advance(player, "plant_first_crop")
	end))
	table.insert(self._connections, self._events:On("FoodProcessed", function(player)
		self:_advance(player, "process_first_food")
	end))
	table.insert(self._connections, self._events:On("PowerActivated", function(player)
		self:_advance(player, "restore_bunker_power")
	end))
	table.insert(self._connections, self._events:On("NightSurvived", function(player)
		self:_advance(player, "survive_first_night")
	end))
end

function OnboardingService:GetView(player: Player)
	local profile = self._playerData:GetView(player)
	if profile == nil then
		return nil
	end
	return {
		Version = profile.Onboarding.Version,
		Step = profile.Onboarding.Step,
		Completed = profile.Onboarding.Completed,
	}
end

function OnboardingService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
end

return OnboardingService
]]></string>
          </Properties>
