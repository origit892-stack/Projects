      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">DomainEvents</string>
          <string name="Source"><![CDATA[--!strict

local EVENT_NAMES = {
	"WorldReady",
	"ProfileReady",
	"ProfileChanged",
	"ProfileLeaving",
	"CharacterSpawned",
	"CharacterDied",
	"ItemAdded",
	"StorageChanged",
	"EquipmentChanged",
	"ToolHit",
	"TreeHarvested",
	"ScrapCollected",
	"ResourceChanged",
	"PlotPlanted",
	"CropHarvested",
	"FoodProcessed",
	"FarmChanged",
	"PurchaseCompleted",
	"UpgradePurchased",
	"PowerActivated",
	"PowerExpired",
	"PlayerDied",
	"ZombieKilled",
	"WaveChanged",
	"NightSurvived",
	"PhaseChanged",
	"OnboardingChanged",
	"InteractionOpened",
}

local ALLOWED_EVENTS: { [string]: boolean } = {}
for _, name in ipairs(EVENT_NAMES) do
	ALLOWED_EVENTS[name] = true
end

local Connection = {}
Connection.__index = Connection

function Connection.Disconnect(self)
	if not self.Connected then
		return
	end
	self.Connected = false
	self._callback = nil
end

local DomainEvents = {}
DomainEvents.__index = DomainEvents

function DomainEvents.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_stopped = false,
		_subscriptions = {} :: { [string]: { any } },
	}, DomainEvents)
end

function DomainEvents.Init(self, _bag)
	if self._initialized then
		return
	end
	self._initialized = true
	self._stopped = false
	for _, name in ipairs(EVENT_NAMES) do
		self._subscriptions[name] = {}
	end
end

function DomainEvents.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "DomainEvents must initialize before Start")
	self._started = true
end

function DomainEvents.On(self, name: string, callback: (...any) -> ())
	assert(self._initialized and not self._stopped, "DomainEvents is not available")
	assert(ALLOWED_EVENTS[name], string.format("unknown domain event %s", tostring(name)))
	assert(type(callback) == "function", "domain event callback must be a function")

	local connection = setmetatable({
		Connected = true,
		_callback = callback,
	}, Connection)
	table.insert(self._subscriptions[name], connection)
	return connection
end

function DomainEvents.Emit(self, name: string, ...: any)
	assert(ALLOWED_EVENTS[name], string.format("unknown domain event %s", tostring(name)))
	if self._stopped then
		return
	end

	local snapshot = table.clone(self._subscriptions[name])
	for _, connection in ipairs(snapshot) do
		if connection.Connected and connection._callback ~= nil then
			local callback = connection._callback
			local arguments = table.pack(...)
			local ok, err = xpcall(function()
				callback(table.unpack(arguments, 1, arguments.n))
			end, debug.traceback)
			if not ok then
				warn(string.format("domain event %s listener failed: %s", name, tostring(err)))
			end
		end
	end
end

function DomainEvents.Stop(self)
	if self._stopped then
		return
	end
	self._stopped = true
	self._started = false
	for _, subscriptions in pairs(self._subscriptions) do
		for _, connection in ipairs(subscriptions) do
			connection:Disconnect()
		end
		table.clear(subscriptions)
	end
end

return DomainEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">PersistenceRepository</string>
          <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local DATASTORE_NAME = Config.Profile.DataStoreName
local LEASE_SECONDS = Config.Persistence.LockLeaseSeconds
local LOAD_DEADLINE_SECONDS = Config.Persistence.LoadDeadlineSeconds
local LOAD_BACKOFF = Config.Persistence.LoadBackoffSeconds

local function copy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[copy(key)] = copy(child)
	end
	return result
end

local function profileKey(userId: number): string
	return Config.Profile.RecordKeyPrefix .. tostring(userId)
end

local function boundedJitter(userId: number, attempt: number): number
	return ((userId * 31 + attempt * 17) % 101) / 500
end

local PersistenceRepository = {}
PersistenceRepository.__index = PersistenceRepository

function PersistenceRepository.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_closed = false,
		_mode = "Memory",
		_jobId = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false),
		_profileSchema = nil,
		_dataStore = nil,
		_memoryRecords = {} :: { [number]: any },
		_knownRevisions = {} :: { [number]: number },
	}, PersistenceRepository)
end

function PersistenceRepository.Init(self, bag)
	if self._initialized then
		return
	end
	self._profileSchema = bag.Context.ProfileSchema
	assert(type(self._profileSchema) == "table", "ProfileSchema shared module is required")
	assert(type(self._profileSchema.CreateDefault) == "function", "ProfileSchema.CreateDefault is required")
	assert(type(self._profileSchema.Validate) == "function", "ProfileSchema.Validate is required")

	local studioDataStoreEnabled = ServerStorage:GetAttribute("FG_UseProductionDataStoreInStudio") == true
	if not RunService:IsStudio() or studioDataStoreEnabled then
		self._mode = "DataStore"
		self._dataStore = DataStoreService:GetDataStore(DATASTORE_NAME)
	else
		self._mode = "Memory"
	end
	self._initialized = true
	self._closed = false
end

function PersistenceRepository.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "PersistenceRepository must initialize before Start")
	self._started = true
end

function PersistenceRepository.GetMode(self): string
	return self._mode
end

function PersistenceRepository:_validateProfile(profile, invalidCode: string?): (boolean, string?)
	if type(profile) ~= "table" then
		return false, invalidCode or "PROFILE_LOAD_FAILED"
	end
	if type(profile.SchemaVersion) == "number" and profile.SchemaVersion ~= Config.Profile.SchemaVersion then
		return false, "PROFILE_VERSION_UNSUPPORTED"
	end
	local ok = self._profileSchema.Validate(profile)
	if not ok then
		return false, invalidCode or "PROFILE_LOAD_FAILED"
	end
	return true, nil
end

function PersistenceRepository:_newRecord(now: number)
	local profile = self._profileSchema.CreateDefault()
	local valid, code = self:_validateProfile(profile, "PROFILE_CONFLICT")
	assert(valid, string.format("ProfileSchema.CreateDefault produced invalid data: %s", tostring(code)))
	return {
		Profile = copy(profile),
		Lock = {
			JobId = self._jobId,
			ExpiresAt = now + LEASE_SECONDS,
		},
	}
end

function PersistenceRepository:Load(userId: number): (boolean, any, string?)
	if self._closed then
		return false, nil, "PROFILE_LOAD_FAILED"
	end
	assert(type(userId) == "number" and userId > 0 and userId % 1 == 0, "userId must be a positive integer")

	if self._mode == "Memory" then
		local now = os.time()
		local record = self._memoryRecords[userId]
		if record == nil then
			record = self:_newRecord(now)
			self._memoryRecords[userId] = record
		else
			if type(record) == "table" and type(record.Profile) == "table" and type(record.Profile.SchemaVersion) == "number" and record.Profile.SchemaVersion ~= Config.Profile.SchemaVersion then
				return false, nil, "PROFILE_VERSION_UNSUPPORTED"
			end
			local recordValid = self._profileSchema.ValidateStoredRecord(record)
			if not recordValid then
				return false, nil, "PROFILE_LOAD_FAILED"
			end
			local valid, code = self:_validateProfile(record.Profile)
			if not valid then
				return false, nil, code
			end
			local lock = record.Lock
			if type(lock) == "table" and lock.JobId ~= self._jobId and lock.JobId ~= "" and lock.ExpiresAt > now then
				return false, nil, "PROFILE_LOCKED"
			end
			record.Lock = {
				JobId = self._jobId,
				ExpiresAt = now + LEASE_SECONDS,
			}
		end
		self._knownRevisions[userId] = record.Profile.Revision
		return true, copy(record.Profile), nil
	end

	local deadline = os.clock() + LOAD_DEADLINE_SECONDS
	local finalCode = "PROFILE_LOAD_FAILED"
	for attempt, delaySeconds in ipairs(LOAD_BACKOFF) do
		if os.clock() >= deadline then
			break
		end
		local acquiredProfile = nil
		local callbackCode = nil
		local ok = pcall(function()
			self._dataStore:UpdateAsync(profileKey(userId), function(stored)
				-- UpdateAsync may rerun this callback after a write conflict. Only the
				-- final invocation may decide whether the lease was acquired.
				acquiredProfile = nil
				callbackCode = nil
				local now = os.time()
				local record = stored
				if record == nil then
					record = self:_newRecord(now)
				else
					if type(record) == "table" and type(record.Profile) == "table" and type(record.Profile.SchemaVersion) == "number" and record.Profile.SchemaVersion ~= Config.Profile.SchemaVersion then
						callbackCode = "PROFILE_VERSION_UNSUPPORTED"
						return nil
					end
					local recordValid = self._profileSchema.ValidateStoredRecord(record)
					if not recordValid then
						callbackCode = "PROFILE_LOAD_FAILED"
						return nil
					end
					local valid, code = self:_validateProfile(record.Profile)
					if not valid then
						callbackCode = code
						return nil
					end
					local lock = record.Lock
					if lock.JobId ~= self._jobId and lock.JobId ~= "" and lock.ExpiresAt > now then
						callbackCode = "PROFILE_LOCKED"
						return nil
					end
					record = copy(record)
					record.Lock = {
						JobId = self._jobId,
						ExpiresAt = now + LEASE_SECONDS,
					}
				end
				acquiredProfile = copy(record.Profile)
				return record
			end)
		end)
		if ok and acquiredProfile ~= nil then
			self._knownRevisions[userId] = acquiredProfile.Revision
			return true, acquiredProfile, nil
		end
		if callbackCode ~= nil then
			finalCode = callbackCode
			if callbackCode == "PROFILE_LOCKED" or callbackCode == "PROFILE_VERSION_UNSUPPORTED" then
				break
			end
		end
		if attempt < #LOAD_BACKOFF then
			local remaining = deadline - os.clock()
			if remaining <= 0 then
				break
			end
			task.wait(math.min(remaining, delaySeconds + boundedJitter(userId, attempt)))
		end
	end
	return false, nil, finalCode
end

function PersistenceRepository:Save(userId: number, profile): (boolean, string?)
	if self._closed then
		return false, "PROFILE_LOAD_FAILED"
	end
	local valid, validationCode = self:_validateProfile(profile, "PROFILE_CONFLICT")
	if not valid then
		return false, validationCode
	end
	local knownRevision = self._knownRevisions[userId]
	if knownRevision == nil then
		return false, "PROFILE_CONFLICT"
	end

	if self._mode == "Memory" then
		local record = self._memoryRecords[userId]
		if record == nil or record.Lock.JobId ~= self._jobId or record.Profile.Revision ~= knownRevision then
			return false, "PROFILE_CONFLICT"
		end
		record.Profile = copy(profile)
		record.Lock.ExpiresAt = os.time() + LEASE_SECONDS
		self._knownRevisions[userId] = profile.Revision
		return true, nil
	end

	local saved = false
	local callbackCode = nil
	local ok = pcall(function()
		self._dataStore:UpdateAsync(profileKey(userId), function(record)
			saved = false
			callbackCode = nil
			local recordValid = self._profileSchema.ValidateStoredRecord(record)
			if not recordValid then
				callbackCode = "PROFILE_CONFLICT"
				return nil
			end
			if record.Lock.JobId ~= self._jobId then
				callbackCode = "PROFILE_LOCKED"
				return nil
			end
			if record.Profile.Revision ~= knownRevision then
				callbackCode = "PROFILE_CONFLICT"
				return nil
			end
			saved = true
			return {
				Profile = copy(profile),
				Lock = {
					JobId = self._jobId,
					ExpiresAt = os.time() + LEASE_SECONDS,
				},
			}
		end)
	end)
	if not ok or not saved then
		return false, callbackCode or "PROFILE_LOAD_FAILED"
	end
	self._knownRevisions[userId] = profile.Revision
	return true, nil
end

function PersistenceRepository:Release(userId: number): (boolean, string?)
	if self._knownRevisions[userId] == nil then
		return true, nil
	end
	if self._mode == "Memory" then
		local record = self._memoryRecords[userId]
		if record ~= nil and record.Lock.JobId == self._jobId then
			record.Lock = { JobId = self._jobId, ExpiresAt = 0 }
		end
		self._knownRevisions[userId] = nil
		return true, nil
	end

	local released = false
	local callbackCode = nil
	local ok = pcall(function()
		self._dataStore:UpdateAsync(profileKey(userId), function(record)
			released = false
			callbackCode = nil
			local recordValid = self._profileSchema.ValidateStoredRecord(record)
			if not recordValid then
				callbackCode = "PROFILE_CONFLICT"
				return nil
			end
			if record.Lock.JobId ~= self._jobId then
				callbackCode = "PROFILE_LOCKED"
				return nil
			end
			local result = copy(record)
			result.Lock = { JobId = self._jobId, ExpiresAt = 0 }
			released = true
			return result
		end)
	end)
	if not ok or not released then
		return false, callbackCode or "PROFILE_LOAD_FAILED"
	end
	self._knownRevisions[userId] = nil
	return true, nil
end

function PersistenceRepository:Close()
	self._closed = true
	self._started = false
	table.clear(self._knownRevisions)
end

function PersistenceRepository.Stop(self)
	if self._closed then
		return
	end
	self:Close()
end

return PersistenceRepository
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">ServerBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Character admission remains closed until the complete service graph starts.
Players.CharacterAutoLoads = false

local root = script.Parent
local servicesFolder = root:FindFirstChild("Services")
assert(servicesFolder ~= nil, "ServerScriptService.Game.Services is required")

local ServiceBag = require(root.ServiceBag)
local DomainEvents = require(root.DomainEvents)
local PersistenceRepository = require(root.PersistenceRepository)

local function serviceModule(name: string)
	local module = servicesFolder:FindFirstChild(name)
	assert(module ~= nil and module:IsA("ModuleScript"), string.format("missing service module %s", name))
	return require(module)
end

local WorldService = serviceModule("WorldService")
local PlayerDataService = serviceModule("PlayerDataService")
local InventoryService = serviceModule("InventoryService")
local BunkerService = serviceModule("BunkerService")
local SpawnService = serviceModule("SpawnService")
local CombatService = serviceModule("CombatService")
local ResourceService = serviceModule("ResourceService")
local FarmingService = serviceModule("FarmingService")
local EconomyService = serviceModule("EconomyService")
local TimeService = serviceModule("TimeService")
local EquipmentService = serviceModule("EquipmentService")
local ZombieService = serviceModule("ZombieService")
local OnboardingService = serviceModule("OnboardingService")
local InteractionService = serviceModule("InteractionService")
local ReplicationService = serviceModule("ReplicationService")
local NetworkService = serviceModule("NetworkService")

local sharedFolder = ReplicatedStorage:FindFirstChild("Game")
assert(sharedFolder ~= nil and sharedFolder:IsA("Folder"), "ReplicatedStorage.Game is required")

local function sharedModule(name: string)
	local module = sharedFolder:FindFirstChild(name)
	assert(module ~= nil and module:IsA("ModuleScript"), string.format("missing shared module %s", name))
	return require(module)
end

local Config = sharedModule("Config")
local Definitions = sharedModule("Definitions")
local ProfileSchema = sharedModule("ProfileSchema")
local NetTypes = sharedModule("NetTypes")
local WorldManifest = sharedModule("WorldManifest")

assert(Config.Server.CharacterAutoLoads == false, "shared config must disable CharacterAutoLoads")
assert(Config.Server.MaxActivePlayers == 6, "shared config maximum must remain six")

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
assert(remotesFolder ~= nil, "source-authored ReplicatedStorage.Remotes is required")
local remotesValid, remotesError = NetTypes.ValidateRemoteContainer(remotesFolder)
assert(remotesValid, remotesError)
local remotes = {}
for remoteName in pairs(NetTypes.RemoteDefinitions) do
	remotes[remoteName] = remotesFolder:FindFirstChild(remoteName)
end

local bag = ServiceBag.new({
	Config = Config,
	Definitions = Definitions,
	ProfileSchema = ProfileSchema,
	NetTypes = NetTypes,
	WorldManifest = WorldManifest,
	RemotesFolder = remotesFolder,
	Remotes = remotes,
})

local domainEvents = bag:Add("DomainEvents", DomainEvents.new())
bag:Add("PersistenceRepository", PersistenceRepository.new())
local worldService = bag:Add("WorldService", WorldService.new())
local playerDataService = bag:Add("PlayerDataService", PlayerDataService.new())
local inventoryService = bag:Add("InventoryService", InventoryService.new())
local bunkerService = bag:Add("BunkerService", BunkerService.new())
local spawnService = bag:Add("SpawnService", SpawnService.new())
local combatService = bag:Add("CombatService", CombatService.new())
local resourceService = bag:Add("ResourceService", ResourceService.new())
local farmingService = bag:Add("FarmingService", FarmingService.new())
local economyService = bag:Add("EconomyService", EconomyService.new())
local timeService = bag:Add("TimeService", TimeService.new())
local equipmentService = bag:Add("EquipmentService", EquipmentService.new())
local zombieService = bag:Add("ZombieService", ZombieService.new())
local onboardingService = bag:Add("OnboardingService", OnboardingService.new())
local interactionService = bag:Add("InteractionService", InteractionService.new())
local replicationService = bag:Add("ReplicationService", ReplicationService.new())
local networkService = bag:Add("NetworkService", NetworkService.new())

-- Keep strong references and make the intended construction order explicit.
assert(domainEvents and worldService and inventoryService and bunkerService and combatService and resourceService)
assert(economyService and timeService and onboardingService)

local closing = false
local admitted: { [Player]: boolean } = {}
local admittedCount = 0
local tearingDown: { [Player]: boolean } = {}
local playerConnections = {}

local function releaseAdmission(player: Player)
	if admitted[player] then
		admitted[player] = nil
		admittedCount = math.max(0, admittedCount - 1)
	end
end

local function teardownStep(player: Player, label: string, callback: () -> ())
	local ok, failure = xpcall(callback, debug.traceback)
	if not ok then
		warn(string.format("player teardown step %s failed for %d: %s", label, player.UserId, tostring(failure)))
	end
end

local function teardownPlayer(player: Player)
	if tearingDown[player] then
		while tearingDown[player] do
			task.wait()
		end
		return
	end
	tearingDown[player] = true

	-- This order is the frozen seven-step player teardown contract.
	teardownStep(player, "1-mark-leaving", function()
		playerDataService:BeginLeaving(player)
	end)
	teardownStep(player, "2-request-state", function()
		networkService:RemovePlayer(player)
	end)
	teardownStep(player, "2-interaction-tokens", function()
		interactionService:InvalidatePlayer(player)
	end)
	teardownStep(player, "3-reservations", function()
		farmingService:ReleasePlayer(player)
	end)
	teardownStep(player, "3-resource-cooldowns", function()
		resourceService:ReleasePlayer(player)
	end)
	teardownStep(player, "4-spawn-slot", function()
		spawnService:Release(player)
	end)
	teardownStep(player, "5-equipment-actor", function()
		equipmentService:ClearCharacter(player)
	end)
	teardownStep(player, "6-wave-eligibility", function()
		zombieService:ReleasePlayer(player)
	end)
	teardownStep(player, "6-replication", function()
		replicationService:RemovePlayer(player)
	end)
	teardownStep(player, "7-profile", function()
		local released, releaseCode = playerDataService:Release(player)
		if not released then
			warn(string.format("profile release failed for %d: %s", player.UserId, tostring(releaseCode)))
		end
	end)
	releaseAdmission(player)
	tearingDown[player] = nil
end

local function failPlayer(player: Player, code: string)
	teardownPlayer(player)
	if player.Parent == Players then
		player:Kick(string.format("Your survival profile could not be prepared. Please retry shortly. [%s]", code))
	end
end

local function handlePlayer(player: Player)
	if closing then
		player:Kick("This server is shutting down. Please reconnect.")
		return
	end
	if admitted[player] then
		return
	end
	if admittedCount >= Config.Server.MaxActivePlayers then
		player:Kick("This server supports six active players. [SERVER_FULL]")
		return
	end
	admitted[player] = true
	admittedCount += 1

	local loaded, loadCode = playerDataService:LoadPlayer(player)
	if not loaded then
		failPlayer(player, loadCode or "PROFILE_LOAD_FAILED")
		return
	end
	if closing or player.Parent ~= Players then
		teardownPlayer(player)
		return
	end

	local reserved, reserveCode = spawnService:Reserve(player)
	if not reserved then
		failPlayer(player, reserveCode or "SERVER_FULL")
		return
	end
	local provisioned, provisionCode = inventoryService:ProvisionStarter(player)
	if not provisioned then
		failPlayer(player, provisionCode)
		return
	end
	local spawned, spawnCode = spawnService:SpawnCharacter(player)
	if not spawned or not equipmentService:HasCharacter(player) then
		failPlayer(player, spawnCode or "NO_CHARACTER")
		return
	end

	replicationService:ActivatePlayer(player)
	local snapshotReady, snapshotCode = replicationService:GetSnapshot(player)
	if not snapshotReady then
		failPlayer(player, snapshotCode)
	end
end

local initialized, startupError = xpcall(function()
	bag:Init()
	bag:Start()
end, debug.traceback)

if not initialized then
	closing = true
	for _, player in ipairs(Players:GetPlayers()) do
		player:Kick("The server failed to initialize safely. Please reconnect.")
	end
	error(startupError, 0)
end

table.insert(playerConnections, Players.PlayerAdded:Connect(function(player)
	task.spawn(handlePlayer, player)
end))
table.insert(playerConnections, Players.PlayerRemoving:Connect(function(player)
	teardownPlayer(player)
end))

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(handlePlayer, player)
end

game:BindToClose(function()
	if closing then
		return
	end
	closing = true
	networkService:RejectNewRequests()
	playerDataService:BeginShutdown()
	for _, connection in ipairs(playerConnections) do
		connection:Disconnect()
	end

	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		pending += 1
		task.spawn(function()
			teardownPlayer(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + Config.Persistence.ShutdownDeadlineSeconds
	while pending > 0 and os.clock() < deadline do
		task.wait()
	end
	if pending > 0 then
		warn(string.format("shutdown deadline reached with %d player teardowns pending", pending))
	end
	bag:Stop()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ServiceBag</string>
          <string name="Source"><![CDATA[--!strict

local ServiceBag = {}
ServiceBag.__index = ServiceBag

export type Service = {
	Init: (self: Service, bag: ServiceBag) -> (),
	Start: (self: Service) -> (),
	Stop: (self: Service) -> (),
}

export type ServiceBag = typeof(setmetatable({} :: {
	Context: { [string]: any },
	_services: { [string]: Service },
	_order: { { Name: string, Service: Service } },
	_initializedCount: number,
	_started: boolean,
	_stopping: boolean,
}, ServiceBag))

function ServiceBag.new(context: { [string]: any }): ServiceBag
	return setmetatable({
		Context = context,
		_services = {},
		_order = {},
		_initializedCount = 0,
		_started = false,
		_stopping = false,
	}, ServiceBag)
end

function ServiceBag.Add(self: ServiceBag, name: string, service: any): any
	assert(not self._started and self._initializedCount == 0, "services must be registered before initialization")
	assert(type(name) == "string" and name ~= "", "service name must be non-empty")
	assert(self._services[name] == nil, string.format("duplicate service %s", name))
	assert(type(service) == "table", string.format("service %s must be a table", name))
	assert(type(service.Init) == "function", string.format("service %s has no Init", name))
	assert(type(service.Start) == "function", string.format("service %s has no Start", name))
	assert(type(service.Stop) == "function", string.format("service %s has no Stop", name))

	self._services[name] = service
	table.insert(self._order, {
		Name = name,
		Service = service,
	})
	return service
end

function ServiceBag.Get(self: ServiceBag, name: string): any
	local service = self._services[name]
	assert(service ~= nil, string.format("unknown service %s", name))
	return service
end

function ServiceBag.IsStopping(self: ServiceBag): boolean
	return self._stopping
end

function ServiceBag.Init(self: ServiceBag)
	if self._initializedCount == #self._order then
		return
	end
	assert(self._initializedCount == 0, "partial service initialization cannot be resumed")

	for index, entry in ipairs(self._order) do
		-- Include the current service in rollback even when Init only partially completes.
		self._initializedCount = index
		local ok, err = xpcall(function()
			entry.Service:Init(self)
		end, debug.traceback)
		if not ok then
			self:Stop()
			error(string.format("service %s Init failed: %s", entry.Name, tostring(err)), 0)
		end
	end
end

function ServiceBag.Start(self: ServiceBag)
	if self._started then
		return
	end
	assert(self._initializedCount == #self._order, "all services must initialize before Start")

	for _, entry in ipairs(self._order) do
		local ok, err = xpcall(function()
			entry.Service:Start()
		end, debug.traceback)
		if not ok then
			self:Stop()
			error(string.format("service %s Start failed: %s", entry.Name, tostring(err)), 0)
		end
	end
	self._started = true
end

function ServiceBag.Stop(self: ServiceBag)
	if self._stopping then
		return
	end
	if self._initializedCount == 0 then
		self._started = false
		return
	end

	self._stopping = true
	for index = self._initializedCount, 1, -1 do
		local entry = self._order[index]
		local ok, err = xpcall(function()
			entry.Service:Stop()
		end, debug.traceback)
		if not ok then
			warn(string.format("service %s Stop failed: %s", entry.Name, tostring(err)))
		end
	end
	self._initializedCount = 0
	self._started = false
	self._stopping = false
end

return ServiceBag
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BunkerService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local POWER_DURATION = Config.Gameplay.Power.DurationSeconds

local BunkerService = {}
BunkerService.__index = BunkerService

function BunkerService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_isActive = false,
		_generation = 0,
		_endsAt = 0,
		_world = nil,
		_playerData = nil,
		_inventory = nil,
		_events = nil,
	}, BunkerService)
end

function BunkerService.Init(self, bag)
	if self._initialized then
		return
	end
	self._world = bag:Get("WorldService")
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._events = bag:Get("DomainEvents")
	self._initialized = true
	self._isActive = false
	self._endsAt = 0
	self._generation = 0
end

function BunkerService:_setPoweredLights(enabled: boolean)
	for _, instance in ipairs(self._world:GetPoweredLights()) do
		if instance:IsA("Light") then
			instance.Enabled = enabled
		elseif instance:IsA("BasePart") and instance:GetAttribute("PowerIndicator") == true then
			instance.Material = if enabled then Enum.Material.Neon else Enum.Material.Metal
		end
	end
end

function BunkerService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "BunkerService must initialize before Start")
	self._started = true
	self:_setPoweredLights(false)
end

function BunkerService:IsPowered(): boolean
	return self._isActive and workspace:GetServerTimeNow() < self._endsAt
end

function BunkerService:_expireAtBoundary()
	if not self._isActive or workspace:GetServerTimeNow() < self._endsAt then
		return
	end
	self._generation += 1
	self._isActive = false
	self._endsAt = 0
	self:_setPoweredLights(false)
	self._events:Emit("PowerExpired", self:GetView())
end

function BunkerService:GetView()
	return {
		IsActive = self:IsPowered(),
		Generation = self._generation,
		EndsAt = if self:IsPowered() then self._endsAt else 0,
	}
end

function BunkerService:TryActivatePower(player: Player): (boolean, string, any)
	self:_expireAtBoundary()
	if self:IsPowered() then
		return false, "POWER_ALREADY_ACTIVE", nil
	end
	if not self._playerData:IsReady(player) then
		return false, "PROFILE_NOT_READY", nil
	end

	local success, code, payload = self._playerData:Transact(player, "ActivatePower", function(profile)
		if self._isActive then
			return false, "POWER_ALREADY_ACTIVE"
		end
		local quantity = profile.Inventory.battery_cell or 0
		local batteryCost = Config.Gameplay.Power.BatteryCost
		if quantity < batteryCost then
			return false, "NOT_ENOUGH_ITEMS"
		end
		profile.Inventory.battery_cell = if quantity == batteryCost then nil else quantity - batteryCost
		return true, { BatteryQuantity = quantity - batteryCost }
	end)
	if not success then
		return false, code, nil
	end

	self._generation += 1
	local generation = self._generation
	self._isActive = true
	self._endsAt = workspace:GetServerTimeNow() + POWER_DURATION
	self:_setPoweredLights(true)
	self._events:Emit("PowerActivated", player, self:GetView())
	task.delay(POWER_DURATION, function()
		if not self._started or self._generation ~= generation or not self._isActive then
			return
		end
		self._isActive = false
		self._endsAt = 0
		self:_setPoweredLights(false)
		self._events:Emit("PowerExpired", self:GetView())
	end)

	return true, "OK", {
		EndsAt = self._endsAt,
		BatteryQuantity = payload.BatteryQuantity,
	}
end

function BunkerService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	self._generation += 1
	self._isActive = false
	self._endsAt = 0
	self:_setPoweredLights(false)
end

return BunkerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))
local Definitions = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Definitions"))

local KILL_CREDIT_SECONDS = Config.Gameplay.Zombie.KillCreditWindowSeconds
local MAX_CREDITS = Config.Profile.CreditsMaximum
local MAX_SCRAP = Definitions.Items.scrap.StackCap

local CombatService = {}
CombatService.__index = CombatService

function CombatService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_actorsByModel = {} :: { [Model]: any },
		_playerActors = {} :: { [Player]: any },
		_zombieActors = {} :: { [string]: any },
		_playerData = nil,
		_spawn = nil,
		_events = nil,
	}, CombatService)
end

function CombatService.Init(self, bag)
	if self._initialized then
		return
	end
	self._playerData = bag:Get("PlayerDataService")
	self._spawn = bag:Get("SpawnService")
	self._events = bag:Get("DomainEvents")
	self._initialized = true
end

function CombatService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "CombatService must initialize before Start")
	self._started = true
end

function CombatService:_removeActor(actor)
	if actor == nil then
		return
	end
	if actor.DiedConnection ~= nil then
		actor.DiedConnection:Disconnect()
		actor.DiedConnection = nil
	end
	self._actorsByModel[actor.Model] = nil
	if actor.Kind == "Player" then
		if self._playerActors[actor.Player] == actor then
			self._playerActors[actor.Player] = nil
		end
	else
		if self._zombieActors[actor.Id] == actor then
			self._zombieActors[actor.Id] = nil
		end
	end
end

function CombatService:RegisterPlayer(player: Player, character: Model)
	self:UnregisterActor(player)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	assert(humanoid ~= nil, "player character must have a Humanoid")
	local actor = {
		Id = string.format("player:%d", player.UserId),
		Kind = "Player",
		Player = player,
		Model = character,
		Humanoid = humanoid,
		Dead = humanoid.Health <= 0,
		DiedConnection = nil,
	}
	actor.DiedConnection = humanoid.Died:Connect(function()
		actor.Dead = true
	end)
	self._actorsByModel[character] = actor
	self._playerActors[player] = actor
	return actor
end

function CombatService:RegisterZombie(model: Model, zombieId: string)
	assert(self._zombieActors[zombieId] == nil, string.format("duplicate zombie actor %s", zombieId))
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	assert(humanoid ~= nil, "zombie actor must have a Humanoid")
	local actor = {
		Id = zombieId,
		Kind = "Zombie",
		Model = model,
		Humanoid = humanoid,
		Dead = false,
		LastDamagingPlayer = nil,
		LastDamageAt = 0,
		DiedConnection = nil,
	}
	actor.DiedConnection = humanoid.Died:Connect(function()
		self:_finishZombie(actor)
	end)
	self._actorsByModel[model] = actor
	self._zombieActors[zombieId] = actor
	return actor
end

function CombatService:GetActor(target)
	if typeof(target) == "Instance" then
		if target:IsA("Player") then
			return self._playerActors[target]
		end
		local current = target
		while current ~= nil and current ~= workspace do
			if current:IsA("Model") and self._actorsByModel[current] ~= nil then
				return self._actorsByModel[current]
			end
			current = current.Parent
		end
	elseif type(target) == "string" then
		return self._zombieActors[target]
	end
	return nil
end

function CombatService:_finishZombie(actor): string
	if actor.Dead then
		return actor.TerminalCode or "OK"
	end
	actor.Dead = true
	local creditedPlayer = actor.LastDamagingPlayer
	if creditedPlayer ~= nil and workspace:GetServerTimeNow() - actor.LastDamageAt > KILL_CREDIT_SECONDS then
		creditedPlayer = nil
	end

	local terminalCode = "OK"
	local reward = { Credits = 0, Scrap = 0 }
	if creditedPlayer ~= nil and self._playerData:IsReady(creditedPlayer) then
		local success, code, payload = self._playerData:Transact(creditedPlayer, "ZombieKillReward", function(profile)
			local oldCredits = profile.Currencies.credits
			local oldScrap = profile.Inventory.scrap or 0
			local newCredits = math.min(MAX_CREDITS, oldCredits + Config.Gameplay.Zombie.KillCredits)
			local newScrap = math.min(MAX_SCRAP, oldScrap + Config.Gameplay.Zombie.KillScrap)
			profile.Currencies.credits = newCredits
			profile.Inventory.scrap = if newScrap == 0 then nil else newScrap
			profile.Stats.ZombiesDefeated = math.min(Config.Profile.RevisionMaximum, profile.Stats.ZombiesDefeated + 1)
			return true, {
				Credits = newCredits - oldCredits,
				Scrap = newScrap - oldScrap,
				Capped = newCredits - oldCredits < Config.Gameplay.Zombie.KillCredits or newScrap - oldScrap < Config.Gameplay.Zombie.KillScrap,
			}
		end)
		if success then
			reward.Credits = payload.Credits
			reward.Scrap = payload.Scrap
			if payload.Capped then
				terminalCode = "KILL_REWARD_CAPPED"
			end
		else
			warn(string.format("zombie reward failed for %d: %s", creditedPlayer.UserId, tostring(code)))
			creditedPlayer = nil
		end
	end
	actor.TerminalCode = terminalCode
	self._events:Emit("ZombieKilled", actor.Id, actor.Model, creditedPlayer, reward, terminalCode)
	return terminalCode
end

function CombatService:ApplyDamage(attacker, target, amount: number, damageKind: string): (boolean, string, any)
	if not self._started or type(amount) ~= "number" or amount <= 0 or amount ~= amount or amount == math.huge then
		return false, "INVALID_PAYLOAD", nil
	end
	local targetActor = self:GetActor(target)
	if targetActor == nil then
		return false, "UNKNOWN_TARGET", nil
	end
	if targetActor.Dead or targetActor.Humanoid.Health <= 0 then
		return false, "TARGET_INACTIVE", nil
	end

	local attackerActor = self:GetActor(attacker)
	local attackerPlayer = if typeof(attacker) == "Instance" and attacker:IsA("Player") then attacker else nil
	if attackerPlayer ~= nil then
		attackerActor = self._playerActors[attackerPlayer]
	end
	if attackerActor == nil then
		return false, "UNKNOWN_TARGET", nil
	end
	if attackerActor.Kind == "Player" and targetActor.Kind == "Player" then
		return false, "UNKNOWN_TARGET", nil
	end
	if attackerActor.Kind == "Zombie" and targetActor.Kind == "Player" and self._spawn:IsProtected(targetActor.Player) then
		return false, "TARGET_INACTIVE", nil
	end

	if attackerActor.Kind == "Player" and targetActor.Kind == "Zombie" then
		targetActor.LastDamagingPlayer = attackerActor.Player
		targetActor.LastDamageAt = workspace:GetServerTimeNow()
	end
	local newHealth = math.max(0, targetActor.Humanoid.Health - amount)
	targetActor.Humanoid.Health = newHealth
	self._events:Emit("ToolHit", attackerActor, targetActor, damageKind, amount, newHealth)
	local terminalCode = "OK"
	if targetActor.Kind == "Zombie" and newHealth <= 0 then
		terminalCode = self:_finishZombie(targetActor)
	end
	return true, terminalCode, {
		TargetId = targetActor.Id,
		TargetHealth = newHealth,
	}
end

function CombatService:UnregisterActor(target)
	local actor = self:GetActor(target)
	self:_removeActor(actor)
end

function CombatService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	local actors = {}
	for _, actor in pairs(self._actorsByModel) do
		table.insert(actors, actor)
	end
	for _, actor in ipairs(actors) do
		self:_removeActor(actor)
	end
	table.clear(self._actorsByModel)
	table.clear(self._playerActors)
	table.clear(self._zombieActors)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local MAX_CREDITS = Config.Profile.CreditsMaximum

local EconomyService = {}
EconomyService.__index = EconomyService

function EconomyService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_playerData = nil,
		_inventory = nil,
		_bunker = nil,
		_events = nil,
		_definitions = nil,
	}, EconomyService)
end

function EconomyService.Init(self, bag)
	if self._initialized then
		return
	end
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._bunker = bag:Get("BunkerService")
	self._events = bag:Get("DomainEvents")
	self._definitions = bag.Context.Definitions
	assert(type(self._definitions.ShopOffers) == "table", "Definitions.ShopOffers is required")
	assert(type(self._definitions.Upgrades) == "table", "Definitions.Upgrades is required")
	self._initialized = true
end

function EconomyService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "EconomyService must initialize before Start")
	self._started = true
end

function EconomyService:GetOffersView()
	local offers = {}
	for offerId, offer in pairs(self._definitions.ShopOffers) do
		table.insert(offers, {
			OfferId = offerId,
			BundleCount = offer.BundleCount,
			CreditCost = offer.CreditCost,
		})
	end
	table.sort(offers, function(a, b)
		return a.OfferId < b.OfferId
	end)
	return offers
end

function EconomyService:BuyOffer(player: Player, offerId: string, count: number): (boolean, string, any)
	local offer = self._definitions.ShopOffers[offerId]
	if offer == nil or type(count) ~= "number" or count % 1 ~= 0 or count < 1 or count > 5 then
		return false, "INVALID_PAYLOAD", nil
	end
	local grantQuantity = offer.BundleCount * count
	local totalCost = offer.CreditCost * count
	local success, code, payload = self._playerData:Transact(player, "BuyOffer", function(profile)
		if profile.Currencies.credits < totalCost then
			return false, "NOT_ENOUGH_CREDITS"
		end
		local canAdd, reason = self._inventory:CanAddToProfile(player, profile, offer.ItemId, grantQuantity, nil)
		if not canAdd then
			return false, reason
		end
		profile.Currencies.credits -= totalCost
		profile.Inventory[offer.ItemId] = (profile.Inventory[offer.ItemId] or 0) + grantQuantity
		return true, {
			OfferId = offerId,
			Count = count,
			Credits = profile.Currencies.credits,
			GrantedItemId = offer.ItemId,
			GrantedQuantity = grantQuantity,
		}
	end)
	if success then
		self._events:Emit("PurchaseCompleted", player, "Shop", offerId, count)
		self._events:Emit("ItemAdded", player, offer.ItemId, grantQuantity)
	end
	return success, code, payload
end

function EconomyService:ExchangeScrap(player: Player, count: number): (boolean, string, any)
	if type(count) ~= "number" or count % 1 ~= 0 or count < 1 or count > 20 then
		return false, "INVALID_PAYLOAD", nil
	end
	local creditGrant = count * Config.Gameplay.Economy.ScrapCreditsEach
	local success, code, payload = self._playerData:Transact(player, "ExchangeScrap", function(profile)
		local scrap = profile.Inventory.scrap or 0
		if scrap < count then
			return false, "NOT_ENOUGH_ITEMS"
		end
		if profile.Currencies.credits + creditGrant > MAX_CREDITS then
			return false, "INVENTORY_FULL"
		end
		profile.Inventory.scrap = if scrap == count then nil else scrap - count
		profile.Currencies.credits += creditGrant
		return true, {
			Count = count,
			Credits = profile.Currencies.credits,
			ScrapQuantity = scrap - count,
		}
	end)
	if success then
		self._events:Emit("PurchaseCompleted", player, "ScrapExchange", count)
	end
	return success, code, payload
end

function EconomyService:BuyUpgrade(player: Player, upgradeId: string): (boolean, string, any)
	local upgrade = self._definitions.Upgrades[upgradeId]
	if upgrade == nil then
		return false, "INVALID_PAYLOAD", nil
	end
	if not self._bunker:IsPowered() then
		return false, "REQUIRES_POWER", nil
	end
	local success, code, payload = self._playerData:Transact(player, "BuyUpgrade", function(profile)
		if profile.Upgrades[upgradeId] == 1 then
			return false, "ALREADY_OWNED"
		end
		if profile.Currencies.credits < upgrade.CreditCost then
			return false, "NOT_ENOUGH_CREDITS"
		end
		profile.Currencies.credits -= upgrade.CreditCost
		profile.Upgrades[upgradeId] = 1
		return true, {
			UpgradeId = upgradeId,
			Tier = 1,
			Credits = profile.Currencies.credits,
		}
	end)
	if success then
		self._events:Emit("UpgradePurchased", player, upgradeId)
		self._events:Emit("PurchaseCompleted", player, "Upgrade", upgradeId)
	end
	return success, code, payload
end

function EconomyService:TransferStorage(player: Player, direction: string, itemId: string, count: number): (boolean, string, any)
	return self._inventory:TransferStorage(player, direction, itemId, count)
end

function EconomyService.Stop(self)
	self._started = false
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">EquipmentService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local AXE_RANGE = Config.Gameplay.Tree.HitRange
local AXE_MELEE_RANGE = Config.Gameplay.AxeMelee.Range
local AXE_TREE_COOLDOWN = Config.Gameplay.Tree.HitCooldownSeconds
local AXE_MELEE_COOLDOWN = Config.Gameplay.AxeMelee.CadenceSeconds
local AXE_DAMAGE = Config.Gameplay.AxeMelee.Damage
local RIFLE_RANGE = Config.Gameplay.Rifle.Range
local RIFLE_COOLDOWN = Config.Gameplay.Rifle.CadenceSeconds
local RATION_COOLDOWN = Config.Gameplay.FoodRation.CooldownSeconds
local RATION_HEAL = Config.Gameplay.FoodRation.Heal

local SLOT_ITEMS = {
	[1] = "axe_basic",
	[2] = "rifle_basic",
}

local EquipmentService = {}
EquipmentService.__index = EquipmentService

local function finiteVector(direction: Vector3): boolean
	return direction.X == direction.X
		and direction.Y == direction.Y
		and direction.Z == direction.Z
		and math.abs(direction.X) < math.huge
		and math.abs(direction.Y) < math.huge
		and math.abs(direction.Z) < math.huge
		and direction.Magnitude >= 0.99
		and direction.Magnitude <= 1.01
end

local function ancestorWithAttribute(instance: Instance?, attribute: string): Instance?
	local current = instance
	while current ~= nil and current ~= workspace do
		if current:GetAttribute(attribute) ~= nil then
			return current
		end
		current = current.Parent
	end
	return nil
end

function EquipmentService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_playerData = nil,
		_inventory = nil,
		_resource = nil,
		_combat = nil,
		_events = nil,
		_players = {} :: { [Player]: any },
		_connections = {},
	}, EquipmentService)
end

function EquipmentService.Init(self, bag)
	if self._initialized then
		return
	end
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._resource = bag:Get("ResourceService")
	self._combat = bag:Get("CombatService")
	self._events = bag:Get("DomainEvents")
	self._initialized = true
end

function EquipmentService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "EquipmentService must initialize before Start")
	self._started = true
	table.insert(self._connections, self._events:On("CharacterSpawned", function(player, character)
		self:ProvisionCharacter(player, character)
	end))
	table.insert(self._connections, self._events:On("CharacterDied", function(player)
		self:ClearCharacter(player)
	end))
end

function EquipmentService:_createTool(player: Player, itemId: string): Tool
	local tool = Instance.new("Tool")
	tool.Name = if itemId == "axe_basic" then "Axe" else "Rifle"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = if itemId == "axe_basic" then "Field Axe" else "Service Rifle"
	tool:SetAttribute("ItemId", itemId)
	tool:SetAttribute("OwnerUserId", player.UserId)
	tool:SetAttribute("WeaponKind", if itemId == "axe_basic" then "Axe" else "Rifle")

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = if itemId == "axe_basic" then Vector3.new(0.36, 3.4, 0.36) else Vector3.new(0.52, 0.72, 2.5)
	handle.Color = if itemId == "axe_basic" then Color3.fromRGB(92, 67, 48) else Color3.fromRGB(50, 56, 53)
	handle.Material = if itemId == "axe_basic" then Enum.Material.Wood else Enum.Material.Metal
	if itemId == "axe_basic" then
		handle.Shape = Enum.PartType.Cylinder
	end
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool

	local function addVisualPart(
		name: string,
		size: Vector3,
		offset: CFrame,
		color: Color3,
		material: Enum.Material
	): Part
		local visual = Instance.new("Part")
		visual.Name = name
		visual.Size = size
		visual.CFrame = handle.CFrame * offset
		visual.Color = color
		visual.Material = material
		visual.CanCollide = false
		visual.CanTouch = false
		visual.CanQuery = false
		visual.Massless = true
		visual.Parent = tool

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = visual
		weld.Parent = visual
		return visual
	end

	local function addVisualWedge(
		name: string,
		size: Vector3,
		offset: CFrame,
		color: Color3,
		material: Enum.Material
	): WedgePart
		local visual = Instance.new("WedgePart")
		visual.Name = name
		visual.Size = size
		visual.CFrame = handle.CFrame * offset
		visual.Color = color
		visual.Material = material
		visual.CanCollide = false
		visual.CanTouch = false
		visual.CanQuery = false
		visual.Massless = true
		visual.Parent = tool

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = visual
		weld.Parent = visual
		return visual
	end

	if itemId == "axe_basic" then
		-- Layered silhouette: a field-repaired axe with a dense, worn head rather
		-- than the former flat primitive bar. All pieces remain welded and cosmetic.
		addVisualPart("AxeHeadCore", Vector3.new(1.62, 0.52, 0.44), CFrame.new(0, 1.45, 0), Color3.fromRGB(72, 78, 74), Enum.Material.CorrodedMetal)
		addVisualWedge("AxeBladeFace", Vector3.new(1.14, 1.02, 0.18), CFrame.new(0.72, 1.22, 0) * CFrame.Angles(0, 0, math.rad(-90)), Color3.fromRGB(142, 145, 134), Enum.Material.Metal)
		addVisualWedge("AxeBladeEdge", Vector3.new(0.90, 0.38, 0.22), CFrame.new(1.02, 0.91, 0) * CFrame.Angles(0, 0, math.rad(-90)), Color3.fromRGB(185, 187, 172), Enum.Material.Metal)
		addVisualPart("AxePoll", Vector3.new(0.58, 0.62, 0.52), CFrame.new(-0.78, 1.44, 0), Color3.fromRGB(61, 66, 62), Enum.Material.CorrodedMetal)
		addVisualPart("HeadBinding", Vector3.new(0.62, 0.28, 0.52), CFrame.new(0, 1.08, 0), Color3.fromRGB(48, 39, 29), Enum.Material.Leather)
		addVisualPart("GripWrapLower", Vector3.new(0.48, 0.92, 0.48), CFrame.new(0, -1.02, 0), Color3.fromRGB(47, 37, 29), Enum.Material.Leather)
		addVisualPart("GripWrapUpper", Vector3.new(0.45, 0.52, 0.45), CFrame.new(0, -0.32, 0), Color3.fromRGB(57, 44, 32), Enum.Material.Leather)
		addVisualPart("RepairBand", Vector3.new(0.52, 0.16, 0.52), CFrame.new(0, -1.45, 0), Color3.fromRGB(112, 92, 55), Enum.Material.Metal)
	else
		addVisualPart("Receiver", Vector3.new(0.74, 0.86, 1.18), CFrame.new(0, 0, 0.12), Color3.fromRGB(67, 75, 69), Enum.Material.Metal)
		addVisualPart("Stock", Vector3.new(0.82, 0.92, 1.4), CFrame.new(0, -0.08, 1.65), Color3.fromRGB(73, 61, 45), Enum.Material.WoodPlanks)
		addVisualPart("Barrel", Vector3.new(0.24, 0.24, 2.55), CFrame.new(0, 0.09, -2.36), Color3.fromRGB(42, 48, 46), Enum.Material.Metal)
		addVisualPart("Muzzle", Vector3.new(0.38, 0.38, 0.42), CFrame.new(0, 0.09, -3.73), Color3.fromRGB(29, 34, 33), Enum.Material.Metal)
		addVisualPart("FrontSight", Vector3.new(0.16, 0.36, 0.22), CFrame.new(0, 0.5, -1.65), Color3.fromRGB(122, 132, 105), Enum.Material.Metal)
		addVisualPart("Grip", Vector3.new(0.38, 1.08, 0.58), CFrame.new(0, -0.78, 0.55) * CFrame.Angles(math.rad(-18), 0, 0), Color3.fromRGB(45, 48, 42), Enum.Material.Metal)
	end
	return tool
end

function EquipmentService:ProvisionCharacter(player: Player, character: Model)
	self:ClearCharacter(player)
	local profile = self._playerData:GetView(player)
	if profile == nil then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack == nil then
		warn(string.format("Backpack missing for %d", player.UserId))
		return
	end
	local entry = {
		Character = character,
		Tools = {},
		EquippedSlot = 0,
		LastPrimary = { axe_basic = 0, rifle_basic = 0 },
		LastRation = 0,
	}
	for slot, itemId in pairs(SLOT_ITEMS) do
		if (profile.Inventory[itemId] or 0) > 0 then
			local tool = self:_createTool(player, itemId)
			tool:SetAttribute("Slot", slot)
			tool.Parent = backpack
			entry.Tools[slot] = tool
		end
	end
	self._players[player] = entry
	self._combat:RegisterPlayer(player, character)
	self._events:Emit("EquipmentChanged", player, 0)
end

function EquipmentService:IsEquipped(player: Player, itemId: string): boolean
	local entry = self._players[player]
	if entry == nil then
		return false
	end
	local slot = entry.EquippedSlot
	local tool = entry.Tools[slot]
	return SLOT_ITEMS[slot] == itemId and tool ~= nil and tool.Parent == entry.Character
end

function EquipmentService:GetEquippedSlot(player: Player): number
	local entry = self._players[player]
	return if entry ~= nil then entry.EquippedSlot else 0
end

function EquipmentService:HasCharacter(player: Player): boolean
	local entry = self._players[player]
	return entry ~= nil and entry.Character == player.Character
end

function EquipmentService:GetHotbar(player: Player)
	local profile = self._playerData:GetView(player)
	local equipped = self:GetEquippedSlot(player)
	return {
		{
			Slot = 1,
			ItemId = "axe_basic",
			Owned = profile ~= nil and (profile.Inventory.axe_basic or 0) > 0,
			Equipped = equipped == 1,
		},
		{
			Slot = 2,
			ItemId = "rifle_basic",
			Owned = profile ~= nil and (profile.Inventory.rifle_basic or 0) > 0,
			Equipped = equipped == 2,
		},
	}
end

function EquipmentService:EquipSlot(player: Player, slot: number): (boolean, string, any)
	if slot ~= 1 and slot ~= 2 then
		return false, "INVALID_SLOT", nil
	end
	local entry = self._players[player]
	if entry == nil or entry.Character ~= player.Character then
		return false, "NO_CHARACTER", nil
	end
	local humanoid = entry.Character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return false, "PLAYER_DEAD", nil
	end
	local tool = entry.Tools[slot]
	if tool == nil or tool:GetAttribute("OwnerUserId") ~= player.UserId or tool:GetAttribute("ItemId") ~= SLOT_ITEMS[slot] then
		return false, "NOT_EQUIPPED", nil
	end
	humanoid:UnequipTools()
	humanoid:EquipTool(tool)
	if tool.Parent ~= entry.Character then
		return false, "NOT_EQUIPPED", nil
	end
	entry.EquippedSlot = slot
	self._events:Emit("EquipmentChanged", player, slot)
	return true, "OK", { Kind = "Equip", EquippedSlot = slot }
end

function EquipmentService:_raycast(entry, direction: Vector3, distance: number): RaycastResult?
	local head = entry.Character:FindFirstChild("Head")
	local root = entry.Character:FindFirstChild("HumanoidRootPart")
	local originPart = if head ~= nil and head:IsA("BasePart") then head else root
	if originPart == nil or not originPart:IsA("BasePart") then
		return nil
	end
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { entry.Character }
	parameters.IgnoreWater = true
	return workspace:Raycast(originPart.Position, direction.Unit * distance, parameters)
end

function EquipmentService:HandlePrimary(player: Player, aimDirection: Vector3): (boolean, string, any)
	if typeof(aimDirection) ~= "Vector3" or not finiteVector(aimDirection) then
		return false, "INVALID_AIM", nil
	end
	local entry = self._players[player]
	if entry == nil or entry.Character ~= player.Character then
		return false, "NO_CHARACTER", nil
	end
	local humanoid = entry.Character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return false, "PLAYER_DEAD", nil
	end
	local slot = entry.EquippedSlot
	local itemId = SLOT_ITEMS[slot]
	local tool = entry.Tools[slot]
	if itemId == nil or tool == nil or tool.Parent ~= entry.Character or tool:GetAttribute("OwnerUserId") ~= player.UserId then
		return false, "NOT_EQUIPPED", nil
	end

	local profile = self._playerData:GetView(player)
	if profile == nil then
		return false, "PROFILE_NOT_READY", nil
	end
	local now = workspace:GetServerTimeNow()
	local ammoRemaining = profile.Inventory.ammo_rifle or 0
	if itemId == "rifle_basic" then
		if now - entry.LastPrimary.rifle_basic < RIFLE_COOLDOWN then
			return false, "COOLDOWN", nil
		end
		if ammoRemaining < 1 then
			return false, "NO_AMMO", nil
		end
		local removed, removeCode, removePayload = self._inventory:Remove(player, "ammo_rifle", 1, "RifleShot")
		if not removed then
			return false, removeCode, nil
		end
		entry.LastPrimary.rifle_basic = now
		ammoRemaining = removePayload.Quantity
		local result = self:_raycast(entry, aimDirection, RIFLE_RANGE)
		if result ~= nil then
			local actor = self._combat:GetActor(result.Instance)
			if actor ~= nil and actor.Kind == "Zombie" then
				local damage = Config.GetRifleDamage(profile.Upgrades.weapon)
				local hit, hitCode, hitPayload = self._combat:ApplyDamage(player, actor.Model, damage, "Rifle")
				if hit then
					return true, hitCode, {
						Kind = "Primary",
						HitKind = "Zombie",
						TargetId = hitPayload.TargetId,
						TargetHealth = hitPayload.TargetHealth,
						AmmoRemaining = ammoRemaining,
					}
				end
			end
		end
		return true, "OK", {
			Kind = "Primary",
			HitKind = "None",
			TargetId = nil,
			TargetHealth = nil,
			AmmoRemaining = ammoRemaining,
		}
	end

	local result = self:_raycast(entry, aimDirection, AXE_RANGE)
	local resourceModel = if result ~= nil then ancestorWithAttribute(result.Instance, "ResourceNodeId") else nil
	local cooldown = if resourceModel ~= nil then AXE_TREE_COOLDOWN else AXE_MELEE_COOLDOWN
	if now - entry.LastPrimary.axe_basic < cooldown then
		return false, "COOLDOWN", nil
	end
	entry.LastPrimary.axe_basic = now
	if resourceModel ~= nil then
		local nodeId = resourceModel:GetAttribute("ResourceNodeId")
		local hit, hitCode, hitPayload = self._resource:TryToolHit(player, nodeId)
		if not hit then
			return false, hitCode, nil
		end
		return true, "OK", {
			Kind = "Primary",
			HitKind = "Tree",
			TargetId = hitPayload.TargetId,
			TargetHealth = hitPayload.TargetHealth,
			AmmoRemaining = ammoRemaining,
		}
	end
	if result ~= nil and result.Distance <= AXE_MELEE_RANGE then
		local actor = self._combat:GetActor(result.Instance)
		if actor ~= nil and actor.Kind == "Zombie" then
			local hit, hitCode, hitPayload = self._combat:ApplyDamage(player, actor.Model, AXE_DAMAGE, "Axe")
			if hit then
				return true, hitCode, {
					Kind = "Primary",
					HitKind = "Zombie",
					TargetId = hitPayload.TargetId,
					TargetHealth = hitPayload.TargetHealth,
					AmmoRemaining = ammoRemaining,
				}
			end
		end
	end
	return true, "OK", {
		Kind = "Primary",
		HitKind = "None",
		TargetId = nil,
		TargetHealth = nil,
		AmmoRemaining = ammoRemaining,
	}
end

function EquipmentService:UseRation(player: Player): (boolean, string, any)
	local entry = self._players[player]
	if entry == nil or entry.Character ~= player.Character then
		return false, "NO_CHARACTER", nil
	end
	local humanoid = entry.Character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return false, "PLAYER_DEAD", nil
	end
	local now = workspace:GetServerTimeNow()
	if now - entry.LastRation < RATION_COOLDOWN then
		return false, "COOLDOWN", nil
	end
	local success, code, payload = self._playerData:Transact(player, "UseFoodRation", function(profile)
		local quantity = profile.Inventory.food_ration or 0
		if quantity < 1 then
			return false, "NOT_ENOUGH_ITEMS"
		end
		profile.Inventory.food_ration = if quantity == 1 then nil else quantity - 1
		return true, { Quantity = quantity - 1 }
	end)
	if not success then
		return false, code, nil
	end
	entry.LastRation = now
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + RATION_HEAL)
	self._events:Emit("ToolHit", player, self._combat:GetActor(player), "FoodRation", -RATION_HEAL, humanoid.Health)
	return true, "OK", {
		Kind = "UseItem",
		ItemId = "food_ration",
		Quantity = payload.Quantity,
		Health = humanoid.Health,
		MaxHealth = humanoid.MaxHealth,
	}
end

function EquipmentService:ClearCharacter(player: Player)
	local entry = self._players[player]
	if entry ~= nil then
		for _, tool in pairs(entry.Tools) do
			if tool.Parent ~= nil then
				tool:Destroy()
			end
		end
		self._players[player] = nil
	end
	self._combat:UnregisterActor(player)
end

function EquipmentService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	local players = {}
	for player in pairs(self._players) do
		table.insert(players, player)
	end
	for _, player in ipairs(players) do
		self:ClearCharacter(player)
	end
end

return EquipmentService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">FarmingService</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local GROWTH_SECONDS = Config.Gameplay.Wheat.GrowthSeconds
local PROCESS_SECONDS = Config.Gameplay.Processor.DurationSeconds

local FarmingService = {}
FarmingService.__index = FarmingService

function FarmingService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_world = nil,
		_playerData = nil,
		_inventory = nil,
		_bunker = nil,
		_events = nil,
		_plots = {} :: { [string]: any },
		_jobs = {} :: { [Player]: any },
		_cropsFolder = nil,
	}, FarmingService)
end

function FarmingService.Init(self, bag)
	if self._initialized then
		return
	end
	self._world = bag:Get("WorldService")
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._bunker = bag:Get("BunkerService")
	self._events = bag:Get("DomainEvents")
	for _, worldPlot in ipairs(self._world:GetPlots()) do
		self._plots[worldPlot.Id] = {
			World = worldPlot,
			State = "Empty",
			Owner = nil,
			CropId = nil,
			ReadyAt = 0,
			Generation = 0,
			Reservation = nil,
			Visual = nil,
		}
	end
	assert(#self._world:GetPlots() == 12, "exactly 12 farm plots are required")
	self._initialized = true
end

function FarmingService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "FarmingService must initialize before Start")
	self._started = true
	local runtime = self._world:GetRuntime()
	local cropsFolder = Instance.new("Folder")
	cropsFolder.Name = "Crops"
	cropsFolder.Parent = runtime
	self._cropsFolder = cropsFolder
end

function FarmingService:GetReservedCapacity(player: Player, itemId: string, exemption): number
	local reserved = 0
	for _, plot in pairs(self._plots) do
		local reservation = plot.Reservation
		if plot.Owner == player and reservation ~= nil and reservation ~= exemption then
			reserved += reservation.Capacity[itemId] or 0
		end
	end
	local job = self._jobs[player]
	if job ~= nil and job.Reservation ~= exemption then
		reserved += job.Reservation.Capacity[itemId] or 0
	end
	return reserved
end

function FarmingService:_destroyVisual(plot)
	if plot.Visual ~= nil then
		plot.Visual:Destroy()
		plot.Visual = nil
	end
end

function FarmingService:_updateVisual(plot)
	self:_destroyVisual(plot)
	if plot.State == "Empty" or self._cropsFolder == nil then
		return
	end
	local crop = Instance.new("Part")
	crop.Name = plot.World.Id .. "_wheat"
	crop.Anchored = true
	crop.CanCollide = false
	crop.CanTouch = false
	crop.CanQuery = false
	crop.Material = Enum.Material.Grass
	crop.Color = if plot.State == "Mature" then Color3.fromRGB(191, 157, 70) else Color3.fromRGB(95, 122, 63)
	crop.Size = if plot.State == "Mature" then Vector3.new(2.5, 3, 2.5) else Vector3.new(1.5, 1, 1.5)
	crop.CFrame = plot.World.Anchor.CFrame + Vector3.new(0, crop.Size.Y / 2, 0)
	crop.Parent = self._cropsFolder
	plot.Visual = crop
end

function FarmingService:GetPlotView(plotId: string, player: Player?)
	local plot = self._plots[plotId]
	if plot == nil then
		return nil
	end
	return {
		PlotId = plotId,
		State = plot.State,
		IsOwned = plot.Owner ~= nil,
		IsOwnedByYou = player ~= nil and plot.Owner == player,
		CropId = plot.CropId,
		ReadyAt = plot.ReadyAt,
	}
end

function FarmingService:GetProcessorJobView(player: Player)
	local job = self._jobs[player]
	if job == nil then
		return nil
	end
	return {
		State = "Processing",
		RecipeId = "food_ration_wheat",
		CompletesAt = job.CompletesAt,
	}
end

function FarmingService:GetView(player: Player)
	local plots = {}
	local ids = {}
	for plotId in pairs(self._plots) do
		table.insert(ids, plotId)
	end
	table.sort(ids)
	for _, plotId in ipairs(ids) do
		table.insert(plots, self:GetPlotView(plotId, player))
	end
	return {
		Plots = plots,
		ProcessorJob = self:GetProcessorJobView(player),
	}
end

function FarmingService:Plant(player: Player, plotId: string, cropId: string): (boolean, string, any)
	local plot = self._plots[plotId]
	if plot == nil then
		return false, "WRONG_INTERACTION", nil
	end
	if cropId ~= "wheat" then
		return false, "INVALID_PAYLOAD", nil
	end
	if plot.State ~= "Empty" then
		return false, "PLOT_OCCUPIED", nil
	end

	local reservation = {
		Id = HttpService:GenerateGUID(false),
		Capacity = { seed_wheat = Config.Gameplay.Wheat.SeedCost },
		Refund = { seed_wheat = Config.Gameplay.Wheat.SeedCost },
	}
	local previousGeneration = plot.Generation
	local success, code = self._playerData:Transact(player, "PlantWheat", function(profile)
		if plot.State ~= "Empty" or plot.Generation ~= previousGeneration then
			return false, "PLOT_OCCUPIED"
		end
		if (profile.Inventory.seed_wheat or 0) < Config.Gameplay.Wheat.SeedCost then
			return false, "NOT_ENOUGH_ITEMS"
		end
		profile.Inventory.seed_wheat -= Config.Gameplay.Wheat.SeedCost
		if profile.Inventory.seed_wheat == 0 then
			profile.Inventory.seed_wheat = nil
		end
		plot.State = "Growing"
		plot.Owner = player
		plot.CropId = "wheat"
		plot.ReadyAt = workspace:GetServerTimeNow() + GROWTH_SECONDS
		plot.Generation += 1
		plot.Reservation = reservation
		return true, nil
	end)
	if not success then
		if plot.Generation == previousGeneration + 1 and plot.Owner == player then
			plot.State = "Empty"
			plot.Owner = nil
			plot.CropId = nil
			plot.ReadyAt = 0
			plot.Generation = previousGeneration
			plot.Reservation = nil
		end
		return false, code, nil
	end

	self:_updateVisual(plot)
	local generation = plot.Generation
	task.delay(GROWTH_SECONDS, function()
		if not self._started or plot.Generation ~= generation or plot.State ~= "Growing" then
			return
		end
		plot.State = "Mature"
		self:_updateVisual(plot)
		self._events:Emit("FarmChanged", plotId, self:GetPlotView(plotId))
	end)
	self._events:Emit("PlotPlanted", player, plotId)
	self._events:Emit("FarmChanged", plotId, self:GetPlotView(plotId))
	return true, "OK", {
		PlotId = plotId,
		State = "Growing",
		ReadyAt = plot.ReadyAt,
	}
end

function FarmingService:Harvest(player: Player, plotId: string): (boolean, string, any)
	local plot = self._plots[plotId]
	if plot == nil then
		return false, "WRONG_INTERACTION", nil
	end
	if plot.Owner ~= player then
		return false, "NOT_PLOT_OWNER", nil
	end
	if plot.State ~= "Mature" then
		return false, "PLOT_NOT_READY", nil
	end
	local generation = plot.Generation
	local reservation = plot.Reservation
	local readyAt = plot.ReadyAt
	local cropId = plot.CropId
	local deltas = {
		crop_wheat = Config.Gameplay.Wheat.CropReward,
		seed_wheat = Config.Gameplay.Wheat.SeedReward,
	}
	local success, code = self._playerData:Transact(player, "HarvestWheat", function(profile)
		local canAdd, reason = self._inventory:CanApplyDeltas(player, profile, deltas, reservation)
		if not canAdd then
			return false, reason
		end
		if plot.Owner ~= player or plot.State ~= "Mature" or plot.Generation ~= generation then
			return false, "PLOT_NOT_READY"
		end
		plot.State = "Empty"
		plot.Owner = nil
		plot.CropId = nil
		plot.ReadyAt = 0
		plot.Generation += 1
		plot.Reservation = nil
		self._inventory:ApplyDeltas(profile, deltas)
		return true, nil
	end)
	if not success then
		if plot.Generation == generation + 1 and plot.Owner == nil then
			plot.State = "Mature"
			plot.Owner = player
			plot.CropId = cropId
			plot.ReadyAt = readyAt
			plot.Generation = generation
			plot.Reservation = reservation
		end
		return false, code, nil
	end
	self:_destroyVisual(plot)
	self._events:Emit("CropHarvested", player, plotId)
	self._events:Emit("FarmChanged", plotId, self:GetPlotView(plotId))
	return true, "OK", {
		PlotId = plotId,
		State = "Empty",
		CropGranted = Config.Gameplay.Wheat.CropReward,
		SeedGranted = Config.Gameplay.Wheat.SeedReward,
	}
end

function FarmingService:StartProcessor(player: Player, recipeId: string): (boolean, string, any)
	if recipeId ~= "food_ration_wheat" then
		return false, "INVALID_PAYLOAD", nil
	end
	if not self._bunker:IsPowered() then
		return false, "REQUIRES_POWER", nil
	end
	if self._jobs[player] ~= nil then
		return false, "PROCESSOR_BUSY", nil
	end

	local reservation = {
		Id = HttpService:GenerateGUID(false),
		Capacity = {
			crop_wheat = Config.Gameplay.Processor.CropCost,
			food_ration = Config.Gameplay.Processor.RationReward,
		},
		Refund = { crop_wheat = Config.Gameplay.Processor.CropCost },
	}
	local job = {
		Generation = 1,
		CompletesAt = workspace:GetServerTimeNow() + PROCESS_SECONDS,
		Reservation = reservation,
	}
	local success, code = self._playerData:Transact(player, "StartFoodProcessor", function(profile)
		if self._jobs[player] ~= nil then
			return false, "PROCESSOR_BUSY"
		end
		if (profile.Inventory.crop_wheat or 0) < Config.Gameplay.Processor.CropCost then
			return false, "NOT_ENOUGH_ITEMS"
		end
		local canReserve, reason = self._inventory:CanAddToProfile(player, profile, "food_ration", Config.Gameplay.Processor.RationReward, nil)
		if not canReserve then
			return false, reason
		end
		profile.Inventory.crop_wheat -= Config.Gameplay.Processor.CropCost
		if profile.Inventory.crop_wheat == 0 then
			profile.Inventory.crop_wheat = nil
		end
		self._jobs[player] = job
		return true, nil
	end)
	if not success then
		if self._jobs[player] == job then
			self._jobs[player] = nil
		end
		return false, code, nil
	end

	self._events:Emit("FarmChanged", player, self:GetView(player))
	task.delay(PROCESS_SECONDS, function()
		local current = self._jobs[player]
		if not self._started or current ~= job or current.Generation ~= 1 then
			return
		end
		local completed, completionCode = self._playerData:Transact(player, "FinishFoodProcessor", function(profile)
			local canAdd, reason = self._inventory:CanAddToProfile(player, profile, "food_ration", Config.Gameplay.Processor.RationReward, reservation)
			if not canAdd then
				return false, reason
			end
			if self._jobs[player] ~= job then
				return false, "PROCESSOR_BUSY"
			end
			self._jobs[player] = nil
			profile.Inventory.food_ration = (profile.Inventory.food_ration or 0) + Config.Gameplay.Processor.RationReward
			return true, nil
		end)
		if not completed then
			warn(string.format("reserved processor completion failed for %d: %s", player.UserId, tostring(completionCode)))
			if self._jobs[player] == nil then
				self._jobs[player] = job
			end
			self:_cancelJob(player, true)
			return
		end
		self._events:Emit("FoodProcessed", player, "food_ration_wheat")
		self._events:Emit("FarmChanged", player, self:GetView(player))
	end)
	return true, "OK", {
		RecipeId = recipeId,
		CompletesAt = job.CompletesAt,
	}
end

function FarmingService:_cancelJob(player: Player, allowSettlement: boolean): boolean
	local job = self._jobs[player]
	if job == nil then
		return true
	end
	job.Generation += 1
	local success, code = self._playerData:Transact(player, "RefundFoodProcessor", function(profile)
		if self._jobs[player] ~= job then
			return false, "PROCESSOR_BUSY"
		end
		local canAdd, reason = self._inventory:CanAddToProfile(player, profile, "crop_wheat", Config.Gameplay.Processor.CropCost, job.Reservation)
		if not canAdd then
			return false, reason
		end
		self._jobs[player] = nil
		profile.Inventory.crop_wheat = (profile.Inventory.crop_wheat or 0) + Config.Gameplay.Processor.CropCost
		return true, nil
	end, allowSettlement)
	if not success then
		if self._jobs[player] == nil then
			self._jobs[player] = job
		end
		warn(string.format("processor refund failed for %d: %s", player.UserId, tostring(code)))
	end
	return success
end

function FarmingService:_clearPlot(plot, allowSettlement: boolean): boolean
	if plot.Owner == nil then
		return true
	end
	local player = plot.Owner
	local reservation = plot.Reservation
	local generation = plot.Generation
	local state = plot.State
	local cropId = plot.CropId
	local readyAt = plot.ReadyAt
	local success, code = self._playerData:Transact(player, "RefundFarmPlot", function(profile)
		local canAdd, reason = self._inventory:CanAddToProfile(player, profile, "seed_wheat", Config.Gameplay.Wheat.SeedCost, reservation)
		if not canAdd then
			return false, reason
		end
		if plot.Owner ~= player or plot.Generation ~= generation then
			return false, "NOT_PLOT_OWNER"
		end
		plot.Owner = nil
		plot.State = "Empty"
		plot.CropId = nil
		plot.ReadyAt = 0
		plot.Generation += 1
		plot.Reservation = nil
		profile.Inventory.seed_wheat = (profile.Inventory.seed_wheat or 0) + Config.Gameplay.Wheat.SeedCost
		return true, nil
	end, allowSettlement)
	if not success then
		if plot.Generation == generation + 1 and plot.Owner == nil then
			plot.Owner = player
			plot.State = state
			plot.CropId = cropId
			plot.ReadyAt = readyAt
			plot.Generation = generation
			plot.Reservation = reservation
		end
		warn(string.format("plot refund failed for %d: %s", player.UserId, tostring(code)))
		return false
	end
	self:_destroyVisual(plot)
	return true
end

function FarmingService:ReleasePlayer(player: Player)
	self:_cancelJob(player, true)
	for _, plot in pairs(self._plots) do
		if plot.Owner == player then
			self:_clearPlot(plot, true)
		end
	end
	self._events:Emit("FarmChanged", player, self:GetView(player))
end

function FarmingService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	local players = {}
	for player in pairs(self._jobs) do
		table.insert(players, player)
	end
	for _, player in ipairs(players) do
		self:_cancelJob(player, true)
	end
	for _, plot in pairs(self._plots) do
		plot.Generation += 1
		if plot.Owner ~= nil then
			self:_clearPlot(plot, true)
		end
		self:_destroyVisual(plot)
	end
	if self._cropsFolder ~= nil then
		self._cropsFolder:Destroy()
		self._cropsFolder = nil
	end
	table.clear(self._jobs)
end

return FarmingService
]]></string>
