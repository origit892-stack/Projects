		BackgroundColor3 = COLORS.SteelRaised,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "E",
		TextColor3 = COLORS.Text,
		TextSize = 18,
		Font = Enum.Font.GothamBold,
		ZIndex = 22,
	}) :: TextButton
	addCorner(promptButton, 5)
