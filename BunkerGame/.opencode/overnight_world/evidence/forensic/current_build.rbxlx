        CreditsMinimum = 0,
        CreditsMaximum = 999_999,
        UpgradeTierMinimum = 0,
        UpgradeTierMaximum = 1,
        DefaultCredits = 25,
        OnboardingVersion = 1,
    },

    Persistence = {
        LoadDeadlineSeconds = 30,
        LoadMaximumAttempts = 5,
        LoadBackoffSeconds = { 0.5, 1, 2, 4, 8 },
        LockLeaseSeconds = 120,
        LockRenewIntervalSeconds = 45,
        AutosaveIntervalSeconds = 60,
        AutosaveJitterSeconds = 5,
        ShutdownDeadlineSeconds = 25,
        StudioUsesMemoryRepositoryByDefault = true,
    },

    Inventory = {
        BaseStorageCapacity = 80,
        StorageCapacityPerTier = 40,
    },

    Gameplay = {
        Tree = {
            Health = 3,
            WoodReward = 4,
            RespawnSeconds = 60,
            HitRange = 10,
            HitCooldownSeconds = 0.55,
            BaseAxeDamage = 1,
            UpgradedAxeDamage = 2,
        },
        ScrapCache = {
            ScrapReward = 2,
            RespawnSeconds = 45,
            CollectRange = 10,
        },
        Wheat = {
            GrowthSeconds = 45,
            CropReward = 2,
            SeedReward = 1,
            SeedCost = 1,
        },
        Processor = {
            CropCost = 2,
            RationReward = 1,
            DurationSeconds = 8,
            MaximumActiveJobsPerPlayer = 1,
        },
        FoodRation = {
            Heal = 35,
            CooldownSeconds = 3,
        },
        Rifle = {
            BaseDamage = 24,
            UpgradedDamage = 34,
            CadenceSeconds = 0.28,
            Range = 180,
            AmmoPerShot = 1,
            UsesMagazine = false,
            UsesReload = false,
            UsesSpread = false,
        },
        AxeMelee = {
            Damage = 18,
