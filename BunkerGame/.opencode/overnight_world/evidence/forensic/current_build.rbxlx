        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")

local WorldService = {}
WorldService.__index = WorldService

local function sortedKeys(values): { string }
	local result = {}
	for key in pairs(values) do
		table.insert(result, key)
	end
	table.sort(result)
	return result
end

local function onePrompt(instance: Instance): ProximityPrompt
	local result = nil
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			assert(result == nil, string.format("%s has multiple ProximityPrompts", instance:GetFullName()))
			result = descendant
		end
	end
	assert(result ~= nil, string.format("%s has no ProximityPrompt", instance:GetFullName()))
	assert(result.Style == Enum.ProximityPromptStyle.Custom, string.format("%s prompt must use Custom presentation", instance:GetFullName()))
	assert(result.Enabled, string.format("%s prompt must be enabled", instance:GetFullName()))
	return result
end

local function indexExpected(records, idField: string): { [string]: any }
	assert(type(records) == "table", string.format("WorldManifest.%s records are required", idField))
	local result = {}
	for _, record in ipairs(records) do
		assert(type(record) == "table", "WorldManifest records must be tables")
		local id = record[idField]
		assert(type(id) == "string" and id ~= "", string.format("WorldManifest record has invalid %s", idField))
		assert(result[id] == nil, string.format("WorldManifest has duplicate %s %s", idField, id))
		result[id] = record
	end
	return result
end

local function assertExact(actual, expected, kind: string)
	for id in pairs(expected) do
		assert(actual[id] ~= nil, string.format("missing %s %s", kind, id))
	end
	for id in pairs(actual) do
		assert(expected[id] ~= nil, string.format("unexpected %s %s", kind, id))
	end
end

function WorldService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_validated = false,
		_gameWorld = nil,
		_runtime = nil,
		_spawns = {},
		_interactions = {},
		_nodes = {},
		_plots = {},
		_zombieSpawns = {},
		_poweredLights = {},
		_audioCues = {},
		_effectsFolder = nil,
		_events = nil,
		_manifest = nil,
		_definitions = nil,
		_connections = {},
	}, WorldService)
end

function WorldService.Init(self, bag)
	if self._initialized then
		return
	end
	self._events = bag:Get("DomainEvents")
	self._manifest = bag.Context.WorldManifest
	self._definitions = bag.Context.Definitions
	assert(type(self._manifest) == "table", "WorldManifest shared module is required")
	assert(type(self._definitions) == "table", "Definitions shared module is required")
	self:Validate()
	self._initialized = true
end

function WorldService:Validate()
	if self._validated then
		return true
	end

	local gameWorld = Workspace:FindFirstChild("GameWorld")
	local runtime = Workspace:FindFirstChild("Runtime")
	assert(gameWorld ~= nil and gameWorld:IsA("Model"), "Workspace.GameWorld Model is required")
	assert(runtime ~= nil and runtime.ClassName == self._manifest.RuntimeRootClassName, "Workspace.Runtime source Folder is required")
	local manifestValid, manifestErrors = self._manifest.ValidateManifest()
	assert(manifestValid, "WorldManifest is invalid: " .. table.concat(manifestErrors, "; "))
	local worldValid, worldErrors = self._manifest.ValidateWorld(gameWorld)
	assert(worldValid, "Workspace.GameWorld violates WorldManifest: " .. table.concat(worldErrors, "; "))
	for _, descendant in ipairs(gameWorld:GetDescendants()) do
		assert(not descendant:IsA("LuaSourceContainer"), string.format("world script is forbidden: %s", descendant:GetFullName()))
	end

	local expectedSpawns = indexExpected(self._manifest.Spawns, "SpawnId")
	local expectedInteractions = indexExpected(self._manifest.Interactions, "InteractionId")
	local expectedNodes = indexExpected(self._manifest.ResourceNodes, "ResourceNodeId")
	local expectedPlots = indexExpected(self._manifest.Plots, "PlotId")
	local expectedZombieSpawns = indexExpected(self._manifest.ZombieSpawns, "SpawnId")

	local spawns = {}
	local interactions = {}
	local nodes = {}
	local plots = {}
	local zombieSpawns = {}

	for _, descendant in ipairs(gameWorld:GetDescendants()) do
		local spawnId = descendant:GetAttribute("SpawnId")
		if spawnId ~= nil and descendant:IsA("SpawnLocation") then
			assert(type(spawnId) == "string" and spawns[spawnId] == nil, string.format("duplicate/invalid spawn %s", tostring(spawnId)))
			local expected = expectedSpawns[spawnId]
			assert(expected ~= nil, string.format("unexpected spawn %s", spawnId))
			assert(descendant:GetAttribute("SpawnRole") == "bedroom", string.format("spawn %s has invalid SpawnRole", spawnId))
			assert(descendant:GetAttribute("SlotIndex") == expected.SlotIndex, string.format("spawn %s has invalid SlotIndex", spawnId))
			assert(descendant.Anchored and not descendant.CanCollide and descendant.Neutral and descendant.Enabled, string.format("spawn %s properties are invalid", spawnId))
			assert(descendant.Duration == 0 and descendant.Size == Vector3.new(5, 1, 5), string.format("spawn %s size/duration is invalid", spawnId))
			spawns[spawnId] = descendant
		end

		local nodeId = descendant:GetAttribute("ResourceNodeId")
		if nodeId ~= nil then
			assert(descendant:IsA("Model"), string.format("resource %s must be a Model", tostring(nodeId)))
			assert(type(nodeId) == "string" and nodes[nodeId] == nil, string.format("duplicate/invalid resource %s", tostring(nodeId)))
			local expected = expectedNodes[nodeId]
			assert(expected ~= nil, string.format("unexpected resource %s", nodeId))
			local definitionId = descendant:GetAttribute("ResourceDefinitionId")
			assert(definitionId == expected.ResourceDefinitionId, string.format("resource %s has wrong definition", nodeId))
			assert(self._definitions.Resources[definitionId] ~= nil, string.format("resource %s references unknown definition %s", nodeId, tostring(definitionId)))
			nodes[nodeId] = {
				Id = nodeId,
				DefinitionId = definitionId,
				Instance = descendant,
				Prompt = if definitionId == "scrap_cache" then onePrompt(descendant) else nil,
				Anchor = descendant:FindFirstChild("ResourceAnchor", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true),
			}
			assert(nodes[nodeId].Anchor ~= nil, string.format("resource %s has no BasePart", nodeId))
		end

		local plotId = descendant:GetAttribute("PlotId")
		if plotId ~= nil then
			assert(descendant:IsA("Model"), string.format("plot %s must be a Model", tostring(plotId)))
			assert(type(plotId) == "string" and plots[plotId] == nil, string.format("duplicate/invalid plot %s", tostring(plotId)))
			assert(expectedPlots[plotId] ~= nil, string.format("unexpected plot %s", plotId))
			assert(descendant:GetAttribute("InteractionKind") == "farm_plot", string.format("plot %s has invalid InteractionKind", plotId))
			plots[plotId] = {
				Id = plotId,
				Kind = "farm_plot",
				Instance = descendant,
				Prompt = onePrompt(descendant),
				Anchor = descendant:FindFirstChild("CropAnchor", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true),
			}
			assert(plots[plotId].Anchor ~= nil, string.format("plot %s has no crop anchor", plotId))
			interactions[plotId] = plots[plotId]
		end

		local interactionId = descendant:GetAttribute("InteractionId")
		local processorId = descendant:GetAttribute("ProcessorId")
		if interactionId ~= nil or processorId ~= nil then
			assert(descendant:IsA("Model"), string.format("interaction %s must be a Model", tostring(interactionId or processorId)))
			local id = interactionId or processorId
			assert(type(id) == "string" and interactions[id] == nil, string.format("duplicate/invalid interaction %s", tostring(id)))
			local expected = expectedInteractions[id]
			assert(expected ~= nil, string.format("unexpected interaction %s", id))
			local kind = descendant:GetAttribute("InteractionKind")
			assert(kind == expected.InteractionKind, string.format("interaction %s has wrong kind", id))
			interactions[id] = {
				Id = id,
				Kind = kind,
				Instance = descendant,
				Prompt = onePrompt(descendant),
				Anchor = descendant:FindFirstChild("InteractionAnchor", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true),
				UpgradeId = descendant:GetAttribute("UpgradeId") or expected.UpgradeId,
			}
			assert(interactions[id].Anchor ~= nil, string.format("interaction %s has no BasePart", id))
		end

		if descendant:IsA("BasePart") and descendant:GetAttribute("SpawnGroupId") ~= nil then
			local enemySpawnId = descendant:GetAttribute("SpawnId")
			assert(type(enemySpawnId) == "string" and zombieSpawns[enemySpawnId] == nil, string.format("duplicate/invalid zombie spawn %s", tostring(enemySpawnId)))
			local expected = expectedZombieSpawns[enemySpawnId]
			assert(expected ~= nil, string.format("unexpected zombie spawn %s", enemySpawnId))
			assert(descendant:GetAttribute("SpawnGroupId") == expected.SpawnGroupId, string.format("zombie spawn %s has wrong group", enemySpawnId))
			zombieSpawns[enemySpawnId] = descendant
		end
	end

	assertExact(spawns, expectedSpawns, "spawn")
	assertExact(nodes, expectedNodes, "resource")
	assertExact(plots, expectedPlots, "plot")
	assertExact(zombieSpawns, expectedZombieSpawns, "zombie spawn")
	for id in pairs(expectedInteractions) do
		assert(interactions[id] ~= nil, string.format("missing interaction %s", id))
	end
	assert(#runtime:GetDescendants() == 0, "source Workspace.Runtime must be empty")

	local bunker = gameWorld:FindFirstChild("Bunker")
	local poweredLights = bunker and bunker:FindFirstChild("PoweredLights", true)
	assert(poweredLights ~= nil, "GameWorld.Bunker.PoweredLights is required")
	local presentation = gameWorld:FindFirstChild("Presentation")
	local audioAnchors = presentation and presentation:FindFirstChild("AudioAnchors")
	assert(audioAnchors ~= nil and audioAnchors:IsA("Model"), "GameWorld.Presentation.AudioAnchors is required")
	assert(audioAnchors:GetAttribute("PlaybackOwner") == "server_interactions", "AudioAnchors playback owner is invalid")
	local openingCueInstance = audioAnchors:FindFirstChild("BlastDoorOpenCueSound", true)
	local closingCueInstance = audioAnchors:FindFirstChild("BlastDoorCloseCueSound", true)
	assert(openingCueInstance ~= nil and openingCueInstance:IsA("Sound"), "BlastDoorOpenCueSound is required")
	assert(closingCueInstance ~= nil and closingCueInstance:IsA("Sound"), "BlastDoorCloseCueSound is required")
	local openingCue = openingCueInstance :: Sound
	local closingCue = closingCueInstance :: Sound
	assert(openingCue.SoundId ~= "" and closingCue.SoundId ~= "", "facility cues require source-authored SoundIds")
	assert(not openingCue.Looped and not closingCue.Looped, "facility cues must be one-shot sounds")

	self._gameWorld = gameWorld
	self._runtime = runtime
	self._spawns = spawns
	self._interactions = interactions
	self._nodes = nodes
	self._plots = plots
	self._zombieSpawns = zombieSpawns
	local poweredInstances = poweredLights:GetDescendants()
	local seen = {} :: { [Instance]: boolean }
	for _, instance in ipairs(poweredInstances) do
		seen[instance] = true
	end
	-- A powered indicator can live on an interactive console or authored story
	-- prop outside the fixture folder. Keep those visuals on the same canonical
	-- circuit so an unpowered bunker never advertises working equipment.
	for _, instance in ipairs(bunker:GetDescendants()) do
		if instance:IsA("BasePart") and instance:GetAttribute("PowerIndicator") == true and not seen[instance] then
			seen[instance] = true
			table.insert(poweredInstances, instance)
		end
	end
	self._poweredLights = poweredInstances
	self._audioCues = {
		PowerActivated = openingCue,
		PowerExpired = closingCue,
	}
	self._validated = true
	return true
end

function WorldService:_playAudioCue(cueName: string)
	local cue = self._audioCues[cueName]
	if cue ~= nil and cue.Parent ~= nil then
		cue:Stop()
		cue:Play()
	end
end

function WorldService.Start(self)
	if self._started then
		return
	end
	assert(self._validated, "WorldService must validate before Start")
	self._started = true
	local effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "Effects"
	effectsFolder.Parent = self._runtime
	self._effectsFolder = effectsFolder
	table.insert(self._connections, self._events:On("PowerActivated", function()
		self:_playAudioCue("PowerActivated")
	end))
	table.insert(self._connections, self._events:On("PowerExpired", function()
		self:_playAudioCue("PowerExpired")
	end))
	self._events:Emit("WorldReady")
end

function WorldService:GetSpawn(slotIndex: number): SpawnLocation?
	for _, spawn in pairs(self._spawns) do
		if spawn:GetAttribute("SlotIndex") == slotIndex then
			return spawn
		end
	end
	return nil
end

function WorldService:GetInteraction(interactionId: string)
	return self._interactions[interactionId]
end

function WorldService:GetInteractions()
	local result = {}
	for _, id in ipairs(sortedKeys(self._interactions)) do
		table.insert(result, self._interactions[id])
	end
	return result
end

function WorldService:GetNode(nodeId: string)
	return self._nodes[nodeId]
end

function WorldService:GetNodes()
	local result = {}
	for _, id in ipairs(sortedKeys(self._nodes)) do
		table.insert(result, self._nodes[id])
	end
	return result
end

function WorldService:GetPlots()
	local result = {}
	for _, id in ipairs(sortedKeys(self._plots)) do
		table.insert(result, self._plots[id])
	end
	return result
end

function WorldService:GetZombieSpawns()
	local result = {}
	for _, id in ipairs(sortedKeys(self._zombieSpawns)) do
		table.insert(result, self._zombieSpawns[id])
	end
	return result
end

function WorldService:GetRuntime()
	return self._runtime
end

function WorldService:GetPoweredLights()
	return self._poweredLights
end

function WorldService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	self._validated = false
	if self._effectsFolder ~= nil then
		self._effectsFolder:Destroy()
		self._effectsFolder = nil
	end
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	for _, cue in pairs(self._audioCues) do
		if cue.Parent ~= nil then
			cue:Stop()
		end
	end
	table.clear(self._spawns)
	table.clear(self._interactions)
	table.clear(self._nodes)
	table.clear(self._plots)
	table.clear(self._zombieSpawns)
	table.clear(self._poweredLights)
	table.clear(self._audioCues)
end

return WorldService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">ZombieService</string>
            <string name="Source"><![CDATA[--!strict

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local MAX_ACTIVE = Config.Gameplay.Zombie.ActiveCap
local SPAWN_CADENCE = Config.Gameplay.Zombie.SpawnCadenceSeconds
local AI_INTERVAL = Config.Gameplay.Zombie.UpdateIntervalSeconds
local PATH_INTERVAL = Config.Gameplay.Zombie.PathRecomputeMinimumSeconds
local AGGRO_RANGE = Config.Gameplay.Zombie.AggroRange
local LEASH_RANGE = Config.Gameplay.Zombie.LeashRange
local MELEE_RANGE = Config.Gameplay.Zombie.MeleeRange
local MELEE_COOLDOWN = Config.Gameplay.Zombie.MeleeCooldownSeconds
local ZOMBIE_HEALTH = Config.Gameplay.Zombie.Health
local ZOMBIE_DAMAGE = Config.Gameplay.Zombie.MeleeDamage
local ZOMBIE_SPEED = Config.Gameplay.Zombie.WalkSpeed

local ZombieService = {}
ZombieService.__index = ZombieService

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local joint = Instance.new("Motor6D")
	joint.Name = name
	joint.Part0 = part0
	joint.Part1 = part1
	joint.C0 = c0
	joint.C1 = c1
	joint.Parent = part0
	return joint
end

local function bodyPart(name: string, size: Vector3, color: Color3, canCollide: boolean): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.CanCollide = canCollide
	part.CanTouch = true
	part.CanQuery = true
	part.Massless = name ~= "HumanoidRootPart"
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

function ZombieService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_world = nil,
		_playerData = nil,
		_spawn = nil,
		_combat = nil,
		_events = nil,
		_enemies = {} :: { [string]: any },
		_connections = {},
		_wave = {
			State = "Idle",
			Revision = 0,
			Budget = 0,
			Spawned = 0,
			Alive = 0,
			EligiblePlayers = 0,
		},
		_waveGeneration = 0,
		_lastNightRevision = -1,
		_eligible = {} :: { [Player]: boolean },
		_lastSpawnIndex = 0,
		_aiGeneration = 0,
		_enemiesFolder = nil,
	}, ZombieService)
end

function ZombieService.Init(self, bag)
	if self._initialized then
		return
	end
	self._world = bag:Get("WorldService")
	self._playerData = bag:Get("PlayerDataService")
	self._spawn = bag:Get("SpawnService")
	self._combat = bag:Get("CombatService")
	self._events = bag:Get("DomainEvents")
	assert(#self._world:GetZombieSpawns() == 7, "exactly seven zombie spawns are required")
	self._initialized = true
end

function ZombieService:_publish()
	self._events:Emit("WaveChanged", self:GetView())
end

function ZombieService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "ZombieService must initialize before Start")
	self._started = true
	local enemiesFolder = Instance.new("Folder")
	enemiesFolder.Name = "Enemies"
	enemiesFolder.Parent = self._world:GetRuntime()
	self._enemiesFolder = enemiesFolder
	table.insert(self._connections, self._events:On("PhaseChanged", function(view)
		self:OnPhase(view)
	end))
	table.insert(self._connections, self._events:On("CharacterDied", function(player)
		if self._eligible[player] ~= nil then
			self._eligible[player] = false
		end
	end))
	table.insert(self._connections, self._events:On("ZombieKilled", function(zombieId)
		self:_removeEnemy(zombieId)
	end))
	self._aiGeneration += 1
	local generation = self._aiGeneration
	task.spawn(function()
		while self._started and self._aiGeneration == generation do
			local startedAt = os.clock()
			local actors = {}
			for _, actor in pairs(self._enemies) do
				table.insert(actors, actor)
			end
			for _, actor in ipairs(actors) do
				if actor.Active then
					self:_updateActor(actor)
				end
			end
			local elapsed = os.clock() - startedAt
			task.wait(math.max(0, AI_INTERVAL - elapsed))
		end
	end)
end

function ZombieService:ReleasePlayer(player: Player)
	self._eligible[player] = nil
end

function ZombieService:_createZombie(zombieId: string, spawnPosition: Vector3): Model
	local model = Instance.new("Model")
	model.Name = zombieId
	model:SetAttribute("ZombieId", zombieId)
	model:SetAttribute("ActorKind", "Zombie")

	local root = bodyPart("HumanoidRootPart", Vector3.new(2, 2, 1), Color3.new(), false)
	root.Transparency = 1
	root.CFrame = CFrame.new(spawnPosition + Vector3.new(0, 3, 0))
	root.Parent = model
	local torso = bodyPart("Torso", Vector3.new(2, 2, 1), Color3.fromRGB(72, 82, 64), true)
	torso.CFrame = root.CFrame
	torso.Parent = model
	local head = bodyPart("Head", Vector3.new(2, 1, 1), Color3.fromRGB(119, 132, 101), false)
	head.CFrame = root.CFrame * CFrame.new(0, 1.5, 0)
	head.Parent = model
	local leftArm = bodyPart("Left Arm", Vector3.new(1, 2, 1), Color3.fromRGB(104, 116, 89), false)
	leftArm.CFrame = root.CFrame * CFrame.new(-1.5, 0, 0)
	leftArm.Parent = model
	local rightArm = bodyPart("Right Arm", Vector3.new(1, 2, 1), Color3.fromRGB(104, 116, 89), false)
	rightArm.CFrame = root.CFrame * CFrame.new(1.5, 0, 0)
	rightArm.Parent = model
	local leftLeg = bodyPart("Left Leg", Vector3.new(1, 2, 1), Color3.fromRGB(48, 51, 46), false)
	leftLeg.CFrame = root.CFrame * CFrame.new(-0.5, -2, 0)
	leftLeg.Parent = model
	local rightLeg = bodyPart("Right Leg", Vector3.new(1, 2, 1), Color3.fromRGB(48, 51, 46), false)
	rightLeg.CFrame = root.CFrame * CFrame.new(0.5, -2, 0)
	rightLeg.Parent = model

	motor("RootJoint", root, torso, CFrame.new(), CFrame.new())
	motor("Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
	motor("Left Shoulder", torso, leftArm, CFrame.new(-1, 0.5, 0), CFrame.new(0.5, 0.5, 0))
	motor("Right Shoulder", torso, rightArm, CFrame.new(1, 0.5, 0), CFrame.new(-0.5, 0.5, 0))
	motor("Left Hip", torso, leftLeg, CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
	motor("Right Hip", torso, rightLeg, CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))

	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.MaxHealth = ZOMBIE_HEALTH
	humanoid.Health = ZOMBIE_HEALTH
	humanoid.WalkSpeed = ZOMBIE_SPEED
	humanoid.JumpPower = 0
	humanoid.AutoJumpEnabled = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	model.PrimaryPart = root
	model.Parent = self._enemiesFolder
	model:PivotTo(CFrame.new(spawnPosition + Vector3.new(0, 3, 0)))
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			pcall(function()
				descendant:SetNetworkOwner(nil)
			end)
		end
	end
	return model
end

function ZombieService:_spawnOne(day: number)
	if self._wave.Alive >= MAX_ACTIVE then
		return false
	end
	local spawns = self._world:GetZombieSpawns()
	local index = ((day + self._wave.Revision + self._wave.Spawned - 1) % #spawns) + 1
	if index == self._lastSpawnIndex and #spawns > 1 then
		index = (index % #spawns) + 1
	end
	self._lastSpawnIndex = index
	local marker = spawns[index]
	local zombieId = string.format("zombie_%03d_%03d", self._wave.Revision, self._wave.Spawned + 1)
	local model = self:_createZombie(zombieId, marker.Position)
	local combatActor = self._combat:RegisterZombie(model, zombieId)
	self._enemies[zombieId] = {
		Id = zombieId,
		Model = model,
		Humanoid = combatActor.Humanoid,
		Root = model.PrimaryPart,
		SpawnPosition = marker.Position,
		Active = true,
		LastAttack = 0,
		LastPathAt = 0,
		PathPending = false,
		Waypoints = nil,
		WaypointIndex = 1,
		WaveGeneration = self._waveGeneration,
	}
	self._wave.Spawned += 1
	self._wave.Alive += 1
	self:_publish()
	return true
end

function ZombieService:_eligibleTarget(actor)
	local nearestPlayer = nil
	local nearestRoot = nil
	local nearestDistance = AGGRO_RANGE
	for _, player in ipairs(Players:GetPlayers()) do
		if self._playerData:IsReady(player) and not self._spawn:IsProtected(player) then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid ~= nil and humanoid.Health > 0 and root ~= nil and root:IsA("BasePart") then
				local distance = (root.Position - actor.Root.Position).Magnitude
				if distance < nearestDistance then
					nearestPlayer = player
					nearestRoot = root
					nearestDistance = distance
				end
			end
		end
	end
	return nearestPlayer, nearestRoot, nearestDistance
end

function ZombieService:_directLine(actor, targetRoot: BasePart): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { actor.Model }
	parameters.IgnoreWater = true
	local result = workspace:Raycast(actor.Root.Position, targetRoot.Position - actor.Root.Position, parameters)
	return result == nil or result.Instance:IsDescendantOf(targetRoot.Parent)
end

function ZombieService:_requestPath(actor, destination: Vector3)
	local now = workspace:GetServerTimeNow()
	if actor.PathPending or now - actor.LastPathAt < PATH_INTERVAL then
		return
	end
	actor.PathPending = true
	actor.LastPathAt = now
	local waveGeneration = actor.WaveGeneration
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = false,
			WaypointSpacing = 5,
		})
		local ok = pcall(function()
			path:ComputeAsync(actor.Root.Position, destination)
		end)
		if actor.Active and actor.WaveGeneration == waveGeneration then
			if ok and path.Status == Enum.PathStatus.Success then
				actor.Waypoints = path:GetWaypoints()
				actor.WaypointIndex = math.min(2, #actor.Waypoints)
			else
				actor.Waypoints = nil
			end
			actor.PathPending = false
		end
	end)
end

function ZombieService:_updateActor(actor)
	if actor.Model.Parent == nil or actor.Humanoid.Health <= 0 then
		return
	end
	if (actor.Root.Position - actor.SpawnPosition).Magnitude > LEASH_RANGE then
		actor.Humanoid:MoveTo(actor.SpawnPosition)
		return
	end
	local player, targetRoot, distance = self:_eligibleTarget(actor)
	if player == nil or targetRoot == nil then
		actor.Humanoid:MoveTo(actor.SpawnPosition)
		return
	end
	local now = workspace:GetServerTimeNow()
	if distance <= MELEE_RANGE then
		actor.Humanoid:MoveTo(actor.Root.Position)
		if now - actor.LastAttack >= MELEE_COOLDOWN then
			actor.LastAttack = now
			self._combat:ApplyDamage(actor.Model, player, ZOMBIE_DAMAGE, "ZombieMelee")
		end
		return
	end
	if self:_directLine(actor, targetRoot) then
		actor.Waypoints = nil
		actor.Humanoid:MoveTo(targetRoot.Position)
		return
	end
	self:_requestPath(actor, targetRoot.Position)
	local waypoints = actor.Waypoints
	if waypoints ~= nil and actor.WaypointIndex <= #waypoints then
		local waypoint = waypoints[actor.WaypointIndex]
		if (actor.Root.Position - waypoint.Position).Magnitude <= 3 then
			actor.WaypointIndex += 1
			waypoint = waypoints[actor.WaypointIndex]
		end
		if waypoint ~= nil then
			actor.Humanoid:MoveTo(waypoint.Position)
			return
		end
	end
	actor.Humanoid:MoveTo(targetRoot.Position)
end

function ZombieService:_removeEnemy(zombieId: string)
	local actor = self._enemies[zombieId]
	if actor == nil then
		return
	end
	actor.Active = false
	self._combat:UnregisterActor(actor.Model)
	if actor.Model.Parent ~= nil then
		actor.Model:Destroy()
	end
	self._enemies[zombieId] = nil
	self._wave.Alive = math.max(0, self._wave.Alive - 1)
	if self._wave.Spawned >= self._wave.Budget and self._wave.Alive == 0 and self._wave.State ~= "Idle" then
		self._wave.State = "Complete"
	end
	self:_publish()
end

function ZombieService:StartWave(day: number, phaseRevision: number)
	if not self._started or phaseRevision == self._lastNightRevision then
		return
	end
	self:StopWave(false, day)
	self._lastNightRevision = phaseRevision
	self._waveGeneration += 1
	local generation = self._waveGeneration
	self._wave.Revision += 1
	self._wave.State = "Spawning"
	self._wave.Spawned = 0
	self._wave.Alive = 0
	table.clear(self._eligible)
	local sampledPlayers = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if self._playerData:IsReady(player) then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			self._eligible[player] = humanoid ~= nil and humanoid.Health > 0
			sampledPlayers += 1
		end
	end
	self._wave.EligiblePlayers = sampledPlayers
	self._wave.Budget = if sampledPlayers == 0 then 0 else Config.GetWaveBudget(day, sampledPlayers)
	self:_publish()
	if self._wave.Budget == 0 then
		self._wave.State = "Complete"
		self:_publish()
		return
	end
	task.spawn(function()
		while self._started and self._waveGeneration == generation and self._wave.Spawned < self._wave.Budget do
			if self._wave.Alive < MAX_ACTIVE then
				self:_spawnOne(day)
			end
			if self._wave.Spawned < self._wave.Budget then
				task.wait(SPAWN_CADENCE)
			end
		end
		if self._waveGeneration == generation and self._wave.State == "Spawning" then
			self._wave.State = if self._wave.Alive > 0 then "Active" else "Complete"
			self:_publish()
		end
	end)
end

function ZombieService:_settleSurvivors(day: number)
	for player, survived in pairs(self._eligible) do
		if survived and player.Parent == Players and self._playerData:IsReady(player) then
			local success = self._playerData:Transact(player, "SurviveNight", function(profile)
				profile.Stats.HighestDay = math.min(Config.Profile.RevisionMaximum, math.max(profile.Stats.HighestDay, day))
				return true, nil
			end)
			if success then
				self._events:Emit("NightSurvived", player, day)
			end
		end
	end
	table.clear(self._eligible)
end

function ZombieService:StopWave(settleSurvivors: boolean, day: number?)
	self._waveGeneration += 1
	local ids = {}
	for zombieId in pairs(self._enemies) do
		table.insert(ids, zombieId)
	end
	for _, zombieId in ipairs(ids) do
		self:_removeEnemy(zombieId)
	end
	if settleSurvivors then
		self:_settleSurvivors(day or 0)
	else
		table.clear(self._eligible)
	end
	if self._wave.State ~= "Idle" then
		self._wave.State = "Complete"
	end
	self._wave.Alive = 0
	self._wave.EligiblePlayers = 0
	self:_publish()
end

function ZombieService:OnPhase(view)
	if view.Phase == "Night" then
		self:StartWave(view.Day, view.PhaseRevision)
	elseif view.Phase == "Dawn" then
		self:StopWave(true, view.Day)
	end
end

function ZombieService:GetView()
	return {
		State = self._wave.State,
		Revision = self._wave.Revision,
		Budget = self._wave.Budget,
		Spawned = self._wave.Spawned,
		Alive = self._wave.Alive,
		EligiblePlayers = self._wave.EligiblePlayers,
	}
end

function ZombieService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	self._aiGeneration += 1
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	self:StopWave(false)
	if self._enemiesFolder ~= nil then
		self._enemiesFolder:Destroy()
		self._enemiesFolder = nil
	end
	self._wave.State = "Idle"
	self._wave.Budget = 0
	self._wave.Spawned = 0
	self._wave.Alive = 0
	self._wave.EligiblePlayers = 0
end

return ZombieService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
