        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local AUTOSAVE_SECONDS = Config.Persistence.AutosaveIntervalSeconds
local LEASE_RENEW_SECONDS = Config.Persistence.LockRenewIntervalSeconds
local MAX_REVISION = Config.Profile.RevisionMaximum

local function autosaveJitter(userId: number): number
	local radius = Config.Persistence.AutosaveJitterSeconds
	return (userId % (2 * radius + 1)) - radius
end

local function copy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[copy(key)] = copy(child)
	end
	return result
end

local PlayerDataService = {}
PlayerDataService.__index = PlayerDataService

function PlayerDataService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_acceptingLoads = true,
		_acceptingMutations = true,
		_shutdownRequested = false,
		_maintenanceGeneration = 0,
		_entries = {} :: { [Player]: any },
		_status = {} :: { [Player]: string },
		_repository = nil,
		_events = nil,
		_profileSchema = nil,
	}, PlayerDataService)
end

function PlayerDataService.Init(self, bag)
	if self._initialized then
		return
	end
	self._repository = bag:Get("PersistenceRepository")
	self._events = bag:Get("DomainEvents")
	self._profileSchema = bag.Context.ProfileSchema
	assert(type(self._profileSchema) == "table" and type(self._profileSchema.Validate) == "function", "ProfileSchema.Validate is required")
	self._initialized = true
	self._acceptingLoads = true
	self._acceptingMutations = true
	self._shutdownRequested = false
end

function PlayerDataService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "PlayerDataService must initialize before Start")
	self._started = true
	self._maintenanceGeneration += 1
	local generation = self._maintenanceGeneration
	task.spawn(function()
		while self._started and self._maintenanceGeneration == generation do
			local now = os.clock()
			for player, entry in pairs(self._entries) do
				if entry.State == "Ready" and not entry.Saving and (now >= entry.NextAutosave or now >= entry.NextLeaseRenewal) then
					local autosaveDue = now >= entry.NextAutosave
					entry.Saving = true
					task.spawn(function()
						local ok, code = self:Save(player, true)
						local current = self._entries[player]
						if current == entry and current.State == "Ready" then
							local completedAt = os.clock()
							if ok then
								current.NextLeaseRenewal = completedAt + LEASE_RENEW_SECONDS
								if autosaveDue then
									current.NextAutosave = completedAt + AUTOSAVE_SECONDS + autosaveJitter(player.UserId)
								end
							else
								warn(string.format("profile autosave failed for %d: %s", player.UserId, tostring(code)))
							end
						end
					end)
				end
			end
			task.wait(1)
		end
	end)
end

function PlayerDataService:LoadPlayer(player: Player): (boolean, string?)
	if not self._acceptingLoads then
		self._status[player] = "PROFILE_LOAD_FAILED"
		return false, "PROFILE_LOAD_FAILED"
	end
	if self._entries[player] ~= nil then
		return self._entries[player].State == "Ready", self._entries[player].Code
	end

	self._status[player] = "Loading"
	local ok, profile, code = self._repository:Load(player.UserId)
	if not ok then
		self._status[player] = code or "PROFILE_LOAD_FAILED"
		return false, self._status[player]
	end
	if player.Parent == nil or not self._acceptingLoads then
		self._repository:Release(player.UserId)
		self._status[player] = "PROFILE_LOAD_FAILED"
		return false, "PROFILE_LOAD_FAILED"
	end

	local now = os.clock()
	self._entries[player] = {
		Profile = profile,
		State = "Ready",
		Saving = false,
		Dirty = false,
		NextAutosave = now + AUTOSAVE_SECONDS + autosaveJitter(player.UserId),
		NextLeaseRenewal = now + LEASE_RENEW_SECONDS,
	}
	self._status[player] = "Ready"
	self._events:Emit("ProfileReady", player, copy(profile))
	return true, nil
end

function PlayerDataService:IsReady(player: Player): boolean
	local entry = self._entries[player]
	return entry ~= nil and entry.State == "Ready"
end

function PlayerDataService:GetStatus(player: Player): string
	return self._status[player] or "PROFILE_NOT_READY"
end

function PlayerDataService:GetView(player: Player)
	local entry = self._entries[player]
	if entry == nil or entry.State == "Released" then
		return nil
	end
	return copy(entry.Profile)
end

function PlayerDataService:GetLoadedPlayers(): { Player }
	local players = {}
	for player, entry in pairs(self._entries) do
		if entry.State ~= "Released" then
			table.insert(players, player)
		end
	end
	return players
end

function PlayerDataService:Transact(player: Player, operation: string, mutator, allowSettlement: boolean?): (boolean, string, any)
	local entry = self._entries[player]
	if entry == nil or (entry.State ~= "Ready" and not (allowSettlement and entry.State == "Leaving")) then
		return false, "PROFILE_NOT_READY", nil
	end
	if not self._acceptingMutations and not allowSettlement then
		return false, "PROFILE_NOT_READY", nil
	end
	local current = entry.Profile
	if current.Revision >= MAX_REVISION then
		return false, "PROFILE_CONFLICT", nil
	end

	local draft = copy(current)
	local ok, accepted, codeOrPayload, payload = xpcall(function()
		return mutator(draft)
	end, debug.traceback)
	if not ok then
		warn(string.format("profile transaction %s failed: %s", operation, tostring(accepted)))
		return false, "PROFILE_CONFLICT", nil
	end
	if not accepted then
		return false, codeOrPayload or "INVALID_PAYLOAD", payload
	end
	draft.Revision = current.Revision + 1
	local valid, validationCode = self._profileSchema.Validate(draft)
	if not valid then
		warn(string.format("profile transaction %s produced invalid profile: %s", operation, tostring(validationCode)))
		return false, validationCode or "PROFILE_CONFLICT", nil
	end

	entry.Profile = draft
	entry.Dirty = true
	self._events:Emit("ProfileChanged", player, operation, copy(draft))
	return true, "OK", codeOrPayload
end

function PlayerDataService:BeginLeaving(player: Player)
	local entry = self._entries[player]
	if entry == nil or entry.State == "Leaving" or entry.State == "Released" then
		return
	end
	entry.State = "Leaving"
	self._status[player] = "PROFILE_NOT_READY"
	self._events:Emit("ProfileLeaving", player)
end

function PlayerDataService:Save(player: Player, ownsSaveLock: boolean?): (boolean, string?)
	local entry = self._entries[player]
	if entry == nil or entry.State == "Released" then
		return true, nil
	end
	if not ownsSaveLock then
		while entry.Saving do
			task.wait()
			if entry.State == "Released" then
				return true, nil
			end
		end
		entry.Saving = true
	end
	local snapshot = copy(entry.Profile)
	local ok, code = self._repository:Save(player.UserId, snapshot)
	entry.Saving = false
	if ok and entry.Profile.Revision == snapshot.Revision then
		entry.Dirty = false
	end
	return ok, code
end

function PlayerDataService:Release(player: Player): (boolean, string?)
	local entry = self._entries[player]
	if entry == nil then
		self._status[player] = nil
		return true, nil
	end
	self:BeginLeaving(player)
	local saved, saveCode = self:Save(player)
	local released = false
	local releaseCode = nil
	if saved then
		released, releaseCode = self._repository:Release(player.UserId)
	end
	entry.State = "Released"
	self._entries[player] = nil
	self._status[player] = nil
	if not saved then
		-- Keep the lease until expiry rather than expose an unsaved older record.
		return false, saveCode
	end
	return released, releaseCode
end

function PlayerDataService:BeginShutdown()
	self._shutdownRequested = true
	self._acceptingLoads = false
	self._acceptingMutations = false
	for player in pairs(self._entries) do
		self:BeginLeaving(player)
	end
end

function PlayerDataService:Shutdown(deadlineSeconds: number)
	self:BeginShutdown()
	local pending = 0
	for _, player in ipairs(self:GetLoadedPlayers()) do
		pending += 1
		task.spawn(function()
			local ok, code = self:Release(player)
			if not ok then
				warn(string.format("shutdown profile release failed for %d: %s", player.UserId, tostring(code)))
			end
			pending -= 1
		end)
	end
	local deadline = os.clock() + deadlineSeconds
	while pending > 0 and os.clock() < deadline do
		task.wait()
	end
	return pending == 0
end

function PlayerDataService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	self._maintenanceGeneration += 1
	if next(self._entries) ~= nil and not self._shutdownRequested then
		self:Shutdown(Config.Persistence.ShutdownDeadlineSeconds)
	end
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ReplicationService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local PROTOCOL = Config.ProtocolVersion

local ReplicationService = {}
ReplicationService.__index = ReplicationService

function ReplicationService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_playerData = nil,
		_inventory = nil,
		_equipment = nil,
		_spawn = nil,
		_farming = nil,
		_bunker = nil,
		_time = nil,
		_zombies = nil,
		_events = nil,
		_netTypes = nil,
		_stateDelta = nil,
		_states = {} :: { [Player]: any },
		_connections = {},
	}, ReplicationService)
end

function ReplicationService.Init(self, bag)
	if self._initialized then
		return
	end
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._equipment = bag:Get("EquipmentService")
	self._spawn = bag:Get("SpawnService")
	self._farming = bag:Get("FarmingService")
	self._bunker = bag:Get("BunkerService")
	self._time = bag:Get("TimeService")
	self._zombies = bag:Get("ZombieService")
	self._events = bag:Get("DomainEvents")
	self._netTypes = bag.Context.NetTypes
	self._stateDelta = bag.Context.Remotes.StateDelta
	assert(self._stateDelta ~= nil and self._stateDelta:IsA("RemoteEvent"), "source-authored StateDelta RemoteEvent is required")
	self._initialized = true
end

function ReplicationService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "ReplicationService must initialize before Start")
	self._started = true
	local function playerDomain(player)
		self:PublishPlayerDomain(player)
	end
	local function allSession()
		self:PublishSessionDomain()
	end
	local function allWorld()
		self:PublishWorldDomain()
	end
	table.insert(self._connections, self._events:On("ProfileChanged", playerDomain))
	table.insert(self._connections, self._events:On("CharacterSpawned", playerDomain))
	table.insert(self._connections, self._events:On("CharacterDied", playerDomain))
	table.insert(self._connections, self._events:On("EquipmentChanged", playerDomain))
	table.insert(self._connections, self._events:On("ToolHit", function(_attacker, targetActor)
		if type(targetActor) == "table" and targetActor.Kind == "Player" then
			playerDomain(targetActor.Player)
		end
	end))
	table.insert(self._connections, self._events:On("OnboardingChanged", playerDomain))
	table.insert(self._connections, self._events:On("PhaseChanged", allSession))
	table.insert(self._connections, self._events:On("WaveChanged", allSession))
	table.insert(self._connections, self._events:On("PowerActivated", allSession))
	table.insert(self._connections, self._events:On("PowerExpired", allSession))
	table.insert(self._connections, self._events:On("FarmChanged", allWorld))
end

function ReplicationService:ActivatePlayer(player: Player)
	if self._states[player] == nil then
		self._states[player] = {
			Revision = 0,
			Domains = {},
		}
	end
end

function ReplicationService:_playerView(player: Player)
	local profile = self._playerData:GetView(player)
	if profile == nil then
		return nil
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local health = if humanoid ~= nil then humanoid.Health else 0
	local maxHealth = if humanoid ~= nil then humanoid.MaxHealth else 100
	return {
		ProfileRevision = profile.Revision,
		Inventory = self._inventory:GetItemQuantities(profile.Inventory),
		Storage = self._inventory:GetItemQuantities(profile.Storage),
		StorageUsed = self._inventory:GetStorageUsed(profile),
		StorageCapacity = self._inventory:GetStorageCapacity(profile),
		Credits = profile.Currencies.credits,
		Upgrades = {
			harvest = profile.Upgrades.harvest,
			weapon = profile.Upgrades.weapon,
			storage = profile.Upgrades.storage,
		},
		Onboarding = {
			Version = profile.Onboarding.Version,
			Step = profile.Onboarding.Step,
			Completed = profile.Onboarding.Completed,
		},
		Stats = {
			HighestDay = profile.Stats.HighestDay,
			ZombiesDefeated = profile.Stats.ZombiesDefeated,
			TreesHarvested = profile.Stats.TreesHarvested,
		},
		Health = health,
		MaxHealth = maxHealth,
		EquippedSlot = self._equipment:GetEquippedSlot(player),
		Hotbar = self._equipment:GetHotbar(player),
		SpawnProtectionEndsAt = self._spawn:GetSpawnProtectionEndsAt(player),
	}
end

function ReplicationService:_sessionView()
	local time = self._time:GetView()
	return {
		Day = time.Day,
		Phase = time.Phase,
		PhaseRevision = time.PhaseRevision,
		PhaseEndsAt = time.PhaseEndsAt,
		Wave = self._zombies:GetView(),
		Power = self._bunker:GetView(),
	}
end

function ReplicationService:_worldView(player: Player)
	return self._farming:GetView(player)
end

function ReplicationService:GetRevision(player: Player): number
	local state = self._states[player]
	return if state ~= nil then state.Revision else 0
end

function ReplicationService:GetSnapshot(player: Player): (boolean, string, any)
	if not self._playerData:IsReady(player) then
		local status = self._playerData:GetStatus(player)
		local code = if status == "PROFILE_LOAD_FAILED" then "PROFILE_LOAD_FAILED" else "PROFILE_NOT_READY"
		return false, code, nil
	end
	self:ActivatePlayer(player)
	local state = self._states[player]
	local playerView = self:_playerView(player)
	local sessionView = self:_sessionView()
	local worldView = self:_worldView(player)
	local playerValid, playerError = self._netTypes.ValidatePlayerView(playerView)
	local sessionValid, sessionError = self._netTypes.ValidateSessionView(sessionView)
	local worldValid, worldError = self._netTypes.ValidateWorldView(worldView)
	assert(playerValid, playerError)
	assert(sessionValid, sessionError)
	assert(worldValid, worldError)
	state.Domains.Player = playerView
	state.Domains.Session = sessionView
	state.Domains.World = worldView
	local snapshot = {
		Protocol = PROTOCOL,
		ViewRevision = state.Revision,
		ServerTime = workspace:GetServerTimeNow(),
		Player = playerView,
		Session = sessionView,
		World = worldView,
	}
	local snapshotValid, snapshotError = self._netTypes.ValidateSnapshot(snapshot)
	assert(snapshotValid, snapshotError)
	return true, "OK", snapshot
end

function ReplicationService:_publish(player: Player, domain: string, value)
	local state = self._states[player]
	if state == nil or not self._playerData:IsReady(player) then
		return
	end
	local baseRevision = state.Revision
	local nextRevision = baseRevision + 1
	local delta = {
		Protocol = PROTOCOL,
		BaseRevision = baseRevision,
		Revision = nextRevision,
		ServerTime = workspace:GetServerTimeNow(),
		Domain = domain,
		Value = value,
	}
	local valid, validationError = self._netTypes.ValidateStateDelta(delta)
	assert(valid, validationError)
	state.Revision = nextRevision
	state.Domains[domain] = value
	self._stateDelta:FireClient(player, delta)
end

function ReplicationService:PublishPlayerDomain(player: Player)
	local view = self:_playerView(player)
	if view ~= nil then
		self:_publish(player, "Player", view)
	end
end

function ReplicationService:PublishSessionDomain()
	local view = self:_sessionView()
	for player in pairs(self._states) do
		self:_publish(player, "Session", view)
	end
end

function ReplicationService:PublishWorldDomain()
	for player in pairs(self._states) do
		self:_publish(player, "World", self:_worldView(player))
	end
end

function ReplicationService:RemovePlayer(player: Player)
	self._states[player] = nil
end

function ReplicationService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	table.clear(self._states)
end

return ReplicationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ResourceService</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local TREE_HEALTH = Config.Gameplay.Tree.Health
local TREE_REWARD = Config.Gameplay.Tree.WoodReward
local TREE_RESPAWN = Config.Gameplay.Tree.RespawnSeconds
local TREE_RANGE = Config.Gameplay.Tree.HitRange
local TREE_COOLDOWN = Config.Gameplay.Tree.HitCooldownSeconds
local SCRAP_REWARD = Config.Gameplay.ScrapCache.ScrapReward
local SCRAP_RESPAWN = Config.Gameplay.ScrapCache.RespawnSeconds
local SCRAP_RANGE = Config.Gameplay.ScrapCache.CollectRange

local ResourceService = {}
ResourceService.__index = ResourceService

local function isLiving(player: Player): (boolean, Model?, BasePart?)
	local character = player.Character
	if character == nil then
		return false, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid == nil or humanoid.Health <= 0 or root == nil or not root:IsA("BasePart") then
		return false, character, nil
	end
	return true, character, root
end

local function hasLineOfSight(character: Model, targetModel: Model, origin: Vector3, target: Vector3): boolean
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.IgnoreWater = true
	local result = workspace:Raycast(origin, target - origin, parameters)
	return result == nil or result.Instance:IsDescendantOf(targetModel)
end

function ResourceService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_world = nil,
		_playerData = nil,
		_inventory = nil,
		_equipment = nil,
		_events = nil,
		_nodes = {} :: { [string]: any },
		_connections = {},
		_lastTreeHit = {} :: { [Player]: number },
	}, ResourceService)
end

function ResourceService.Init(self, bag)
	if self._initialized then
		return
	end
	self._world = bag:Get("WorldService")
	self._playerData = bag:Get("PlayerDataService")
	self._inventory = bag:Get("InventoryService")
	self._equipment = bag:Get("EquipmentService")
	self._events = bag:Get("DomainEvents")
	for _, worldNode in ipairs(self._world:GetNodes()) do
		local originals = {}
		for _, descendant in ipairs(worldNode.Instance:GetDescendants()) do
			if descendant:IsA("BasePart") then
				table.insert(originals, {
					Part = descendant,
					Transparency = descendant.Transparency,
					CanCollide = descendant.CanCollide,
					CanTouch = descendant.CanTouch,
					CanQuery = descendant.CanQuery,
				})
			end
		end
		self._nodes[worldNode.Id] = {
			World = worldNode,
			DefinitionId = worldNode.DefinitionId,
			Active = true,
			Health = if worldNode.DefinitionId == "tree" then TREE_HEALTH else 1,
			Cycle = 0,
			Originals = originals,
			PromptWasEnabled = if worldNode.Prompt ~= nil then worldNode.Prompt.Enabled else false,
		}
	end
	self._initialized = true
end

function ResourceService:_setVisible(node, visible: boolean)
	for _, original in ipairs(node.Originals) do
		local part = original.Part
		if part.Parent ~= nil then
			part.Transparency = if visible then original.Transparency else 1
			part.CanCollide = visible and original.CanCollide
			part.CanTouch = visible and original.CanTouch
			part.CanQuery = visible and original.CanQuery
		end
	end
	if node.World.Prompt ~= nil then
		node.World.Prompt.Enabled = visible and node.PromptWasEnabled
	end
end

function ResourceService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "ResourceService must initialize before Start")
	self._started = true
	for _, node in pairs(self._nodes) do
		self:_setVisible(node, true)
		if node.DefinitionId == "scrap_cache" and node.World.Prompt ~= nil then
			table.insert(self._connections, node.World.Prompt.Triggered:Connect(function(player)
				self:TryCollectScrap(player, node.World.Id)
			end))
		end
	end
end

function ResourceService:_scheduleRespawn(node, seconds: number)
	local cycle = node.Cycle
	task.delay(seconds, function()
		if not self._started or node.Cycle ~= cycle or node.Active then
			return
		end
		node.Active = true
		node.Health = if node.DefinitionId == "tree" then TREE_HEALTH else 1
		self:_setVisible(node, true)
		self._events:Emit("ResourceChanged", node.World.Id, self:GetNodeView(node.World.Id))
	end)
end

function ResourceService:GetNodeView(nodeId: string)
	local node = self._nodes[nodeId]
	if node == nil then
		return nil
	end
	return {
		ResourceNodeId = nodeId,
		ResourceDefinitionId = node.DefinitionId,
		Active = node.Active,
		Health = node.Health,
		Cycle = node.Cycle,
	}
end

function ResourceService:GetView()
	local view = {}
	for nodeId in pairs(self._nodes) do
		view[nodeId] = self:GetNodeView(nodeId)
	end
	return view
end

function ResourceService:TryToolHit(player: Player, nodeId: string): (boolean, string, any)
	local node = self._nodes[nodeId]
	if node == nil or node.DefinitionId ~= "tree" then
		return false, "UNKNOWN_TARGET", nil
	end
	if not node.Active then
		return false, "TARGET_INACTIVE", nil
	end
	if not self._equipment:IsEquipped(player, "axe_basic") then
		return false, "NOT_EQUIPPED", nil
	end
	local living, character, root = isLiving(player)
	if not living or character == nil or root == nil then
		return false, "PLAYER_DEAD", nil
	end
	local anchor = node.World.Anchor
	if (root.Position - anchor.Position).Magnitude > TREE_RANGE then
		return false, "OUT_OF_RANGE", nil
	end
	if not hasLineOfSight(character, node.World.Instance, root.Position, anchor.Position) then
		return false, "LINE_OF_SIGHT_BLOCKED", nil
	end
	local now = workspace:GetServerTimeNow()
	if now - (self._lastTreeHit[player] or 0) < TREE_COOLDOWN then
		return false, "COOLDOWN", nil
	end
	self._lastTreeHit[player] = now

	local profile = self._playerData:GetView(player)
	if profile == nil then
		return false, "PROFILE_NOT_READY", nil
	end
	local damage = Config.GetTreeDamage(profile.Upgrades.harvest)
	if node.Health - damage > 0 then
		node.Health -= damage
		self._events:Emit("ResourceChanged", nodeId, self:GetNodeView(nodeId))
		return true, "OK", {
			HitKind = "Tree",
			TargetId = nodeId,
			TargetHealth = node.Health,
		}
	end

	local previousHealth = node.Health
	local previousCycle = node.Cycle
	local success, code = self._playerData:Transact(player, "HarvestTree", function(draft)
		local canAdd, reason = self._inventory:CanAddToProfile(player, draft, "wood", TREE_REWARD, nil)
		if not canAdd then
			return false, reason
		end
		if not node.Active or node.Cycle ~= previousCycle then
			return false, "TARGET_INACTIVE"
		end
		-- The world lifecycle changes before the one terminal profile commit.
		node.Active = false
		node.Health = 0
		node.Cycle += 1
		draft.Inventory.wood = (draft.Inventory.wood or 0) + TREE_REWARD
		draft.Stats.TreesHarvested = math.min(Config.Profile.RevisionMaximum, draft.Stats.TreesHarvested + 1)
		return true, nil
	end)
	if not success then
		if node.Cycle == previousCycle + 1 then
			node.Active = true
			node.Health = previousHealth
			node.Cycle = previousCycle
		end
		return false, code, nil
	end

	self:_setVisible(node, false)
	self:_scheduleRespawn(node, TREE_RESPAWN)
	self._events:Emit("TreeHarvested", player, nodeId, TREE_REWARD)
	self._events:Emit("ResourceChanged", nodeId, self:GetNodeView(nodeId))
	return true, "OK", {
		HitKind = "Tree",
		TargetId = nodeId,
		TargetHealth = 0,
	}
end

function ResourceService:TryCollectScrap(player: Player, nodeId: string): (boolean, string, any)
	local node = self._nodes[nodeId]
	if node == nil or node.DefinitionId ~= "scrap_cache" then
		return false, "UNKNOWN_TARGET", nil
	end
	if not node.Active then
		return false, "TARGET_INACTIVE", nil
	end
	local living, character, root = isLiving(player)
	if not living or character == nil or root == nil then
		return false, "PLAYER_DEAD", nil
	end
	local anchor = node.World.Anchor
	if (root.Position - anchor.Position).Magnitude > SCRAP_RANGE then
		return false, "OUT_OF_RANGE", nil
	end
	if not hasLineOfSight(character, node.World.Instance, root.Position, anchor.Position) then
		return false, "LINE_OF_SIGHT_BLOCKED", nil
	end

	local previousCycle = node.Cycle
	local success, code, payload = self._playerData:Transact(player, "CollectScrap", function(profile)
		local canAdd, reason = self._inventory:CanAddToProfile(player, profile, "scrap", SCRAP_REWARD, nil)
		if not canAdd then
			return false, reason
		end
		if not node.Active or node.Cycle ~= previousCycle then
			return false, "TARGET_INACTIVE"
		end
		node.Active = false
		node.Health = 0
		node.Cycle += 1
		profile.Inventory.scrap = (profile.Inventory.scrap or 0) + SCRAP_REWARD
		return true, { Quantity = profile.Inventory.scrap }
	end)
	if not success then
		if node.Cycle == previousCycle + 1 then
			node.Active = true
			node.Health = 1
			node.Cycle = previousCycle
		end
		return false, code, nil
	end
	self:_setVisible(node, false)
	self:_scheduleRespawn(node, SCRAP_RESPAWN)
	self._events:Emit("ScrapCollected", player, nodeId, SCRAP_REWARD)
	self._events:Emit("ResourceChanged", nodeId, self:GetNodeView(nodeId))
	return true, "OK", { Quantity = payload.Quantity }
end

function ResourceService:ReleasePlayer(player: Player)
	self._lastTreeHit[player] = nil
end

function ResourceService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	table.clear(self._connections)
	table.clear(self._lastTreeHit)
	for _, node in pairs(self._nodes) do
		node.Cycle += 1
		node.Active = true
		node.Health = if node.DefinitionId == "tree" then TREE_HEALTH else 1
		self:_setVisible(node, true)
	end
end

return ResourceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">SpawnService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local RESPAWN_DELAY = Config.Server.RespawnDelaySeconds
local SPAWN_PROTECTION_SECONDS = Config.Server.SpawnProtectionSeconds
local MAX_SLOTS = Config.Server.MaxActivePlayers

local SpawnService = {}
SpawnService.__index = SpawnService

function SpawnService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_world = nil,
		_playerData = nil,
		_events = nil,
		_slots = {} :: { [number]: Player },
		_players = {} :: { [Player]: any },
	}, SpawnService)
end

function SpawnService.Init(self, bag)
	if self._initialized then
		return
	end
	self._world = bag:Get("WorldService")
	self._playerData = bag:Get("PlayerDataService")
	self._events = bag:Get("DomainEvents")
	self._initialized = true
end

function SpawnService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "SpawnService must initialize before Start")
	Players.CharacterAutoLoads = false
	self._started = true
end

function SpawnService:Reserve(player: Player): (boolean, string?, number?)
	local existing = self._players[player]
	if existing ~= nil then
		return true, nil, existing.Slot
	end
	for slot = 1, MAX_SLOTS do
		if self._slots[slot] == nil then
			local spawn = self._world:GetSpawn(slot)
			assert(spawn ~= nil, string.format("validated spawn slot %d disappeared", slot))
			self._slots[slot] = player
			self._players[player] = {
				Slot = slot,
				Generation = 0,
				Character = nil,
				DiedConnection = nil,
				SpawnProtectionEndsAt = 0,
			}
			player.RespawnLocation = spawn
			return true, nil, slot
		end
	end
	return false, "SERVER_FULL", nil
end

function SpawnService:_disconnectCharacter(entry)
	if entry.DiedConnection ~= nil then
		entry.DiedConnection:Disconnect()
		entry.DiedConnection = nil
	end
	entry.Character = nil
	entry.SpawnProtectionEndsAt = 0
end

function SpawnService:SpawnCharacter(player: Player): (boolean, string?)
	local entry = self._players[player]
	if entry == nil or not self._started or not self._playerData:IsReady(player) or player.Parent ~= Players then
		return false, "PROFILE_NOT_READY"
	end

	entry.Generation += 1
	local generation = entry.Generation
	self:_disconnectCharacter(entry)
	local spawn = self._world:GetSpawn(entry.Slot)
	if spawn == nil then
		return false, "NO_CHARACTER"
	end
	player.RespawnLocation = spawn

	local loaded, loadError = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not loaded then
		warn(string.format("LoadCharacterAsync failed for %d: %s", player.UserId, tostring(loadError)))
		return false, "NO_CHARACTER"
	end
	if entry.Generation ~= generation or player.Parent ~= Players then
		return false, "NO_CHARACTER"
	end

	local character = player.Character
	if character == nil then
		return false, "NO_CHARACTER"
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid == nil or root == nil or not root:IsA("BasePart") then
		character:Destroy()
		return false, "NO_CHARACTER"
	end

	character:PivotTo(spawn.CFrame + Vector3.new(0, 3, 0))
	entry.Character = character
	entry.SpawnProtectionEndsAt = workspace:GetServerTimeNow() + SPAWN_PROTECTION_SECONDS
	entry.DiedConnection = humanoid.Died:Connect(function()
		if entry.Generation ~= generation or entry.Character ~= character then
			return
		end
		entry.Generation += 1
		local deathGeneration = entry.Generation
		entry.SpawnProtectionEndsAt = 0
		self._events:Emit("CharacterDied", player, character)
		self._events:Emit("PlayerDied", player)
		self:ScheduleRespawn(player, deathGeneration)
	end)
	self._events:Emit("CharacterSpawned", player, character, entry.SpawnProtectionEndsAt)
	return true, nil
end

function SpawnService:ScheduleRespawn(player: Player, generation: number?)
	local entry = self._players[player]
	if entry == nil then
		return
	end
	local expectedGeneration = generation or entry.Generation
	task.delay(RESPAWN_DELAY, function()
		local current = self._players[player]
		if not self._started or current == nil or current.Generation ~= expectedGeneration then
			return
		end
		if player.Parent ~= Players or not self._playerData:IsReady(player) then
			return
		end
		self:SpawnCharacter(player)
	end)
end

function SpawnService:GetSpawnProtectionEndsAt(player: Player): number
	local entry = self._players[player]
	return if entry ~= nil then entry.SpawnProtectionEndsAt else 0
end

function SpawnService:IsProtected(player: Player): boolean
	return workspace:GetServerTimeNow() < self:GetSpawnProtectionEndsAt(player)
end

function SpawnService:GetSlot(player: Player): number?
	local entry = self._players[player]
	return if entry ~= nil then entry.Slot else nil
end

function SpawnService:Release(player: Player)
	local entry = self._players[player]
	if entry == nil then
		return
	end
	entry.Generation += 1
	self:_disconnectCharacter(entry)
	if self._slots[entry.Slot] == player then
		self._slots[entry.Slot] = nil
	end
	player.RespawnLocation = nil
	self._players[player] = nil
end

function SpawnService.Stop(self)
	if not self._initialized then
		return
	end
	self._started = false
	local players = {}
	for player in pairs(self._players) do
		table.insert(players, player)
	end
	for _, player in ipairs(players) do
		self:Release(player)
	end
	table.clear(self._slots)
end

return SpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">TimeService</string>
            <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Game"):WaitForChild("Config"))

local PHASES = Config.Gameplay.Time.PhaseOrder
local DURATIONS = {
	Day = Config.Gameplay.Time.DaySeconds,
	Dusk = Config.Gameplay.Time.DuskSeconds,
	Night = Config.Gameplay.Time.NightSeconds,
	Dawn = Config.Gameplay.Time.DawnSeconds,
}

local PHASE_LIGHTING = {
	Day = { ClockTime = 13.5, Brightness = 2.3, Exposure = 0.45, Ambient = Color3.fromRGB(78, 96, 96) },
	Dusk = { ClockTime = 18.3, Brightness = 1.45, Exposure = 0.18, Ambient = Color3.fromRGB(60, 76, 78) },
	Night = { ClockTime = 1.2, Brightness = 0.85, Exposure = -0.05, Ambient = Color3.fromRGB(42, 58, 64) },
	Dawn = { ClockTime = 5.6, Brightness = 1.35, Exposure = 0.15, Ambient = Color3.fromRGB(68, 84, 86) },
}

local TimeService = {}
TimeService.__index = TimeService

function TimeService.new()
	return setmetatable({
		_initialized = false,
		_started = false,
		_events = nil,
		_day = 1,
		_phaseIndex = 1,
		_phaseRevision = 0,
		_phaseEndsAt = 0,
		_timeScale = 1,
		_clockGeneration = 0,
	}, TimeService)
end

function TimeService.Init(self, bag)
	if self._initialized then
		return
	end
	self._events = bag:Get("DomainEvents")
	self._initialized = true
end

function TimeService:_schedulePhase()
	self._clockGeneration += 1
	local generation = self._clockGeneration
	local phase = PHASES[self._phaseIndex]
	local presentation = PHASE_LIGHTING[phase]
	Lighting.ClockTime = presentation.ClockTime
	Lighting.Brightness = presentation.Brightness
	Lighting.ExposureCompensation = presentation.Exposure
	Lighting.Ambient = presentation.Ambient
	Lighting.OutdoorAmbient = presentation.Ambient
	local realDuration = DURATIONS[phase] / self._timeScale
	self._phaseEndsAt = workspace:GetServerTimeNow() + realDuration
	self._events:Emit("PhaseChanged", self:GetView())
	task.delay(realDuration, function()
		if not self._started or self._clockGeneration ~= generation then
			return
		end
		self._phaseIndex += 1
		if self._phaseIndex > #PHASES then
			self._phaseIndex = 1
			self._day += 1
		end
		self._phaseRevision += 1
		self:_schedulePhase()
	end)
end

function TimeService:StartClock()
	if not self._started then
		return
	end
	self:_schedulePhase()
end

function TimeService.Start(self)
	if self._started then
		return
	end
	assert(self._initialized, "TimeService must initialize before Start")
	self._started = true
	self:StartClock()
end

function TimeService:GetView()
	return {
		Day = self._day,
		Phase = PHASES[self._phaseIndex],
		PhaseRevision = self._phaseRevision,
		PhaseEndsAt = self._phaseEndsAt,
	}
end

function TimeService:SetStudioTimeScale(scale: number): (boolean, string?)
	if not RunService:IsStudio() or ServerStorage:GetAttribute("FG_AllowTimeScaleQA") ~= true then
		return false, "UNKNOWN_REQUEST"
	end
	if type(scale) ~= "number" or scale ~= scale or scale < 0.1 or scale > 20 then
		return false, "INVALID_PAYLOAD"
	end
	self._timeScale = scale
	if self._started then
		self:_schedulePhase()
	end
	return true, nil
end

function TimeService.Stop(self)
	self._started = false
	self._clockGeneration += 1
	self._phaseEndsAt = 0
end

return TimeService
]]></string>
