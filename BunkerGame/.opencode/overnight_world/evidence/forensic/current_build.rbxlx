          <string name="Source"><![CDATA[--!strict

local Config = require(script.Parent.Config)

export type ItemId =
    "axe_basic"
    | "rifle_basic"
    | "ammo_rifle"
    | "wood"
    | "scrap"
    | "battery_cell"
    | "seed_wheat"
    | "crop_wheat"
    | "food_ration"

export type UpgradeId = "harvest" | "weapon" | "storage"
export type OfferId = "battery_1" | "wheat_seed_2" | "rifle_ammo_12" | "ration_1"
export type CropId = "wheat"
export type RecipeId = "food_ration_wheat"
export type ResourceDefinitionId = "tree" | "scrap_cache"
export type ZombieDefinitionId = "zombie_basic"
export type OnboardingStep =
    "wake_in_bunker"
    | "harvest_first_wood"
    | "plant_first_crop"
    | "process_first_food"
    | "restore_bunker_power"
    | "survive_first_night"
    | "onboarding_complete"
export type Phase = "Day" | "Dusk" | "Night" | "Dawn"
export type InteractionKind =
    "farm_plot"
    | "food_processor"
    | "shop"
    | "storage"
    | "power"
    | "scrap_exchange"
    | "upgrade"
export type InteractionAction =
    "FarmPlant"
    | "FarmHarvest"
    | "ProcessorStart"
    | "ShopBuy"
    | "StorageTransfer"
    | "PowerActivate"
    | "ScrapExchange"
    | "UpgradeBuy"

export type ItemDefinition = {
    Id: ItemId,
    StackCap: number,
    Kind: "Tool" | "Ammunition" | "Resource" | "Consumable",
    RuntimeTool: boolean,
    HotbarSlot: number?,
    StorageAllowed: boolean,
}

export type UpgradeDefinition = {
    Id: UpgradeId,
    CreditCost: number,
    MaximumTier: number,
    Effect: "TreeDamage" | "RifleDamage" | "StorageCapacity",
    TierOneValue: number,
}

export type OfferDefinition = {
    Id: OfferId,
    ItemId: ItemId,
    BundleCount: number,
    CreditCost: number,
}

local function deepFreeze<T>(value: T): T
    if type(value) ~= "table" then
        return value
    end

    local tableValue = value :: any
    for _, child in pairs(tableValue) do
        if type(child) == "table" and not table.isfrozen(child) then
            deepFreeze(child)
        end
    end
    table.freeze(tableValue)

    return value
end

