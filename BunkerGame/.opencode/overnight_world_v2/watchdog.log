{"type":"tool_use","timestamp":1788165278511,"sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","part":{"type":"tool","tool":"read","callID":"call_01a056f4ca7d7180a0ca39771627c2f9","state":{"status":"completed","input":{"filePath":"/Users/Ori/Documents/Projects/BunkerGame/src/ReplicatedStorage/Game/Config.luau"},"output":"<path>/Users/Ori/Documents/Projects/BunkerGame/src/ReplicatedStorage/Game/Config.luau</path>\n<type>file</type>\n<content>\n1: --!strict\n2: \n3: export type RateLimit = {\n4:     Burst: number,\n5:     RefillPerSecond: number,\n6: }\n7: \n8: local MAX_SIGNED_32 = 2_147_483_647\n9: \n10: local function isIntegerInRange(value: number, minimum: number, maximum: number): boolean\n11:     return value == value\n12:         and value > -math.huge\n13:         and value < math.huge\n14:         and math.floor(value) == value\n15:         and value >= minimum\n16:         and value <= maximum\n17: end\n18: \n19: local function getWaveBudget(day: number, sampledPlayers: number): number\n20:     assert(isIntegerInRange(day, 1, MAX_SIGNED_32), \"day must be a positive 32-bit integer\")\n21:     assert(isIntegerInRange(sampledPlayers, 1, 6), \"sampledPlayers must be between 1 and 6\")\n22: \n23:     return math.min(18, 3 + day + 2 * (sampledPlayers - 1))\n24: end\n25: \n26: local function getStorageCapacity(storageTier: number): number\n27:     assert(isIntegerInRange(storageTier, 0, 1), \"storageTier must be 0 or 1\")\n28:     return 80 + 40 * storageTier\n29: end\n30: \n31: local function getRifleDamage(weaponTier: number): number\n32:     assert(isIntegerInRange(weaponTier, 0, 1), \"weaponTier must be 0 or 1\")\n33:     return if weaponTier == 1 then 34 else 24\n34: end\n35: \n36: local function getTreeDamage(harvestTier: number): number\n37:     assert(isIntegerInRange(harvestTier, 0, 1), \"harvestTier must be 0 or 1\")\n38:     return if harvestTier == 1 then 2 else 1\n39: end\n40: \n41: local function deepFreeze<T>(value: T): T\n42:     if type(value) ~= \"table\" then\n43:         return value\n44:     end\n45: \n46:     local tableValue = value :: any\n47:     for _, child in pairs(tableValue) do\n48:         if type(child) == \"table\" and not table.isfrozen(child) then\n49:             deepFreeze(child)\n50:         end\n51:     end\n52:     table.freeze(tableValue)\n53: \n54:     return value\n55: end\n56: \n57: local Config = {\n58:     ProtocolVersion = 1,\n59: \n60:     Server = {\n61:         MaxActivePlayers = 6,\n62:         CharacterAutoLoads = false,\n63:         StreamingEnabled = false,\n64:         FriendlyFire = false,\n65:         RespawnDelaySeconds = 8,\n66:         SpawnProtectionSeconds = 10,\n67:     },\n68: \n69:     Profile = {\n70:         SchemaName = \"ProfileV1\",\n71:         SchemaVersion = 1,\n72:         DataStoreName = \"FullGameProfiles_v1\",\n73:         RecordKeyPrefix = \"player:\",\n74:         RevisionMinimum = 0,\n75:         RevisionMaximum = MAX_SIGNED_32,\n76:         CreditsMinimum = 0,\n77:         CreditsMaximum = 999_999,\n78:         UpgradeTierMinimum = 0,\n79:         UpgradeTierMaximum = 1,\n80:         DefaultCredits = 25,\n81:         OnboardingVersion = 1,\n82:     },\n83: \n84:     Persistence = {\n85:         LoadDeadlineSeconds = 30,\n86:         LoadMaximumAttempts = 5,\n87:         LoadBackoffSeconds = { 0.5, 1, 2, 4, 8 },\n88:         LockLeaseSeconds = 120,\n89:         LockRenewIntervalSeconds = 45,\n90:         AutosaveIntervalSeconds = 60,\n91:         AutosaveJitterSeconds = 5,\n92:         ShutdownDeadlineSeconds = 25,\n93:         StudioUsesMemoryRepositoryByDefault = true,\n94:     },\n95: \n96:     Inventory = {\n97:         BaseStorageCapacity = 80,\n98:         StorageCapacityPerTier = 40,\n99:     },\n100: \n101:     Gameplay = {\n102:         Tree = {\n103:             Health = 3,\n104:             WoodReward = 4,\n105:             RespawnSeconds = 60,\n106:             HitRange = 10,\n107:             HitCooldownSeconds = 0.55,\n108:             BaseAxeDamage = 1,\n109:             UpgradedAxeDamage = 2,\n110:         },\n111:         ScrapCache = {\n112:             ScrapReward = 2,\n113:             RespawnSeconds = 45,\n114:             CollectRange = 10,\n115:         },\n116:         Wheat = {\n117:             GrowthSeconds = 45,\n118:             CropReward = 2,\n119:             SeedReward = 1,\n120:             SeedCost = 1,\n121:         },\n122:         Processor = {\n123:             CropCost = 2,\n124:             RationReward = 1,\n125:             DurationSeconds = 8,\n126:             MaximumActiveJobsPerPlayer = 1,\n127:         },\n128:         FoodRation = {\n129:             Heal = 35,\n130:             CooldownSeconds = 3,\n131:         },\n132:         Rifle = {\n133:             BaseDamage = 24,\n134:             UpgradedDamage = 34,\n135:             CadenceSeconds = 0.28,\n136:             Range = 180,\n137:             AmmoPerShot = 1,\n138:             UsesMagazine = false,\n139:             UsesReload = false,\n140:             UsesSpread = false,\n141:         },\n142:         AxeMelee = {\n143:             Damage = 18,\n144:             CadenceSeconds = 0.65,\n145:             Range = 8,\n146:         },\n147:         Zombie = {\n148:             Health = 80,\n149:             WalkSpeed = 7,\n150:             MeleeDamage = 10,\n151:             MeleeRange = 4.5,\n152:             MeleeCooldownSeconds = 1.2,\n153:             UpdateFrequencyHz = 5,\n154:             UpdateIntervalSeconds = 0.2,\n155:             PathRecomputeMinimumSeconds = 1,\n156:             AggroRange = 220,\n157:             LeashRange = 300,\n158:             SpawnCadenceSeconds = 1.2,\n159:             ActiveCap = 18,\n160:             KillCreditWindowSeconds = 10,\n161:             KillCredits = 4,\n162:             KillScrap = 1,\n163:         },\n164:         Time = {\n165:             PhaseOrder = { \"Day\", \"Dusk\", \"Night\", \"Dawn\" },\n166:             DaySeconds = 180,\n167:             DuskSeconds = 20,\n168:             NightSeconds = 150,\n169:             DawnSeconds = 20,\n170:         },\n171:         Wave = {\n172:             ActiveCap = 18,\n173:             BaseBudget = 3,\n174:             BudgetPerDay = 1,\n175:             BudgetPerAdditionalPlayer = 2,\n176:             WavesPerNight = 1,\n177:         },\n178:         Power = {\n179:             BatteryCost = 1,\n180:             DurationSeconds = 180,\n181:             StartsActive = false,\n182:         },\n183:         Economy = {\n184:             ScrapCreditsEach = 5,\n185:             ScrapExchangeMinimum = 1,\n186:             ScrapExchangeMaximum = 20,\n187:             ShopBundleCountMinimum = 1,\n188:             ShopBundleCountMaximum = 5,\n189:         },\n190:     },\n191: \n192:     Network = {\n193:         RequestIdMinimumLength = 1,\n194:         RequestIdMaximumLength = 36,\n195:         CanonicalIdMinimumLength = 1,\n196:         CanonicalIdMaximumLength = 48,\n197:         StationTokenLength = 32,\n198:         DefaultCountMinimum = 1,\n199:         DefaultCountMaximum = 50,\n200:         InteractionTokenLifetimeSeconds = 10,\n201:         InteractionMaximumDistance = 12,\n202:         ResultCacheSizePerPlayer = 64,\n203:         ResultCacheLifetimeSeconds = 30,\n204:         SnapshotRetryMinimumSeconds = 0.5,\n205:         SnapshotRetryMaximumSeconds = 5,\n206:         AimMagnitudeMinimum = 0.99,\n207:         AimMagnitudeMaximum = 1.01,\n208:         RateLimits = {\n209:             GetSnapshot = { Burst = 2, RefillPerSecond = 0.5 },\n210:             ToolIntent = { Burst = 12, RefillPerSecond = 6 },\n211:             InteractionIntent = { Burst = 6, RefillPerSecond = 3 },\n212:             InteractionCloseIntent = { Burst = 6, RefillPerSecond = 3 },\n213:             UseItemIntent = { Burst = 3, RefillPerSecond = 1 },\n214:         },\n215:     },\n216: \n217:     Performance = {\n218:         GameWorldMaximumBaseParts = 2_500,\n219:         GameWorldMaximumDescendants = 3_600,\n220:         BunkerMaximumBaseParts = 600,\n221:         BunkerMaximumDescendants = 900,\n222:         FarmMaximumBaseParts = 180,\n223:         FarmMaximumCollidableParts = 40,\n224:         MaximumLights = 23,\n225:         MaximumShadowLights = 6,\n226:         MaximumParticleEmitters = 12,\n227:         MaximumVisibleParticles = 180,\n228:         MaximumActiveSounds = 16,\n229:         MaximumAmbientBeds = 2,\n230:         MaximumPathRecomputesPerSecond = 18,\n231:     },\n232: \n233:     GetWaveBudget = getWaveBudget,\n234:     GetStorageCapacity = getStorageCapacity,\n235:     GetRifleDamage = getRifleDamage,\n236:     GetTreeDamage = getTreeDamage,\n237:     IsIntegerInRange = isIntegerInRange,\n238: }\n239: \n240: return deepFreeze(Config)\n\n(End of file - total 240 lines)\n</content>","metadata":{"preview":"--!strict\n\nexport type RateLimit = {\n    Burst: number,\n    RefillPerSecond: number,\n}\n\nlocal MAX_SIGNED_32 = 2_147_483_647\n\nlocal function isIntegerInRange(value: number, minimum: number, maximum: number): boolean\n    return value == value\n        and value > -math.huge\n        and value < math.huge\n        and math.floor(value) == value\n        and value >= minimum\n        and value <= maximum\nend\n\nlocal function getWaveBudget(day: number, sampledPlayers: number): number\n    assert(isIntegerInRange(day, 1, MAX_SIGNED_32), \"day must be a positive 32-bit integer\")","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/Ori/Documents/Projects/BunkerGame/src/ReplicatedStorage/Game/Config.luau","text":"--!strict\n\nexport type RateLimit = {\n    Burst: number,\n    RefillPerSecond: number,\n}\n\nlocal MAX_SIGNED_32 = 2_147_483_647\n\nlocal function isIntegerInRange(value: number, minimum: number, maximum: number): boolean\n    return value == value\n        and value > -math.huge\n        and value < math.huge\n        and math.floor(value) == value\n        and value >= minimum\n        and value <= maximum\nend\n\nlocal function getWaveBudget(day: number, sampledPlayers: number): number\n    assert(isIntegerInRange(day, 1, MAX_SIGNED_32), \"day must be a positive 32-bit integer\")\n    assert(isIntegerInRange(sampledPlayers, 1, 6), \"sampledPlayers must be between 1 and 6\")\n\n    return math.min(18, 3 + day + 2 * (sampledPlayers - 1))\nend\n\nlocal function getStorageCapacity(storageTier: number): number\n    assert(isIntegerInRange(storageTier, 0, 1), \"storageTier must be 0 or 1\")\n    return 80 + 40 * storageTier\nend\n\nlocal function getRifleDamage(weaponTier: number): number\n    assert(isIntegerInRange(weaponTier, 0, 1), \"weaponTier must be 0 or 1\")\n    return if weaponTier == 1 then 34 else 24\nend\n\nlocal function getTreeDamage(harvestTier: number): number\n    assert(isIntegerInRange(harvestTier, 0, 1), \"harvestTier must be 0 or 1\")\n    return if harvestTier == 1 then 2 else 1\nend\n\nlocal function deepFreeze<T>(value: T): T\n    if type(value) ~= \"table\" then\n        return value\n    end\n\n    local tableValue = value :: any\n    for _, child in pairs(tableValue) do\n        if type(child) == \"table\" and not table.isfrozen(child) then\n            deepFreeze(child)\n        end\n    end\n    table.freeze(tableValue)\n\n    return value\nend\n\nlocal Config = {\n    ProtocolVersion = 1,\n\n    Server = {\n        MaxActivePlayers = 6,\n        CharacterAutoLoads = false,\n        StreamingEnabled = false,\n        FriendlyFire = false,\n        RespawnDelaySeconds = 8,\n        SpawnProtectionSeconds = 10,\n    },\n\n    Profile = {\n        SchemaName = \"ProfileV1\",\n        SchemaVersion = 1,\n        DataStoreName = \"FullGameProfiles_v1\",\n        RecordKeyPrefix = \"player:\",\n        RevisionMinimum = 0,\n        RevisionMaximum = MAX_SIGNED_32,\n        CreditsMinimum = 0,\n        CreditsMaximum = 999_999,\n        UpgradeTierMinimum = 0,\n        UpgradeTierMaximum = 1,\n        DefaultCredits = 25,\n        OnboardingVersion = 1,\n    },\n\n    Persistence = {\n        LoadDeadlineSeconds = 30,\n        LoadMaximumAttempts = 5,\n        LoadBackoffSeconds = { 0.5, 1, 2, 4, 8 },\n        LockLeaseSeconds = 120,\n        LockRenewIntervalSeconds = 45,\n        AutosaveIntervalSeconds = 60,\n        AutosaveJitterSeconds = 5,\n        ShutdownDeadlineSeconds = 25,\n        StudioUsesMemoryRepositoryByDefault = true,\n    },\n\n    Inventory = {\n        BaseStorageCapacity = 80,\n        StorageCapacityPerTier = 40,\n    },\n\n    Gameplay = {\n        Tree = {\n            Health = 3,\n            WoodReward = 4,\n            RespawnSeconds = 60,\n            HitRange = 10,\n            HitCooldownSeconds = 0.55,\n            BaseAxeDamage = 1,\n            UpgradedAxeDamage = 2,\n        },\n        ScrapCache = {\n            ScrapReward = 2,\n            RespawnSeconds = 45,\n            CollectRange = 10,\n        },\n        Wheat = {\n            GrowthSeconds = 45,\n            CropReward = 2,\n            SeedReward = 1,\n            SeedCost = 1,\n        },\n        Processor = {\n            CropCost = 2,\n            RationReward = 1,\n            DurationSeconds = 8,\n            MaximumActiveJobsPerPlayer = 1,\n        },\n        FoodRation = {\n            Heal = 35,\n            CooldownSeconds = 3,\n        },\n        Rifle = {\n            BaseDamage = 24,\n            UpgradedDamage = 34,\n            CadenceSeconds = 0.28,\n            Range = 180,\n            AmmoPerShot = 1,\n            UsesMagazine = false,\n            UsesReload = false,\n            UsesSpread = false,\n        },\n        AxeMelee = {\n            Damage = 18,\n            CadenceSeconds = 0.65,\n            Range = 8,\n        },\n        Zombie = {\n            Health = 80,\n            WalkSpeed = 7,\n            MeleeDamage = 10,\n            MeleeRange = 4.5,\n            MeleeCooldownSeconds = 1.2,\n            UpdateFrequencyHz = 5,\n            UpdateIntervalSeconds = 0.2,\n            PathRecomputeMinimumSeconds = 1,\n            AggroRange = 220,\n            LeashRange = 300,\n            SpawnCadenceSeconds = 1.2,\n            ActiveCap = 18,\n            KillCreditWindowSeconds = 10,\n            KillCredits = 4,\n            KillScrap = 1,\n        },\n        Time = {\n            PhaseOrder = { \"Day\", \"Dusk\", \"Night\", \"Dawn\" },\n            DaySeconds = 180,\n            DuskSeconds = 20,\n            NightSeconds = 150,\n            DawnSeconds = 20,\n        },\n        Wave = {\n            ActiveCap = 18,\n            BaseBudget = 3,\n            BudgetPerDay = 1,\n            BudgetPerAdditionalPlayer = 2,\n            WavesPerNight = 1,\n        },\n        Power = {\n            BatteryCost = 1,\n            DurationSeconds = 180,\n            StartsActive = false,\n        },\n        Economy = {\n            ScrapCreditsEach = 5,\n            ScrapExchangeMinimum = 1,\n            ScrapExchangeMaximum = 20,\n            ShopBundleCountMinimum = 1,\n            ShopBundleCountMaximum = 5,\n        },\n    },\n\n    Network = {\n        RequestIdMinimumLength = 1,\n        RequestIdMaximumLength = 36,\n        CanonicalIdMinimumLength = 1,\n        CanonicalIdMaximumLength = 48,\n        StationTokenLength = 32,\n        DefaultCountMinimum = 1,\n        DefaultCountMaximum = 50,\n        InteractionTokenLifetimeSeconds = 10,\n        InteractionMaximumDistance = 12,\n        ResultCacheSizePerPlayer = 64,\n        ResultCacheLifetimeSeconds = 30,\n        SnapshotRetryMinimumSeconds = 0.5,\n        SnapshotRetryMaximumSeconds = 5,\n        AimMagnitudeMinimum = 0.99,\n        AimMagnitudeMaximum = 1.01,\n        RateLimits = {\n            GetSnapshot = { Burst = 2, RefillPerSecond = 0.5 },\n            ToolIntent = { Burst = 12, RefillPerSecond = 6 },\n            InteractionIntent = { Burst = 6, RefillPerSecond = 3 },\n            InteractionCloseIntent = { Burst = 6, RefillPerSecond = 3 },\n            UseItemIntent = { Burst = 3, RefillPerSecond = 1 },\n        },\n    },\n\n    Performance = {\n        GameWorldMaximumBaseParts = 2_500,\n        GameWorldMaximumDescendants = 3_600,\n        BunkerMaximumBaseParts = 600,\n        BunkerMaximumDescendants = 900,\n        FarmMaximumBaseParts = 180,\n        FarmMaximumCollidableParts = 40,\n        MaximumLights = 23,\n        MaximumShadowLights = 6,\n        MaximumParticleEmitters = 12,\n        MaximumVisibleParticles = 180,\n        MaximumActiveSounds = 16,\n        MaximumAmbientBeds = 2,\n        MaximumPathRecomputesPerSecond = 18,\n    },\n\n    GetWaveBudget = getWaveBudget,\n    GetStorageCapacity = getStorageCapacity,\n    GetRifleDamage = getRifleDamage,\n    GetTreeDamage = getTreeDamage,\n    IsIntegerInRange = isIntegerInRange,\n}\n\nreturn deepFreeze(Config)","lineStart":1,"lineEnd":240,"totalLines":240,"truncated":false}},"title":"BunkerGame/src/ReplicatedStorage/Game/Config.luau","time":{"start":1788165278484,"end":1788165278505}},"metadata":{"openai":{"itemId":"fc_01a056f4ca7d7180a0ca39771627c2f9"}},"id":"prt_056f4ca63001L6UIqkG7dMxSgQ","sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","messageID":"msg_056f4bfd2001dH3CFWuqVfZozS"}}
