{"type":"tool_use","timestamp":1788166238228,"sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","part":{"type":"tool","tool":"read","callID":"call_01a057036f317c30b4d89cf15425738e","state":{"status":"completed","input":{"filePath":"/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/Services/WildlifeService.luau"},"output":"<path>/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/Services/WildlifeService.luau</path>\n<type>file</type>\n<content>\n1: --!strict\n2: --[[\n3: \tWildlifeService — CP06 ambient wildlife\n4: \n5: \tServer-authoritative, low-cost ambient wildlife:\n6: \t- 3-5 distant deer-like silhouettes in forest perimeters\n7: \t- 2-3 bird silhouettes traversing overhead\n8: \t- Deterministic waypoints, slow wander, no per-frame AI\n9: \t- Tick rate: ~3 seconds via task.delay loop\n10: \t- All runtime clones cleaned up on Stop()\n11: \n12: \tAnchors live in GameWorld.Exterior.Wildlife (filesystem source of truth).\n13: \tModels are instantiated at runtime under Workspace.Runtime.Wildlife.\n14: --]]\n15: \n16: local TweenService = game:GetService(\"TweenService\")\n17: \n18: -- ── Tuning ───────────────────────────────────────────────────────────\n19: local TICK_INTERVAL = 3.0          -- seconds between wander updates\n20: local DEER_WALK_SPEED = 5          -- studs/sec tween speed\n21: local BIRD_WALK_SPEED = 18         -- studs/sec for bird traversal\n22: local BIRD_PERIOD = 45             -- seconds between bird crossings\n23: local BIRD_ALTITUDE = 75           -- Y position for birds\n24: local GROUND_Y = 54.0              -- DatumY\n25: \n26: -- ── Deterministic waypoint sets (fixed, no RNG) ──────────────────────\n27: -- West forest zone: X -140 to -195, Z 0-140\n28: local DEER_WAYPOINTS: { { x: number, z: number } } = {\n29: \t-- West forest herd (3 deer)\n30: \t{ x = -155, z = 25 },\n31: \t{ x = -170, z = 55 },\n32: \t{ x = -185, z = 85 },\n33: \t{ x = -165, z = 110 },\n34: \t{ x = -148, z = 70 },\n35: \t-- East forest herd (2 deer)\n36: \t{ x = 175, z = -15 },\n37: \t{ x = 195, z = 15 },\n38: \t{ x = 210, z = 45 },\n39: \t{ x = 185, z = 60 },\n40: \t{ x = 200, z = -10 },\n41: }\n42: \n43: -- Each deer gets a deterministic start index (cycles through its zone waypoints)\n44: local DEER_START_INDICES = { 1, 3, 5, 7, 9 } -- 5 deer total\n45: \n46: -- Bird crossing paths: fixed start/end at high altitude\n47: local BIRD_PATHS: { { sx: number, sz: number, ex: number, ez: number } } = {\n48: \t{ sx = -200, sz = -40, ex = 200, ez = 100 },\n49: \t{ sx = 180, sz = 120, ex = -180, ez = -20 },\n50: \t{ sx = -100, sz = 140, ex = 160, ez = -30 },\n51: }\n52: \n53: -- ── Earth tones for deer ─────────────────────────────────────────────\n54: local DEER_COLORS = {\n55: \tbody  = Color3.fromRGB(101, 78, 56),\n56: \thead  = Color3.fromRGB(115, 88, 62),\n57: \tlegs  = Color3.fromRGB(80, 60, 42),\n58: }\n59: \n60: -- ── Service ──────────────────────────────────────────────────────────\n61: local WildlifeService = {}\n62: WildlifeService.__index = WildlifeService\n63: \n64: function WildlifeService.new()\n65: \treturn setmetatable({\n66: \t\t_initialized = false,\n67: \t\t_started = false,\n68: \t\t_runtimeFolder = nil :: Folder?,\n69: \t\t_deer = {} :: { model: Model, waypointIndex: number, zoneOffset: number },\n70: \t\t_birds = {} :: { part: Part, pathIndex: number, nextCrossingAt: number },\n71: \t\t_tickConnection = nil,\n72: \t\t_birdConnections = {} :: { RBXScriptConnection },\n73: \t}, WildlifeService)\n74: end\n75: \n76: function WildlifeService.Init(self, bag)\n77: \tif self._initialized then\n78: \t\treturn\n79: \tend\n80: \tself._initialized = true\n81: end\n82: \n83: -- ── Deer model builder ───────────────────────────────────────────────\n84: local function buildDeerModel(name: string): Model\n85: \tlocal model = Instance.new(\"Model\")\n86: \tmodel.Name = name\n87: \n88: \t-- Body (PrimaryPart)\n89: \tlocal body = Instance.new(\"Part\")\n90: \tbody.Name = \"Body\"\n91: \tbody.Size = Vector3.new(3, 1.5, 2)\n92: \tbody.Color = DEER_COLORS.body\n93: \tbody.Material = Enum.Material.SmoothPlastic\n94: \tbody.Anchored = true\n95: \tbody.CanCollide = false\n96: \tbody.CastShadow = true\n97: \tbody.TopSurface = Enum.SurfaceType.Smooth\n98: \tbody.BottomSurface = Enum.SurfaceType.Smooth\n99: \tbody.Parent = model\n100: \n101: \t-- Head\n102: \tlocal head = Instance.new(\"Part\")\n103: \thead.Name = \"Head\"\n104: \thead.Size = Vector3.new(1, 1, 1)\n105: \thead.Color = DEER_COLORS.head\n106: \thead.Material = Enum.Material.SmoothPlastic\n107: \thead.Anchored = true\n108: \thead.CanCollide = false\n109: \thead.CastShadow = true\n110: \thead.TopSurface = Enum.SurfaceType.Smooth\n111: \thead.BottomSurface = Enum.SurfaceType.Smooth\n112: \thead.CFrame = CFrame.new(0, 0.5, -1.8) -- forward from body\n113: \thead.Parent = model\n114: \n115: \t-- Neck (connecting body to head)\n116: \tlocal neck = Instance.new(\"Part\")\n117: \tneck.Name = \"Neck\"\n118: \tneck.Size = Vector3.new(0.5, 1.2, 0.6)\n119: \tneck.Color = DEER_COLORS.body\n120: \tneck.Material = Enum.Material.SmoothPlastic\n121: \tneck.Anchored = true\n122: \tneck.CanCollide = false\n123: \tneck.CastShadow = false\n124: \tneck.Transparency = 0.0\n125: \tneck.TopSurface = Enum.SurfaceType.Smooth\n126: \tneck.BottomSurface = Enum.SurfaceType.Smooth\n127: \tneck.CFrame = CFrame.new(0, 0.6, -1.2)\n128: \tneck.Parent = model\n129: \n130: \t-- 4 Legs\n131: \tlocal legPositions = {\n132: \t\t{ name = \"FrontLeft\",  offset = Vector3.new(-0.8, -0.75, -0.8) },\n133: \t\t{ name = \"FrontRight\", offset = Vector3.new(0.8, -0.75, -0.8) },\n134: \t\t{ name = \"RearLeft\",   offset = Vector3.new(-0.8, -0.75, 0.8) },\n135: \t\t{ name = \"RearRight\",  offset = Vector3.new(0.8, -0.75, 0.8) },\n136: \t}\n137: \tfor _, leg in ipairs(legPositions) do\n138: \t\tlocal part = Instance.new(\"Part\")\n139: \t\tpart.Name = leg.name\n140: \t\tpart.Size = Vector3.new(0.3, 1.0, 0.3)\n141: \t\tpart.Color = DEER_COLORS.legs\n142: \t\tpart.Material = Enum.Material.SmoothPlastic\n143: \t\tpart.Anchored = true\n144: \t\tpart.CanCollide = false\n145: \t\tpart.CastShadow = false\n146: \t\tpart.TopSurface = Enum.SurfaceType.Smooth\n147: \t\tpart.BottomSurface = Enum.SurfaceType.Smooth\n148: \t\tpart.CFrame = CFrame.new(leg.offset)\n149: \t\tpart.Parent = model\n150: \tend\n151: \n152: \tmodel.PrimaryPart = body\n153: \treturn model\n154: end\n155: \n156: -- ── Bird part builder ────────────────────────────────────────────────\n157: local function buildBirdPart(name: string): Part\n158: \tlocal part = Instance.new(\"Part\")\n159: \tpart.Name = name\n160: \tpart.Size = Vector3.new(0.5, 0.15, 0.5)\n161: \tpart.Color = Color3.fromRGB(35, 30, 28)\n162: \tpart.Material = Enum.Material.SmoothPlastic\n163: \tpart.Anchored = true\n164: \tpart.CanCollide = false\n165: \tpart.CastShadow = false\n166: \tpart.Transparency = 0.35\n167: \tpart.TopSurface = Enum.SurfaceType.Smooth\n168: \tpart.BottomSurface = Enum.SurfaceType.Smooth\n169: \treturn part\n170: end\n171: \n172: -- ── Spawn wildlife ───────────────────────────────────────────────────\n173: function WildlifeService:_spawnDeer()\n174: \t-- Find anchor positions from GameWorld or use hardcoded defaults\n175: \tlocal anchorFolder = self:_findAnchorFolder()\n176: \n177: \tfor i, startIndex in ipairs(DEER_START_INDICES) do\n178: \t\tlocal deer = buildDeerModel(\"Deer\" .. i)\n179: \t\t-- Determine which zone this deer belongs to\n180: \t\tlocal zoneOffset = (i <= 3) and 0 or 5\n181: \t\tlocal wpIndex = startIndex\n182: \t\tlocal wp = DEER_WAYPOINTS[wpIndex]\n183: \t\tlocal spawnCFrame = CFrame.new(wp.x, GROUND_Y + 0.75, wp.z)\n184: \t\t-- Orient to face next waypoint\n185: \t\tlocal nextWpIndex = (wpIndex % #DEER_WAYPOINTS) + 1\n186: \t\tlocal nextWp = DEER_WAYPOINTS[nextWpIndex]\n187: \t\tlocal dir = Vector3.new(nextWp.x - wp.x, 0, nextWp.z - wp.z).Unit\n188: \t\tdeer:SetPrimaryPartCFrame(spawnCFrame * CFrame.Angles(0, math.atan2(dir.X, dir.Z), 0))\n189: \t\tdeer.Parent = self._runtimeFolder\n190: \n191: \t\ttable.insert(self._deer, {\n192: \t\t\tmodel = deer,\n193: \t\t\twaypointIndex = wpIndex,\n194: \t\t\tzoneOffset = zoneOffset,\n195: \t\t})\n196: \tend\n197: end\n198: \n199: function WildlifeService:_spawnBirds()\n200: \tfor i, path in ipairs(BIRD_PATHS) do\n201: \t\tlocal bird = buildBirdPart(\"Bird\" .. i)\n202: \t\t-- Start at the start point, hidden\n203: \t\tbird.CFrame = CFrame.new(path.sx, BIRD_ALTITUDE, path.sz)\n204: \t\tbird.Parent = self._runtimeFolder\n205: \n206: \t\ttable.insert(self._birds, {\n207: \t\t\tpart = bird,\n208: \t\t\tpathIndex = i,\n209: \t\t\tnextCrossingAt = os.clock() + (i * 5), -- stagger initial crossings\n210: \t\t})\n211: \tend\n212: end\n213: \n214: -- ── Movement tick ────────────────────────────────────────────────────\n215: function WildlifeService:_tickDeer()\n216: \tfor _, entry in ipairs(self._deer) do\n217: \t\tlocal wpIndex = entry.waypointIndex\n218: \t\tlocal wp = DEER_WAYPOINTS[wpIndex]\n219: \t\tlocal nextIndex = (wpIndex % #DEER_WAYPOINTS) + 1\n220: \t\tlocal nextWp = DEER_WAYPOINTS[nextIndex]\n221: \n222: \t\t-- Calculate direction and tween\n223: \t\tlocal fromPos = Vector3.new(wp.x, GROUND_Y + 0.75, wp.z)\n224: \t\tlocal toPos = Vector3.new(nextWp.x, GROUND_Y + 0.75, nextWp.z)\n225: \t\tlocal distance = (toPos - fromPos).Magnitude\n226: \t\tlocal duration = distance / DEER_WALK_SPEED\n227: \n228: \t\t-- Face direction of travel\n229: \t\tlocal dir = (toPos - fromPos).Unit\n230: \t\tlocal angle = math.atan2(dir.X, dir.Z)\n231: \t\tlocal targetCFrame = CFrame.new(toPos) * CFrame.Angles(0, angle, 0)\n232: \n233: \t\tlocal model = entry.model\n234: \t\tlocal primaryPart = model.PrimaryPart\n235: \t\tif primaryPart and primaryPart.Parent then\n236: \t\t\tlocal tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)\n237: \t\t\tlocal tween = TweenService:Create(primaryPart, tweenInfo, { CFrame = targetCFrame })\n238: \t\t\ttween:Play()\n239: \t\tend\n240: \n241: \t\t-- Advance waypoint\n242: \t\tentry.waypointIndex = nextIndex\n243: \tend\n244: end\n245: \n246: function WildlifeService:_tickBirds()\n247: \tlocal now = os.clock()\n248: \tfor _, entry in ipairs(self._birds) do\n249: \t\tif now >= entry.nextCrossingAt then\n250: \t\t\tlocal path = BIRD_PATHS[entry.pathIndex]\n251: \t\t\tlocal fromPos = Vector3.new(path.sx, BIRD_ALTITUDE, path.sz)\n252: \t\t\tlocal toPos = Vector3.new(path.ex, BIRD_ALTITUDE, path.ez)\n253: \t\t\tlocal distance = (toPos - fromPos).Magnitude\n254: \t\t\tlocal duration = distance / BIRD_WALK_SPEED\n255: \n256: \t\t\tlocal part = entry.part\n257: \t\t\tif part and part.Parent then\n258: \t\t\t\tpart.CFrame = CFrame.new(fromPos)\n259: \t\t\t\tlocal tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)\n260: \t\t\t\tlocal tween = TweenService:Create(part, tweenInfo, { CFrame = CFrame.new(toPos) })\n261: \t\t\t\ttween:Play()\n262: \t\t\tend\n263: \n264: \t\t\tentry.nextCrossingAt = now + BIRD_PERIOD\n265: \t\t\t-- Alternate direction next time\n266: \t\t\tlocal temp = BIRD_PATHS[entry.pathIndex].sx\n267: \t\t\tBIRD_PATHS[entry.pathIndex].sx = BIRD_PATHS[entry.pathIndex].ex\n268: \t\t\tBIRD_PATHS[entry.pathIndex].ex = temp\n269: \t\t\ttemp = BIRD_PATHS[entry.pathIndex].sz\n270: \t\t\tBIRD_PATHS[entry.pathIndex].sz = BIRD_PATHS[entry.pathIndex].ez\n271: \t\t\tBIRD_PATHS[entry.pathIndex].ez = temp\n272: \t\tend\n273: \tend\n274: end\n275: \n276: function WildlifeService:_tick()\n277: \tif not self._started then\n278: \t\treturn\n279: \tend\n280: \tself:_tickDeer()\n281: \tself:_tickBirds()\n282: \t-- Schedule next tick\n283: \ttask.delay(TICK_INTERVAL, function()\n284: \t\tself:_tick()\n285: \tend)\n286: end\n287: \n288: -- ── Anchor finder ────────────────────────────────────────────────────\n289: function WildlifeService:_findAnchorFolder(): Folder?\n290: \t-- Try to find the Wildlife anchors in GameWorld.Exterior.Wildlife\n291: \tlocal gameWorld = workspace:FindFirstChild(\"GameWorld\")\n292: \tif gameWorld then\n293: \t\tlocal exterior = gameWorld:FindFirstChild(\"Exterior\")\n294: \t\tif exterior then\n295: \t\t\tlocal wildlife = exterior:FindFirstChild(\"Wildlife\")\n296: \t\t\tif wildlife and wildlife:IsA(\"Folder\") then\n297: \t\t\t\treturn wildlife\n298: \t\t\tend\n299: \t\tend\n300: \tend\n301: \treturn nil\n302: end\n303: \n304: -- ── Lifecycle ────────────────────────────────────────────────────────\n305: function WildlifeService.Start(self)\n306: \tif self._started then\n307: \t\treturn\n308: \tend\n309: \tassert(self._initialized, \"WildlifeService must initialize before Start\")\n310: \tself._started = true\n311: \n312: \t-- Create runtime folder\n313: \tlocal runtime = workspace:FindFirstChild(\"Runtime\")\n314: \tif not runtime then\n315: \t\truntime = Instance.new(\"Folder\")\n316: \t\truntime.Name = \"Runtime\"\n317: \t\truntime.Parent = workspace\n318: \tend\n319: \tlocal wildlifeFolder = Instance.new(\"Folder\")\n320: \twildlifeFolder.Name = \"Wildlife\"\n321: \twildlifeFolder.Parent = runtime\n322: \tself._runtimeFolder = wildlifeFolder\n323: \n324: \t-- Spawn deer and birds\n325: \tself:_spawnDeer()\n326: \tself:_spawnBirds()\n327: \n328: \t-- Start movement loop (first tick after a short delay)\n329: \ttask.delay(1.0, function()\n330: \t\tself:_tick()\n331: \tend)\n332: end\n333: \n334: function WildlifeService.Stop(self)\n335: \tif not self._started then\n336: \t\treturn\n337: \tend\n338: \tself._started = false\n339: \n340: \t-- Destroy all runtime clones\n341: \tif self._runtimeFolder then\n342: \t\tfor _, entry in ipairs(self._deer) do\n343: \t\t\tif entry.model and entry.model.Parent then\n344: \t\t\t\tentry.model:Destroy()\n345: \t\t\tend\n346: \t\tend\n347: \t\tfor _, entry in ipairs(self._birds) do\n348: \t\t\tif entry.part and entry.part.Parent then\n349: \t\t\t\tentry.part:Destroy()\n350: \t\t\tend\n351: \t\tend\n352: \t\tif self._runtimeFolder.Parent then\n353: \t\t\tself._runtimeFolder:Destroy()\n354: \t\tend\n355: \t\tself._runtimeFolder = nil\n356: \tend\n357: \n358: \tself._deer = {}\n359: \tself._birds = {}\n360: end\n361: \n362: -- ── Query API (optional, kept minimal) ───────────────────────────────\n363: function WildlifeService:GetWildlife()\n364: \tlocal result = {}\n365: \tfor _, entry in ipairs(self._deer) do\n366: \t\tlocal primaryPart = entry.model and entry.model.PrimaryPart\n367: \t\tif primaryPart and primaryPart.Parent then\n368: \t\t\ttable.insert(result, {\n369: \t\t\t\tName = entry.model.Name,\n370: \t\t\t\tPosition = primaryPart.Position,\n371: \t\t\t})\n372: \t\tend\n373: \tend\n374: \treturn result\n375: end\n376: \n377: return WildlifeService\n\n(End of file - total 377 lines)\n</content>","metadata":{"preview":"--!strict\n--[[\n\tWildlifeService — CP06 ambient wildlife\n\n\tServer-authoritative, low-cost ambient wildlife:\n\t- 3-5 distant deer-like silhouettes in forest perimeters\n\t- 2-3 bird silhouettes traversing overhead\n\t- Deterministic waypoints, slow wander, no per-frame AI\n\t- Tick rate: ~3 seconds via task.delay loop\n\t- All runtime clones cleaned up on Stop()\n\n\tAnchors live in GameWorld.Exterior.Wildlife (filesystem source of truth).\n\tModels are instantiated at runtime under Workspace.Runtime.Wildlife.\n--]]\n\nlocal TweenService = game:GetService(\"TweenService\")\n\n-- ── Tuning ───────────────────────────────────────────────────────────\nlocal TICK_INTERVAL = 3.0          -- seconds between wander updates\nlocal DEER_WALK_SPEED = 5          -- studs/sec tween speed","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/Services/WildlifeService.luau","text":"--!strict\n--[[\n\tWildlifeService — CP06 ambient wildlife\n\n\tServer-authoritative, low-cost ambient wildlife:\n\t- 3-5 distant deer-like silhouettes in forest perimeters\n\t- 2-3 bird silhouettes traversing overhead\n\t- Deterministic waypoints, slow wander, no per-frame AI\n\t- Tick rate: ~3 seconds via task.delay loop\n\t- All runtime clones cleaned up on Stop()\n\n\tAnchors live in GameWorld.Exterior.Wildlife (filesystem source of truth).\n\tModels are instantiated at runtime under Workspace.Runtime.Wildlife.\n--]]\n\nlocal TweenService = game:GetService(\"TweenService\")\n\n-- ── Tuning ───────────────────────────────────────────────────────────\nlocal TICK_INTERVAL = 3.0          -- seconds between wander updates\nlocal DEER_WALK_SPEED = 5          -- studs/sec tween speed\nlocal BIRD_WALK_SPEED = 18         -- studs/sec for bird traversal\nlocal BIRD_PERIOD = 45             -- seconds between bird crossings\nlocal BIRD_ALTITUDE = 75           -- Y position for birds\nlocal GROUND_Y = 54.0              -- DatumY\n\n-- ── Deterministic waypoint sets (fixed, no RNG) ──────────────────────\n-- West forest zone: X -140 to -195, Z 0-140\nlocal DEER_WAYPOINTS: { { x: number, z: number } } = {\n\t-- West forest herd (3 deer)\n\t{ x = -155, z = 25 },\n\t{ x = -170, z = 55 },\n\t{ x = -185, z = 85 },\n\t{ x = -165, z = 110 },\n\t{ x = -148, z = 70 },\n\t-- East forest herd (2 deer)\n\t{ x = 175, z = -15 },\n\t{ x = 195, z = 15 },\n\t{ x = 210, z = 45 },\n\t{ x = 185, z = 60 },\n\t{ x = 200, z = -10 },\n}\n\n-- Each deer gets a deterministic start index (cycles through its zone waypoints)\nlocal DEER_START_INDICES = { 1, 3, 5, 7, 9 } -- 5 deer total\n\n-- Bird crossing paths: fixed start/end at high altitude\nlocal BIRD_PATHS: { { sx: number, sz: number, ex: number, ez: number } } = {\n\t{ sx = -200, sz = -40, ex = 200, ez = 100 },\n\t{ sx = 180, sz = 120, ex = -180, ez = -20 },\n\t{ sx = -100, sz = 140, ex = 160, ez = -30 },\n}\n\n-- ── Earth tones for deer ─────────────────────────────────────────────\nlocal DEER_COLORS = {\n\tbody  = Color3.fromRGB(101, 78, 56),\n\thead  = Color3.fromRGB(115, 88, 62),\n\tlegs  = Color3.fromRGB(80, 60, 42),\n}\n\n-- ── Service ──────────────────────────────────────────────────────────\nlocal WildlifeService = {}\nWildlifeService.__index = WildlifeService\n\nfunction WildlifeService.new()\n\treturn setmetatable({\n\t\t_initialized = false,\n\t\t_started = false,\n\t\t_runtimeFolder = nil :: Folder?,\n\t\t_deer = {} :: { model: Model, waypointIndex: number, zoneOffset: number },\n\t\t_birds = {} :: { part: Part, pathIndex: number, nextCrossingAt: number },\n\t\t_tickConnection = nil,\n\t\t_birdConnections = {} :: { RBXScriptConnection },\n\t}, WildlifeService)\nend\n\nfunction WildlifeService.Init(self, bag)\n\tif self._initialized then\n\t\treturn\n\tend\n\tself._initialized = true\nend\n\n-- ── Deer model builder ───────────────────────────────────────────────\nlocal function buildDeerModel(name: string): Model\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name = name\n\n\t-- Body (PrimaryPart)\n\tlocal body = Instance.new(\"Part\")\n\tbody.Name = \"Body\"\n\tbody.Size = Vector3.new(3, 1.5, 2)\n\tbody.Color = DEER_COLORS.body\n\tbody.Material = Enum.Material.SmoothPlastic\n\tbody.Anchored = true\n\tbody.CanCollide = false\n\tbody.CastShadow = true\n\tbody.TopSurface = Enum.SurfaceType.Smooth\n\tbody.BottomSurface = Enum.SurfaceType.Smooth\n\tbody.Parent = model\n\n\t-- Head\n\tlocal head = Instance.new(\"Part\")\n\thead.Name = \"Head\"\n\thead.Size = Vector3.new(1, 1, 1)\n\thead.Color = DEER_COLORS.head\n\thead.Material = Enum.Material.SmoothPlastic\n\thead.Anchored = true\n\thead.CanCollide = false\n\thead.CastShadow = true\n\thead.TopSurface = Enum.SurfaceType.Smooth\n\thead.BottomSurface = Enum.SurfaceType.Smooth\n\thead.CFrame = CFrame.new(0, 0.5, -1.8) -- forward from body\n\thead.Parent = model\n\n\t-- Neck (connecting body to head)\n\tlocal neck = Instance.new(\"Part\")\n\tneck.Name = \"Neck\"\n\tneck.Size = Vector3.new(0.5, 1.2, 0.6)\n\tneck.Color = DEER_COLORS.body\n\tneck.Material = Enum.Material.SmoothPlastic\n\tneck.Anchored = true\n\tneck.CanCollide = false\n\tneck.CastShadow = false\n\tneck.Transparency = 0.0\n\tneck.TopSurface = Enum.SurfaceType.Smooth\n\tneck.BottomSurface = Enum.SurfaceType.Smooth\n\tneck.CFrame = CFrame.new(0, 0.6, -1.2)\n\tneck.Parent = model\n\n\t-- 4 Legs\n\tlocal legPositions = {\n\t\t{ name = \"FrontLeft\",  offset = Vector3.new(-0.8, -0.75, -0.8) },\n\t\t{ name = \"FrontRight\", offset = Vector3.new(0.8, -0.75, -0.8) },\n\t\t{ name = \"RearLeft\",   offset = Vector3.new(-0.8, -0.75, 0.8) },\n\t\t{ name = \"RearRight\",  offset = Vector3.new(0.8, -0.75, 0.8) },\n\t}\n\tfor _, leg in ipairs(legPositions) do\n\t\tlocal part = Instance.new(\"Part\")\n\t\tpart.Name = leg.name\n\t\tpart.Size = Vector3.new(0.3, 1.0, 0.3)\n\t\tpart.Color = DEER_COLORS.legs\n\t\tpart.Material = Enum.Material.SmoothPlastic\n\t\tpart.Anchored = true\n\t\tpart.CanCollide = false\n\t\tpart.CastShadow = false\n\t\tpart.TopSurface = Enum.SurfaceType.Smooth\n\t\tpart.BottomSurface = Enum.SurfaceType.Smooth\n\t\tpart.CFrame = CFrame.new(leg.offset)\n\t\tpart.Parent = model\n\tend\n\n\tmodel.PrimaryPart = body\n\treturn model\nend\n\n-- ── Bird part builder ────────────────────────────────────────────────\nlocal function buildBirdPart(name: string): Part\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = name\n\tpart.Size = Vector3.new(0.5, 0.15, 0.5)\n\tpart.Color = Color3.fromRGB(35, 30, 28)\n\tpart.Material = Enum.Material.SmoothPlastic\n\tpart.Anchored = true\n\tpart.CanCollide = false\n\tpart.CastShadow = false\n\tpart.Transparency = 0.35\n\tpart.TopSurface = Enum.SurfaceType.Smooth\n\tpart.BottomSurface = Enum.SurfaceType.Smooth\n\treturn part\nend\n\n-- ── Spawn wildlife ───────────────────────────────────────────────────\nfunction WildlifeService:_spawnDeer()\n\t-- Find anchor positions from GameWorld or use hardcoded defaults\n\tlocal anchorFolder = self:_findAnchorFolder()\n\n\tfor i, startIndex in ipairs(DEER_START_INDICES) do\n\t\tlocal deer = buildDeerModel(\"Deer\" .. i)\n\t\t-- Determine which zone this deer belongs to\n\t\tlocal zoneOffset = (i <= 3) and 0 or 5\n\t\tlocal wpIndex = startIndex\n\t\tlocal wp = DEER_WAYPOINTS[wpIndex]\n\t\tlocal spawnCFrame = CFrame.new(wp.x, GROUND_Y + 0.75, wp.z)\n\t\t-- Orient to face next waypoint\n\t\tlocal nextWpIndex = (wpIndex % #DEER_WAYPOINTS) + 1\n\t\tlocal nextWp = DEER_WAYPOINTS[nextWpIndex]\n\t\tlocal dir = Vector3.new(nextWp.x - wp.x, 0, nextWp.z - wp.z).Unit\n\t\tdeer:SetPrimaryPartCFrame(spawnCFrame * CFrame.Angles(0, math.atan2(dir.X, dir.Z), 0))\n\t\tdeer.Parent = self._runtimeFolder\n\n\t\ttable.insert(self._deer, {\n\t\t\tmodel = deer,\n\t\t\twaypointIndex = wpIndex,\n\t\t\tzoneOffset = zoneOffset,\n\t\t})\n\tend\nend\n\nfunction WildlifeService:_spawnBirds()\n\tfor i, path in ipairs(BIRD_PATHS) do\n\t\tlocal bird = buildBirdPart(\"Bird\" .. i)\n\t\t-- Start at the start point, hidden\n\t\tbird.CFrame = CFrame.new(path.sx, BIRD_ALTITUDE, path.sz)\n\t\tbird.Parent = self._runtimeFolder\n\n\t\ttable.insert(self._birds, {\n\t\t\tpart = bird,\n\t\t\tpathIndex = i,\n\t\t\tnextCrossingAt = os.clock() + (i * 5), -- stagger initial crossings\n\t\t})\n\tend\nend\n\n-- ── Movement tick ────────────────────────────────────────────────────\nfunction WildlifeService:_tickDeer()\n\tfor _, entry in ipairs(self._deer) do\n\t\tlocal wpIndex = entry.waypointIndex\n\t\tlocal wp = DEER_WAYPOINTS[wpIndex]\n\t\tlocal nextIndex = (wpIndex % #DEER_WAYPOINTS) + 1\n\t\tlocal nextWp = DEER_WAYPOINTS[nextIndex]\n\n\t\t-- Calculate direction and tween\n\t\tlocal fromPos = Vector3.new(wp.x, GROUND_Y + 0.75, wp.z)\n\t\tlocal toPos = Vector3.new(nextWp.x, GROUND_Y + 0.75, nextWp.z)\n\t\tlocal distance = (toPos - fromPos).Magnitude\n\t\tlocal duration = distance / DEER_WALK_SPEED\n\n\t\t-- Face direction of travel\n\t\tlocal dir = (toPos - fromPos).Unit\n\t\tlocal angle = math.atan2(dir.X, dir.Z)\n\t\tlocal targetCFrame = CFrame.new(toPos) * CFrame.Angles(0, angle, 0)\n\n\t\tlocal model = entry.model\n\t\tlocal primaryPart = model.PrimaryPart\n\t\tif primaryPart and primaryPart.Parent then\n\t\t\tlocal tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)\n\t\t\tlocal tween = TweenService:Create(primaryPart, tweenInfo, { CFrame = targetCFrame })\n\t\t\ttween:Play()\n\t\tend\n\n\t\t-- Advance waypoint\n\t\tentry.waypointIndex = nextIndex\n\tend\nend\n\nfunction WildlifeService:_tickBirds()\n\tlocal now = os.clock()\n\tfor _, entry in ipairs(self._birds) do\n\t\tif now >= entry.nextCrossingAt then\n\t\t\tlocal path = BIRD_PATHS[entry.pathIndex]\n\t\t\tlocal fromPos = Vector3.new(path.sx, BIRD_ALTITUDE, path.sz)\n\t\t\tlocal toPos = Vector3.new(path.ex, BIRD_ALTITUDE, path.ez)\n\t\t\tlocal distance = (toPos - fromPos).Magnitude\n\t\t\tlocal duration = distance / BIRD_WALK_SPEED\n\n\t\t\tlocal part = entry.part\n\t\t\tif part and part.Parent then\n\t\t\t\tpart.CFrame = CFrame.new(fromPos)\n\t\t\t\tlocal tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)\n\t\t\t\tlocal tween = TweenService:Create(part, tweenInfo, { CFrame = CFrame.new(toPos) })\n\t\t\t\ttween:Play()\n\t\t\tend\n\n\t\t\tentry.nextCrossingAt = now + BIRD_PERIOD\n\t\t\t-- Alternate direction next time\n\t\t\tlocal temp = BIRD_PATHS[entry.pathIndex].sx\n\t\t\tBIRD_PATHS[entry.pathIndex].sx = BIRD_PATHS[entry.pathIndex].ex\n\t\t\tBIRD_PATHS[entry.pathIndex].ex = temp\n\t\t\ttemp = BIRD_PATHS[entry.pathIndex].sz\n\t\t\tBIRD_PATHS[entry.pathIndex].sz = BIRD_PATHS[entry.pathIndex].ez\n\t\t\tBIRD_PATHS[entry.pathIndex].ez = temp\n\t\tend\n\tend\nend\n\nfunction WildlifeService:_tick()\n\tif not self._started then\n\t\treturn\n\tend\n\tself:_tickDeer()\n\tself:_tickBirds()\n\t-- Schedule next tick\n\ttask.delay(TICK_INTERVAL, function()\n\t\tself:_tick()\n\tend)\nend\n\n-- ── Anchor finder ────────────────────────────────────────────────────\nfunction WildlifeService:_findAnchorFolder(): Folder?\n\t-- Try to find the Wildlife anchors in GameWorld.Exterior.Wildlife\n\tlocal gameWorld = workspace:FindFirstChild(\"GameWorld\")\n\tif gameWorld then\n\t\tlocal exterior = gameWorld:FindFirstChild(\"Exterior\")\n\t\tif exterior then\n\t\t\tlocal wildlife = exterior:FindFirstChild(\"Wildlife\")\n\t\t\tif wildlife and wildlife:IsA(\"Folder\") then\n\t\t\t\treturn wildlife\n\t\t\tend\n\t\tend\n\tend\n\treturn nil\nend\n\n-- ── Lifecycle ────────────────────────────────────────────────────────\nfunction WildlifeService.Start(self)\n\tif self._started then\n\t\treturn\n\tend\n\tassert(self._initialized, \"WildlifeService must initialize before Start\")\n\tself._started = true\n\n\t-- Create runtime folder\n\tlocal runtime = workspace:FindFirstChild(\"Runtime\")\n\tif not runtime then\n\t\truntime = Instance.new(\"Folder\")\n\t\truntime.Name = \"Runtime\"\n\t\truntime.Parent = workspace\n\tend\n\tlocal wildlifeFolder = Instance.new(\"Folder\")\n\twildlifeFolder.Name = \"Wildlife\"\n\twildlifeFolder.Parent = runtime\n\tself._runtimeFolder = wildlifeFolder\n\n\t-- Spawn deer and birds\n\tself:_spawnDeer()\n\tself:_spawnBirds()\n\n\t-- Start movement loop (first tick after a short delay)\n\ttask.delay(1.0, function()\n\t\tself:_tick()\n\tend)\nend\n\nfunction WildlifeService.Stop(self)\n\tif not self._started then\n\t\treturn\n\tend\n\tself._started = false\n\n\t-- Destroy all runtime clones\n\tif self._runtimeFolder then\n\t\tfor _, entry in ipairs(self._deer) do\n\t\t\tif entry.model and entry.model.Parent then\n\t\t\t\tentry.model:Destroy()\n\t\t\tend\n\t\tend\n\t\tfor _, entry in ipairs(self._birds) do\n\t\t\tif entry.part and entry.part.Parent then\n\t\t\t\tentry.part:Destroy()\n\t\t\tend\n\t\tend\n\t\tif self._runtimeFolder.Parent then\n\t\t\tself._runtimeFolder:Destroy()\n\t\tend\n\t\tself._runtimeFolder = nil\n\tend\n\n\tself._deer = {}\n\tself._birds = {}\nend\n\n-- ── Query API (optional, kept minimal) ───────────────────────────────\nfunction WildlifeService:GetWildlife()\n\tlocal result = {}\n\tfor _, entry in ipairs(self._deer) do\n\t\tlocal primaryPart = entry.model and entry.model.PrimaryPart\n\t\tif primaryPart and primaryPart.Parent then\n\t\t\ttable.insert(result, {\n\t\t\t\tName = entry.model.Name,\n\t\t\t\tPosition = primaryPart.Position,\n\t\t\t})\n\t\tend\n\tend\n\treturn result\nend\n\nreturn WildlifeService","lineStart":1,"lineEnd":377,"totalLines":377,"truncated":false}},"title":"BunkerGame/src/ServerScriptService/Game/Services/WildlifeService.luau","time":{"start":1788166238199,"end":1788166238222}},"metadata":{"openai":{"itemId":"fc_01a057036f317c30b4d89cf15425738e"}},"id":"prt_057036ee6001WEC8M4e338RHlJ","sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","messageID":"msg_057035733001BcffxpJBluPyZp"}}
