{"type":"tool_use","timestamp":1788165280836,"sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","part":{"type":"tool","tool":"read","callID":"call_01a056f4d36773539b22d9599968fc14","state":{"status":"completed","input":{"filePath":"/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/Services/WorldService.luau"},"output":"<path>/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/Services/WorldService.luau</path>\n<type>file</type>\n<content>\n1: --!strict\n2: \n3: local Workspace = game:GetService(\"Workspace\")\n4: \n5: local WorldService = {}\n6: WorldService.__index = WorldService\n7: \n8: local function sortedKeys(values): { string }\n9: \tlocal result = {}\n10: \tfor key in pairs(values) do\n11: \t\ttable.insert(result, key)\n12: \tend\n13: \ttable.sort(result)\n14: \treturn result\n15: end\n16: \n17: local function onePrompt(instance: Instance): ProximityPrompt\n18: \tlocal result = nil\n19: \tfor _, descendant in ipairs(instance:GetDescendants()) do\n20: \t\tif descendant:IsA(\"ProximityPrompt\") then\n21: \t\t\tassert(result == nil, string.format(\"%s has multiple ProximityPrompts\", instance:GetFullName()))\n22: \t\t\tresult = descendant\n23: \t\tend\n24: \tend\n25: \tassert(result ~= nil, string.format(\"%s has no ProximityPrompt\", instance:GetFullName()))\n26: \tassert(result.Style == Enum.ProximityPromptStyle.Custom, string.format(\"%s prompt must use Custom presentation\", instance:GetFullName()))\n27: \tassert(result.Enabled, string.format(\"%s prompt must be enabled\", instance:GetFullName()))\n28: \treturn result\n29: end\n30: \n31: local function indexExpected(records, idField: string): { [string]: any }\n32: \tassert(type(records) == \"table\", string.format(\"WorldManifest.%s records are required\", idField))\n33: \tlocal result = {}\n34: \tfor _, record in ipairs(records) do\n35: \t\tassert(type(record) == \"table\", \"WorldManifest records must be tables\")\n36: \t\tlocal id = record[idField]\n37: \t\tassert(type(id) == \"string\" and id ~= \"\", string.format(\"WorldManifest record has invalid %s\", idField))\n38: \t\tassert(result[id] == nil, string.format(\"WorldManifest has duplicate %s %s\", idField, id))\n39: \t\tresult[id] = record\n40: \tend\n41: \treturn result\n42: end\n43: \n44: local function assertExact(actual, expected, kind: string)\n45: \tfor id in pairs(expected) do\n46: \t\tassert(actual[id] ~= nil, string.format(\"missing %s %s\", kind, id))\n47: \tend\n48: \tfor id in pairs(actual) do\n49: \t\tassert(expected[id] ~= nil, string.format(\"unexpected %s %s\", kind, id))\n50: \tend\n51: end\n52: \n53: function WorldService.new()\n54: \treturn setmetatable({\n55: \t\t_initialized = false,\n56: \t\t_started = false,\n57: \t\t_validated = false,\n58: \t\t_gameWorld = nil,\n59: \t\t_runtime = nil,\n60: \t\t_spawns = {},\n61: \t\t_interactions = {},\n62: \t\t_nodes = {},\n63: \t\t_plots = {},\n64: \t\t_zombieSpawns = {},\n65: \t\t_poweredLights = {},\n66: \t\t_audioCues = {},\n67: \t\t_effectsFolder = nil,\n68: \t\t_events = nil,\n69: \t\t_manifest = nil,\n70: \t\t_definitions = nil,\n71: \t\t_connections = {},\n72: \t}, WorldService)\n73: end\n74: \n75: function WorldService.Init(self, bag)\n76: \tif self._initialized then\n77: \t\treturn\n78: \tend\n79: \tself._events = bag:Get(\"DomainEvents\")\n80: \tself._manifest = bag.Context.WorldManifest\n81: \tself._definitions = bag.Context.Definitions\n82: \tassert(type(self._manifest) == \"table\", \"WorldManifest shared module is required\")\n83: \tassert(type(self._definitions) == \"table\", \"Definitions shared module is required\")\n84: \tself:Validate()\n85: \tself._initialized = true\n86: end\n87: \n88: function WorldService:Validate()\n89: \tif self._validated then\n90: \t\treturn true\n91: \tend\n92: \n93: \tlocal gameWorld = Workspace:FindFirstChild(\"GameWorld\")\n94: \tlocal runtime = Workspace:FindFirstChild(\"Runtime\")\n95: \tassert(gameWorld ~= nil and gameWorld:IsA(\"Model\"), \"Workspace.GameWorld Model is required\")\n96: \tassert(runtime ~= nil and runtime.ClassName == self._manifest.RuntimeRootClassName, \"Workspace.Runtime source Folder is required\")\n97: \tlocal manifestValid, manifestErrors = self._manifest.ValidateManifest()\n98: \tassert(manifestValid, \"WorldManifest is invalid: \" .. table.concat(manifestErrors, \"; \"))\n99: \tlocal worldValid, worldErrors = self._manifest.ValidateWorld(gameWorld)\n100: \tassert(worldValid, \"Workspace.GameWorld violates WorldManifest: \" .. table.concat(worldErrors, \"; \"))\n101: \tfor _, descendant in ipairs(gameWorld:GetDescendants()) do\n102: \t\tassert(not descendant:IsA(\"LuaSourceContainer\"), string.format(\"world script is forbidden: %s\", descendant:GetFullName()))\n103: \tend\n104: \n105: \tlocal expectedSpawns = indexExpected(self._manifest.Spawns, \"SpawnId\")\n106: \tlocal expectedInteractions = indexExpected(self._manifest.Interactions, \"InteractionId\")\n107: \tlocal expectedNodes = indexExpected(self._manifest.ResourceNodes, \"ResourceNodeId\")\n108: \tlocal expectedPlots = indexExpected(self._manifest.Plots, \"PlotId\")\n109: \tlocal expectedZombieSpawns = indexExpected(self._manifest.ZombieSpawns, \"SpawnId\")\n110: \n111: \tlocal spawns = {}\n112: \tlocal interactions = {}\n113: \tlocal nodes = {}\n114: \tlocal plots = {}\n115: \tlocal zombieSpawns = {}\n116: \n117: \tfor _, descendant in ipairs(gameWorld:GetDescendants()) do\n118: \t\tlocal spawnId = descendant:GetAttribute(\"SpawnId\")\n119: \t\tif spawnId ~= nil and descendant:IsA(\"SpawnLocation\") then\n120: \t\t\tassert(type(spawnId) == \"string\" and spawns[spawnId] == nil, string.format(\"duplicate/invalid spawn %s\", tostring(spawnId)))\n121: \t\t\tlocal expected = expectedSpawns[spawnId]\n122: \t\t\tassert(expected ~= nil, string.format(\"unexpected spawn %s\", spawnId))\n123: \t\t\tassert(descendant:GetAttribute(\"SpawnRole\") == \"bedroom\", string.format(\"spawn %s has invalid SpawnRole\", spawnId))\n124: \t\t\tassert(descendant:GetAttribute(\"SlotIndex\") == expected.SlotIndex, string.format(\"spawn %s has invalid SlotIndex\", spawnId))\n125: \t\t\tassert(descendant.Anchored and not descendant.CanCollide and descendant.Neutral and descendant.Enabled, string.format(\"spawn %s properties are invalid\", spawnId))\n126: \t\t\tassert(descendant.Duration == 0 and descendant.Size == Vector3.new(5, 1, 5), string.format(\"spawn %s size/duration is invalid\", spawnId))\n127: \t\t\tspawns[spawnId] = descendant\n128: \t\tend\n129: \n130: \t\tlocal nodeId = descendant:GetAttribute(\"ResourceNodeId\")\n131: \t\tif nodeId ~= nil then\n132: \t\t\tassert(descendant:IsA(\"Model\"), string.format(\"resource %s must be a Model\", tostring(nodeId)))\n133: \t\t\tassert(type(nodeId) == \"string\" and nodes[nodeId] == nil, string.format(\"duplicate/invalid resource %s\", tostring(nodeId)))\n134: \t\t\tlocal expected = expectedNodes[nodeId]\n135: \t\t\tassert(expected ~= nil, string.format(\"unexpected resource %s\", nodeId))\n136: \t\t\tlocal definitionId = descendant:GetAttribute(\"ResourceDefinitionId\")\n137: \t\t\tassert(definitionId == expected.ResourceDefinitionId, string.format(\"resource %s has wrong definition\", nodeId))\n138: \t\t\tassert(self._definitions.Resources[definitionId] ~= nil, string.format(\"resource %s references unknown definition %s\", nodeId, tostring(definitionId)))\n139: \t\t\tnodes[nodeId] = {\n140: \t\t\t\tId = nodeId,\n141: \t\t\t\tDefinitionId = definitionId,\n142: \t\t\t\tInstance = descendant,\n143: \t\t\t\tPrompt = if definitionId == \"scrap_cache\" then onePrompt(descendant) else nil,\n144: \t\t\t\tAnchor = descendant:FindFirstChild(\"ResourceAnchor\", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(\"BasePart\", true),\n145: \t\t\t}\n146: \t\t\tassert(nodes[nodeId].Anchor ~= nil, string.format(\"resource %s has no BasePart\", nodeId))\n147: \t\tend\n148: \n149: \t\tlocal plotId = descendant:GetAttribute(\"PlotId\")\n150: \t\tif plotId ~= nil then\n151: \t\t\tassert(descendant:IsA(\"Model\"), string.format(\"plot %s must be a Model\", tostring(plotId)))\n152: \t\t\tassert(type(plotId) == \"string\" and plots[plotId] == nil, string.format(\"duplicate/invalid plot %s\", tostring(plotId)))\n153: \t\t\tassert(expectedPlots[plotId] ~= nil, string.format(\"unexpected plot %s\", plotId))\n154: \t\t\tassert(descendant:GetAttribute(\"InteractionKind\") == \"farm_plot\", string.format(\"plot %s has invalid InteractionKind\", plotId))\n155: \t\t\tplots[plotId] = {\n156: \t\t\t\tId = plotId,\n157: \t\t\t\tKind = \"farm_plot\",\n158: \t\t\t\tInstance = descendant,\n159: \t\t\t\tPrompt = onePrompt(descendant),\n160: \t\t\t\tAnchor = descendant:FindFirstChild(\"CropAnchor\", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(\"BasePart\", true),\n161: \t\t\t}\n162: \t\t\tassert(plots[plotId].Anchor ~= nil, string.format(\"plot %s has no crop anchor\", plotId))\n163: \t\t\tinteractions[plotId] = plots[plotId]\n164: \t\tend\n165: \n166: \t\tlocal interactionId = descendant:GetAttribute(\"InteractionId\")\n167: \t\tlocal processorId = descendant:GetAttribute(\"ProcessorId\")\n168: \t\tif interactionId ~= nil or processorId ~= nil then\n169: \t\t\tassert(descendant:IsA(\"Model\"), string.format(\"interaction %s must be a Model\", tostring(interactionId or processorId)))\n170: \t\t\tlocal id = interactionId or processorId\n171: \t\t\tassert(type(id) == \"string\" and interactions[id] == nil, string.format(\"duplicate/invalid interaction %s\", tostring(id)))\n172: \t\t\tlocal expected = expectedInteractions[id]\n173: \t\t\tassert(expected ~= nil, string.format(\"unexpected interaction %s\", id))\n174: \t\t\tlocal kind = descendant:GetAttribute(\"InteractionKind\")\n175: \t\t\tassert(kind == expected.InteractionKind, string.format(\"interaction %s has wrong kind\", id))\n176: \t\t\tinteractions[id] = {\n177: \t\t\t\tId = id,\n178: \t\t\t\tKind = kind,\n179: \t\t\t\tInstance = descendant,\n180: \t\t\t\tPrompt = onePrompt(descendant),\n181: \t\t\t\tAnchor = descendant:FindFirstChild(\"InteractionAnchor\", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(\"BasePart\", true),\n182: \t\t\t\tUpgradeId = descendant:GetAttribute(\"UpgradeId\") or expected.UpgradeId,\n183: \t\t\t}\n184: \t\t\tassert(interactions[id].Anchor ~= nil, string.format(\"interaction %s has no BasePart\", id))\n185: \t\tend\n186: \n187: \t\tif descendant:IsA(\"BasePart\") and descendant:GetAttribute(\"SpawnGroupId\") ~= nil then\n188: \t\t\tlocal enemySpawnId = descendant:GetAttribute(\"SpawnId\")\n189: \t\t\tassert(type(enemySpawnId) == \"string\" and zombieSpawns[enemySpawnId] == nil, string.format(\"duplicate/invalid zombie spawn %s\", tostring(enemySpawnId)))\n190: \t\t\tlocal expected = expectedZombieSpawns[enemySpawnId]\n191: \t\t\tassert(expected ~= nil, string.format(\"unexpected zombie spawn %s\", enemySpawnId))\n192: \t\t\tassert(descendant:GetAttribute(\"SpawnGroupId\") == expected.SpawnGroupId, string.format(\"zombie spawn %s has wrong group\", enemySpawnId))\n193: \t\t\tzombieSpawns[enemySpawnId] = descendant\n194: \t\tend\n195: \tend\n196: \n197: \tassertExact(spawns, expectedSpawns, \"spawn\")\n198: \tassertExact(nodes, expectedNodes, \"resource\")\n199: \tassertExact(plots, expectedPlots, \"plot\")\n200: \tassertExact(zombieSpawns, expectedZombieSpawns, \"zombie spawn\")\n201: \tfor id in pairs(expectedInteractions) do\n202: \t\tassert(interactions[id] ~= nil, string.format(\"missing interaction %s\", id))\n203: \tend\n204: \tassert(#runtime:GetDescendants() == 0, \"source Workspace.Runtime must be empty\")\n205: \n206: \tlocal bunker = gameWorld:FindFirstChild(\"Bunker\")\n207: \tlocal poweredLights = bunker and bunker:FindFirstChild(\"PoweredLights\", true)\n208: \tassert(poweredLights ~= nil, \"GameWorld.Bunker.PoweredLights is required\")\n209: \tlocal presentation = gameWorld:FindFirstChild(\"Presentation\")\n210: \tlocal audioAnchors = presentation and presentation:FindFirstChild(\"AudioAnchors\")\n211: \tassert(audioAnchors ~= nil and audioAnchors:IsA(\"Model\"), \"GameWorld.Presentation.AudioAnchors is required\")\n212: \tassert(audioAnchors:GetAttribute(\"PlaybackOwner\") == \"server_interactions\", \"AudioAnchors playback owner is invalid\")\n213: \tlocal openingCueInstance = audioAnchors:FindFirstChild(\"BlastDoorOpenCueSound\", true)\n214: \tlocal closingCueInstance = audioAnchors:FindFirstChild(\"BlastDoorCloseCueSound\", true)\n215: \tassert(openingCueInstance ~= nil and openingCueInstance:IsA(\"Sound\"), \"BlastDoorOpenCueSound is required\")\n216: \tassert(closingCueInstance ~= nil and closingCueInstance:IsA(\"Sound\"), \"BlastDoorCloseCueSound is required\")\n217: \tlocal openingCue = openingCueInstance :: Sound\n218: \tlocal closingCue = closingCueInstance :: Sound\n219: \tassert(openingCue.SoundId ~= \"\" and closingCue.SoundId ~= \"\", \"facility cues require source-authored SoundIds\")\n220: \tassert(not openingCue.Looped and not closingCue.Looped, \"facility cues must be one-shot sounds\")\n221: \n222: \tself._gameWorld = gameWorld\n223: \tself._runtime = runtime\n224: \tself._spawns = spawns\n225: \tself._interactions = interactions\n226: \tself._nodes = nodes\n227: \tself._plots = plots\n228: \tself._zombieSpawns = zombieSpawns\n229: \tlocal poweredInstances = poweredLights:GetDescendants()\n230: \tlocal seen = {} :: { [Instance]: boolean }\n231: \tfor _, instance in ipairs(poweredInstances) do\n232: \t\tseen[instance] = true\n233: \tend\n234: \t-- A powered indicator can live on an interactive console or authored story\n235: \t-- prop outside the fixture folder. Keep those visuals on the same canonical\n236: \t-- circuit so an unpowered bunker never advertises working equipment.\n237: \tfor _, instance in ipairs(bunker:GetDescendants()) do\n238: \t\tif instance:IsA(\"BasePart\") and instance:GetAttribute(\"PowerIndicator\") == true and not seen[instance] then\n239: \t\t\tseen[instance] = true\n240: \t\t\ttable.insert(poweredInstances, instance)\n241: \t\tend\n242: \tend\n243: \tself._poweredLights = poweredInstances\n244: \tself._audioCues = {\n245: \t\tPowerActivated = openingCue,\n246: \t\tPowerExpired = closingCue,\n247: \t}\n248: \tself._validated = true\n249: \treturn true\n250: end\n251: \n252: function WorldService:_playAudioCue(cueName: string)\n253: \tlocal cue = self._audioCues[cueName]\n254: \tif cue ~= nil and cue.Parent ~= nil then\n255: \t\tcue:Stop()\n256: \t\tcue:Play()\n257: \tend\n258: end\n259: \n260: function WorldService.Start(self)\n261: \tif self._started then\n262: \t\treturn\n263: \tend\n264: \tassert(self._validated, \"WorldService must validate before Start\")\n265: \tself._started = true\n266: \tlocal effectsFolder = Instance.new(\"Folder\")\n267: \teffectsFolder.Name = \"Effects\"\n268: \teffectsFolder.Parent = self._runtime\n269: \tself._effectsFolder = effectsFolder\n270: \ttable.insert(self._connections, self._events:On(\"PowerActivated\", function()\n271: \t\tself:_playAudioCue(\"PowerActivated\")\n272: \tend))\n273: \ttable.insert(self._connections, self._events:On(\"PowerExpired\", function()\n274: \t\tself:_playAudioCue(\"PowerExpired\")\n275: \tend))\n276: \tself._events:Emit(\"WorldReady\")\n277: end\n278: \n279: function WorldService:GetSpawn(slotIndex: number): SpawnLocation?\n280: \tfor _, spawn in pairs(self._spawns) do\n281: \t\tif spawn:GetAttribute(\"SlotIndex\") == slotIndex then\n282: \t\t\treturn spawn\n283: \t\tend\n284: \tend\n285: \treturn nil\n286: end\n287: \n288: function WorldService:GetInteraction(interactionId: string)\n289: \treturn self._interactions[interactionId]\n290: end\n291: \n292: function WorldService:GetInteractions()\n293: \tlocal result = {}\n294: \tfor _, id in ipairs(sortedKeys(self._interactions)) do\n295: \t\ttable.insert(result, self._interactions[id])\n296: \tend\n297: \treturn result\n298: end\n299: \n300: function WorldService:GetNode(nodeId: string)\n301: \treturn self._nodes[nodeId]\n302: end\n303: \n304: function WorldService:GetNodes()\n305: \tlocal result = {}\n306: \tfor _, id in ipairs(sortedKeys(self._nodes)) do\n307: \t\ttable.insert(result, self._nodes[id])\n308: \tend\n309: \treturn result\n310: end\n311: \n312: function WorldService:GetPlots()\n313: \tlocal result = {}\n314: \tfor _, id in ipairs(sortedKeys(self._plots)) do\n315: \t\ttable.insert(result, self._plots[id])\n316: \tend\n317: \treturn result\n318: end\n319: \n320: function WorldService:GetZombieSpawns()\n321: \tlocal result = {}\n322: \tfor _, id in ipairs(sortedKeys(self._zombieSpawns)) do\n323: \t\ttable.insert(result, self._zombieSpawns[id])\n324: \tend\n325: \treturn result\n326: end\n327: \n328: function WorldService:GetRuntime()\n329: \treturn self._runtime\n330: end\n331: \n332: function WorldService:GetPoweredLights()\n333: \treturn self._poweredLights\n334: end\n335: \n336: function WorldService.Stop(self)\n337: \tif not self._initialized then\n338: \t\treturn\n339: \tend\n340: \tself._started = false\n341: \tself._validated = false\n342: \tif self._effectsFolder ~= nil then\n343: \t\tself._effectsFolder:Destroy()\n344: \t\tself._effectsFolder = nil\n345: \tend\n346: \tfor _, connection in ipairs(self._connections) do\n347: \t\tconnection:Disconnect()\n348: \tend\n349: \ttable.clear(self._connections)\n350: \tfor _, cue in pairs(self._audioCues) do\n351: \t\tif cue.Parent ~= nil then\n352: \t\t\tcue:Stop()\n353: \t\tend\n354: \tend\n355: \ttable.clear(self._spawns)\n356: \ttable.clear(self._interactions)\n357: \ttable.clear(self._nodes)\n358: \ttable.clear(self._plots)\n359: \ttable.clear(self._zombieSpawns)\n360: \ttable.clear(self._poweredLights)\n361: \ttable.clear(self._audioCues)\n362: end\n363: \n364: return WorldService\n\n(End of file - total 364 lines)\n</content>","metadata":{"preview":"--!strict\n\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal WorldService = {}\nWorldService.__index = WorldService\n\nlocal function sortedKeys(values): { string }\n\tlocal result = {}\n\tfor key in pairs(values) do\n\t\ttable.insert(result, key)\n\tend\n\ttable.sort(result)\n\treturn result\nend\n\nlocal function onePrompt(instance: Instance): ProximityPrompt\n\tlocal result = nil\n\tfor _, descendant in ipairs(instance:GetDescendants()) do\n\t\tif descendant:IsA(\"ProximityPrompt\") then","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/Services/WorldService.luau","text":"--!strict\n\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal WorldService = {}\nWorldService.__index = WorldService\n\nlocal function sortedKeys(values): { string }\n\tlocal result = {}\n\tfor key in pairs(values) do\n\t\ttable.insert(result, key)\n\tend\n\ttable.sort(result)\n\treturn result\nend\n\nlocal function onePrompt(instance: Instance): ProximityPrompt\n\tlocal result = nil\n\tfor _, descendant in ipairs(instance:GetDescendants()) do\n\t\tif descendant:IsA(\"ProximityPrompt\") then\n\t\t\tassert(result == nil, string.format(\"%s has multiple ProximityPrompts\", instance:GetFullName()))\n\t\t\tresult = descendant\n\t\tend\n\tend\n\tassert(result ~= nil, string.format(\"%s has no ProximityPrompt\", instance:GetFullName()))\n\tassert(result.Style == Enum.ProximityPromptStyle.Custom, string.format(\"%s prompt must use Custom presentation\", instance:GetFullName()))\n\tassert(result.Enabled, string.format(\"%s prompt must be enabled\", instance:GetFullName()))\n\treturn result\nend\n\nlocal function indexExpected(records, idField: string): { [string]: any }\n\tassert(type(records) == \"table\", string.format(\"WorldManifest.%s records are required\", idField))\n\tlocal result = {}\n\tfor _, record in ipairs(records) do\n\t\tassert(type(record) == \"table\", \"WorldManifest records must be tables\")\n\t\tlocal id = record[idField]\n\t\tassert(type(id) == \"string\" and id ~= \"\", string.format(\"WorldManifest record has invalid %s\", idField))\n\t\tassert(result[id] == nil, string.format(\"WorldManifest has duplicate %s %s\", idField, id))\n\t\tresult[id] = record\n\tend\n\treturn result\nend\n\nlocal function assertExact(actual, expected, kind: string)\n\tfor id in pairs(expected) do\n\t\tassert(actual[id] ~= nil, string.format(\"missing %s %s\", kind, id))\n\tend\n\tfor id in pairs(actual) do\n\t\tassert(expected[id] ~= nil, string.format(\"unexpected %s %s\", kind, id))\n\tend\nend\n\nfunction WorldService.new()\n\treturn setmetatable({\n\t\t_initialized = false,\n\t\t_started = false,\n\t\t_validated = false,\n\t\t_gameWorld = nil,\n\t\t_runtime = nil,\n\t\t_spawns = {},\n\t\t_interactions = {},\n\t\t_nodes = {},\n\t\t_plots = {},\n\t\t_zombieSpawns = {},\n\t\t_poweredLights = {},\n\t\t_audioCues = {},\n\t\t_effectsFolder = nil,\n\t\t_events = nil,\n\t\t_manifest = nil,\n\t\t_definitions = nil,\n\t\t_connections = {},\n\t}, WorldService)\nend\n\nfunction WorldService.Init(self, bag)\n\tif self._initialized then\n\t\treturn\n\tend\n\tself._events = bag:Get(\"DomainEvents\")\n\tself._manifest = bag.Context.WorldManifest\n\tself._definitions = bag.Context.Definitions\n\tassert(type(self._manifest) == \"table\", \"WorldManifest shared module is required\")\n\tassert(type(self._definitions) == \"table\", \"Definitions shared module is required\")\n\tself:Validate()\n\tself._initialized = true\nend\n\nfunction WorldService:Validate()\n\tif self._validated then\n\t\treturn true\n\tend\n\n\tlocal gameWorld = Workspace:FindFirstChild(\"GameWorld\")\n\tlocal runtime = Workspace:FindFirstChild(\"Runtime\")\n\tassert(gameWorld ~= nil and gameWorld:IsA(\"Model\"), \"Workspace.GameWorld Model is required\")\n\tassert(runtime ~= nil and runtime.ClassName == self._manifest.RuntimeRootClassName, \"Workspace.Runtime source Folder is required\")\n\tlocal manifestValid, manifestErrors = self._manifest.ValidateManifest()\n\tassert(manifestValid, \"WorldManifest is invalid: \" .. table.concat(manifestErrors, \"; \"))\n\tlocal worldValid, worldErrors = self._manifest.ValidateWorld(gameWorld)\n\tassert(worldValid, \"Workspace.GameWorld violates WorldManifest: \" .. table.concat(worldErrors, \"; \"))\n\tfor _, descendant in ipairs(gameWorld:GetDescendants()) do\n\t\tassert(not descendant:IsA(\"LuaSourceContainer\"), string.format(\"world script is forbidden: %s\", descendant:GetFullName()))\n\tend\n\n\tlocal expectedSpawns = indexExpected(self._manifest.Spawns, \"SpawnId\")\n\tlocal expectedInteractions = indexExpected(self._manifest.Interactions, \"InteractionId\")\n\tlocal expectedNodes = indexExpected(self._manifest.ResourceNodes, \"ResourceNodeId\")\n\tlocal expectedPlots = indexExpected(self._manifest.Plots, \"PlotId\")\n\tlocal expectedZombieSpawns = indexExpected(self._manifest.ZombieSpawns, \"SpawnId\")\n\n\tlocal spawns = {}\n\tlocal interactions = {}\n\tlocal nodes = {}\n\tlocal plots = {}\n\tlocal zombieSpawns = {}\n\n\tfor _, descendant in ipairs(gameWorld:GetDescendants()) do\n\t\tlocal spawnId = descendant:GetAttribute(\"SpawnId\")\n\t\tif spawnId ~= nil and descendant:IsA(\"SpawnLocation\") then\n\t\t\tassert(type(spawnId) == \"string\" and spawns[spawnId] == nil, string.format(\"duplicate/invalid spawn %s\", tostring(spawnId)))\n\t\t\tlocal expected = expectedSpawns[spawnId]\n\t\t\tassert(expected ~= nil, string.format(\"unexpected spawn %s\", spawnId))\n\t\t\tassert(descendant:GetAttribute(\"SpawnRole\") == \"bedroom\", string.format(\"spawn %s has invalid SpawnRole\", spawnId))\n\t\t\tassert(descendant:GetAttribute(\"SlotIndex\") == expected.SlotIndex, string.format(\"spawn %s has invalid SlotIndex\", spawnId))\n\t\t\tassert(descendant.Anchored and not descendant.CanCollide and descendant.Neutral and descendant.Enabled, string.format(\"spawn %s properties are invalid\", spawnId))\n\t\t\tassert(descendant.Duration == 0 and descendant.Size == Vector3.new(5, 1, 5), string.format(\"spawn %s size/duration is invalid\", spawnId))\n\t\t\tspawns[spawnId] = descendant\n\t\tend\n\n\t\tlocal nodeId = descendant:GetAttribute(\"ResourceNodeId\")\n\t\tif nodeId ~= nil then\n\t\t\tassert(descendant:IsA(\"Model\"), string.format(\"resource %s must be a Model\", tostring(nodeId)))\n\t\t\tassert(type(nodeId) == \"string\" and nodes[nodeId] == nil, string.format(\"duplicate/invalid resource %s\", tostring(nodeId)))\n\t\t\tlocal expected = expectedNodes[nodeId]\n\t\t\tassert(expected ~= nil, string.format(\"unexpected resource %s\", nodeId))\n\t\t\tlocal definitionId = descendant:GetAttribute(\"ResourceDefinitionId\")\n\t\t\tassert(definitionId == expected.ResourceDefinitionId, string.format(\"resource %s has wrong definition\", nodeId))\n\t\t\tassert(self._definitions.Resources[definitionId] ~= nil, string.format(\"resource %s references unknown definition %s\", nodeId, tostring(definitionId)))\n\t\t\tnodes[nodeId] = {\n\t\t\t\tId = nodeId,\n\t\t\t\tDefinitionId = definitionId,\n\t\t\t\tInstance = descendant,\n\t\t\t\tPrompt = if definitionId == \"scrap_cache\" then onePrompt(descendant) else nil,\n\t\t\t\tAnchor = descendant:FindFirstChild(\"ResourceAnchor\", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(\"BasePart\", true),\n\t\t\t}\n\t\t\tassert(nodes[nodeId].Anchor ~= nil, string.format(\"resource %s has no BasePart\", nodeId))\n\t\tend\n\n\t\tlocal plotId = descendant:GetAttribute(\"PlotId\")\n\t\tif plotId ~= nil then\n\t\t\tassert(descendant:IsA(\"Model\"), string.format(\"plot %s must be a Model\", tostring(plotId)))\n\t\t\tassert(type(plotId) == \"string\" and plots[plotId] == nil, string.format(\"duplicate/invalid plot %s\", tostring(plotId)))\n\t\t\tassert(expectedPlots[plotId] ~= nil, string.format(\"unexpected plot %s\", plotId))\n\t\t\tassert(descendant:GetAttribute(\"InteractionKind\") == \"farm_plot\", string.format(\"plot %s has invalid InteractionKind\", plotId))\n\t\t\tplots[plotId] = {\n\t\t\t\tId = plotId,\n\t\t\t\tKind = \"farm_plot\",\n\t\t\t\tInstance = descendant,\n\t\t\t\tPrompt = onePrompt(descendant),\n\t\t\t\tAnchor = descendant:FindFirstChild(\"CropAnchor\", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(\"BasePart\", true),\n\t\t\t}\n\t\t\tassert(plots[plotId].Anchor ~= nil, string.format(\"plot %s has no crop anchor\", plotId))\n\t\t\tinteractions[plotId] = plots[plotId]\n\t\tend\n\n\t\tlocal interactionId = descendant:GetAttribute(\"InteractionId\")\n\t\tlocal processorId = descendant:GetAttribute(\"ProcessorId\")\n\t\tif interactionId ~= nil or processorId ~= nil then\n\t\t\tassert(descendant:IsA(\"Model\"), string.format(\"interaction %s must be a Model\", tostring(interactionId or processorId)))\n\t\t\tlocal id = interactionId or processorId\n\t\t\tassert(type(id) == \"string\" and interactions[id] == nil, string.format(\"duplicate/invalid interaction %s\", tostring(id)))\n\t\t\tlocal expected = expectedInteractions[id]\n\t\t\tassert(expected ~= nil, string.format(\"unexpected interaction %s\", id))\n\t\t\tlocal kind = descendant:GetAttribute(\"InteractionKind\")\n\t\t\tassert(kind == expected.InteractionKind, string.format(\"interaction %s has wrong kind\", id))\n\t\t\tinteractions[id] = {\n\t\t\t\tId = id,\n\t\t\t\tKind = kind,\n\t\t\t\tInstance = descendant,\n\t\t\t\tPrompt = onePrompt(descendant),\n\t\t\t\tAnchor = descendant:FindFirstChild(\"InteractionAnchor\", true) or descendant.PrimaryPart or descendant:FindFirstChildWhichIsA(\"BasePart\", true),\n\t\t\t\tUpgradeId = descendant:GetAttribute(\"UpgradeId\") or expected.UpgradeId,\n\t\t\t}\n\t\t\tassert(interactions[id].Anchor ~= nil, string.format(\"interaction %s has no BasePart\", id))\n\t\tend\n\n\t\tif descendant:IsA(\"BasePart\") and descendant:GetAttribute(\"SpawnGroupId\") ~= nil then\n\t\t\tlocal enemySpawnId = descendant:GetAttribute(\"SpawnId\")\n\t\t\tassert(type(enemySpawnId) == \"string\" and zombieSpawns[enemySpawnId] == nil, string.format(\"duplicate/invalid zombie spawn %s\", tostring(enemySpawnId)))\n\t\t\tlocal expected = expectedZombieSpawns[enemySpawnId]\n\t\t\tassert(expected ~= nil, string.format(\"unexpected zombie spawn %s\", enemySpawnId))\n\t\t\tassert(descendant:GetAttribute(\"SpawnGroupId\") == expected.SpawnGroupId, string.format(\"zombie spawn %s has wrong group\", enemySpawnId))\n\t\t\tzombieSpawns[enemySpawnId] = descendant\n\t\tend\n\tend\n\n\tassertExact(spawns, expectedSpawns, \"spawn\")\n\tassertExact(nodes, expectedNodes, \"resource\")\n\tassertExact(plots, expectedPlots, \"plot\")\n\tassertExact(zombieSpawns, expectedZombieSpawns, \"zombie spawn\")\n\tfor id in pairs(expectedInteractions) do\n\t\tassert(interactions[id] ~= nil, string.format(\"missing interaction %s\", id))\n\tend\n\tassert(#runtime:GetDescendants() == 0, \"source Workspace.Runtime must be empty\")\n\n\tlocal bunker = gameWorld:FindFirstChild(\"Bunker\")\n\tlocal poweredLights = bunker and bunker:FindFirstChild(\"PoweredLights\", true)\n\tassert(poweredLights ~= nil, \"GameWorld.Bunker.PoweredLights is required\")\n\tlocal presentation = gameWorld:FindFirstChild(\"Presentation\")\n\tlocal audioAnchors = presentation and presentation:FindFirstChild(\"AudioAnchors\")\n\tassert(audioAnchors ~= nil and audioAnchors:IsA(\"Model\"), \"GameWorld.Presentation.AudioAnchors is required\")\n\tassert(audioAnchors:GetAttribute(\"PlaybackOwner\") == \"server_interactions\", \"AudioAnchors playback owner is invalid\")\n\tlocal openingCueInstance = audioAnchors:FindFirstChild(\"BlastDoorOpenCueSound\", true)\n\tlocal closingCueInstance = audioAnchors:FindFirstChild(\"BlastDoorCloseCueSound\", true)\n\tassert(openingCueInstance ~= nil and openingCueInstance:IsA(\"Sound\"), \"BlastDoorOpenCueSound is required\")\n\tassert(closingCueInstance ~= nil and closingCueInstance:IsA(\"Sound\"), \"BlastDoorCloseCueSound is required\")\n\tlocal openingCue = openingCueInstance :: Sound\n\tlocal closingCue = closingCueInstance :: Sound\n\tassert(openingCue.SoundId ~= \"\" and closingCue.SoundId ~= \"\", \"facility cues require source-authored SoundIds\")\n\tassert(not openingCue.Looped and not closingCue.Looped, \"facility cues must be one-shot sounds\")\n\n\tself._gameWorld = gameWorld\n\tself._runtime = runtime\n\tself._spawns = spawns\n\tself._interactions = interactions\n\tself._nodes = nodes\n\tself._plots = plots\n\tself._zombieSpawns = zombieSpawns\n\tlocal poweredInstances = poweredLights:GetDescendants()\n\tlocal seen = {} :: { [Instance]: boolean }\n\tfor _, instance in ipairs(poweredInstances) do\n\t\tseen[instance] = true\n\tend\n\t-- A powered indicator can live on an interactive console or authored story\n\t-- prop outside the fixture folder. Keep those visuals on the same canonical\n\t-- circuit so an unpowered bunker never advertises working equipment.\n\tfor _, instance in ipairs(bunker:GetDescendants()) do\n\t\tif instance:IsA(\"BasePart\") and instance:GetAttribute(\"PowerIndicator\") == true and not seen[instance] then\n\t\t\tseen[instance] = true\n\t\t\ttable.insert(poweredInstances, instance)\n\t\tend\n\tend\n\tself._poweredLights = poweredInstances\n\tself._audioCues = {\n\t\tPowerActivated = openingCue,\n\t\tPowerExpired = closingCue,\n\t}\n\tself._validated = true\n\treturn true\nend\n\nfunction WorldService:_playAudioCue(cueName: string)\n\tlocal cue = self._audioCues[cueName]\n\tif cue ~= nil and cue.Parent ~= nil then\n\t\tcue:Stop()\n\t\tcue:Play()\n\tend\nend\n\nfunction WorldService.Start(self)\n\tif self._started then\n\t\treturn\n\tend\n\tassert(self._validated, \"WorldService must validate before Start\")\n\tself._started = true\n\tlocal effectsFolder = Instance.new(\"Folder\")\n\teffectsFolder.Name = \"Effects\"\n\teffectsFolder.Parent = self._runtime\n\tself._effectsFolder = effectsFolder\n\ttable.insert(self._connections, self._events:On(\"PowerActivated\", function()\n\t\tself:_playAudioCue(\"PowerActivated\")\n\tend))\n\ttable.insert(self._connections, self._events:On(\"PowerExpired\", function()\n\t\tself:_playAudioCue(\"PowerExpired\")\n\tend))\n\tself._events:Emit(\"WorldReady\")\nend\n\nfunction WorldService:GetSpawn(slotIndex: number): SpawnLocation?\n\tfor _, spawn in pairs(self._spawns) do\n\t\tif spawn:GetAttribute(\"SlotIndex\") == slotIndex then\n\t\t\treturn spawn\n\t\tend\n\tend\n\treturn nil\nend\n\nfunction WorldService:GetInteraction(interactionId: string)\n\treturn self._interactions[interactionId]\nend\n\nfunction WorldService:GetInteractions()\n\tlocal result = {}\n\tfor _, id in ipairs(sortedKeys(self._interactions)) do\n\t\ttable.insert(result, self._interactions[id])\n\tend\n\treturn result\nend\n\nfunction WorldService:GetNode(nodeId: string)\n\treturn self._nodes[nodeId]\nend\n\nfunction WorldService:GetNodes()\n\tlocal result = {}\n\tfor _, id in ipairs(sortedKeys(self._nodes)) do\n\t\ttable.insert(result, self._nodes[id])\n\tend\n\treturn result\nend\n\nfunction WorldService:GetPlots()\n\tlocal result = {}\n\tfor _, id in ipairs(sortedKeys(self._plots)) do\n\t\ttable.insert(result, self._plots[id])\n\tend\n\treturn result\nend\n\nfunction WorldService:GetZombieSpawns()\n\tlocal result = {}\n\tfor _, id in ipairs(sortedKeys(self._zombieSpawns)) do\n\t\ttable.insert(result, self._zombieSpawns[id])\n\tend\n\treturn result\nend\n\nfunction WorldService:GetRuntime()\n\treturn self._runtime\nend\n\nfunction WorldService:GetPoweredLights()\n\treturn self._poweredLights\nend\n\nfunction WorldService.Stop(self)\n\tif not self._initialized then\n\t\treturn\n\tend\n\tself._started = false\n\tself._validated = false\n\tif self._effectsFolder ~= nil then\n\t\tself._effectsFolder:Destroy()\n\t\tself._effectsFolder = nil\n\tend\n\tfor _, connection in ipairs(self._connections) do\n\t\tconnection:Disconnect()\n\tend\n\ttable.clear(self._connections)\n\tfor _, cue in pairs(self._audioCues) do\n\t\tif cue.Parent ~= nil then\n\t\t\tcue:Stop()\n\t\tend\n\tend\n\ttable.clear(self._spawns)\n\ttable.clear(self._interactions)\n\ttable.clear(self._nodes)\n\ttable.clear(self._plots)\n\ttable.clear(self._zombieSpawns)\n\ttable.clear(self._poweredLights)\n\ttable.clear(self._audioCues)\nend\n\nreturn WorldService","lineStart":1,"lineEnd":364,"totalLines":364,"truncated":false}},"title":"BunkerGame/src/ServerScriptService/Game/Services/WorldService.luau","time":{"start":1788165280810,"end":1788165280826}},"metadata":{"openai":{"itemId":"fc_01a056f4d36773539b22d9599968fc14"}},"id":"prt_056f4d426001uX8kE3sEhgHaIr","sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","messageID":"msg_056f4cf3e001IlZKNVlQ4US4Qb"}}
