ver_ok() {\n  /usr/bin/curl -fsS \\\n    --max-time 5 \\\n    http://127.0.0.1:4098/global/health \\\n    > \"$R/evidence/opencode_health.json\" \\\n    2>/dev/null\n}\n\nsnapshot_source() {\n  TS=\"$(/bin/date '+%Y%m%d_%H%M%S')\"\n  D=\"$R/backups/pre_run_$TS\"\n\n  /bin/mkdir -p \"$D\"\n\n  if [ -d \"$ROOT/src\" ]; then\n    log \"Creating immutable pre-run source snapshot\"\n    /usr/bin/tar -czf \"$D/src.tar.gz\" -C \"$ROOT\" src || return 1\n  fi\n\n  [ -f \"$ROOT/default.project.json\" ] && /bin/cp \"$ROOT/default.project.json\" \"$D/\" || true\n  [ -f \"$ROOT/opencode.json\" ] && /bin/cp \"$ROOT/opencode.json\" \"$D/\" || true\n\n  /usr/bin/find \"$ROOT/src\" \\\n    -type f \\\n    -print \\\n    2>/dev/null \\\n    | /usr/bin/sort \\\n    > \"$D/source_files.txt\"\n\n  printf '%s\\n' \"$D\" > \"$R/pre_run_backup.txt\"\n\n  log \"PRE_RUN_BACKUP=$D\"\n}\n\nrequired_checkpoints_passed() {\n  E=\"$R/events.log\"\n\n  for CP in \\\n    CP01_SAFETY \\\n    CP02_WORLD_PLAN \\\n    CP03_TERRAIN \\\n    CP04_FOREST \\\n    CP05_ROCKS_LANDMARKS \\\n    CP06_WILDLIFE \\\n    CP07_GAMEPLAY \\\n    CP08_PRESENTATION \\\n    CP09_TECH_QA \\\n    CP10_PLAY_QA \\\n    CP11_VISUAL_QA \\\n    CP12_FINAL\n  do\n    /usr/bin/grep -q \"|$CP|PASS|\" \"$E\" || return 1\n  done\n\n  return 0\n}\n\nterminate_run() {\n  PID=\"$1\"\n\n  log \"Attempting graceful termination of stalled run PID=$PID\"\n\n  for CHILD in $(/usr/bin/pgrep -P \"$PID\" 2>/dev/null); do\n    /bin/kill -TERM \"$CHILD\" 2>/dev/null || true\n  done\n\n  /bin/kill -TERM \"$PID\" 2>/dev/null || true\n  /bin/sleep 5\n\n  if /bin/kill -0 \"$PID\" 2>/dev/null; then\n    log \"Run still alive after TERM; sending KILL to run process only\"\n    /bin/kill -KILL \"$PID\" 2>/dev/null || true\n  fi\n}\n\nstate PREFLIGHT\n\nlog \"============================================================\"\nlog \"OVERNIGHT WORLD V2 WATCHDOG START\"\nlog \"ROOT=$ROOT\"\nlog \"PID=$$\"\nlog \"===============================================