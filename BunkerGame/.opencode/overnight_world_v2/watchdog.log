{"type":"tool_use","timestamp":1788166194552,"sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","part":{"type":"tool","tool":"read","callID":"call_01a05702c40a7103a8874bd1a0023cc2","state":{"status":"completed","input":{"filePath":"/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/ServiceBag.luau"},"output":"<path>/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/ServiceBag.luau</path>\n<type>file</type>\n<content>\n1: --!strict\n2: \n3: local ServiceBag = {}\n4: ServiceBag.__index = ServiceBag\n5: \n6: export type Service = {\n7: \tInit: (self: Service, bag: ServiceBag) -> (),\n8: \tStart: (self: Service) -> (),\n9: \tStop: (self: Service) -> (),\n10: }\n11: \n12: export type ServiceBag = typeof(setmetatable({} :: {\n13: \tContext: { [string]: any },\n14: \t_services: { [string]: Service },\n15: \t_order: { { Name: string, Service: Service } },\n16: \t_initializedCount: number,\n17: \t_started: boolean,\n18: \t_stopping: boolean,\n19: }, ServiceBag))\n20: \n21: function ServiceBag.new(context: { [string]: any }): ServiceBag\n22: \treturn setmetatable({\n23: \t\tContext = context,\n24: \t\t_services = {},\n25: \t\t_order = {},\n26: \t\t_initializedCount = 0,\n27: \t\t_started = false,\n28: \t\t_stopping = false,\n29: \t}, ServiceBag)\n30: end\n31: \n32: function ServiceBag.Add(self: ServiceBag, name: string, service: any): any\n33: \tassert(not self._started and self._initializedCount == 0, \"services must be registered before initialization\")\n34: \tassert(type(name) == \"string\" and name ~= \"\", \"service name must be non-empty\")\n35: \tassert(self._services[name] == nil, string.format(\"duplicate service %s\", name))\n36: \tassert(type(service) == \"table\", string.format(\"service %s must be a table\", name))\n37: \tassert(type(service.Init) == \"function\", string.format(\"service %s has no Init\", name))\n38: \tassert(type(service.Start) == \"function\", string.format(\"service %s has no Start\", name))\n39: \tassert(type(service.Stop) == \"function\", string.format(\"service %s has no Stop\", name))\n40: \n41: \tself._services[name] = service\n42: \ttable.insert(self._order, {\n43: \t\tName = name,\n44: \t\tService = service,\n45: \t})\n46: \treturn service\n47: end\n48: \n49: function ServiceBag.Get(self: ServiceBag, name: string): any\n50: \tlocal service = self._services[name]\n51: \tassert(service ~= nil, string.format(\"unknown service %s\", name))\n52: \treturn service\n53: end\n54: \n55: function ServiceBag.IsStopping(self: ServiceBag): boolean\n56: \treturn self._stopping\n57: end\n58: \n59: function ServiceBag.Init(self: ServiceBag)\n60: \tif self._initializedCount == #self._order then\n61: \t\treturn\n62: \tend\n63: \tassert(self._initializedCount == 0, \"partial service initialization cannot be resumed\")\n64: \n65: \tfor index, entry in ipairs(self._order) do\n66: \t\t-- Include the current service in rollback even when Init only partially completes.\n67: \t\tself._initializedCount = index\n68: \t\tlocal ok, err = xpcall(function()\n69: \t\t\tentry.Service:Init(self)\n70: \t\tend, debug.traceback)\n71: \t\tif not ok then\n72: \t\t\tself:Stop()\n73: \t\t\terror(string.format(\"service %s Init failed: %s\", entry.Name, tostring(err)), 0)\n74: \t\tend\n75: \tend\n76: end\n77: \n78: function ServiceBag.Start(self: ServiceBag)\n79: \tif self._started then\n80: \t\treturn\n81: \tend\n82: \tassert(self._initializedCount == #self._order, \"all services must initialize before Start\")\n83: \n84: \tfor _, entry in ipairs(self._order) do\n85: \t\tlocal ok, err = xpcall(function()\n86: \t\t\tentry.Service:Start()\n87: \t\tend, debug.traceback)\n88: \t\tif not ok then\n89: \t\t\tself:Stop()\n90: \t\t\terror(string.format(\"service %s Start failed: %s\", entry.Name, tostring(err)), 0)\n91: \t\tend\n92: \tend\n93: \tself._started = true\n94: end\n95: \n96: function ServiceBag.Stop(self: ServiceBag)\n97: \tif self._stopping then\n98: \t\treturn\n99: \tend\n100: \tif self._initializedCount == 0 then\n101: \t\tself._started = false\n102: \t\treturn\n103: \tend\n104: \n105: \tself._stopping = true\n106: \tfor index = self._initializedCount, 1, -1 do\n107: \t\tlocal entry = self._order[index]\n108: \t\tlocal ok, err = xpcall(function()\n109: \t\t\tentry.Service:Stop()\n110: \t\tend, debug.traceback)\n111: \t\tif not ok then\n112: \t\t\twarn(string.format(\"service %s Stop failed: %s\", entry.Name, tostring(err)))\n113: \t\tend\n114: \tend\n115: \tself._initializedCount = 0\n116: \tself._started = false\n117: \tself._stopping = false\n118: end\n119: \n120: return ServiceBag\n\n(End of file - total 120 lines)\n</content>","metadata":{"preview":"--!strict\n\nlocal ServiceBag = {}\nServiceBag.__index = ServiceBag\n\nexport type Service = {\n\tInit: (self: Service, bag: ServiceBag) -> (),\n\tStart: (self: Service) -> (),\n\tStop: (self: Service) -> (),\n}\n\nexport type ServiceBag = typeof(setmetatable({} :: {\n\tContext: { [string]: any },\n\t_services: { [string]: Service },\n\t_order: { { Name: string, Service: Service } },\n\t_initializedCount: number,\n\t_started: boolean,\n\t_stopping: boolean,\n}, ServiceBag))\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/Ori/Documents/Projects/BunkerGame/src/ServerScriptService/Game/ServiceBag.luau","text":"--!strict\n\nlocal ServiceBag = {}\nServiceBag.__index = ServiceBag\n\nexport type Service = {\n\tInit: (self: Service, bag: ServiceBag) -> (),\n\tStart: (self: Service) -> (),\n\tStop: (self: Service) -> (),\n}\n\nexport type ServiceBag = typeof(setmetatable({} :: {\n\tContext: { [string]: any },\n\t_services: { [string]: Service },\n\t_order: { { Name: string, Service: Service } },\n\t_initializedCount: number,\n\t_started: boolean,\n\t_stopping: boolean,\n}, ServiceBag))\n\nfunction ServiceBag.new(context: { [string]: any }): ServiceBag\n\treturn setmetatable({\n\t\tContext = context,\n\t\t_services = {},\n\t\t_order = {},\n\t\t_initializedCount = 0,\n\t\t_started = false,\n\t\t_stopping = false,\n\t}, ServiceBag)\nend\n\nfunction ServiceBag.Add(self: ServiceBag, name: string, service: any): any\n\tassert(not self._started and self._initializedCount == 0, \"services must be registered before initialization\")\n\tassert(type(name) == \"string\" and name ~= \"\", \"service name must be non-empty\")\n\tassert(self._services[name] == nil, string.format(\"duplicate service %s\", name))\n\tassert(type(service) == \"table\", string.format(\"service %s must be a table\", name))\n\tassert(type(service.Init) == \"function\", string.format(\"service %s has no Init\", name))\n\tassert(type(service.Start) == \"function\", string.format(\"service %s has no Start\", name))\n\tassert(type(service.Stop) == \"function\", string.format(\"service %s has no Stop\", name))\n\n\tself._services[name] = service\n\ttable.insert(self._order, {\n\t\tName = name,\n\t\tService = service,\n\t})\n\treturn service\nend\n\nfunction ServiceBag.Get(self: ServiceBag, name: string): any\n\tlocal service = self._services[name]\n\tassert(service ~= nil, string.format(\"unknown service %s\", name))\n\treturn service\nend\n\nfunction ServiceBag.IsStopping(self: ServiceBag): boolean\n\treturn self._stopping\nend\n\nfunction ServiceBag.Init(self: ServiceBag)\n\tif self._initializedCount == #self._order then\n\t\treturn\n\tend\n\tassert(self._initializedCount == 0, \"partial service initialization cannot be resumed\")\n\n\tfor index, entry in ipairs(self._order) do\n\t\t-- Include the current service in rollback even when Init only partially completes.\n\t\tself._initializedCount = index\n\t\tlocal ok, err = xpcall(function()\n\t\t\tentry.Service:Init(self)\n\t\tend, debug.traceback)\n\t\tif not ok then\n\t\t\tself:Stop()\n\t\t\terror(string.format(\"service %s Init failed: %s\", entry.Name, tostring(err)), 0)\n\t\tend\n\tend\nend\n\nfunction ServiceBag.Start(self: ServiceBag)\n\tif self._started then\n\t\treturn\n\tend\n\tassert(self._initializedCount == #self._order, \"all services must initialize before Start\")\n\n\tfor _, entry in ipairs(self._order) do\n\t\tlocal ok, err = xpcall(function()\n\t\t\tentry.Service:Start()\n\t\tend, debug.traceback)\n\t\tif not ok then\n\t\t\tself:Stop()\n\t\t\terror(string.format(\"service %s Start failed: %s\", entry.Name, tostring(err)), 0)\n\t\tend\n\tend\n\tself._started = true\nend\n\nfunction ServiceBag.Stop(self: ServiceBag)\n\tif self._stopping then\n\t\treturn\n\tend\n\tif self._initializedCount == 0 then\n\t\tself._started = false\n\t\treturn\n\tend\n\n\tself._stopping = true\n\tfor index = self._initializedCount, 1, -1 do\n\t\tlocal entry = self._order[index]\n\t\tlocal ok, err = xpcall(function()\n\t\t\tentry.Service:Stop()\n\t\tend, debug.traceback)\n\t\tif not ok then\n\t\t\twarn(string.format(\"service %s Stop failed: %s\", entry.Name, tostring(err)))\n\t\tend\n\tend\n\tself._initializedCount = 0\n\tself._started = false\n\tself._stopping = false\nend\n\nreturn ServiceBag","lineStart":1,"lineEnd":120,"totalLines":120,"truncated":false}},"title":"BunkerGame/src/ServerScriptService/Game/ServiceBag.luau","time":{"start":1788166194517,"end":1788166194544}},"metadata":{"openai":{"itemId":"fc_01a05702c40a7103a8874bd1a0023cc2"}},"id":"prt_05702c3e6001VsPy5QP9P7X2vK","sessionID":"ses_fa90d7edcffe1ucmkd4gJeyy9S","messageID":"msg_05702a79a0011NV8hJO0EhwW4t"}}
