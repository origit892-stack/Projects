def log(msg):
    line = time.strftime('%Y-%m-%d %H:%M:%S') + ' ' + msg
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open('a', encoding='utf-8') as f:
        f.write(line + '\n')
    print(line, flush=True)


def request(method, path, body=None):
    if method == 'GET':
        return bapi.request(method, path, body, timeout=30, retries=2)
    return bapi.request(method, path, body, timeout=60, retries=4)


def get_messages():
    result = request('GET', f'/session/{SID}/message')
    return result if isinstance(result, list) else []


def get_latest_text(messages):
    if not messages:
        return ''
    item = messages[-1] if isinstance(messages[-1], dict) else {}
    texts = [p.get('text') for p in item.get('parts', []) if isinstance(p, dict) and p.get('type') == 'text' and p.get('text')]
    return texts[-1] if texts else ''


def message_signature(messages):
    latest = get_latest_text(messages)
    return str(len(messages)) + '|' + latest[-1200:]


def filesystem_fingerprint():
    rows = []
    for base in WATCH_PATHS:
        if not base.exists():
            continue
        for f in base.rglob('*'):
            if not f.is_file():
                continue
            try:
                st = f.stat()
            except OSError:
                continue
            rows.append(f'{f.relative_to(ROOT)}|{st.st_mtime_ns}|{st.st_size}')
    rows.sort()
    return hashlib.sha256('\n'.join(rows).encode()).hexdigest()


def is_status_only(text):
    low = text.lower().strip()
    return bool(low) and any(x in low for x in STATUS_ONLY_PHRASES) and not any(x in low for x in ACTION_EVIDENCE_TERMS)


def has_action_evidence(text):
    low = text.lower().strip()
    if not low or is_status_only(text):
        return False
    return any(x in low for x in ACTION_EVIDENCE_TERMS)


def is_positive_terminal(text):
    normalized = text.upper().replace(' ', '_').replace('`', '')
    positive = 'NEW_DIRECTOR_REVIEW=PASS' in normalized
    negative = any(x in normalized for x in (
        'CANNOT_TRUTHFULLY_ISSUE', 'CANNOT_ISSUE', 'CANNOT_MARK', 'NOT_COMPLETE',
        'INCOMPLETE', 'REMAINS_BLOCKED', 'NO_AFFIRMATIVE', 'NOT_YET'
    ))
    return positive and not negative


def dispatch(prompt):
    request('POST', f'/session/{SID}/message', {'parts': [{'type': 'text', 'text': prompt}]})


def process_health():
    checks = []
    for pattern in ['opencode serve', 'rojo serve', 'RobloxStudio']:
        result = subprocess.run(['pgrep', '-fl', pattern], capture_output=True, text=True)
        checks.append(pattern + '=' + ('UP' if result.returncode == 0 else 'DOWN'))
    return ' '.join(checks)


last_signature = ''
last_progress = time.time()
last_fs = filesystem_fingerprint()
consecutive_errors = 0

if STATE.exists():
    try:
        saved = json.loads(STATE.read_text(encoding='utf-8'))
        last_signature = saved.get('signature', '')
        last_progress = float(saved.get('last_progress', time.time()))
        last_fs = saved.get('filesystem_fingerprint', last_fs)
        consecutive_errors = int(saved.get('errors', 0))
    except Exception:
        pass

log(f'WATCHDOG_HARDENED_START cadence={CADENCE}s stall_threshold={STALL_SECONDS}s debug_max={DEBUG_MAX}')

while True:
    cycle_started = time.time()
    try:
        messages = get_messages()
        signature = message_signature(messages)
        latest = get_latest_text(messages)
        current_fs = filesystem_fingerprint()
        fs_changed = current_fs != last_fs
        msg_changed = signature != last_signature

        if is_positive_terminal(latest):
            log('NEW_DIRECTOR_REVIEW_CONFIRMED_PASS')
            STATE.write_text(json.dumps({
                'signature': signature, 'last_progress': last_progress, 'errors': 0,
                'director_review': True, 'filesystem_fingerprint': current_fs
            }), encoding='utf-8')
            break

        meaningful = False
        reasons = []
        if fs_changed:
            meaningful = True
            reasons.append('filesystem_change')
        if msg_changed and has_action_evidence(latest):
            meaningful = True
            reasons.append('action_evidence')

        last_signature = signature
        last_fs = current_fs

        if meaningful:
            last_progress = time.time()
            consecutive_errors = 0
            log('MEANINGFUL_PROGRESS reason=' + '+'.join(reasons) + ' messages=' + str(len(messages)) + ' latest=' + latest[-350:].replace('\n', ' '))
        elif msg_changed:
            log('STATUS_ONLY_IGNORED messages=' + str(len(messages)) + ' latest=' + latest[-350:].replace('\n', ' '))

        age = time.time() - last_progress
        log('WATCHDOG_CHECK age_seconds=' + str(round(age, 1)) + ' age_minutes=' + str(round(age/60, 2)) + ' ' + process_health())

        # If OpenCode says it is finished/blocked but there is no real terminal gate, force execution without resetting progress.
        low = latest.lower()
        early_stop = any(x in low for x in ('finished', 'completed', 'stopped', 'idle', 'cannot continue', 'blocked', 'human-only blocker', 'cannot truthfully complete'))
        if msg_changed and early_stop and not meaningful:
            log('STATUS_BLOCK_OR_EARLY_STOP -> FORCE_EXECUTION_WITHOUT_PROGRESS_RESET')
            dispatch(CONTINUE_PROMPT)

        if age > STALL_SECONDS:
            log('NO_MEANINGFUL_PROGRESS_OVER_20_MIN -> DIAGNOSE_AND_FIX ' + process_health())
            recovered = False
            for attempt in range(1, DEBUG_MAX + 1):
                try:
                    log('STALL_RECOVERY_ATTEMPT=' + str(attempt))
                    dispatch(DEBUG_PROMPT)
                    log('STALL_RECOVERY_DISPATCHED attempt=' + str(attempt) + ' awaiting_real_evidence')
                    recovered = True
                    break
                except Exception as exc:
                    log('STALL_RECOVERY_FAIL attempt=' + str(attempt) + ' ' + repr(exc))
                    time.sleep(min(15 * attempt, 60))
            if not recovered:
                log('error debug maxed out')
                STATE.write_text(json.dumps({
                    'signature': last_signature, 'last_progress': last_progress, 'errors': 5,
                    'fatal': 'error debug maxed out', 'filesystem_fingerprint': last_fs
                }), encoding='utf-8')
                break

        STATE.write_text(json.dumps({
            'signature': last_signature, 'last_progress': last_progress, 'errors': consecutive_errors,
            'director_review': False, 'filesystem_fingerprint': last_fs
        }), encoding='utf-8')

    except Exception as exc:
        consecutive_errors += 1
        log('ERROR cycle_count=' + str(consecutive_errors) + ' ' + repr(exc) + ' ' + process_health())
        recovered = False
        for attempt in range(1, DEBUG_MAX + 1):
            try:
                time.sleep(min(10 * attempt, 45))
                _ = get_messages()
                dispatch(DEBUG_PROMPT)
                log('ERROR_RECOVERY_DISPATCHED attempt=' + str(attempt) + ' awaiting_real_evidence')
                consecutive_errors = 0
                recovered = True
                break
            except Exception as debug_exc:
                log('DEBUG_FAIL attempt=' + str(attempt) + ' ' + repr(debug_exc))
        if not recovered:
            log('error debug maxed out')
            STATE.write_text(json.dumps({
                'signature': last_signature, 'last_progress': last_progress, 'errors': 5,
                'fatal': 'error debug maxed out', 'filesystem_fingerprint': last_fs
            }), encoding='utf-8')
            break

    elapsed = time.time() - cycle_started
    time.sleep(max(1, CADENCE - elapsed))
