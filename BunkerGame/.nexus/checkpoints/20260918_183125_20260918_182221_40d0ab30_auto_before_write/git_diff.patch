+function haversine(a,b){const R=6371000;const dLat=(b[0]-a[0])*Math.PI/180;const dLon=(b[1]-a[1])*Math.PI/180;const sDLat=Math.sin(dLat/2);const sDLon=Math.sin(dLon/2);const val=sDLat*sDLat+Math.cos(a[0]*Math.PI/180)*Math.cos(b[0]*Math.PI/180)*sDLon*sDLon;return R*2*Math.atan2(Math.sqrt(val),Math.sqrt(1-val))}
