+function optimizeRoute(ids,locations){if(ids.length<2)return ids;const entrance=[48.265,7.721];let pool=[...ids],route=[];let minDist=Infinity,best=0;pool.forEach((id,i)=>{const d=haversine(entrance,locations[id]);if(d<minDist){minDist=d;best=i}});route.push(pool[best]);pool.splice(best,1);while(pool.length){const last=locations[route[route.length-1]];minDist=Infinity;best=0;pool.forEach((id,i)=>{const d=haversine(last,locations[id]);if(d<minDist){minDist=d;best=i}});route.push(pool[best]);pool.splice(best,1)}return route}
