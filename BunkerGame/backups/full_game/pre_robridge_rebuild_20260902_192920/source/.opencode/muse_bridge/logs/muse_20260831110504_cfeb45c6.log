        2.0\n114:                 ],\n115:                 \"Anchored\": true,\n116:                 \"CanCollide\": true,\n117:                 \"CanTouch\": false,\n118:                 \"CanQuery\": false,\n119:                 \"Material\": \"SmoothPlastic\",\n120:                 \"Color\": [\n121:                   0.22,\n122:                   0.235,\n123:                   0.23\n124:                 ],\n125:                 \"Transparency\": 1.0,\n126:                 \"CastShadow\": false,\n127:                 \"Position\": [\n128:                   0.0,\n129:                   64.0,\n130:                   -241.0\n131:                 ]\n132:               }\n133:             },\n134:             {\n135:               \"Name\": \"NorthBoundary\",\n136:               \"ClassName\": \"Part\",\n137:               \"Properties\": {\n138:                 \"Size\": [\n139:                   640.0,\n140:                   22.0,\n141:                   2.0\n142:                 ],\n143:                 \"Anchored\": true,\n144:                 \"CanCollide\": true,\n145:                 \"CanTouch\": false,\n146:                 \"CanQuery\": false,\n147:                 \"Material\": \"SmoothPlastic\",\n148:                 \"Color\": [\n149:                   0.22,\n150:                   0.235,\n151:                   0.23\n152:                 ],\n153:                 \"Transparency\": 1.0,\n154:                 \"CastShadow\": false,\n155:                 \"Position\": [\n156:                   0.0,\n157:                   64.0,\n158:                   401.0\n159:                 ]\n160:               }\n161:             }\n162:           ],\n163:           \"attributes\": {\n164:             \"InvisibleSafetyBoundary\": true\n165:           }\n166:         }\n167:       ]\n168:     },\n169:     {\n170:       \"Name\": \"Bunker\",\n171:       \"ClassName\": \"Model\",\n172:       \"Children\": [\n173:         {\n174:           \"Name\": \"Architecture\",\n17