path\": \"src/ServerStorage\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/Ori/Documents/Projects/BunkerGame/default.project.json","text":"{\n  \"name\": \"BunkerGame\",\n  \"tree\": {\n    \"$className\": \"DataModel\",\n    \"Players\": {\n      \"$properties\": {\n        \"CharacterAutoLoads\": false\n      }\n    },\n    \"Lighting\": {\n      \"$path\": \"src/Lighting\"\n    },\n    \"ReplicatedStorage\": {\n      \"$path\": \"src/ReplicatedStorage\"\n    },\n    \"ServerScriptService\": {\n      \"$path\": \"src/ServerScriptService\"\n    },\n    \"ServerStorage\": {\n      \"$path\": \"src/ServerStorage\"\n    },\n    \"StarterGui\": {\n      \"$path\": \"src/StarterGui\"\n    },\n    \"StarterPlayer\": {\n      \"StarterPlayerScripts\": {\n        \"$path\": \"src/StarterPlayer/StarterPlayerScripts\"\n      }\n    },\n    \"Workspace\": {\n      \"$properties\": {\n        \"FilteringEnabled\": true,\n        \"SignalBehavior\": \"Deferred\",\n        \"StreamingEnabled\": false\n      },\n      \"$path\": \"src/Workspace\"\n    }\n  }\n}","lineStart":1,"lineEnd":39,"totalLines":39,"truncated":false}},"title":"BunkerGame/default.project.json","time":{"start":1788174329389,"end":1788174329406}},"metadata":{"openai":{"itemId":"fc_01a0577ee5d471e1a55e402a2d2d9071"}},"id":"prt_0577ee629001GQc2YOueMV903P","sessionID":"ses_fa8815f1bffeeE6hC19uqKKiGR","messageID":"msg_0577ee060001KIwl4vmkzG1fGW"}}
