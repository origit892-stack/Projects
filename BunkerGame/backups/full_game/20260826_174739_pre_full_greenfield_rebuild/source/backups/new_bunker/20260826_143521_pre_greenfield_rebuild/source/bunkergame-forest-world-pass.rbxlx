          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">InteractionPromptController</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local InteractionPrompt = require(ReplicatedStorage.UI.Components.InteractionPrompt)

local FEEDBACK_SERIAL_ATTRIBUTE = "FeedbackSerial"
local FEEDBACK_TONE_ATTRIBUTE = "FeedbackTone"

local Controller = {}

local started = false
local activePrompt: ProximityPrompt? = nil
local activeInputType = Enum.ProximityPromptInputType.Keyboard
local holdStartedAt: number? = nil
local holdConnection: RBXScriptConnection? = nil
local touchInputBegun = false
local attributeConnections: { RBXScriptConnection } = {}
local serviceConnections: { RBXScriptConnection } = {}
local cameraConnection: RBXScriptConnection? = nil
local view = nil

local GAMEPAD_LABELS: { [Enum.KeyCode]: string } = {
    [Enum.KeyCode.ButtonA] = "A",
    [Enum.KeyCode.ButtonB] = "B",
    [Enum.KeyCode.ButtonX] = "X",
    [Enum.KeyCode.ButtonY] = "Y",
    [Enum.KeyCode.ButtonL1] = "LB",
    [Enum.KeyCode.ButtonR1] = "RB",
    [Enum.KeyCode.ButtonL2] = "LT",
    [Enum.KeyCode.ButtonR2] = "RT",
}

local function disconnectAttributeConnections()
    for _, connection in attributeConnections do
        connection:Disconnect()
    end
    table.clear(attributeConnections)
end

local function stopHoldProgress(resetProgress: boolean?)
    holdStartedAt = nil
    if holdConnection then
        holdConnection:Disconnect()
        holdConnection = nil
    end
    if resetProgress and view ~= nil then
        view:setProgress(0)
    end
end

local function promptInputTypeFromLastInput(lastInputType: Enum.UserInputType): Enum.ProximityPromptInputType
    if lastInputType == Enum.UserInputType.Touch then
        return Enum.ProximityPromptInputType.Touch
    end
    if string.find(lastInputType.Name, "Gamepad") then
        return Enum.ProximityPromptInputType.Gamepad
    end
    return Enum.ProximityPromptInputType.Keyboard
end

local function keyboardLabel(keyCode: Enum.KeyCode): string
    local ok, localized = pcall(function()
        return UserInputService:GetStringForKeyCode(keyCode)
    end)
    if ok and localized ~= "" and string.match(localized, "^[%w%s%p]+$") then
        return string.upper(localized)
    end
    return string.upper(keyCode.Name)
end

local function gamepadPresentation(keyCode: Enum.KeyCode): (string, string?)
    local ok, image = pcall(function()
        return UserInputService:GetImageForKeyCode(keyCode)
    end)
    if ok and image ~= "" then
        return GAMEPAD_LABELS[keyCode] or keyCode.Name, image
    end
    return GAMEPAD_LABELS[keyCode] or keyCode.Name, nil
end

local function inputPresentation(prompt: ProximityPrompt): (string, string?)
    if activeInputType == Enum.ProximityPromptInputType.Touch then
        return if prompt.HoldDuration > 0 then "HOLD" else "TAP", nil
    end
    if activeInputType == Enum.ProximityPromptInputType.Gamepad then
        return gamepadPresentation(prompt.GamepadKeyCode)
    end
    return keyboardLabel(prompt.KeyboardKeyCode), nil
end

local function refreshContent()
    local prompt = activePrompt
    if prompt == nil or view == nil then
        return
    end
    local label, image = inputPresentation(prompt)
    view:setContent(label, image, prompt.ActionText, prompt.ObjectText, prompt.HoldDuration > 0)
end

local function updateViewportScale()
    if view == nil then
        return
    end
    local camera = Workspace.CurrentCamera
    if camera == nil then
        return
    end
    view:setViewportScale(camera.ViewportSize.Y / 1080)
end

local function bindCamera()
    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end
    local camera = Workspace.CurrentCamera
    if camera then
        cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewportScale)
    end
    updateViewportScale()
end

local function bindPromptAttributes(prompt: ProximityPrompt)
    disconnectAttributeConnections()
    table.insert(attributeConnections, prompt:GetPropertyChangedSignal("ActionText"):Connect(refreshContent))
    table.insert(attributeConnections, prompt:GetPropertyChangedSignal("ObjectText"):Connect(refreshContent))
    table.insert(attributeConnections, prompt:GetPropertyChangedSignal("KeyboardKeyCode"):Connect(refreshContent))
    table.insert(attributeConnections, prompt:GetPropertyChangedSignal("GamepadKeyCode"):Connect(refreshContent))
    table.insert(attributeConnections, prompt:GetPropertyChangedSignal("HoldDuration"):Connect(refreshContent))
    table.insert(attributeConnections, prompt:GetAttributeChangedSignal(FEEDBACK_SERIAL_ATTRIBUTE):Connect(function()
        if activePrompt ~= prompt or view == nil then
            return
        end
        local tone = prompt:GetAttribute(FEEDBACK_TONE_ATTRIBUTE)
        if tone == "Success" or tone == "Unavailable" then
            view:showFeedback(tone)
        end
    end))
end

local function onPromptShown(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
    if prompt.Style ~= Enum.ProximityPromptStyle.Custom or view == nil then
        return
    end
    if activePrompt ~= prompt then
        if touchInputBegun and activePrompt then
            touchInputBegun = false
            activePrompt:InputHoldEnd()
        end
        stopHoldProgress(true)
        disconnectAttributeConnections()
    end
    activePrompt = prompt
    activeInputType = inputType
    holdStartedAt = nil
    bindPromptAttributes(prompt)
    refreshContent()
    view:show()
end

local function onPromptHidden(prompt: ProximityPrompt)
    if activePrompt ~= prompt or view == nil then
        return
    end
    if touchInputBegun then
        touchInputBegun = false
        prompt:InputHoldEnd()
    end
    activePrompt = nil
    stopHoldProgress(true)
    disconnectAttributeConnections()
    view:hide()
end

local function onHoldBegan(prompt: ProximityPrompt)
    if activePrompt == prompt then
        stopHoldProgress(false)
        holdStartedAt = os.clock()
        holdConnection = RunService.RenderStepped:Connect(function()
            if activePrompt ~= prompt or view == nil or holdStartedAt == nil or prompt.HoldDuration <= 0 then
                return
            end
            view:setProgress((os.clock() - holdStartedAt) / prompt.HoldDuration)
        end)
    end
end

local function onHoldEnded(prompt: ProximityPrompt)
    if activePrompt == prompt and view ~= nil then
        stopHoldProgress(true)
    end
end

local function beginTouchInput()
    local prompt = activePrompt
    if prompt == nil or activeInputType ~= Enum.ProximityPromptInputType.Touch then
        return
    end
    if touchInputBegun then
        return
    end
    touchInputBegun = true
    prompt:InputHoldBegin()
end

local function endTouchInput(promptOverride: ProximityPrompt?)
    if not touchInputBegun then
        return
    end
    local prompt = promptOverride or activePrompt
    touchInputBegun = false
    if prompt == nil then
        return
    end
    prompt:InputHoldEnd()
end

function Controller.start()
    if started then
        return
    end
    started = true

    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
    local existing = playerGui:FindFirstChild("BunkerInteractionUI")
    if existing then
        existing:Destroy()
    end
    view = InteractionPrompt.create(playerGui)
    bindCamera()

    table.insert(serviceConnections, ProximityPromptService.PromptShown:Connect(onPromptShown))
    table.insert(serviceConnections, ProximityPromptService.PromptHidden:Connect(onPromptHidden))
    table.insert(serviceConnections, ProximityPromptService.PromptButtonHoldBegan:Connect(onHoldBegan))
    table.insert(serviceConnections, ProximityPromptService.PromptButtonHoldEnded:Connect(onHoldEnded))
    table.insert(serviceConnections, UserInputService.LastInputTypeChanged:Connect(function(lastInputType)
        local nextType = promptInputTypeFromLastInput(lastInputType)
        if nextType ~= activeInputType then
            if activeInputType == Enum.ProximityPromptInputType.Touch then
                endTouchInput()
            end
            activeInputType = nextType
            refreshContent()
        end
    end))
    table.insert(serviceConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            endTouchInput()
        end
    end))
    table.insert(serviceConnections, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        bindCamera()
    end))

    table.insert(serviceConnections, view.InputButton.MouseButton1Down:Connect(beginTouchInput))
    table.insert(serviceConnections, view.InputButton.MouseButton1Up:Connect(function()
        endTouchInput()
    end))
end

function Controller.stop()
    if not started then
        return
    end
    started = false

    endTouchInput(activePrompt)
    stopHoldProgress(true)
    disconnectAttributeConnections()

    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end
    for _, connection in serviceConnections do
        connection:Disconnect()
    end
    table.clear(serviceConnections)

    activePrompt = nil
    holdStartedAt = nil
    activeInputType = Enum.ProximityPromptInputType.Keyboard
    if view ~= nil then
        view:destroy()
        view = nil
    end
end

return table.freeze(Controller)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">NotificationController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Notification = require(ReplicatedStorage.UI.Components.Notification)

local NotificationController = {
    showNotification = function(text, variant)
        local notification = Notification.create({
            Name = "Notification",
            Size = UDim2.new(0, 300, 0, 60),
            Position = UDim2.new(0.5, -150, 0.1, 0),
            AnchorPoint = Vector2.new(0.5, 0),
            Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui"),
            Text = text,
        })
        
        Notification.show(notification, text, variant)

        task.delay(4, function()
            if notification.Parent then
                Notification.destroy(notification)
            end
        end)
    end,
}
return NotificationController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tokens = require(ReplicatedStorage.UI.Tokens)
local NotificationController = require(ReplicatedStorage.UI.Controllers.NotificationController)

local UIController = {}

local function corner(parent, radius)
    local value = Instance.new("UICorner")
    value.CornerRadius = UDim.new(0, radius)
    value.Parent = parent
end

local function stroke(parent, transparency)
    local value = Instance.new("UIStroke")
    value.Color = Tokens.Color.StrokeStrong
    value.Transparency = transparency or 0.25
    value.Thickness = 1
    value.Parent = parent
end

local function label(parent, name, text, size, position, textSize, color, alignment)
    local value = Instance.new("TextLabel")
    value.Name = name
    value.BackgroundTransparency = 1
    value.Size = size
    value.Position = position
    value.Font = Enum.Font.GothamMedium
    value.Text = text
    value.TextSize = textSize
    value.TextColor3 = color
    value.TextXAlignment = alignment or Enum.TextXAlignment.Left
    value.TextYAlignment = Enum.TextYAlignment.Center
    value.Parent = parent
    return value
end

local function makeChip(parent, name, caption, initial)
    local chip = Instance.new("Frame")
    chip.Name = name
    chip.Size = UDim2.fromOffset(132, 42)
    chip.BackgroundColor3 = Tokens.Color.Surface
    chip.BackgroundTransparency = 0.08
    chip.BorderSizePixel = 0
    chip.Parent = parent
    corner(chip, 6)
    stroke(chip, 0.45)
    label(chip, "Caption", caption, UDim2.new(1, -16, 0, 15), UDim2.fromOffset(8, 4), 11, Tokens.Color.TextMuted)
    return label(chip, "Value", initial, UDim2.new(1, -16, 0, 20), UDim2.fromOffset(8, 18), 16, Tokens.Color.TextPrimary)
end

function UIController.start()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    if playerGui:FindFirstChild("BunkerHUD") then return end

    local hud = Instance.new("ScreenGui")
    hud.Name = "BunkerHUD"
    hud.ResetOnSpawn = false
    hud.IgnoreGuiInset = true
    hud.DisplayOrder = Tokens.Layer.HUD
    hud.Parent = playerGui

    local vignette = Instance.new("Frame")
    vignette.Name = "TopReadout"
    vignette.Size = UDim2.fromOffset(448, 66)
    vignette.Position = UDim2.new(0.5, -224, 0, 18)
    vignette.BackgroundColor3 = Tokens.Color.Background
    vignette.BackgroundTransparency = 0.14
    vignette.BorderSizePixel = 0
    vignette.Parent = hud
    corner(vignette, 8)
    stroke(vignette, 0.3)

    label(vignette, "Eyebrow", "BUNKER // SURVIVAL STATUS", UDim2.new(1, -24, 0, 18), UDim2.fromOffset(12, 7), 11, Tokens.Color.TextMuted, Enum.TextXAlignment.Center)
    local status = label(vignette, "Status", "SYSTEMS NOMINAL", UDim2.new(1, -24, 0, 28), UDim2.fromOffset(12, 27), 17, Tokens.Color.TextPrimary, Enum.TextXAlignment.Center)

    local cyclePanel = Instance.new("Frame")
    cyclePanel.Name = "CycleReadout"
    cyclePanel.Size = UDim2.fromOffset(190, 54)
    cyclePanel.Position = UDim2.fromOffset(18, 18)
    cyclePanel.BackgroundColor3 = Tokens.Color.Background
    cyclePanel.BackgroundTransparency = 0.14
    cyclePanel.BorderSizePixel = 0
    cyclePanel.Parent = hud
    corner(cyclePanel, 8)
    stroke(cyclePanel, 0.3)
    local cycleCaption = label(cyclePanel, "Cycle", "DAY 01 // DAY", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 5), 12, Tokens.Color.TextSecondary)
    local cycleTime = label(cyclePanel, "Time", "01:00", UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 25), 17, Tokens.Color.TextPrimary)

    local left = Instance.new("Frame")
    left.Name = "SurvivalReadout"
    left.Size = UDim2.fromOffset(150, 104)
    left.Position = UDim2.new(0, 18, 1, -122)
    left.BackgroundTransparency = 1
    left.Parent = hud
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = left
    local healthValue = makeChip(left, "HealthChip", "VITALS", "100 / 100")
    local woodValue = makeChip(left, "WoodChip", "WOOD", tostring(player:GetAttribute("CanonicalWoodQuantity") or 0))

    local right = Instance.new("Frame")
    right.Name = "ResourceReadout"
    right.Size = UDim2.fromOffset(150, 104)
    right.Position = UDim2.new(1, -168, 1, -122)
    right.BackgroundTransparency = 1
    right.Parent = hud
    local rightLayout = layout:Clone()
    rightLayout.Parent = right
    local function hasAxeTool()
        local function scan(root)
            if not root then return false end
            for _, child in root:GetChildren() do
                if child:IsA("Tool") and child:GetAttribute("ToolDefinitionId") == "axe_basic" then
                    return true
                end
            end
            return false
        end
        return scan(player.Character) or scan(player:FindFirstChildOfClass("Backpack"))
    end
    local function axeReady()
        local quantity = player:GetAttribute("CanonicalAxeQuantity")
        if type(quantity) == "number" and quantity > 0 then return true end
        return hasAxeTool()
    end
    local axeValue = makeChip(right, "AxeChip", "FIELD AXE", axeReady() and "READY" or "MISSING")

    local function bindCharacter(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        local function updateHealth()
            healthValue.Text = string.format("%d / %d", math.max(0, math.floor(humanoid.Health + 0.5)), math.floor(humanoid.MaxHealth + 0.5))
            healthValue.TextColor3 = humanoid.Health / math.max(humanoid.MaxHealth, 1) <= 0.3 and Tokens.Color.Danger or Tokens.Color.TextPrimary
        end
        updateHealth()
        humanoid.HealthChanged:Connect(updateHealth)
        humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(updateHealth)
    end
    if player.Character then task.defer(bindCharacter, player.Character) end
    player.CharacterAdded:Connect(bindCharacter)

    player:GetAttributeChangedSignal("CanonicalWoodQuantity"):Connect(function()
        woodValue.Text = tostring(player:GetAttribute("CanonicalWoodQuantity") or 0)
    end)
    local watchedTools = setmetatable({}, { __mode = "k" })
    local function updateAxeReadout()
        axeValue.Text = axeReady() and "READY" or "MISSING"
    end
    local function watchTool(child)
        if not child:IsA("Tool") or watchedTools[child] then return end
        watchedTools[child] = true
        child:GetAttributeChangedSignal("ToolDefinitionId"):Connect(updateAxeReadout)
        updateAxeReadout()
    end
    player:GetAttributeChangedSignal("CanonicalAxeQuantity"):Connect(updateAxeReadout)
    local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
    if backpack then
        for _, child in backpack:GetChildren() do watchTool(child) end
        backpack.ChildAdded:Connect(function(child) watchTool(child); updateAxeReadout() end)
        backpack.ChildRemoved:Connect(updateAxeReadout)
    end
    local function bindAxeCharacter(character)
        for _, child in character:GetChildren() do watchTool(child) end
        character.ChildAdded:Connect(function(child) watchTool(child); updateAxeReadout() end)
        character.ChildRemoved:Connect(updateAxeReadout)
        task.defer(updateAxeReadout)
    end
    player.CharacterAdded:Connect(bindAxeCharacter)
    if player.Character then bindAxeCharacter(player.Character) end
    task.defer(updateAxeReadout)
    task.delay(0.5, updateAxeReadout)
    task.delay(1.5, updateAxeReadout)
    task.delay(3, updateAxeReadout)

    local gamePhase = ReplicatedStorage:FindFirstChild("GamePhase")
    local dayCount = ReplicatedStorage:FindFirstChild("DayCount")
    local timeLeft = ReplicatedStorage:FindFirstChild("TimeLeft")
    local function updateCycle()
        local phase = gamePhase and gamePhase.Value or "--"
        local day = dayCount and dayCount.Value or 0
        local seconds = math.max(0, math.floor((timeLeft and timeLeft.Value or 0) + 0.5))
        cycleCaption.Text = string.format("DAY %02d // %s", day, string.upper(tostring(phase)))
        cycleTime.Text = string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
        cycleCaption.TextColor3 = phase == "Night" and Tokens.Color.Warning or Tokens.Color.TextSecondary
    end
    updateCycle()
    if gamePhase then gamePhase.Changed:Connect(updateCycle) end
    if dayCount then dayCount.Changed:Connect(updateCycle) end
    if timeLeft then timeLeft.Changed:Connect(updateCycle) end

    local farmPanel = Instance.new("Frame")
    farmPanel.Name = "FarmingReadout"
    farmPanel.Size = UDim2.fromOffset(432, 52)
    farmPanel.Position = UDim2.new(0.5, -216, 1, -70)
    farmPanel.BackgroundColor3 = Tokens.Color.Background
    farmPanel.BackgroundTransparency = 0.12
    farmPanel.BorderSizePixel = 0
    farmPanel.Parent = hud
    corner(farmPanel, 8)
    stroke(farmPanel, 0.35)

    local farmLayout = Instance.new("UIListLayout")
    farmLayout.FillDirection = Enum.FillDirection.Horizontal
    farmLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    farmLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    farmLayout.Padding = UDim.new(0, 8)
    farmLayout.Parent = farmPanel

    local creditsValue = makeChip(farmPanel, "CreditsChip", "CREDITS", "0")
    local seedsValue = makeChip(farmPanel, "SeedsChip", "SEEDS", "0")
    local cropsValue = makeChip(farmPanel, "CropsChip", "CROPS", "0")

    for _, chip in farmPanel:GetChildren() do
        if chip:IsA("Frame") then chip.Size = UDim2.fromOffset(128, 42) end
    end

    local progressFrame = Instance.new("Frame")
    progressFrame.Name = "ProcessorProgress"
    progressFrame.Size = UDim2.fromOffset(280, 8)
    progressFrame.Position = UDim2.new(0.5, -140, 1, -82)
    progressFrame.BackgroundColor3 = Tokens.Color.SurfaceRaised
    progressFrame.BorderSizePixel = 0
    progressFrame.Visible = false
    progressFrame.Parent = hud
    corner(progressFrame, 4)
    local progressFill = Instance.new("Frame")
    progressFill.Name = "Fill"
    progressFill.Size = UDim2.fromScale(0, 1)
    progressFill.BackgroundColor3 = Tokens.Color.Machine
    progressFill.BorderSizePixel = 0
    progressFill.Parent = progressFrame
    corner(progressFill, 4)

    local farmingRemotes = ReplicatedStorage:FindFirstChild("FarmingRemotes")
    if farmingRemotes then
        local updateUI = farmingRemotes:FindFirstChild("UpdateUI")
        if updateUI then
            updateUI.OnClientEvent:Connect(function(credits, seeds, crops, food)
                creditsValue.Text = tostring(credits)
                seedsValue.Text = tostring(seeds)
                cropsValue.Text = tostring(crops)
                status.Text = string.format("FOOD %d   //   SHELTER SYSTEMS ONLINE", food)
            end)
        end
        local updateProgress = farmingRemotes:FindFirstChild("UpdateProgress")
        if updateProgress then
            updateProgress.OnClientEvent:Connect(function(pct)
                local normalized = math.clamp((tonumber(pct) or 0) / 100, 0, 1)
                progressFill.Size = UDim2.fromScale(normalized, 1)
                progressFrame.Visible = normalized > 0
            end)
        end
        local notify = farmingRemotes:FindFirstChild("Notify")
        if notify then
            notify.OnClientEvent:Connect(function(text)
                NotificationController.showNotification(text, "Info")
            end)
        end
    end
end

return UIController
]]></string>
          </Properties>
        </Item>
      </Item>
