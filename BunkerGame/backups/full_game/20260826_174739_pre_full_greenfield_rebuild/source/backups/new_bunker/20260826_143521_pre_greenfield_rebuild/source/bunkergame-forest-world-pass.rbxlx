  <Item class="StarterGui" referent="226">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">4</token>
    </Properties>
    <Item class="ScreenGui" referent="227">
      <Properties>
        <string name="Name">FarmingUI</string>
