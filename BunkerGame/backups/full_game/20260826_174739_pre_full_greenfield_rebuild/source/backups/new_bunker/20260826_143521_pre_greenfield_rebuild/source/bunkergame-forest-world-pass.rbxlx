        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ItemDefinitions</string>
            <string name="Source"><![CDATA[-- Canonical item-definition registry boundary.
-- FND-002 intentionally defines no gameplay item catalog content.
local definitions = {
    wood = table.freeze({
        Id = "wood",
        Category = "Resource",
        StackPolicy = table.freeze({ Stackable = true }),
        Tags = table.freeze({ "Resource", "Wood" }),
        Presentation = table.freeze({ DisplayName = "Wood" }),
    }),
    axe_basic = table.freeze({
        Id = "axe_basic",
        Category = "Tool",
        StackPolicy = table.freeze({ Stackable = false, MaxQuantity = 1 }),
        Tags = table.freeze({ "Tool", "Axe" }),
        Presentation = table.freeze({ DisplayName = "Axe" }),
        GameplayRef = "axe_basic",
    }),
}

local ItemDefinitions = {}

function ItemDefinitions.get(itemId: string)
    return definitions[itemId]
end

function ItemDefinitions.isDefined(itemId: string): boolean
    return definitions[itemId] ~= nil
end

function ItemDefinitions.getAll()
    return table.clone(definitions)
end

return table.freeze(ItemDefinitions)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ItemTypes</string>
            <string name="Source"><![CDATA[export type ItemId = string

export type StackPolicy = {
    Stackable: boolean,
    MaxQuantity: number?,
}

export type ItemPresentation = {
    DisplayName: string?,
    Icon: string?,
}

export type ItemDefinition = {
    Id: ItemId,
    Category: string,
    StackPolicy: StackPolicy,
    Tags: { string }?,
    Presentation: ItemPresentation?,
    GameplayRef: string?,
}

export type InventoryEntryView = {
    ItemId: ItemId,
    Quantity: number,
}

export type InventoryView = {
    Entries: { InventoryEntryView },
}

export type InventoryResult = {
    Success: boolean,
    Code: string,
    ItemId: ItemId?,
    Quantity: number?,
}

return table.freeze({})
]]></string>
          </Properties>
        </Item>
      </Item>
