      <Item class="LocalScript" referent="228">
        <Properties>
          <string name="Name">FarmingClient</string>
          <string name="Source"><![CDATA[--[[
	FarmingUI.client.lua  (StarterGui > FarmingUI)
	Client-side UI: credits display, inventory hotbar, floating notifications,
	and processor progress bar.
--]]

-- ── Services ────────────────────────────────────────────────────────────────
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ── Remote Events ───────────────────────────────────────────────────────────
local remotes = ReplicatedStorage:WaitForChild("FarmingRemotes")
local UpdateUI      = remotes:WaitForChild("UpdateUI")
local NotifyRE      = remotes:WaitForChild("Notify")
local UpdateProgress = remotes:WaitForChild("UpdateProgress")

-- ── UI Creation ─────────────────────────────────────────────────────────────
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FarmingUI"
screenGui.IgnoreGuiInset = true
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 15
screenGui.Parent = playerGui

-- Helper: create a simple label with common defaults
local function makeLabel(name, text, pos, size, color): TextLabel
	local lbl = Instance.new("TextLabel")
	lbl.Name = name
	lbl.Text = text
	lbl.Position = pos
	lbl.Size = size
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	lbl.TextScaled = true
	lbl.Font = Enum.Font.GothamBold
	lbl.TextXAlignment = Enum.TextXAlignment.Center
	lbl.Parent = screenGui
	return lbl
end

-- ── Top-Right: Credits ─────────────────────────────────────────────────────
local creditsLabel = makeLabel(
	"CreditsLabel",
	"Credits: 0",
	UDim2.new(1, -200, 0, 10),
	UDim2.new(0, 190, 0, 36),
	Color3.fromRGB(255, 215, 0)   -- gold
)
creditsLabel.TextXAlignment = Enum.TextXAlignment.Right

-- ── Bottom-Centre: Inventory Hotbar ─────────────────────────────────────────
local hotbar = Instance.new("Frame")
hotbar.Name = "Hotbar"
hotbar.Size = UDim2.new(0, 420, 0, 44)
hotbar.Position = UDim2.new(0.5, -210, 1, -60)
hotbar.BackgroundTransparency = 0.4
hotbar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
hotbar.BorderSizePixel = 0
hotbar.Parent = screenGui

-- UI corner rounding (modern look)
local uic = Instance.new("UICorner", hotbar)
uic.CornerRadius = UDim.new(0, 8)

local seedLbl, cropLbl, foodLbl

do
	local function makeSlot(name, text, xOff)
		local f = Instance.new("Frame")
		f.Name = name
		f.Size = UDim2.new(0, 130, 1, 0)
		f.Position = UDim2.new(0, xOff, 0, 0)
		f.BackgroundTransparency = 1
		f.Parent = hotbar

		local l = Instance.new("TextLabel")
		l.Name = "Count"
		l.Text = text
		l.Size = UDim2.new(1, 0, 1, 0)
		l.BackgroundTransparency = 1
		l.TextColor3 = Color3.fromRGB(255, 255, 255)
		l.TextScaled = true
		l.Font = Enum.Font.GothamBold
		l.Parent = f
		return l
	end

	seedLbl = makeSlot("SeedsSlot",   "[Seeds: 5]",       0)
	cropLbl = makeSlot("CropsSlot",   "[Crops: 0]",       140)
	foodLbl = makeSlot("FoodSlot",    "[Food Items: 0]",  280)
end

-- Colour-coded icons for each slot
seedLbl.TextColor3 = Color3.fromRGB(76, 175, 80)    -- green
cropLbl.TextColor3 = Color3.fromRGB(255, 193, 7)     -- amber
foodLbl.TextColor3 = Color3.fromRGB(33, 150, 243)    -- blue

-- ── Floating Notification System ───────────────────────────────────────────
-- A pool of reusable labels to avoid alloc spam.
local NOTIF_POOL_SIZE = 5
local notifPool: { TextLabel } = {}
local notifIdx = 0

for _ = 1, NOTIF_POOL_SIZE do
	local lbl = makeLabel(
		"Notif",
		"",
		UDim2.new(0.5, -150, 0.4, 0),
		UDim2.new(0, 300, 0, 36),
		Color3.fromRGB(255, 255, 255)
	)
	lbl.TextTransparency = 1
	lbl.Visible = false
	table.insert(notifPool, lbl)
end

local function spawnNotification(text: string)
	notifIdx = notifIdx % NOTIF_POOL_SIZE + 1
	local lbl = notifPool[notifIdx]

	-- Stop any running tween on this label
	local existing = lbl:FindFirstChild("NotifTween")
	if existing then
		existing:Cancel()
		existing:Destroy()
	end

	lbl.Text = text
	lbl.TextTransparency = 0
	lbl.Position = UDim2.new(0.5, -150, 0.4, 0)
	lbl.Visible = true

	-- Float upward + fade out over 1.6 s
	local tween = TweenService:Create(lbl,
		TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Position         = UDim2.new(0.5, -150, 0.35, 0),
			TextTransparency = 1,
		}
	)
	tween:Play()

	-- Tag so we can cancel it later
	tween.Name = "NotifTween"
	tween.Parent = lbl

	tween.Completed:Connect(function()
		lbl.Visible = false
	end)
end

-- ── Processor Progress Billboard ────────────────────────────────────────────
local progressFill: Frame

-- Processor is created by the server at runtime, so wait for it.
local processorModel = Workspace:WaitForChild("FoodProcessor", 30)
if processorModel then
	local dummy = processorModel:WaitForChild("ProgressDummy", 30)
	if dummy then
		local bb = Instance.new("BillboardGui")
		bb.Name = "ProcessBar"
		bb.Size = UDim2.new(0, 200, 0, 36)
		bb.StudsOffset = Vector3.new(0, 2, 0)
		bb.AlwaysOnTop = true
		bb.Parent = dummy

		local bg = Instance.new("Frame")
		bg.Name = "BG"
		bg.Size = UDim2.new(1, 0, 1, 0)
		bg.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		bg.BorderSizePixel = 0
		bg.Parent = bb

		local uic2 = Instance.new("UICorner", bg)
		uic2.CornerRadius = UDim.new(0, 6)

		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.Size = UDim2.new(0, 0, 1, 0)
		fill.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
		fill.BorderSizePixel = 0
		fill.Parent = bg

		local uic3 = Instance.new("UICorner", fill)
		uic3.CornerRadius = UDim.new(0, 6)

		local pctLabel = Instance.new("TextLabel")
		pctLabel.Name = "Pct"
		pctLabel.Size = UDim2.new(1, 0, 1, 0)
		pctLabel.BackgroundTransparency = 1
		pctLabel.Text = "0%"
		pctLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		pctLabel.TextScaled = true
		pctLabel.Font = Enum.Font.GothamBold
		pctLabel.Parent = bb

		progressFill = fill
	end
end

-- ── Remote Event Handlers ───────────────────────────────────────────────────

UpdateUI.OnClientEvent:Connect(function(credits, seeds, crops, food)
	creditsLabel.Text = string.format("Credits: %d", credits)
	seedLbl.Text = string.format("[Seeds: %d]", seeds)
	cropLbl.Text = string.format("[Crops: %d]", crops)
	foodLbl.Text = string.format("[Food Items: %d]", food)
end)

NotifyRE.OnClientEvent:Connect(spawnNotification)

UpdateProgress.OnClientEvent:Connect(function(pct: number)
	if not progressFill then return end
	progressFill.Size = UDim2.new(pct / 100, 0, 1, 0)
	local pctLabel = progressFill.Parent:FindFirstChild("Pct")
	if pctLabel then
		pctLabel.Text = string.format("%.0f%%", pct)
	end
end)

-- ── Periodic cleanup for orphaned tweens (RunService heartbeat) ────────────
RunService.Heartbeat:Connect(function()
	for _, lbl in notifPool do
		if lbl.Visible and lbl.TextTransparency >= 0.99 then
			lbl.Visible = false
		end
	end
end)

print("[FarmingUI] Loaded")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="229">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">128</float>
      <bool name="CharacterUseJumpPower">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="230">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
    </Item>
    <Item class="StarterPlayerScripts" referent="231">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="232">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[print("Hello world, from client!")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="233">
        <Properties>
          <string name="Name">HarvestController</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local NotificationController = require(ReplicatedStorage.UI.Controllers.NotificationController)
local remotes = ReplicatedStorage:WaitForChild("SurvivalRemotes")
local harvestIntent = remotes:WaitForChild("HarvestIntent")
local feedback = remotes:WaitForChild("HarvestFeedback")

local activeToolConnection = nil
local equippedTool = nil

local function eachResourceNode(callback)
    local grove = Workspace:FindFirstChild("PrototypeHarvestGrove")
    if grove then
        for _, node in grove:GetChildren() do if node:IsA("Model") then callback(node) end end
    end
    local forest = Workspace:FindFirstChild("ForestResourceRegion")
    if forest then
        for _, node in forest:GetChildren() do if node:IsA("Model") then callback(node) end end
    end
end

local function findNode(nodeId)
    local found = nil
    eachResourceNode(function(node)
        if not found and node:GetAttribute("ResourceNodeId") == nodeId then found = node end
    end)
    return found
end

local function nearestTarget()
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    local best, bestDistance = nil, math.huge
    eachResourceNode(function(node)
        if node:GetAttribute("HarvestState") == "Active" then
            local anchor = node:FindFirstChild("HitAnchor")
            if anchor and anchor:IsA("BasePart") then
                local distance = (rootPart.Position - anchor.Position).Magnitude
                if distance < bestDistance and distance <= 12 then best, bestDistance = node, distance end
            end
        end
    end)
    return best
end

local function pulseAxe(tool)
    local handle = tool:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return end
    local original = tool.Grip
    tool.Grip = original * CFrame.Angles(0, 0, math.rad(-34))
    task.delay(0.11, function()
        if tool.Parent then tool.Grip = original * CFrame.Angles(0, 0, math.rad(14)) end
    end)
    task.delay(0.22, function()
        if tool.Parent then tool.Grip = original end
    end)
end

local function bindTool(tool)
    if tool:GetAttribute("ToolDefinitionId") ~= "axe_basic" then return end
    if activeToolConnection then activeToolConnection:Disconnect() end
    equippedTool = tool
    activeToolConnection = tool.Activated:Connect(function()
        pulseAxe(tool)
        local target = nearestTarget()
        if target then harvestIntent:FireServer(target:GetAttribute("ResourceNodeId")) end
    end)
end

local function watchCharacter(character)
    character.ChildAdded:Connect(function(child) if child:IsA("Tool") then bindTool(child) end end)
    character.ChildRemoved:Connect(function(child)
        if child == equippedTool then
            equippedTool = nil
            if activeToolConnection then activeToolConnection:Disconnect(); activeToolConnection = nil end
        end
    end)
    for _, child in character:GetChildren() do if child:IsA("Tool") then bindTool(child) end end
end

if player.Character then watchCharacter(player.Character) end
player.CharacterAdded:Connect(watchCharacter)

feedback.OnClientEvent:Connect(function(kind, payload)
    if kind == "Reward" and payload and payload.ItemId == "wood" then
        NotificationController.showNotification(string.format("+%d Wood  •  %d total", payload.Quantity or 0, payload.Total or 0), "Success")
    elseif kind == "Hit" and payload then
        local node = findNode(payload.NodeId)
        if node then node:SetAttribute("ClientHitPulse", (node:GetAttribute("ClientHitPulse") or 0) + 1) end
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="234">
        <Properties>
          <string name="Name">HarvestVisualController</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local remotes = ReplicatedStorage:WaitForChild("SurvivalRemotes")
local feedback = remotes:WaitForChild("HarvestFeedback")
local attached = setmetatable({}, { __mode = "k" })
local basePivots = setmetatable({}, { __mode = "k" })
local progressGuis = setmetatable({}, { __mode = "k" })

script:SetAttribute("HarvestVisualBooted", true)
script:SetAttribute("HarvestVisualAttachCount", 0)
script:SetAttribute("HarvestVisualAttachAttemptCount", 0)
script:SetAttribute("HarvestVisualAttachRootCount", 0)
script:SetAttribute("HarvestVisualLastRoot", "")
script:SetAttribute("HarvestVisualLastFailure", "")

local function findNode(nodeId)
    for _, rootName in { "PrototypeHarvestGrove", "ForestResourceRegion" } do
        local root = Workspace:FindFirstChild(rootName)
        if root then
            for _, node in root:GetChildren() do
                if node:IsA("Model") and node:GetAttribute("ResourceNodeId") == nodeId then return node end
            end
        end
    end
    return nil
end

local function makeProgress(node)
    local anchor = node:FindFirstChild("HitAnchor")
    if not anchor or not anchor:IsA("BasePart") then return false end
    local ok, failure = pcall(function()
    local gui = Instance.new("BillboardGui")
    gui.Name = "HarvestProgressUI"
    gui.Size = UDim2.fromOffset(112, 18)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 3.8, 0)
    gui.AlwaysOnTop = true
    gui.Enabled = false
    gui.Adornee = anchor
    gui.Parent = anchor
    local back = Instance.new("Frame")
    back.Size = UDim2.fromScale(1, 1)
    back.BackgroundColor3 = Color3.fromRGB(22, 25, 22)
    back.BackgroundTransparency = 0.18
    back.BorderSizePixel = 0
    back.Parent = gui
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = Color3.fromRGB(169, 139, 76)
    fill.BorderSizePixel = 0
    fill.Parent = back
    progressGuis[node] = gui
    end)
    if not ok then
        script:SetAttribute("HarvestVisualLastFailure", tostring(failure))
        return false
    end
    script:SetAttribute("HarvestVisualAttachCount", (script:GetAttribute("HarvestVisualAttachCount") or 0) + 1)
    return true
end

local function updateProgress(node)
    local gui = progressGuis[node]
    if not gui then return end
    local progress = node:GetAttribute("HarvestProgress") or 0
    local state = node:GetAttribute("HarvestState")
    gui.Enabled = state == "Active" and progress > 0
    local fill = gui:FindFirstChild("Fill", true)
    if fill and fill:IsA("Frame") then
        TweenService:Create(fill, TweenInfo.new(0.12), { Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1) }):Play()
    end
end

local function emitChips(node)
    local anchor = node:FindFirstChild("HitAnchor")
    if not anchor or not anchor:IsA("BasePart") then return end
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "HarvestWoodChips"
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(Color3.fromRGB(135, 91, 52), Color3.fromRGB(82, 53, 31))
    emitter.Lifetime = NumberRange.new(0.18, 0.34)
    emitter.Speed = NumberRange.new(4, 8)
    emitter.SpreadAngle = Vector2.new(38, 38)
    emitter.Rate = 0
    emitter.RotSpeed = NumberRange.new(-160, 160)
    emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0.03) })
    emitter.Parent = anchor
    emitter:Emit(7)
    task.delay(0.5, function() if emitter.Parent then emitter:Destroy() end end)
end

local function playImpact(node)
    local anchor = node:FindFirstChild("HitAnchor")
    if not anchor or not anchor:IsA("BasePart") then return end
    local sound = Instance.new("Sound")
    sound.Name = "HarvestWoodImpact"
    sound.SoundId = "rbxassetid://157167203"
    sound.Volume = 0.18
    sound.PlaybackSpeed = 1.32
    sound.RollOffMinDistance = 4
    sound.RollOffMaxDistance = 34
    sound.Parent = anchor
    sound:Play()
    task.delay(2, function() if sound.Parent then sound:Destroy() end end)
end

local function hitReaction(node)
    local base = basePivots[node] or node:GetPivot()
    basePivots[node] = base
    node:PivotTo(base * CFrame.Angles(0, 0, math.rad(2.2)))
    task.delay(0.07, function()
        if node.Parent and node:GetAttribute("HarvestState") == "Active" then node:PivotTo(base * CFrame.Angles(0, 0, math.rad(-1.2))) end
    end)
    task.delay(0.14, function()
        if node.Parent and node:GetAttribute("HarvestState") == "Active" then node:PivotTo(base) end
    end)
    emitChips(node)
    playImpact(node)
    updateProgress(node)
end

local function fall(node)
    local base = basePivots[node] or node:GetPivot()
    basePivots[node] = base
    local value = Instance.new("CFrameValue")
    value.Value = node:GetPivot()
    local connection = value:GetPropertyChangedSignal("Value"):Connect(function()
        if node.Parent then node:PivotTo(value.Value) end
    end)
    local target = base * CFrame.new(0, -1.2, 0) * CFrame.Angles(0, 0, math.rad(78))
    local tween = TweenService:Create(value, TweenInfo.new(0.72, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = target })
    tween:Play()
    tween.Completed:Connect(function() connection:Disconnect(); value:Destroy() end)
    local gui = progressGuis[node]
    if gui then gui.Enabled = false end
end

local function respawn(node)
    local base = basePivots[node]
    if not base then return end
    node:PivotTo(base * CFrame.new(0, -2.4, 0))
    for _, descendant in node:GetDescendants() do
        if descendant:IsA("BasePart") and descendant.Name ~= "HitAnchor" then descendant.Transparency = 0.45 end
    end
    local value = Instance.new("CFrameValue")
    value.Value = node:GetPivot()
    local connection = value:GetPropertyChangedSignal("Value"):Connect(function() if node.Parent then node:PivotTo(value.Value) end end)
    local tween = TweenService:Create(value, TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = base })
    tween:Play()
    tween.Completed:Connect(function()
        connection:Disconnect(); value:Destroy()
        for _, descendant in node:GetDescendants() do
            if descendant:IsA("BasePart") and descendant.Name ~= "HitAnchor" then descendant.Transparency = 0 end
        end
        updateProgress(node)
    end)
end

local function attach(node)
    script:SetAttribute("HarvestVisualAttachAttemptCount", (script:GetAttribute("HarvestVisualAttachAttemptCount") or 0) + 1)
    if attached[node] then return end

    local function tryAttach()
        if not node.Parent or attached[node] then return end
        local anchor = node:FindFirstChild("HitAnchor")
        if not anchor or not anchor:IsA("BasePart") then return end
        if not makeProgress(node) then return end
        attached[node] = true
        basePivots[node] = node:GetPivot()
        node:GetAttributeChangedSignal("HarvestProgress"):Connect(function() updateProgress(node) end)
    end

    tryAttach()
    if attached[node] then return end

    local connection
    connection = node.ChildAdded:Connect(function(child)
        if child.Name ~= "HitAnchor" then return end
        tryAttach()
        if attached[node] and connection then
            connection:Disconnect()
            connection = nil
        end
    end)

    task.delay(3, function()
        if not attached[node] then tryAttach() end
        if attached[node] and connection then
            connection:Disconnect()
            connection = nil
        end
    end)
end
local function attachRoot(root)
    script:SetAttribute("HarvestVisualAttachRootCount", (script:GetAttribute("HarvestVisualAttachRootCount") or 0) + 1)
    script:SetAttribute("HarvestVisualLastRoot", root:GetFullName())
    for _, node in root:GetChildren() do if node:IsA("Model") then attach(node) end end
    root.ChildAdded:Connect(function(node) if node:IsA("Model") then task.defer(attach, node) end end)
end

for _, rootName in { "PrototypeHarvestGrove", "ForestResourceRegion" } do
    local root = Workspace:FindFirstChild(rootName)
    if root then attachRoot(root) end
end
Workspace.ChildAdded:Connect(function(child)
    if child.Name == "ForestResourceRegion" then attachRoot(child) end
end)

feedback.OnClientEvent:Connect(function(kind, payload)
    if not payload or not payload.NodeId then return end
    local node = findNode(payload.NodeId)
    if not node then return end
    attach(node)
    if kind == "Hit" then hitReaction(node)
    elseif kind == "Depleted" then fall(node)
    elseif kind == "Respawn" then respawn(node) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="235">
        <Properties>
          <string name="Name">UIBootstrap</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = ReplicatedStorage:WaitForChild("UI")

-- The contextual interaction layer starts independently so an unrelated HUD
-- dependency cannot suppress nearby-world interaction affordances.
local InteractionPromptController = require(UI.Controllers.InteractionPromptController)
InteractionPromptController.start()

-- Phase 2 migration: the approved UI architecture now owns the primary HUD.
-- FarmingUI remains temporarily active only for farming-specific hotbar/progress
-- until its state bindings are fully migrated, but the unified BunkerHUD starts now.
local UIController = require(UI.Controllers.UIController)
UIController.start()
]]></string>
        </Properties>
      </Item>
