              <string name="ScriptGuid">{d5f375cb-6e24-444a-b800-6934d51e31b5}</string>
              <string name="Source">local prompt = script.Parent
local model = prompt.Parent -- עכשיו זה ימצא את WolfNPC
local humanoid = model:WaitForChild("Humanoid")
local root = model:WaitForChild("HumanoidRootPart")

-- הגדרות
local isInteracting = false
local WALK_SPEED = 8
local PET_REWARD = 2
local COOLDOWN = 30

-----------------------------------------------------------
-- 1. תיקון פיזיקה (Anti-Sink &amp; Anti-Fall)
-----------------------------------------------------------
local function setupPhysics()
	model.PrimaryPart = root
	root.CanCollide = true

	-- הגדרה קריטית למניעת שקיעה
	humanoid.HipHeight = 2.8 

	for _, part in pairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false 
			if part ~= root then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
				part.CanCollide = false 
			end
		end
	end

	-- מונע מהם ליפול על הצד (כמו שקרה לך עם הנמר)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
end

-----------------------------------------------------------
-- 2. לוגיקת עצירה מוחלטת (Double Anchor)
-----------------------------------------------------------
prompt.Triggered:Connect(function(player)
	if isInteracting then return end
	isInteracting = true
	prompt.Enabled = false 

	-- עצירה פיזית מוחלטת
	humanoid.WalkSpeed = 0
	humanoid.PlatformStand = true -- מכבה את ה-AI של התנועה
	root.Anchored = true -- נועל פיזית באוויר/על הרצפה
	root.AssemblyLinearVelocity = Vector3.new(0,0,0) -- עוצר תנע

	-- מתן קרדיטים
	if player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Credits") then
		player.leaderstats.Credits.Value += PET_REWARD
	end

	task.wait(5) -- זמן הליטוף

	-- שחרור
	root.Anchored = false 
	humanoid.PlatformStand = false 
	humanoid.WalkSpeed = WALK_SPEED
	isInteracting = false

	task.wait(COOLDOWN - 5)
	prompt.Enabled = true
end)

-----------------------------------------------------------
-- 3. תנועה אקראית חסינה
-----------------------------------------------------------
task.spawn(function()
	local startPos = root.Position
	while true do
		if isInteracting then 
			task.wait(0.5)
		else
			local target = startPos + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
			humanoid:MoveTo(target)

			local moveFinished = false
			local connection
			connection = humanoid.MoveToFinished:Connect(function() moveFinished = true end)

			-- לולאת המתנה שבודקת גם את ה-isInteracting
			repeat task.wait(0.1) until moveFinished or isInteracting
			if connection then connection:Disconnect() end

			if not isInteracting then
				task.wait(math.random(3, 8))
			end
		end
	end
end)

setupPhysics()</string>
