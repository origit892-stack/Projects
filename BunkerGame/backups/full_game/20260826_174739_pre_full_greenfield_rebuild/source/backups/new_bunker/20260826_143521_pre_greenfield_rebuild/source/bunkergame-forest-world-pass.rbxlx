        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CombatTypes</string>
            <string name="Source"><![CDATA[export type LifecycleState = "Alive" | "Downed" | "Dead"

export type HealthView = {
    Current: number,
    Maximum: number,
}

export type PlayerCombatView = {
    LifecycleState: LifecycleState,
    Health: HealthView?,
}

export type DamageRequest = {
    SourceActor: Instance?,
    TargetActor: Instance,
    DamageSourceId: string,
    AuthoritativeDamagePayload: {
        Amount: number,
    },
    Context: any?,
}

export type DamageResult = {
    Success: boolean,
    Code: string,
    AppliedAmount: number,
    ResultingLifecycleState: LifecycleState?,
}

export type WeaponId = string

export type WeaponDefinition = {
    Id: WeaponId,
    ItemId: string?,
}

return table.freeze({})
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">WeaponDefinitions</string>
            <string name="Source"><![CDATA[-- Canonical weapon-definition boundary. No weapon content is authorized in FND-003.
local definitions = {}

local WeaponDefinitions = {}

function WeaponDefinitions.get(weaponId: string)
    return definitions[weaponId]
end

function WeaponDefinitions.isDefined(weaponId: string): boolean
    return definitions[weaponId] ~= nil
end

function WeaponDefinitions.getAll()
    return table.clone(definitions)
end

return table.freeze(WeaponDefinitions)
]]></string>
          </Properties>
        </Item>
      </Item>
