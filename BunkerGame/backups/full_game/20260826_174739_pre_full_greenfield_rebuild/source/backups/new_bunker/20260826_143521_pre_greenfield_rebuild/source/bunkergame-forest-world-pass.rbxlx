              <string name="Source">local prompt = script.Parent
local model = prompt.Parent
local humanoid = model:WaitForChild("Humanoid")
local root = model:WaitForChild("HumanoidRootPart")

-- הגדרות משחק
local isInteracting = false
local WALK_SPEED = 8
local PET_REWARD = 2
local COOLDOWN = 30

-----------------------------------------------------------
-- 1. אתחול פיזיקה (הגנה מפני שקיעה)
-----------------------------------------------------------
local function setupPhysics()
	model.PrimaryPart = root
	root.CanCollide = true
	humanoid.HipHeight = 2.8 -- הגובה שסידרנו

	for _, part in pairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false 
			if part ~= root then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
				part.CanCollide = false
			end
		end
	end
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
end

-----------------------------------------------------------
-- 2. לוגיקת עצירה מוחלטת (הקפאת AI)
-----------------------------------------------------------
prompt.Triggered:Connect(function(player)
	if isInteracting then return end
	isInteracting = true -- חסימת לולאת התנועה מיד

	-- שלב א': ביטול AI ופיזיקה
	prompt.Enabled = false
	humanoid.WalkSpeed = 0
	humanoid.PlatformStand = true -- מכבה את ה-AI של התנועה
	root.Anchored = true -- נועל את המיקום ב-100%
	root.AssemblyLinearVelocity = Vector3.new(0,0,0) -- מאפס מומנטום

	-- מתן קרדיטים
	if player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Credits") then
		player.leaderstats.Credits.Value += PET_REWARD
	end

	task.wait(5) -- זמן הליטוף

	-- שלב ב': שחרור וחזרה לחיים
	root.Anchored = false
	humanoid.PlatformStand = false
	humanoid.WalkSpeed = WALK_SPEED
	isInteracting = false -- מאפשר ללולאת התנועה לחזור לעבוד

	task.wait(COOLDOWN - 5)
	prompt.Enabled = true
end)

-----------------------------------------------------------
-- 3. תנועה אקראית עם בדיקת "מנעול"
-----------------------------------------------------------
task.spawn(function()
	local startPos = root.Position
	while true do
		-- אם אנחנו באמצע אינטראקציה, ה-AI "ישן"
		if isInteracting then 
			task.wait(0.5)
		else
			local target = startPos + Vector3.new(math.random(-25, 25), 0, math.random(-25, 25))
			humanoid:MoveTo(target)

			-- לולאת המתנה שבודקת בכל רגע אם לחצו על הפרומפט
			local arrived = false
			local connection
			connection = humanoid.MoveToFinished:Connect(function() arrived = true end)

			repeat 
				task.wait(0.1) 
			until arrived or isInteracting -- אם התחילה אינטראקציה, הלולאה נשברת מיד

			if connection then connection:Disconnect() end

			if not isInteracting then
				task.wait(math.random(3, 8))
			end
		end
	end
end)

setupPhysics()</string>
