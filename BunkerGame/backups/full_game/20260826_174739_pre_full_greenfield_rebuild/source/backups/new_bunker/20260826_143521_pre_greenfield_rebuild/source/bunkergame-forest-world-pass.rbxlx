    </Properties>
    <Item class="Script" referent="41">
      <Properties>
        <string name="Name">BunkerAtmosphereController</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Selected practical lights fail irregularly without rapid strobing or blackout.
-- Fixture names are a deliberate contract with new_bunker/lighting_materials.py
-- and new_bunker/power_room.py. One scheduler owns every state transition.

local Workspace = game:GetService("Workspace")

local UPDATE_INTERVAL = 0.1
local STARTUP_DELAY = 1
local random = Random.new()

type FixtureContract = {
	name: string,
	minimumScale: number,
	restMinimum: number,
	restMaximum: number,
}

type EmitterState = {
	part: BasePart,
	transparency: number,
}

type LightState = {
	light: Light,
	brightness: number,
}

type FixtureState = {
	contract: FixtureContract,
	emitters: { EmitterState },
	lights: { LightState },
	phase: string,
	pulsesRemaining: number,
	nextChange: number,
}

local contracts: { FixtureContract } = {
	{ name = "WakeSideFluorescent", minimumScale = 0.48, restMinimum = 6.0, restMaximum = 13.0 },
	{ name = "MiddleAgedBay", minimumScale = 0.42, restMinimum = 7.0, restMaximum = 15.0 },
	{ name = "StorageAisleLight", minimumScale = 0.46, restMinimum = 8.0, restMaximum = 17.0 },
	{ name = "WorkshopEntryFill", minimumScale = 0.52, restMinimum = 9.0, restMaximum = 18.0 },
	{ name = "ServiceConnectorPractical", minimumScale = 0.44, restMinimum = 10.0, restMaximum = 20.0 },
	{ name = "FarmExitEmergencyPractical", minimumScale = 0.56, restMinimum = 11.0, restMaximum = 22.0 },
}

local function setFixtureScale(state: FixtureState, scale: number)
	for _, lightState in state.lights do
		if lightState.light.Parent then
			lightState.light.Brightness = lightState.brightness * scale
		end
	end

	for _, emitterState in state.emitters do
		if emitterState.part.Parent then
			local addedHaze = (1 - scale) * 0.32
			emitterState.part.Transparency = math.min(0.38, emitterState.transparency + addedHaze)
		end
	end
end

local function collectFixture(modelInstance: Model, contract: FixtureContract): FixtureState?
	local emitters: { EmitterState } = {}
	local lights: { LightState } = {}

	for _, descendant in modelInstance:GetDescendants() do
		if descendant:IsA("Light") then
			table.insert(lights, { light = descendant, brightness = descendant.Brightness })
		elseif descendant:IsA("BasePart") and (
			descendant.Name == "TubeA"
			or descendant.Name == "UtilityLens"
			or descendant.Name == "CageGlow"
		) then
			table.insert(emitters, { part = descendant, transparency = descendant.Transparency })
		end
	end

	if #lights == 0 then
		warn(string.format("[BunkerAtmosphereController] %s has no local light", modelInstance:GetFullName()))
		return nil
	end

	local now = os.clock()
	return {
		contract = contract,
		emitters = emitters,
		lights = lights,
		phase = "rest",
		pulsesRemaining = 0,
		nextChange = now + random:NextNumber(contract.restMinimum, contract.restMaximum),
	}
end

task.wait(STARTUP_DELAY)

local rebuild = Workspace:WaitForChild("Rebuild", 30)
local bunker = rebuild and rebuild:WaitForChild("NewBunker", 30)
if not bunker then
	warn("[BunkerAtmosphereController] NewBunker was not found; selected flicker is disabled")
	return
end

local fixtures: { FixtureState } = {}
for _, contract in contracts do
	local instance = bunker:FindFirstChild(contract.name, true)
	if instance and instance:IsA("Model") then
		local state = collectFixture(instance, contract)
		if state then
			table.insert(fixtures, state)
		end
	else
		warn(string.format("[BunkerAtmosphereController] Fixture %s was not found", contract.name))
	end
end

while #fixtures > 0 do
	local now = os.clock()
	for _, state in fixtures do
		if now < state.nextChange then
			continue
		end

		if state.phase == "rest" then
			state.pulsesRemaining = random:NextInteger(1, 3)
			local powerMarker = bunker:FindFirstChild("FutureBunkerLightsControlMarker", true)
			local gridPowered = powerMarker and powerMarker:GetAttribute("PowerOn") == true
			local minimumScale = gridPowered and math.max(0.72, state.contract.minimumScale) or state.contract.minimumScale
			if not gridPowered and random:NextNumber() < 0.12 then
				minimumScale = math.max(0.18, minimumScale * 0.55)
			end
			local scale = random:NextNumber(minimumScale, gridPowered and 0.92 or 0.78)
			setFixtureScale(state, scale)
			state.phase = "dim"
			state.nextChange = now + random:NextNumber(0.12, 0.31)
		elseif state.phase == "dim" then
			setFixtureScale(state, 1)
			state.pulsesRemaining -= 1
			if state.pulsesRemaining > 0 then
				state.phase = "gap"
				state.nextChange = now + random:NextNumber(0.22, 0.38)
			else
				state.phase = "rest"
				state.nextChange = now
					+ random:NextNumber(state.contract.restMinimum, state.contract.restMaximum)
			end
		else
			local powerMarker = bunker:FindFirstChild("FutureBunkerLightsControlMarker", true)
			local gridPowered = powerMarker and powerMarker:GetAttribute("PowerOn") == true
			local minimumScale = gridPowered and math.max(0.72, state.contract.minimumScale) or state.contract.minimumScale
			local scale = random:NextNumber(minimumScale, gridPowered and 0.92 or 0.78)
			setFixtureScale(state, scale)
			state.phase = "dim"
			state.nextChange = now + random:NextNumber(0.16, 0.28)
		end
	end

	task.wait(UPDATE_INTERVAL)
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="42">
      <Properties>
        <string name="Name">BunkerEntranceContract</string>
        <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local BunkerEntranceContract = {}

local TARGET_ATTRIBUTE = "BunkerEntranceTarget"

local function findNewBunker()
    local rebuild = Workspace:FindFirstChild("Rebuild")
    return rebuild and rebuild:FindFirstChild("NewBunker")
end

function BunkerEntranceContract.GetTarget()
    local tagged = Workspace:GetDescendants()
    for _, instance in tagged do
        if instance:IsA("BasePart") and instance:GetAttribute(TARGET_ATTRIBUTE) == true then
            return instance
        end
    end

    local bunker = findNewBunker()
    local markers = bunker and bunker:FindFirstChild("CompositionMarkers")
    local marker = markers and markers:FindFirstChild("FutureBunkerDoorMarker")
    if marker and marker:IsA("BasePart") then
        return marker
    end

    return nil
end

function BunkerEntranceContract.GetTargetPosition()
    local target = BunkerEntranceContract.GetTarget()
    return target and target.Position or nil
end

return table.freeze(BunkerEntranceContract)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="43">
      <Properties>
        <string name="Name">BunkerEnvironmentalVFX</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Restrained environmental VFX for the approved NewBunker art pass.
-- Runtime-only emitters attach to existing authored visual anchors. They do not
-- create collision, gameplay state, interaction affordances, or new geometry.

local Workspace = game:GetService("Workspace")

local STARTUP_DELAY = 1

type VFXContract = {
	anchorName: string,
	emitterName: string,
	texture: string,
	rate: number,
	lifetime: NumberRange,
	speed: NumberRange,
	acceleration: Vector3,
	drag: number,
	spreadAngle: Vector2,
	rotation: NumberRange,
	rotSpeed: NumberRange,
	size: NumberSequence,
	transparency: NumberSequence,
	color: ColorSequence,
	lightInfluence: number,
	orientation: Enum.ParticleOrientation,
}

local contracts: { VFXContract } = {
	{
		anchorName = "WaterDripPool",
		emitterName = "SparseWaterDrip",
		texture = "rbxasset://textures/particles/sparkles_main.dds",
		rate = 1.2,
		lifetime = NumberRange.new(0.32, 0.48),
		speed = NumberRange.new(0.8, 1.35),
		acceleration = Vector3.new(0, -9, 0),
		drag = 0,
		spreadAngle = Vector2.new(5, 5),
		rotation = NumberRange.new(0, 180),
		rotSpeed = NumberRange.new(-20, 20),
		size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.055),
			NumberSequenceKeypoint.new(0.7, 0.035),
			NumberSequenceKeypoint.new(1, 0),
		}),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.36),
			NumberSequenceKeypoint.new(0.75, 0.48),
			NumberSequenceKeypoint.new(1, 1),
		}),
		color = ColorSequence.new(Color3.fromRGB(150, 184, 190), Color3.fromRGB(94, 125, 130)),
		lightInfluence = 0.82,
		orientation = Enum.ParticleOrientation.FacingCamera,
	},
	{
		anchorName = "ServiceWetSheen",
		emitterName = "LowServiceMist",
		texture = "rbxasset://textures/particles/smoke_main.dds",
		rate = 0.55,
		lifetime = NumberRange.new(2.4, 4.0),
		speed = NumberRange.new(0.08, 0.22),
		acceleration = Vector3.new(0, 0.16, 0),
		drag = 0.9,
		spreadAngle = Vector2.new(18, 18),
		rotation = NumberRange.new(0, 360),
		rotSpeed = NumberRange.new(-4, 4),
		size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(0.55, 0.82),
			NumberSequenceKeypoint.new(1, 1.1),
		}),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.93),
			NumberSequenceKeypoint.new(0.35, 0.88),
			NumberSequenceKeypoint.new(1, 1),
		}),
		color = ColorSequence.new(Color3.fromRGB(104, 121, 117), Color3.fromRGB(74, 88, 86)),
		lightInfluence = 0.9,
		orientation = Enum.ParticleOrientation.FacingCamera,
	},
	{
		anchorName = "ExhaustCap",
		emitterName = "GeneratorExhaustHaze",
		texture = "rbxasset://textures/particles/smoke_main.dds",
		rate = 0.75,
		lifetime = NumberRange.new(1.5, 2.5),
		speed = NumberRange.new(0.28, 0.52),
		acceleration = Vector3.new(0, 0.42, 0),
		drag = 0.65,
		spreadAngle = Vector2.new(10, 10),
		rotation = NumberRange.new(0, 360),
		rotSpeed = NumberRange.new(-7, 7),
		size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.32),
			NumberSequenceKeypoint.new(0.6, 0.72),
			NumberSequenceKeypoint.new(1, 1.0),
		}),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.88),
			NumberSequenceKeypoint.new(0.45, 0.84),
			NumberSequenceKeypoint.new(1, 1),
		}),
		color = ColorSequence.new(Color3.fromRGB(76, 78, 74), Color3.fromRGB(52, 57, 55)),
		lightInfluence = 0.78,
		orientation = Enum.ParticleOrientation.FacingCamera,
	},
}

local function attachEmitter(anchor: BasePart, contract: VFXContract)
	if anchor:FindFirstChild(contract.emitterName) then
		return
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = contract.emitterName .. "Anchor"
	attachment.Parent = anchor

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = contract.emitterName
	emitter.Texture = contract.texture
	emitter.Rate = contract.rate
	emitter.Lifetime = contract.lifetime
	emitter.Speed = contract.speed
	emitter.Acceleration = contract.acceleration
	emitter.Drag = contract.drag
	emitter.SpreadAngle = contract.spreadAngle
	emitter.Rotation = contract.rotation
	emitter.RotSpeed = contract.rotSpeed
	emitter.Size = contract.size
	emitter.Transparency = contract.transparency
	emitter.Color = contract.color
	emitter.LightInfluence = contract.lightInfluence
	emitter.Orientation = contract.orientation
	emitter.LockedToPart = false
	emitter.Enabled = true
	emitter.Parent = attachment
end

task.wait(STARTUP_DELAY)

local rebuild = Workspace:WaitForChild("Rebuild", 30)
local bunker = rebuild and rebuild:WaitForChild("NewBunker", 30)
if not bunker then
	warn("[BunkerEnvironmentalVFX] NewBunker was not found; environmental VFX are disabled")
	return
end

for _, contract in contracts do
	local found = 0
	for _, descendant in bunker:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == contract.anchorName then
			attachEmitter(descendant, contract)
			found += 1
		end
	end

	if found == 0 then
		warn(string.format("[BunkerEnvironmentalVFX] Anchor %s was not found", contract.anchorName))
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="44">
      <Properties>
        <string name="Name">BunkerInteractionService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local interactionFolder = ReplicatedStorage:WaitForChild("Interaction")
local InteractionTypes = require(interactionFolder:WaitForChild("InteractionTypes"))
local GameplayInteractionTypes = require(interactionFolder:WaitForChild("GameplayInteractionTypes"))
local LegacyBunkerGameplayService = require(game.ServerScriptService:WaitForChild("LegacyBunkerGameplayService"))

local bunkerAudioCatalog = nil
local audioFolder = ReplicatedStorage:WaitForChild("Audio", 10)
local audioCatalogModule = audioFolder and audioFolder:WaitForChild("BunkerAudioCatalog", 10)
if audioCatalogModule and audioCatalogModule:IsA("ModuleScript") then
	local ok, result = pcall(require, audioCatalogModule)
	if ok and type(result) == "table" then
		bunkerAudioCatalog = result
	else
		warn("[BunkerInteractionService] BunkerAudioCatalog could not be loaded; hinge cues are disabled")
	end
else
	warn("[BunkerInteractionService] BunkerAudioCatalog was not mapped in time; hinge cues are disabled")
end

local INTERACTION_COOLDOWN = 0.35
local DISTANCE_TOLERANCE = 2
local OPEN_TWEEN = TweenInfo.new(0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local AUDIO_LIFETIME = 4
local audioRandom = Random.new()

local busyModels: { [Model]: boolean } = setmetatable({}, { __mode = "k" })
local closedCFrames: { [Model]: CFrame } = setmetatable({}, { __mode = "k" })
local lastInteractionAt: { [Player]: number } = setmetatable({}, { __mode = "k" })

local supportedPromptNames = {
	[InteractionTypes.PromptNames.Crate] = true,
	[InteractionTypes.PromptNames.Locker] = true,
	[InteractionTypes.PromptNames.OfflineControl] = true,
	[InteractionTypes.PromptNames.InspectStation] = true,
}

local rebuild = Workspace:WaitForChild("Rebuild", 30)
local bunker = rebuild and rebuild:WaitForChild("NewBunker", 30)
local interactiveRoot = bunker and bunker:WaitForChild(InteractionTypes.InteractiveRootName, 30)

if not interactiveRoot then
	warn("[BunkerInteractionService] NewBunker.InteractiveProps was not found; prototype interactions are disabled")
	return
end

local function findPropModel(prompt: ProximityPrompt): Model?
	local current = prompt.Parent
	while current and current ~= interactiveRoot do
		if current:IsA("Model") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function getPromptWorldPosition(prompt: ProximityPrompt, propModel: Model): Vector3
	local parent = prompt.Parent
	if parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	if parent and parent:IsA("BasePart") then
		return parent.Position
	end
	return propModel:GetPivot().Position
end

local function validatePlayerDistance(player: Player, prompt: ProximityPrompt, propModel: Model): boolean
	if player.Parent ~= Players or not prompt.Enabled then
		return false
	end
	if not prompt:IsDescendantOf(interactiveRoot) or not propModel:IsDescendantOf(interactiveRoot) then
		return false
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local allowedDistance = prompt.MaxActivationDistance + DISTANCE_TOLERANCE
	return (rootPart.Position - getPromptWorldPosition(prompt, propModel)).Magnitude <= allowedDistance
end

local function passCooldown(player: Player): boolean
	local now = os.clock()
	local previous = lastInteractionAt[player]
	if previous and now - previous < INTERACTION_COOLDOWN then
		return false
	end
	lastInteractionAt[player] = now
	return true
end

local function emitFeedback(prompt: ProximityPrompt, tone: string)
	prompt:SetAttribute("FeedbackTone", tone)
	local serial = prompt:GetAttribute("FeedbackSerial")
	prompt:SetAttribute("FeedbackSerial", (if type(serial) == "number" then serial else 0) + 1)
end

local function playHingeCue(movingPart: BasePart, isOpen: boolean)
	if not bunkerAudioCatalog then
		return
	end

	local cue = if isOpen then bunkerAudioCatalog.MetalHingeOpen else bunkerAudioCatalog.MetalHingeClose
	if type(cue) ~= "table" or type(cue.soundId) ~= "string" or cue.soundId == "" then
		return
	end

	local minimumSpeed = math.clamp(tonumber(cue.playbackSpeedMinimum) or 1, 0.5, 2)
	local maximumSpeed = math.clamp(tonumber(cue.playbackSpeedMaximum) or minimumSpeed, minimumSpeed, 2)
	local minimumDistance = math.clamp(tonumber(cue.rollOffMinDistance) or 4, 1, 50)
	local maximumDistance = math.max(
		minimumDistance + 1,
		math.clamp(tonumber(cue.rollOffMaxDistance) or 28, 2, 200)
	)

	local sound = Instance.new("Sound")
	sound.Name = "PrototypeHingeCue"
	sound.SoundId = cue.soundId
	sound.Volume = math.clamp(tonumber(cue.volume) or 0.2, 0, 1)
	sound.PlaybackSpeed = audioRandom:NextNumber(minimumSpeed, maximumSpeed)
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = minimumDistance
	sound.RollOffMaxDistance = maximumDistance
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.Parent = movingPart

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, AUDIO_LIFETIME)
	sound:Play()
end

local function getAnimatedParts(propModel: Model): (BasePart?, BasePart?)
	local movingPart = propModel:FindFirstChild(InteractionTypes.PartNames.MovingPart, true)
	local openPose = propModel:FindFirstChild(InteractionTypes.PartNames.OpenPose, true)

	if not movingPart or not movingPart:IsA("BasePart") then
		return nil, nil
	end
	if not openPose or not openPose:IsA("BasePart") then
		return nil, nil
	end
	return movingPart, openPose
end

local function togglePrototypeProp(prompt: ProximityPrompt, propModel: Model)
	if busyModels[propModel] then
		return
	end

	local movingPart, openPose = getAnimatedParts(propModel)
	if not movingPart or not openPose then
		warn(string.format(
			"[BunkerInteractionService] %s requires BaseParts named MovingPart and OpenPose",
			propModel:GetFullName()
		))
		emitFeedback(prompt, InteractionTypes.FeedbackTone.Unavailable)
		return
	end

	busyModels[propModel] = true
	closedCFrames[propModel] = closedCFrames[propModel] or movingPart.CFrame

	local wasOpen = propModel:GetAttribute("PrototypeOpen") == true
	local targetCFrame = if wasOpen then closedCFrames[propModel] else openPose.CFrame

	local ok, err = xpcall(function()
		local tween = TweenService:Create(movingPart, OPEN_TWEEN, { CFrame = targetCFrame })
		tween:Play()
		tween.Completed:Wait()

		if prompt:IsDescendantOf(interactiveRoot) and propModel:IsDescendantOf(interactiveRoot) then
			local isOpen = not wasOpen
			propModel:SetAttribute("PrototypeOpen", isOpen)
			prompt.ActionText = if isOpen then "CLOSE" else "OPEN"
			emitFeedback(prompt, InteractionTypes.FeedbackTone.Success)
			playHingeCue(movingPart, isOpen)
		end
	end, debug.traceback)

	busyModels[propModel] = nil
	if not ok then
		warn(string.format("[BunkerInteractionService] Failed to animate %s: %s", propModel:GetFullName(), err))
		if prompt:IsDescendantOf(interactiveRoot) then
			emitFeedback(prompt, InteractionTypes.FeedbackTone.Unavailable)
		end
	end
end

local function inspectOfflineControl(prompt: ProximityPrompt)
	emitFeedback(prompt, InteractionTypes.FeedbackTone.Unavailable)
end

local prototypeHandlers = {
	[InteractionTypes.PromptNames.Crate] = function(context)
		togglePrototypeProp(context.Prompt, context.ResolvedTarget)
		return { Success = true, Code = GameplayInteractionTypes.ResultCode.Ok }
	end,
	[InteractionTypes.PromptNames.Locker] = function(context)
		togglePrototypeProp(context.Prompt, context.ResolvedTarget)
		return { Success = true, Code = GameplayInteractionTypes.ResultCode.Ok }
	end,
	[InteractionTypes.PromptNames.OfflineControl] = function(context)
		inspectOfflineControl(context.Prompt)
		return { Success = false, Code = GameplayInteractionTypes.ResultCode.Unavailable }
	end,
	[InteractionTypes.PromptNames.InspectStation] = function(context)
		inspectOfflineControl(context.Prompt)
		return { Success = false, Code = GameplayInteractionTypes.ResultCode.Unavailable }
	end,
}

local function dispatchGameplayInteraction(context)
	if type(context.GameplayTargetId) == "string" and context.GameplayTargetId ~= "" then
		local gameplayResult = LegacyBunkerGameplayService.TryInteract(context.Player, context.GameplayTargetId)
		emitFeedback(context.Prompt, gameplayResult.Success and InteractionTypes.FeedbackTone.Success or InteractionTypes.FeedbackTone.Unavailable)
		context.Prompt:SetAttribute("GameplayResultCode", gameplayResult.Code)
		context.Prompt:SetAttribute("GameplayResultSerial", (context.Prompt:GetAttribute("GameplayResultSerial") or 0) + 1)
		return gameplayResult
	end

	local handler = prototypeHandlers[context.InteractionKind]
	if not handler then
		return { Success = false, Code = GameplayInteractionTypes.ResultCode.NoHandler }
	end
	return handler(context)
end

local function handlePromptTriggered(prompt: ProximityPrompt, player: Player)
	if not supportedPromptNames[prompt.Name] or not prompt:IsDescendantOf(interactiveRoot) then
		return
	end

	local propModel = findPropModel(prompt)
	if not propModel then
		return
	end

	if not validatePlayerDistance(player, prompt, propModel) or not passCooldown(player) then
		return
	end

	dispatchGameplayInteraction({
		Player = player,
		InteractionKind = prompt.Name,
		ResolvedTarget = propModel,
		GameplayTargetId = propModel:GetAttribute("GameplayTargetId"),
		Prompt = prompt,
	})
end

local active = true
local serviceConnections: { RBXScriptConnection } = {}

local function teardown()
	if not active then
		return
	end
	active = false
	for _, connection in serviceConnections do
		connection:Disconnect()
	end
	table.clear(serviceConnections)
end

table.insert(serviceConnections, ProximityPromptService.PromptTriggered:Connect(function(
	prompt: ProximityPrompt,
	player: Player
)
	if active then
		handlePromptTriggered(prompt, player)
	end
end))

table.insert(serviceConnections, Players.PlayerRemoving:Connect(function(player: Player)
	lastInteractionAt[player] = nil
end))

table.insert(serviceConnections, interactiveRoot.AncestryChanged:Connect(function()
	if not interactiveRoot:IsDescendantOf(Workspace) then
		teardown()
	end
end))
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="45">
      <Properties>
        <string name="Name">BunkerPowerService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local LIGHT_DURATION = 60
local isPowerOn = false

local function getBunker()
    local rebuild = Workspace:FindFirstChild("Rebuild")
    return rebuild and rebuild:FindFirstChild("NewBunker")
end

local function getControlMarker()
    local bunker = getBunker()
    local markers = bunker and bunker:FindFirstChild("CompositionMarkers")
    local marker = markers and markers:FindFirstChild("FutureBunkerLightsControlMarker")
    return marker and marker:IsA("BasePart") and marker or nil
end

local function setBunkerLights(enabled)
    local bunker = getBunker()
    local lighting = bunker and bunker:FindFirstChild("Lighting")
    if not lighting then return 0 end

    local changed = 0
    for _, descendant in lighting:GetDescendants() do
        if descendant:IsA("Light") then
            descendant.Enabled = enabled
            changed += 1
        end
    end
    return changed
end

local marker = getControlMarker()
if not marker then
    warn("[BunkerPowerService] NewBunker power-control marker missing")
    return
end

marker:SetAttribute("BunkerPowerControl", true)
marker:SetAttribute("PowerOn", false)
marker:SetAttribute("PowerDurationSeconds", LIGHT_DURATION)

local prompt = marker:FindFirstChildOfClass("ProximityPrompt")
if not prompt then
    prompt = Instance.new("ProximityPrompt")
    prompt.Name = "BunkerPowerPrompt"
    prompt.ActionText = "RESTORE POWER"
    prompt.ObjectText = "BUNKER GRID - 1 BATTERY"
    prompt.HoldDuration = 0.65
    prompt.MaxActivationDistance = 7
    prompt.RequiresLineOfSight = false
    prompt.Parent = marker
end

local function setPromptEnabled(enabled)
    prompt.Enabled = enabled
end

setBunkerLights(false)

prompt.Triggered:Connect(function(player)
    if isPowerOn then return end

    local leaderstats = player:FindFirstChild("leaderstats")
    local batteries = leaderstats and leaderstats:FindFirstChild("Batteries")
    if not batteries or batteries.Value <= 0 then
        marker:SetAttribute("LastPowerResult", "BATTERY_REQUIRED")
        return
    end

    batteries.Value -= 1
    isPowerOn = true
    setPromptEnabled(false)
    marker:SetAttribute("PowerOn", true)
    marker:SetAttribute("LastPowerResult", "POWER_ON")
    marker:SetAttribute("PowerCycleSerial", (marker:GetAttribute("PowerCycleSerial") or 0) + 1)
    setBunkerLights(true)

    task.delay(LIGHT_DURATION, function()
        if not marker.Parent then return end
        setBunkerLights(false)
        isPowerOn = false
        marker:SetAttribute("PowerOn", false)
        marker:SetAttribute("LastPowerResult", "POWER_OUTAGE")
        setPromptEnabled(true)
    end)
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="46">
      <Properties>
        <string name="Name">Foundation</string>
      </Properties>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Combat</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CombatStateService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local CombatStateService = {}

local lifecycleByPlayer: { [Player]: string } = {}

local function getHumanoid(player: Player): Humanoid?
    local character = player.Character
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function inferLifecycle(player: Player): string
    local explicit = lifecycleByPlayer[player]
    if explicit == "Downed" or explicit == "Dead" then
        return explicit
    end
    local humanoid = getHumanoid(player)
    if humanoid and humanoid.Health <= 0 then
        return "Dead"
    end
    return "Alive"
end

function CombatStateService.GetView(player: Player)
    local humanoid = getHumanoid(player)
    local healthView = nil
    if humanoid then
        healthView = table.freeze({
            Current = humanoid.Health,
            Maximum = humanoid.MaxHealth,
        })
    end
    return table.freeze({
        LifecycleState = inferLifecycle(player),
        Health = healthView,
    })
end

function CombatStateService.SetLifecycleState(player: Player, lifecycleState: string)
    if player.Parent ~= Players then
        return table.freeze({ Success = false, Code = "PLAYER_NOT_ACTIVE" })
    end
    if lifecycleState ~= "Alive" and lifecycleState ~= "Downed" and lifecycleState ~= "Dead" then
        return table.freeze({ Success = false, Code = "INVALID_LIFECYCLE_STATE" })
    end
    lifecycleByPlayer[player] = lifecycleState
    return table.freeze({ Success = true, Code = "OK" })
end

function CombatStateService.ApplyHealthDamage(player: Player, amount: number)
    if player.Parent ~= Players then
        return table.freeze({ Success = false, Code = "PLAYER_NOT_ACTIVE", AppliedAmount = 0 })
    end
    if amount ~= amount or amount <= 0 or amount == math.huge then
        return table.freeze({ Success = false, Code = "INVALID_DAMAGE", AppliedAmount = 0 })
    end
    local humanoid = getHumanoid(player)
    if not humanoid or humanoid.Health <= 0 then
        return table.freeze({ Success = false, Code = "TARGET_NOT_DAMAGEABLE", AppliedAmount = 0 })
    end
    local before = humanoid.Health
    humanoid:TakeDamage(amount)
    local applied = math.max(0, before - humanoid.Health)
    if humanoid.Health <= 0 then
        lifecycleByPlayer[player] = "Dead"
    end
    return table.freeze({
        Success = true,
        Code = "OK",
        AppliedAmount = applied,
        ResultingLifecycleState = inferLifecycle(player),
    })
end

local function resetPlayer(player: Player)
    lifecycleByPlayer[player] = "Alive"
end

for _, player in Players:GetPlayers() do
    resetPlayer(player)
    player.CharacterAdded:Connect(function()
        resetPlayer(player)
    end)
end

Players.PlayerAdded:Connect(function(player)
    resetPlayer(player)
    player.CharacterAdded:Connect(function()
        resetPlayer(player)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    lifecycleByPlayer[player] = nil
end)

return table.freeze(CombatStateService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local CombatStateService = require(script.Parent.CombatStateService)

local DamageService = {}

local function failure(code: string)
    return table.freeze({
        Success = false,
        Code = code,
        AppliedAmount = 0,
    })
end

function DamageService.Apply(request)
    if type(request) ~= "table" then
        return failure("INVALID_REQUEST")
    end
    if type(request.DamageSourceId) ~= "string" or request.DamageSourceId == "" then
        return failure("INVALID_DAMAGE_SOURCE")
    end
    local payload = request.AuthoritativeDamagePayload
    if type(payload) ~= "table" or type(payload.Amount) ~= "number" then
        return failure("INVALID_DAMAGE_PAYLOAD")
    end

    local targetActor = request.TargetActor
    if typeof(targetActor) ~= "Instance" then
        return failure("INVALID_TARGET")
    end

    local targetPlayer = Players:GetPlayerFromCharacter(targetActor)
    if not targetPlayer then
        return failure("UNSUPPORTED_TARGET")
    end

    -- This is an internal server-domain API. A future client weapon protocol must
    -- resolve trusted damage server-side before constructing this request.
    return CombatStateService.ApplyHealthDamage(targetPlayer, payload.Amount)
end

return table.freeze(DamageService)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Inventory</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemDefinitions = require(ReplicatedStorage.Shared.Inventory.ItemDefinitions)

local InventoryService = {}

local inventories: { [Player]: { [string]: number } } = {}

local function result(success: boolean, code: string, itemId: string?, quantity: number?)
    return table.freeze({
        Success = success,
        Code = code,
        ItemId = itemId,
        Quantity = quantity,
    })
end

local function validQuantity(quantity: number): boolean
    return quantity == quantity and quantity > 0 and quantity < math.huge and quantity % 1 == 0
end

local function getState(player: Player): { [string]: number }?
    return inventories[player]
end

local function validate(player: Player, itemId: string, quantity: number)
    if player.Parent ~= Players then
        return result(false, "PLAYER_NOT_ACTIVE", itemId)
    end
    if type(itemId) ~= "string" or itemId == "" then
        return result(false, "INVALID_ITEM_ID")
    end
    if not ItemDefinitions.isDefined(itemId) then
        return result(false, "UNKNOWN_ITEM", itemId)
    end
    if not validQuantity(quantity) then
        return result(false, "INVALID_QUANTITY", itemId)
    end
    if not getState(player) then
        return result(false, "INVENTORY_NOT_READY", itemId)
    end
    return nil
end

function InventoryService.GetQuantity(player: Player, itemId: string): number
    local state = getState(player)
    if not state then
        return 0
    end
    return state[itemId] or 0
end

function InventoryService.CanAdd(player: Player, itemId: string, quantity: number)
    local failure = validate(player, itemId, quantity)
    if failure then
        return failure
    end
    return result(true, "OK", itemId, quantity)
end

function InventoryService.Add(player: Player, itemId: string, quantity: number, _context: any?)
    local allowed = InventoryService.CanAdd(player, itemId, quantity)
    if not allowed.Success then
        return allowed
    end
    local state = getState(player) :: { [string]: number }
    state[itemId] = (state[itemId] or 0) + quantity
    return result(true, "OK", itemId, state[itemId])
end

function InventoryService.CanRemove(player: Player, itemId: string, quantity: number)
    local failure = validate(player, itemId, quantity)
    if failure then
        return failure
    end
    if InventoryService.GetQuantity(player, itemId) < quantity then
        return result(false, "INSUFFICIENT_QUANTITY", itemId, InventoryService.GetQuantity(player, itemId))
    end
    return result(true, "OK", itemId, quantity)
end

function InventoryService.Remove(player: Player, itemId: string, quantity: number, _context: any?)
    local allowed = InventoryService.CanRemove(player, itemId, quantity)
    if not allowed.Success then
        return allowed
    end
    local state = getState(player) :: { [string]: number }
    state[itemId] -= quantity
    if state[itemId] == 0 then
        state[itemId] = nil
    end
    return result(true, "OK", itemId, state[itemId] or 0)
end

function InventoryService.GetSnapshot(player: Player)
    local state = getState(player)
    local entries = {}
    if state then
        for itemId, quantity in state do
            table.insert(entries, table.freeze({ ItemId = itemId, Quantity = quantity }))
        end
        table.sort(entries, function(a, b)
            return a.ItemId < b.ItemId
        end)
    end
    return table.freeze({ Entries = table.freeze(entries) })
end

local function initializePlayer(player: Player)
    if inventories[player] == nil then
        inventories[player] = {}
    end
end

for _, player in Players:GetPlayers() do
    initializePlayer(player)
end

Players.PlayerAdded:Connect(initializePlayer)
Players.PlayerRemoving:Connect(function(player)
    inventories[player] = nil
end)

return table.freeze(InventoryService)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="52">
        <Properties>
          <string name="Name">Session</string>
        </Properties>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">SessionContextService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local SessionContextService = {}

local membership: { [Player]: boolean } = {}

local function isEligible(player: Player): boolean
    return player.Parent == Players and membership[player] == true
end

local function addPlayer(player: Player)
    membership[player] = true
end

local function removePlayer(player: Player)
    membership[player] = nil
end

for _, player in Players:GetPlayers() do
    addPlayer(player)
end

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(removePlayer)

function SessionContextService.IsActivePlayer(player: Player): boolean
    return isEligible(player)
end

function SessionContextService.GetActivePlayersSnapshot(): { Player }
    local snapshot = {}
    for player in membership do
        if isEligible(player) then
            table.insert(snapshot, player)
        end
    end
    table.sort(snapshot, function(a, b)
        return a.UserId < b.UserId
    end)
    return snapshot
end

function SessionContextService.GetActivePlayerCount(): number
    local count = 0
    for player in membership do
        if isEligible(player) then
            count += 1
        end
    end
    return count
end

function SessionContextService.GetPlayerSessionState(player: Player)
    return table.freeze({
        UserId = player.UserId,
        Active = isEligible(player),
    })
end

function SessionContextService.GetSnapshot()
    local players = {}
    for _, player in SessionContextService.GetActivePlayersSnapshot() do
        table.insert(players, SessionContextService.GetPlayerSessionState(player))
    end
    return table.freeze({
        ActivePlayerCount = #players,
        Players = table.freeze(players),
    })
end

return table.freeze(SessionContextService)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Script" referent="54">
      <Properties>
        <string name="Name">GlobalManager</string>
        <token name="RunContext">0</token>
        <string name="Source">local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")

-----------------------------------------------------------
-- 1. יצירת ערכים ב-ReplicatedStorage
-----------------------------------------------------------
local function getOrCreateValue(name, className, defaultValue)
	local val = ReplicatedStorage:FindFirstChild(name)
	if not val then
		val = Instance.new(className)
		val.Name = name
		val.Value = defaultValue
		val.Parent = ReplicatedStorage
	end
	return val
end

local GamePhase = getOrCreateValue("GamePhase", "StringValue", "Day")
local DayCount = getOrCreateValue("DayCount", "IntValue", 1)
local IsNight = getOrCreateValue("IsNight", "BoolValue", false)
local TimeLeft = getOrCreateValue("TimeLeft", "NumberValue", 60)

-- הגדרות זומבים
local zombieTemplate = ServerStorage:WaitForChild("BunkerZombie")
local spawnFolder = workspace:WaitForChild("ZombieSpawns")
local BASE_ZOMBIES = 3 

-----------------------------------------------------------
-- 2. מערכת ה-Leaderstats (Scrap, Credits, Batteries)
-----------------------------------------------------------
Players.PlayerAdded:Connect(function(player)
	local stats = Instance.new("Folder", player)
	stats.Name = "leaderstats"

	Instance.new("IntValue", stats).Name = "Scrap"
	Instance.new("IntValue", stats).Name = "Credits"
	Instance.new("IntValue", stats).Name = "Batteries"
end)

-----------------------------------------------------------
-- 3. מערכת גלי זומבים (Wave System)
-----------------------------------------------------------
local function spawnZombieWave()
	local amountToSpawn = BASE_ZOMBIES + DayCount.Value 
	print("!!! WAVE " .. DayCount.Value .. " STARTED: " .. amountToSpawn .. " zombies incoming !!!")

	for i = 1, amountToSpawn do
		local spawns = spawnFolder:GetChildren()
		if #spawns &gt; 0 then
			local randomSpawn = spawns[math.random(1, #spawns)]
			local newZombie = zombieTemplate:Clone()
			newZombie:PivotTo(randomSpawn.CFrame * CFrame.new(0, 5, 0))
			newZombie.Parent = workspace
		end
		task.wait(3) -- מרווח בין זומבי לזומבי
	end
end

-----------------------------------------------------------
-- 4. ניהול זמן וספירה לאחור
-----------------------------------------------------------
local function syncTimeOnPhaseChange()
	if GamePhase.Value == "Day" then
		Lighting.ClockTime = 6 -- בוקר
		IsNight.Value = false
	else
		Lighting.ClockTime = 18 -- ערב
		IsNight.Value = true
		task.wait(2) 
		task.spawn(spawnZombieWave) -- הגל מתחיל כשיש לילה
	end
end

GamePhase.Changed:Connect(syncTimeOnPhaseChange)

task.spawn(function()
	-- הגדרות התחלה
	GamePhase.Value = "Day"
	DayCount.Value = 1
	syncTimeOnPhaseChange()

	while true do
		local dt = 0.1
		local currentTime = Lighting.ClockTime

		if GamePhase.Value == "Day" then
			-- יום: 12 שעות ב-60 שניות
			Lighting.ClockTime += (12 / 60) * dt
			-- חישוב זמן שנותר לשלט (מ-60 ל-0)
			TimeLeft.Value = math.max(0, (18 - Lighting.ClockTime) / (12 / 60))

			if Lighting.ClockTime &gt;= 18 then 
				GamePhase.Value = "Night" 
			end
		else
			-- לילה: 12 שעות ב-30 שניות
			Lighting.ClockTime += (12 / 30) * dt
			-- חישוב זמן שנותר ללילה (מ-30 ל-0)
			local hoursRem = (Lighting.ClockTime &gt;= 18) and (24 - Lighting.ClockTime + 6) or (6 - Lighting.ClockTime)
			TimeLeft.Value = math.max(0, hoursRem / (12 / 30))

			if Lighting.ClockTime &gt;= 24 then Lighting.ClockTime = 0 end

			if Lighting.ClockTime &gt;= 6 and Lighting.ClockTime &lt; 18 then
				GamePhase.Value = "Day"
				DayCount.Value += 1
			end
		end
		task.wait(dt)
	end
end)</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="55">
      <Properties>
        <string name="Name">LegacyBunkerGameplayService</string>
        <string name="Source"><![CDATA[local LegacyBunkerGameplayService = {}

local function getStat(player: Player, name: string): IntValue?
    local leaderstats = player:FindFirstChild("leaderstats")
    local value = leaderstats and leaderstats:FindFirstChild(name)
    return value and value:IsA("IntValue") and value or nil
end

local function result(success: boolean, code: string)
    return table.freeze({ Success = success, Code = code })
end

local handlers = {
    legacy_battery_station = function(player: Player)
        local credits = getStat(player, "Credits")
        local batteries = getStat(player, "Batteries")
        if not credits or not batteries then return result(false, "STATE_NOT_READY") end
        if credits.Value < 20 then return result(false, "INSUFFICIENT_CREDITS") end
        credits.Value -= 20
        batteries.Value += 1
        return result(true, "BATTERY_PURCHASED")
    end,
    legacy_scrap_processor = function(player: Player)
        local scrap = getStat(player, "Scrap")
        local credits = getStat(player, "Credits")
        if not scrap or not credits then return result(false, "STATE_NOT_READY") end
        if scrap.Value <= 0 then return result(false, "NO_SCRAP") end
        credits.Value += scrap.Value * 5
        scrap.Value = 0
        return result(true, "SCRAP_PROCESSED")
    end,
    legacy_harvest_upgrade = function(player: Player)
        local credits = getStat(player, "Credits")
        if not credits then return result(false, "STATE_NOT_READY") end
        if player:GetAttribute("HarvestPower") == 2 then return result(false, "ALREADY_UPGRADED") end
        if credits.Value < 100 then return result(false, "INSUFFICIENT_CREDITS") end
        credits.Value -= 100
        player:SetAttribute("HarvestPower", 2)
        return result(true, "HARVEST_UPGRADED")
    end,
    legacy_weapon_upgrade = function(player: Player)
        local credits = getStat(player, "Credits")
        if not credits then return result(false, "STATE_NOT_READY") end
        if credits.Value < 200 then return result(false, "INSUFFICIENT_CREDITS") end
        credits.Value -= 200
        player:SetAttribute("GunDamage", (player:GetAttribute("GunDamage") or 20) + 10)
        return result(true, "WEAPON_UPGRADED")
    end,
}

function LegacyBunkerGameplayService.TryInteract(player: Player, gameplayTargetId: string)
    local handler = handlers[gameplayTargetId]
    if not handler then return result(false, "UNKNOWN_TARGET") end
    return handler(player)
end

return table.freeze(LegacyBunkerGameplayService)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="56">
      <Properties>
        <string name="Name">Survival</string>
      </Properties>
      <Item class="Script" referent="57">
        <Properties>
          <string name="Name">ForestResourceSpawner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")
local ResourceNodeService = require(ServerScriptService.Survival.ResourceNodeService)

local SEED = 42042
local TREE_COUNT = 36
local MIN_TREE_DISTANCE = 22
local forestOrigin = Vector3.new(120, 0, 180)
local forestRadius = 210

local sourceGrove = Workspace:WaitForChild("PrototypeHarvestGrove")
local sourceTree = sourceGrove:WaitForChild("prototype_tree_01")
local forestFolder = Workspace:FindFirstChild("ForestResourceRegion")
if not forestFolder then
    forestFolder = Instance.new("Folder")
    forestFolder.Name = "ForestResourceRegion"
    forestFolder.Parent = Workspace
end

local random = Random.new(SEED)
local placements = {}
local function validPlacement(candidate)
    for _, existing in placements do
        if (candidate - existing).Magnitude < MIN_TREE_DISTANCE then return false end
    end
    return true
end
local function nextPlacement()
    for _ = 1, 150 do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = math.sqrt(random:NextNumber()) * forestRadius
        local candidate = Vector3.new(forestOrigin.X + math.cos(angle) * radius, 0, forestOrigin.Z + math.sin(angle) * radius)
        if validPlacement(candidate) then table.insert(placements, candidate); return candidate end
    end
    return nil
end

for index = 1, TREE_COUNT do
    local placement = nextPlacement()
    if not placement then break end
    local tree = sourceTree:Clone()
    tree.Name = string.format("forest_tree_%03d", index)
    tree:SetAttribute("ResourceNodeId", tree.Name)
    tree:SetAttribute("ResourceDefinitionId", "tree_basic")
    local scale = random:NextNumber(0.82, 1.18)
    local rotation = math.rad(random:NextNumber(0, 360))
    tree:ScaleTo(scale)

    -- Deterministic presentation variation only. Resource IDs, HitAnchor,
    -- authoritative health/reward state and interaction rules remain unchanged.
    local canopyBias = random:NextNumber(0.88, 1.08)
    for _, descendant in tree:GetDescendants() do
        if descendant:IsA("BasePart") and string.find(descendant.Name, "Canopy", 1, true) then
            descendant.Size = Vector3.new(
                descendant.Size.X * canopyBias,
                descendant.Size.Y * random:NextNumber(0.92, 1.08),
                descendant.Size.Z * random:NextNumber(0.90, 1.10)
            )
        end
    end

    tree:PivotTo(CFrame.new(placement.X, sourceTree:GetPivot().Position.Y, placement.Z) * CFrame.Angles(0, rotation, 0))
    tree.Parent = forestFolder
    ResourceNodeService.RegisterNode(tree)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="58">
        <Properties>
          <string name="Name">HarvestService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InventoryService = require(game.ServerScriptService.Foundation.Inventory.InventoryService)
local ResourceNodeService = require(game.ServerScriptService.Survival.ResourceNodeService)

local remotes = ReplicatedStorage:FindFirstChild("SurvivalRemotes")
if not remotes then
    remotes = Instance.new("Folder")
    remotes.Name = "SurvivalRemotes"
    remotes.Parent = ReplicatedStorage
end
local harvestIntent = remotes:FindFirstChild("HarvestIntent")
if not harvestIntent then
    harvestIntent = Instance.new("RemoteEvent")
    harvestIntent.Name = "HarvestIntent"
    harvestIntent.Parent = remotes
end

local function makeAxeTool()
    local tool = Instance.new("Tool")
    tool.Name = "Axe"
    tool.ToolTip = "Field Axe — Chop harvestable trees"
    tool.CanBeDropped = false
    tool.RequiresHandle = true
    tool:SetAttribute("ItemId", "axe_basic")
    tool:SetAttribute("ToolDefinitionId", "axe_basic")
    tool.Grip = CFrame.new(0, -0.25, -0.1) * CFrame.Angles(0, 0, math.rad(-8))

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.32, 3.55, 0.32)
    handle.Material = Enum.Material.Wood
    handle.Color = Color3.fromRGB(105, 67, 38)
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    local knob = Instance.new("Part")
    knob.Name = "HandleKnob"
    knob.Size = Vector3.new(0.42, 0.28, 0.42)
    knob.Material = Enum.Material.Wood
    knob.Color = Color3.fromRGB(72, 43, 27)
    knob.CanCollide = false
    knob.Massless = true
    knob.CFrame = handle.CFrame * CFrame.new(0, -1.72, 0)
    knob.Parent = tool

    local head = Instance.new("Part")
    head.Name = "AxeHead"
    head.Size = Vector3.new(1.48, 0.72, 0.42)
    head.Material = Enum.Material.Metal
    head.Color = Color3.fromRGB(72, 78, 80)
    head.CanCollide = false
    head.Massless = true
    head.CFrame = handle.CFrame * CFrame.new(0.35, 1.48, 0)
    head.Parent = tool

    local blade = Instance.new("WedgePart")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.62, 1.0, 0.46)
    blade.Material = Enum.Material.Metal
    blade.Color = Color3.fromRGB(151, 156, 154)
    blade.CanCollide = false
    blade.Massless = true
    blade.CFrame = handle.CFrame * CFrame.new(1.18, 1.48, 0) * CFrame.Angles(0, math.rad(90), 0)
    blade.Parent = tool

    for _, part in { knob, head, blade } do
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = part
        weld.Parent = part
    end
    return tool
end

local function ensurePrototypeAxe(player)
    if InventoryService.GetQuantity(player, "axe_basic") < 1 then
        local grant = InventoryService.Add(player, "axe_basic", 1, { Source = "PrototypeSurvivalSliceBootstrap" })
        if not grant.Success then
            warn("[HarvestService] Could not grant canonical prototype axe", player.Name, grant.Code)
            return
        end
    end
    local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 10)
    if not backpack then return end
    local character = player.Character
    local existing = (character and character:FindFirstChild("Axe")) or backpack:FindFirstChild("Axe")
    if not existing then makeAxeTool().Parent = backpack end
end

local function setupPlayer(player)
    task.defer(ensurePrototypeAxe, player)
    player.CharacterAdded:Connect(function()
        task.wait(0.25)
        ensurePrototypeAxe(player)
    end)
end

for _, player in Players:GetPlayers() do setupPlayer(player) end
Players.PlayerAdded:Connect(setupPlayer)

-- Read-only runtime diagnostics are server-authored attributes for QA/observability.
-- They expose no mutation authority and can be removed/replaced by later telemetry.
local function publishInventoryDiagnostics(player)
    player:SetAttribute("CanonicalAxeQuantity", InventoryService.GetQuantity(player, "axe_basic"))
    player:SetAttribute("CanonicalWoodQuantity", InventoryService.GetQuantity(player, "wood"))
end

for _, player in Players:GetPlayers() do
    publishInventoryDiagnostics(player)
end

harvestIntent.OnServerEvent:Connect(function(player, nodeId)
    local result = ResourceNodeService.TryHarvest(player, nodeId)
    player:SetAttribute("LastHarvestResultCode", result.Code)
    local serial = player:GetAttribute("HarvestResultSerial")
    player:SetAttribute("HarvestResultSerial", (if type(serial) == "number" then serial else 0) + 1)
    publishInventoryDiagnostics(player)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">ResourceNodeService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ResourceDefinitions = require(ReplicatedStorage.Shared.Survival.ResourceDefinitions)
local ToolDefinitions = require(ReplicatedStorage.Shared.Survival.ToolDefinitions)
local InventoryService = require(game.ServerScriptService.Foundation.Inventory.InventoryService)
local SessionContextService = require(game.ServerScriptService.Foundation.Session.SessionContextService)

local ResourceNodeService = {}
local states = {}
local playerCooldowns = setmetatable({}, { __mode = "k" })

local function getFeedbackRemote()
    local folder = ReplicatedStorage:FindFirstChild("SurvivalRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "SurvivalRemotes"
        folder.Parent = ReplicatedStorage
    end
    local remote = folder:FindFirstChild("HarvestFeedback")
    if not remote then
        remote = Instance.new("RemoteEvent")
        remote.Name = "HarvestFeedback"
        remote.Parent = folder
    end
    return remote
end

local feedbackRemote = getFeedbackRemote()

local function result(success, code, payload)
    return table.freeze({ Success = success, Code = code, Payload = payload })
end

local function setPresentation(node, state, definition)
    node:SetAttribute("HarvestState", state.LifecycleState)
    node:SetAttribute("HarvestHealth", state.CurrentHealth)
    node:SetAttribute("HarvestMaxHealth", definition.MaxHealth)
    node:SetAttribute("HarvestProgress", math.clamp(1 - state.CurrentHealth / definition.MaxHealth, 0, 1))
    node:SetAttribute("HarvestHitSerial", state.HitSerial)
    node:SetAttribute("CycleSerial", state.CycleSerial)
end

local function setNodeVisible(node, visible)
    for _, descendant in node:GetDescendants() do
        if descendant:IsA("BasePart") and descendant.Name ~= "HitAnchor" then
            descendant.Transparency = visible and 0 or 1
            descendant.CanCollide = visible and descendant.Name == "Trunk"
        end
    end
end

local function initializeNode(node)
    local nodeId = node:GetAttribute("ResourceNodeId")
    local definitionId = node:GetAttribute("ResourceDefinitionId")
    local definition = type(definitionId) == "string" and ResourceDefinitions.get(definitionId) or nil
    if type(nodeId) ~= "string" or nodeId == "" or not definition then
        warn("[ResourceNodeService] Invalid authored resource node", node:GetFullName())
        return false
    end
    if states[nodeId] then
        return false
    end
    states[nodeId] = {
        Node = node,
        Definition = definition,
        CurrentHealth = definition.MaxHealth,
        LifecycleState = "Active",
        CycleSerial = 1,
        HitSerial = 0,
        RewardPending = nil,
    }
    setNodeVisible(node, true)
    setPresentation(node, states[nodeId], definition)
    return true
end

function ResourceNodeService.RegisterNode(node)
    if not node or not node:IsA("Model") then
        return false
    end
    return initializeNode(node)
end

local prototypeGrove = Workspace:WaitForChild("PrototypeHarvestGrove", 30)
if prototypeGrove then
    for _, child in prototypeGrove:GetChildren() do
        if child:IsA("Model") then initializeNode(child) end
    end
end

local function getEquippedTool(player)
    local character = player.Character
    if not character then return nil end
    for _, child in character:GetChildren() do
        if child:IsA("Tool") and child:GetAttribute("ToolDefinitionId") == "axe_basic" then
            return child
        end
    end
    return nil
end

local function validatePlayer(player)
    if not SessionContextService.IsActivePlayer(player) then return false, "PLAYER_NOT_ACTIVE" end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
        return false, "CHARACTER_NOT_READY"
    end
    return true, rootPart
end

local function toolCanHarvest(toolDefinition, resourceDefinition)
    return toolDefinition.ToolTags[resourceDefinition.RequiredToolTag] == true
end

local function finishRespawn(state)
    state.CycleSerial += 1
    state.CurrentHealth = state.Definition.MaxHealth
    state.LifecycleState = "Active"
    state.RewardPending = nil
    setNodeVisible(state.Node, true)
    setPresentation(state.Node, state, state.Definition)
    feedbackRemote:FireAllClients("Respawn", { NodeId = state.Node:GetAttribute("ResourceNodeId"), CycleSerial = state.CycleSerial })
end

local function commitReward(state)
    local pending = state.RewardPending
    if not pending or pending.Committed then return end
    local winner = pending.Player
    if not winner or winner.Parent ~= Players then
        warn("[ResourceNodeService] Reward pending winner left before canonical grant", state.Node:GetFullName())
        return
    end
    local grant = InventoryService.Add(winner, pending.ItemId, pending.Quantity, {
        Source = "ResourceHarvest",
        ResourceNodeId = state.Node:GetAttribute("ResourceNodeId"),
        ResourceDefinitionId = state.Node:GetAttribute("ResourceDefinitionId"),
        CycleSerial = state.CycleSerial,
    })
    if not grant.Success then
        warn("[ResourceNodeService] Canonical reward grant failed", grant.Code)
        return
    end
    pending.Committed = true
    state.LifecycleState = "Depleted"
    setPresentation(state.Node, state, state.Definition)
    feedbackRemote:FireAllClients("Depleted", { NodeId = state.Node:GetAttribute("ResourceNodeId"), CycleSerial = state.CycleSerial })
    feedbackRemote:FireClient(winner, "Reward", { ItemId = pending.ItemId, Quantity = pending.Quantity, Total = grant.Quantity })
    task.delay(state.Definition.RespawnDelaySeconds, function()
        if states[state.Node:GetAttribute("ResourceNodeId")] == state and state.LifecycleState == "Depleted" then
            state.LifecycleState = "Respawning"
            setPresentation(state.Node, state, state.Definition)
            finishRespawn(state)
        end
    end)
end

function ResourceNodeService.TryHarvest(player, nodeId: string)
    if type(nodeId) ~= "string" or nodeId == "" then return result(false, "INVALID_NODE_ID") end
    local state = states[nodeId]
    if not state then return result(false, "UNKNOWN_NODE") end
    if state.LifecycleState ~= "Active" then return result(false, "NODE_NOT_ACTIVE") end

    local valid, rootOrCode = validatePlayer(player)
    if not valid then return result(false, rootOrCode) end
    local rootPart = rootOrCode
    local tool = getEquippedTool(player)
    if not tool then return result(false, "AXE_NOT_EQUIPPED") end
    if InventoryService.GetQuantity(player, "axe_basic") < 1 then return result(false, "AXE_NOT_OWNED") end
    local toolDefinition = ToolDefinitions.get(tool:GetAttribute("ToolDefinitionId"))
    if not toolDefinition or not toolCanHarvest(toolDefinition, state.Definition) then return result(false, "INVALID_TOOL") end

    local anchor = state.Node:FindFirstChild("HitAnchor")
    if not anchor or not anchor:IsA("BasePart") then return result(false, "NODE_INVALID") end
    if (rootPart.Position - anchor.Position).Magnitude > state.Definition.InteractionDistance then return result(false, "OUT_OF_RANGE") end

    local now = os.clock()
    local cooldown = math.max(toolDefinition.UseCooldownSeconds, state.Definition.HitCooldownSeconds)
    local previous = playerCooldowns[player]
    if previous and now - previous < cooldown then return result(false, "RATE_LIMITED") end
    playerCooldowns[player] = now

    state.CurrentHealth = math.max(0, state.CurrentHealth - toolDefinition.HarvestDamage)
    state.HitSerial += 1
    setPresentation(state.Node, state, state.Definition)
    feedbackRemote:FireAllClients("Hit", {
        NodeId = nodeId,
        Health = state.CurrentHealth,
        MaxHealth = state.Definition.MaxHealth,
        HitSerial = state.HitSerial,
    })

    if state.CurrentHealth <= 0 and state.LifecycleState == "Active" then
        state.LifecycleState = "RewardPending"
        state.RewardPending = {
            Player = player,
            ItemId = state.Definition.RewardItemId,
            Quantity = state.Definition.RewardQuantity,
            Committed = false,
        }
        setPresentation(state.Node, state, state.Definition)
        commitReward(state)
    end

    return result(true, "OK", { Health = state.CurrentHealth, State = state.LifecycleState, CycleSerial = state.CycleSerial })
end

function ResourceNodeService.GetState(nodeId: string)
    local state = states[nodeId]
    if not state then return nil end
    return table.freeze({
        CurrentHealth = state.CurrentHealth,
        LifecycleState = state.LifecycleState,
        CycleSerial = state.CycleSerial,
        HitSerial = state.HitSerial,
    })
end

Players.PlayerRemoving:Connect(function(player)
    playerCooldowns[player] = nil
end)

return table.freeze(ResourceNodeService)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="60">
      <Properties>
        <string name="Name">ZombieEntranceTargetMigration</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local EntranceContract = require(ServerScriptService:WaitForChild("BunkerEntranceContract"))

local ZOMBIE_NAMES = {
    BunkerZombie = true,
    RunnerZombie = true,
    TankZombie = true,
}

local function migrateZombie(zombie)
    if not zombie:IsA("Model") or not ZOMBIE_NAMES[zombie.Name] then
        return
    end
    if zombie:GetAttribute("EntranceTargetMigrated") then
        return
    end

    zombie:SetAttribute("EntranceTargetMigrated", true)

    local target = EntranceContract.GetTarget()
    if target then
        target:SetAttribute("BunkerEntranceTarget", true)
        zombie:SetAttribute("EntranceTargetPath", target:GetFullName())
    end

    -- Disable only the legacy door-aware AI script on the spawned clone.
    -- The original ServerStorage templates remain untouched.
    for _, child in zombie:GetChildren() do
        if child:IsA("Script") and child.Name == "Script" then
            child.Disabled = true
        end
    end
end

for _, child in Workspace:GetChildren() do
    migrateZombie(child)
end

Workspace.ChildAdded:Connect(function(child)
    task.defer(migrateZombie, child)
end)

local target = EntranceContract.GetTarget()
if target then
    target:SetAttribute("BunkerEntranceTarget", true)
end
]]></string>
      </Properties>
