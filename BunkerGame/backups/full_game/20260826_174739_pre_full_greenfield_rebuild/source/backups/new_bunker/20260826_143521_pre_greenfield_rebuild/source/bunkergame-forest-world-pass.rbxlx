          <string name="ScriptGuid">{4ce93d0d-f174-4702-819d-640022fcda13}</string>
          <string name="Source">local PathfindingService = game:GetService("PathfindingService")
local zombie = script.Parent
local humanoid = zombie:WaitForChild("Humanoid")
local rootPart = zombie:WaitForChild("HumanoidRootPart")

-- הגדרות זומבי
local VISION_RANGE = 500  -- טווח ראייה
local ATTACK_RANGE = 5    -- טווח תקיפה
local ATTACK_DAMAGE = 10  -- נזק בכל מכה
humanoid.WalkSpeed = 12   -- מהירות תנועה

-----------------------------------------------------------
-- 1. פונקציית בחירת מטרה (שחקן או דלת)
-----------------------------------------------------------
local function getTarget()
	local closestTarget = nil
	local shortestDistance = VISION_RANGE

	-- חיפוש שחקנים
	for _, player in pairs(game.Players:GetPlayers()) do
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local dist = (rootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
			if dist &lt; shortestDistance then
				closestTarget = player.Character.HumanoidRootPart
				shortestDistance = dist
			end
		end
	end

	-- אם יש דלת בונקר קרובה, היא בעדיפות
	local door = workspace:FindFirstChild("BunkerDoor")
	if door and (rootPart.Position - door.Position).Magnitude &lt; 15 then
		closestTarget = door
	end

	return closestTarget
end

-----------------------------------------------------------
-- 2. לוגיקת תקיפה והעלמת דלת
-----------------------------------------------------------
task.spawn(function()
	while humanoid.Health &gt; 0 do
		local target = getTarget()
		if target and (rootPart.Position - target.Position).Magnitude &lt;= ATTACK_RANGE then
			-- תקיפת דלת
			if target.Name == "BunkerDoor" then
				local health = target:FindFirstChild("DoorHealth")
				if health and health.Value &gt; 0 then
					health.Value -= ATTACK_DAMAGE
					if health.Value &lt;= 0 then
						target.Parent = game:GetService("ServerStorage") -- העלמה פיזית
					end
				end
				-- תקיפת שחקן
			elseif target.Parent:FindFirstChild("Humanoid") then
				target.Parent.Humanoid:TakeDamage(ATTACK_DAMAGE)
			end
			task.wait(1) -- קצב מכות
		end
		task.wait(0.5)
	end
end)

-----------------------------------------------------------
-- 3. לוגיקת תנועה חכמה (Pathfinding)
-----------------------------------------------------------
task.spawn(function()
	while humanoid.Health &gt; 0 do
		local target = getTarget()
		if target then
			local path = PathfindingService:CreatePath({AgentCanJump = true, AgentRadius = 3})
			path:ComputeAsync(rootPart.Position, target.Position)

			if path.Status == Enum.PathStatus.Success then
				local waypoints = path:GetWaypoints()
				-- זז ל-3 נקודות ואז מחשב מחדש למניעת לאג
				for i = 1, math.min(3, #waypoints) do
					if humanoid.Health &lt;= 0 then break end
					humanoid:MoveTo(waypoints[i].Position)
					humanoid.MoveToFinished:Wait()
				end
			else
				-- אם אין נתיב, הולך ישירות
				humanoid:MoveTo(target.Position)
			end
		end
		task.wait(0.2)
	end
end)

-----------------------------------------------------------
-- 4. לוגיקת מוות: הפלת Scrap ומתן קרדיטים
-----------------------------------------------------------
humanoid.Died:Connect(function()
	print("Zombie died! Dropping scrap...")

	-- יצירת ה-Scrap הפיזי
	local scrap = Instance.new("Part")
	scrap.Name = "Scrap"
	scrap.Size = Vector3.new(2, 1, 2)
	scrap.Position = rootPart.Position + Vector3.new(0, 1, 0)
	scrap.BrickColor = BrickColor.new("Dark stone grey")
	scrap.Parent = workspace

	-- הוספת אפשרות איסוף
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Collect Scrap"
	prompt.ObjectText = "10 Credits"
	prompt.HoldDuration = 0.5
	prompt.Parent = scrap

	prompt.Triggered:Connect(function(player)
		if player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Credits") then
			player.leaderstats.Credits.Value += 10 -- מתן קרדיטים
		end
		scrap:Destroy()
	end)

	-- מחיקת גופת הזומבי למניעת עומס
	task.wait(5)
	zombie:Destroy()
end)</string>
