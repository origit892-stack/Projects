      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GameplayInteractionTypes</string>
          <string name="Source"><![CDATA[export type InteractionContext = {
    Player: Player,
    InteractionKind: string,
    ResolvedTarget: Instance,
    GameplayTargetId: string?,
    Prompt: ProximityPrompt,
}

export type GameplayInteractionResult = {
    Success: boolean,
    Code: string,
    FeedbackTone: string?,
}

local GameplayInteractionTypes = {
    ResultCode = table.freeze({
        Ok = "OK",
        Unavailable = "UNAVAILABLE",
        NoHandler = "NO_HANDLER",
    }),
}

return table.freeze(GameplayInteractionTypes)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">InteractionTypes</string>
          <string name="Source"><![CDATA[local InteractionTypes = {
	InteractiveRootName = "InteractiveProps",

	PromptNames = table.freeze({
		Crate = "PrototypeCratePrompt",
		Locker = "PrototypeLockerPrompt",
		OfflineControl = "OfflineControlPrompt",
		InspectStation = "InspectStationPrompt",
	}),

	FeedbackTone = table.freeze({
		Success = "Success",
		Unavailable = "Unavailable",
	}),

	PartNames = table.freeze({
		MovingPart = "MovingPart",
		OpenPose = "OpenPose",
	}),
}

return table.freeze(InteractionTypes)
]]></string>
        </Properties>
