local Blueprint={"title":"Verdant Frontier","overview":"Verdant Frontier: A stylized forest frontier with dramatic hills, winding river, ancient ruins, a giant tree and waterfall. Designed with strong focal hierarchy, separated biome zones, terrain elevation, exploration loops, and landmarks.","style":"Stylized Low Poly","biomes":["Highlands","River Basin","Woodlands","Ancient Ruins"],"landmarks":[{"name":"Beacon Spire","type":"tower","x":0,"z":0,"scale":1.54,"description":"Tower destination and landmark."},{"name":"Pinewatch","type":"village","x":-0.702,"z":-0.338,"scale":1.5,"description":"Village destination and landmark."},{"name":"Sunken Shrine","type":"temple","x":0.541,"z":-0.647,"scale":1.58,"description":"Temple destination and landmark."},{"name":"Hidden Cascade","type":"waterfall","x":-0.596,"z":0.582,"scale":1.44,"description":"Waterfall destination and landmark."},{"name":"Skyspan Crossing","type":"bridge","x":0.672,"z":0.404,"scale":1.56,"description":"Bridge destination and landmark."},{"name":"Crystal Hollow","type":"cave","x":-0.017,"z":0.706,"scale":1.17,"description":"Cave destination and landmark."},{"name":"Broken Gate","type":"ruins","x":0.06,"z":-0.864,"scale":1.2,"description":"Ruins destination and landmark."},{"name":"Elderwood","type":"giant_tree","x":-0.83,"z":0.062,"scale":1.32,"description":"Giant Tree destination and landmark."},{"name":"World Pillar","type":"monument","x":0.829,"z":-0.075,"scale":1.56,"description":"Monument destination and landmark."},{"name":"Blue Basin","type":"lake","x":-0.358,"z":0.09,"scale":1.1,"description":"Lake destination and landmark."}],"routes":[{"name":"Grand Exploration Loop","type":"loop","waypoints":[[0,0],[-0.68,-0.42],[0.64,-0.55],[0.65,0.43],[-0.67,0.5],[0,0]]},{"name":"Scenic Ridge Trail","type":"scenic","waypoints":[[-0.91,0.05],[-0.38,0.18],[0.37,0.16],[0.91,-0.08]]}],"palette":["#426b48","#80a85d","#b6a06d","#638da0"],"archetype":"temperate","seed":271828,"settings":{"size":2000,"grid":40,"seed":271828,"relief":1.25,"decor":80,"style":"Stylized Low Poly"},"idea":"A stylized forest frontier with dramatic hills, winding river, ancient ruins, a giant tree and waterfall","engine":"Procedural World Engine v2"}
local WORLD_SIZE=2000;local GRID=40;local SEED=271828;local RELIEF=1.25;local DECOR=80;local TILE=WORLD_SIZE/GRID
local Terrain=workspace.Terrain
-- Non-destructive mode: existing terrain outside this generated footprint is preserved.
local old=workspace:FindFirstChild('Idea2World_Generated');if old then old:Destroy() end
local root=Instance.new('Folder');root.Name='Idea2World_Generated';root.Parent=workspace
local deco=Instance.new('Folder');deco.Name='Decoration';deco.Parent=root
local landmarksFolder=Instance.new('Folder');landmarksFolder.Name='Landmarks';landmarksFolder.Parent=root
local routeFolder=Instance.new('Folder');routeFolder.Name='Routes';routeFolder.Parent=root
local rng=Random.new(SEED);local biome=Blueprint.archetype or 'temperate'
local function hash(x,z)local n=math.sin(x*127.1+z*311.7+SEED*.013)*43758.5453;return n-math.floor(n)end
local function noise(x,z)local ix,iz=math.floor(x),math.floor(z);local fx,fz=x-ix,z-iz;fx=fx*fx*(3-2*fx);fz=fz*fz*(3-2*fz);local a,b,c,d=hash(ix,iz),hash(ix+1,iz),hash(ix,iz+1),hash(ix+1,iz+1);local ab=a+(b-a)*fx;local cd=c+(d-c)*fx;return ab+(cd-ab)*fz end
local function heightAt(x,z)local n1=noise(x*.012,z*.012);local n2=noise(x*.034+17,z*.034-9);local n3=noise(x*.09-23,z*.09+31);local radial=math.clamp(1-math.sqrt(x*x+z*z)/(WORLD_SIZE*.72),0,1);local h=(7+n1*32+n2*13+n3*4+radial*16)*RELIEF;if biome=='volcanic' then h+=math.max(0,1-math.sqrt(x*x+z*z)/(WORLD_SIZE*.44))*70*RELIEF end;if biome=='snow' then h+=math.max(0,n1-.55)*60*RELIEF end;return math.max(4,h)end
local function material(h,n)if biome=='desert' then return Enum.Material.Sand elseif biome=='snow' then return Enum.Material.Snow elseif biome=='volcanic' then return h>48 and Enum.Material.Basalt or Enum.Material.Ground elseif biome=='swamp' then return Enum.Material.Mud end;return h>50 and Enum.Material.Rock or (n>.72 and Enum.Material.Ground or Enum.Material.Grass)end
-- Terrain generation batches yield periodically to keep Studio responsive.
local written=0
for xIndex=1,GRID do for zIndex=1,GRID do local x=-WORLD_SIZE/2+(xIndex-.5)*TILE;local z=-WORLD_SIZE/2+(zIndex-.5)*TILE;local h=heightAt(x,z);Terrain:FillBlock(CFrame.new(x,h/2-3,z),Vector3.new(TILE+1,h,TILE+1),material(h,noise(x*.025,z*.025)));written+=1;if written%125==0 then task.wait() end end end
-- Meandering river ribbon cut through terrain.
local function riverX(t)return math.sin(t*8.2+SEED*.07)*WORLD_SIZE*.16+math.sin(t*3.3)*WORLD_SIZE*.09 end
for i=0,100 do local t=i/100;local z=-WORLD_SIZE*.46+t*WORLD_SIZE*.92;local x=riverX(t);Terrain:FillBlock(CFrame.new(x,heightAt(x,z)-7,z),Vector3.new(WORLD_SIZE*.07,20,TILE*1.25),Enum.Material.Water);if i%20==0 then task.wait() end end
local function part(parent,name,size,pos,color,mat,shape)local p=Instance.new('Part');p.Name=name;p.Size=size;p.Position=pos;p.Anchored=true;p.CanCollide=true;p.Material=mat or Enum.Material.Slate;p.Color=color or Color3.fromRGB(120,120,120);if shape then p.Shape=shape end;p.Parent=parent;return p end
local stone=Color3.fromRGB(110,105,97);local gold=Color3.fromRGB(180,142,84);local wood=Color3.fromRGB(110,75,46)
local function build(lm,i)local x,z=lm.x*WORLD_SIZE*.42,lm.z*WORLD_SIZE*.42;local y=heightAt(x,z);local s=math.max(18,lm.scale*TILE*1.3);local typ=lm.type;local m=Instance.new('Model');m.Name=lm.name;m.Parent=landmarksFolder
 if typ=='volcano' then for j=1,5 do local r=s*(3.2-j*.4);part(m,'CraterRing_'..j,Vector3.new(r,s*.35,r),Vector3.new(x,y+s*.4+j*s*.2,z),Color3.fromRGB(76+j*5,52+j*3,44),Enum.Material.Rock)end;part(m,'Lava',Vector3.new(s,5,s),Vector3.new(x,y+s*2,z),Color3.fromRGB(255,85,15),Enum.Material.Neon)
 elseif typ=='giant_tree' then part(m,'Trunk',Vector3.new(s*.4,s*2,s*.4),Vector3.new(x,y+s,z),wood,Enum.Material.Wood);for j=1,7 do part(m,'Canopy'..j,Vector3.new(s,s,s),Vector3.new(x+math.sin(j)*s*.25,y+s*(1+j*.18),z+math.cos(j)*s*.25),Color3.fromRGB(45+j*4,115+j*4,48),Enum.Material.Grass,Enum.PartType.Ball)end
 elseif typ=='lake' or typ=='waterfall' then part(m,'Pool',Vector3.new(s*2.4,4,s*2.4),Vector3.new(x,y+1,z),Color3.fromRGB(60,150,205),Enum.Material.Glass);if typ=='waterfall' then part(m,'Cascade',Vector3.new(s*.55,s*2.3,5),Vector3.new(x,y+s,z),Color3.fromRGB(125,205,235),Enum.Material.Glass)end
 elseif typ=='bridge' then part(m,'Deck',Vector3.new(s*3.4,5,s*.7),Vector3.new(x,y+5,z),stone,Enum.Material.Slate);for side=-1,1,2 do part(m,'Pier',Vector3.new(6,s,6),Vector3.new(x+side*s,y+s*.4,z),stone,Enum.Material.Rock)end
 elseif typ=='village' or typ=='factory' or typ=='castle' then for j=1,8 do local ox=rng:NextNumber(-1,1)*s;local oz=rng:NextNumber(-1,1)*s;local h=rng:NextNumber(s*.4,s);part(m,'Building'..j,Vector3.new(s*.35,h,s*.35),Vector3.new(x+ox,y+h/2,z+oz),Color3.fromRGB(150,118,82),Enum.Material.Wood);part(m,'Roof'..j,Vector3.new(s*.4,4,s*.4),Vector3.new(x+ox,y+h+2,z+oz),gold,Enum.Material.Slate)end
 else part(m,'Base',Vector3.new(s*1.6,5,s*1.6),Vector3.new(x,y+2.5,z),stone,Enum.Material.Slate);for j=1,4 do local h=s*(.8+j*.35);local ox=(j-2.5)*s*.4;part(m,'Tower'..j,Vector3.new(s*.4,h,s*.4),Vector3.new(x+ox,y+h/2,z),stone,Enum.Material.Slate);part(m,'Cap'..j,Vector3.new(s*.45,4,s*.45),Vector3.new(x+ox,y+h+2,z),gold,Enum.Material.Metal)end end end
for i,lm in ipairs(Blueprint.landmarks)do build(lm,i);task.wait()end
-- Route lines are built between blueprint waypoint pairs.
for routeIndex,route in ipairs(Blueprint.routes or {}) do local pts=route.waypoints or {{-.8,0},{.8,0}};for j=1,#pts-1 do local a,b=pts[j],pts[j+1];local ax,az=a[1]*WORLD_SIZE*.4,a[2]*WORLD_SIZE*.4;local bx,bz=b[1]*WORLD_SIZE*.4,b[2]*WORLD_SIZE*.4;local dx,dz=bx-ax,bz-az;local len=math.sqrt(dx*dx+dz*dz);local mx,mz=(ax+bx)/2,(az+bz)/2;local path=part(routeFolder,'Route_'..routeIndex..'_'..j,Vector3.new(12,1.4,len),Vector3.new(mx,heightAt(mx,mz)+1,mz),Color3.fromRGB(160,145,112),Enum.Material.Ground);path.CFrame=CFrame.new(mx,heightAt(mx,mz)+1,mz)*CFrame.Angles(0,math.atan2(dx,dz),0) end end
-- Scatter only where landmark clear zones permit.
local target=math.floor(GRID*GRID*.07*(DECOR/70));local attempts,placed=0,0
while placed<target and attempts<target*6 do attempts+=1;local x=rng:NextNumber(-WORLD_SIZE*.46,WORLD_SIZE*.46);local z=rng:NextNumber(-WORLD_SIZE*.46,WORLD_SIZE*.46);local y=heightAt(x,z);local safe=y<95 and math.abs(x-riverX(z/WORLD_SIZE+.5))>WORLD_SIZE*.045
 for _,lm in ipairs(Blueprint.landmarks)do if (Vector2.new(x,z)-Vector2.new(lm.x*WORLD_SIZE*.42,lm.z*WORLD_SIZE*.42)).Magnitude<TILE*lm.scale*1.4 then safe=false;break end end
 if safe then local h=rng:NextNumber(9,17);part(deco,'TreeTrunk'..placed,Vector3.new(2,h,2),Vector3.new(x,y+h/2,z),wood,Enum.Material.Wood);local sz=rng:NextNumber(8,14);part(deco,'TreeCrown'..placed,Vector3.new(sz,sz,sz),Vector3.new(x,y+h+sz*.3,z),Color3.fromRGB(rng:NextInteger(40,75),rng:NextInteger(100,150),rng:NextInteger(40,70)),Enum.Material.Grass,Enum.PartType.Ball);placed+=1 end;if attempts%300==0 then task.wait()end end
local lighting=game:GetService('Lighting');lighting.ClockTime=16.1;lighting.Brightness=2;local atmosphere=lighting:FindFirstChild('Idea2World_Atmosphere')or Instance.new('Atmosphere');atmosphere.Name='Idea2World_Atmosphere';atmosphere.Density=.18;atmosphere.Haze=1.1;atmosphere.Parent=lighting
print('Idea2World 2.0 generated: '..Blueprint.title..' | terrain cells '..written..' | trees '..placed)
