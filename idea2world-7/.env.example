# ---------------------------------------------------------------------------------------------
# Idea2World 6.0 configuration.
# Everything here is optional: with no keys the deterministic planner runs the whole pipeline.
# Copy to .env — app.py reads it on start, mcp_server.py inherits it from the environment.
# ---------------------------------------------------------------------------------------------

# LLM brain. The first configured provider wins: anthropic -> openai -> gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Any OpenAI-compatible endpoint (local vLLM, OpenRouter, LiteLLM, ...).
IDEA2WORLD_API_URL=
IDEA2WORLD_API_KEY=
IDEA2WORLD_MODEL=

# Roblox Studio MCP. Leave empty to auto-discover the binary shipped with Studio.
IDEA2WORLD_STUDIO_MCP=
IDEA2WORLD_STUDIO_TIMEOUT=120

# Server / storage
IDEA2WORLD_PORT=8765
IDEA2WORLD_PROJECTS=./projects

# ---------------------------------------------------------------------------------------------
# 7.0 tool engines. All optional: without a key the engine reports `skipped` (honest) and the
# local built-in builder stays the live route. Never faked.
# ---------------------------------------------------------------------------------------------
# BloxMaps (map generation from a prompt). Export costs credits and only runs when
# confirm_bloxmaps_export=true is passed in the run settings.
BLOXMAPS_API_KEY=
# Meshy (text-to-3D asset generation, two-step preview -> refine).
MESHY_API_KEY=
