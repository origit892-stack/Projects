{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea2world.local/schemas/worldspec.schema.json",
  "title": "Idea2World WorldSpec",
  "description": "Single source of truth for a generated world. Python and Luau both read this shape.",
  "type": "object",
  "required": ["schema_version", "idea", "title", "world", "regions", "pois", "paths", "spawns",
               "art_direction", "asset_manifest", "placements", "navigation_report"],
  "properties": {
    "schema_version": {"const": 6},
    "idea": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 1},
    "genre": {"type": "string"},
    "audience": {"type": "string"},
    "core_loop": {"type": "array", "items": {"type": "string"}},
    "game_design": {"type": "object"},
    "references": {"type": "array", "items": {"type": "object"}},
    "art_direction": {
      "type": "object",
      "required": ["palette"],
      "properties": {
        "palette": {
          "type": "object",
          "required": ["primary", "secondary", "accent", "ground", "highlight", "shadow"],
          "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        },
        "style": {"type": "string"},
        "theme": {"type": "string"},
        "mood": {"type": "string"},
        "geometry_language": {"type": "string"}
      }
    },
    "lighting": {
      "type": "object",
      "properties": {
        "clock_time": {"type": "number", "minimum": 0, "maximum": 24},
        "brightness": {"type": "number"},
        "exposure": {"type": "number"},
        "ambient": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
      }
    },
    "atmosphere": {"type": "object"},
    "world": {
      "type": "object",
      "required": ["size", "seed", "water_level"],
      "properties": {
        "size": {"type": "number", "minimum": 400},
        "seed": {"type": "integer"},
        "water_level": {"type": "number"},
        "relief": {"type": "number"},
        "detail_budget": {"type": "integer", "minimum": 0}
      }
    },
    "budget": {"type": "object"},
    "archetype": {"type": "string"},
    "regions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "center", "radius"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "role": {"type": "string"},
          "center": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "radius": {"type": "number", "exclusiveMinimum": 0},
          "ground": {"type": "string"},
          "water": {"type": "boolean"},
          "pois": {"type": "array", "items": {"type": "string"}},
          "asset_mix": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "pois": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "region", "x", "z"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "region": {"type": "string"},
          "x": {"type": "number"},
          "z": {"type": "number"},
          "y": {"type": "number"},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "rotation": {"type": "number"},
          "role": {"enum": ["focal", "support", "landmark"]},
          "interaction": {"type": "string"}
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "width", "nodes", "connects"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"enum": ["main", "branch", "loop"]},
          "width": {"type": "number", "minimum": 4},
          "nodes": {"type": "array", "minItems": 2, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
          "connects": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "length": {"type": "number"}
        }
      }
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "z"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "x": {"type": "number"},
          "z": {"type": "number"},
          "y": {"type": "number"},
          "radius": {"type": "number"}
        }
      }
    },
    "composition": {"type": "object"},
    "biomes": {"type": "array", "items": {"type": "object"}},
    "ambient_vfx": {"type": "array", "items": {"type": "object"}},
    "asset_manifest": {"$ref": "asset_manifest.schema.json"},
    "material_variants": {"type": "array", "items": {"type": "object"}},
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "kind", "category", "x", "y", "z"],
        "properties": {
          "asset": {"type": "string"},
          "kind": {"type": "string"},
          "category": {"type": "string"},
          "region": {"type": "string"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "z": {"type": "number"},
          "rot": {"type": "number"},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "color": {"type": "string"}
        }
      }
    },
    "asset_validation": {"type": "object"},
    "material_plan": {"type": "object"},
    "asset_reuse": {"type": "object"},
    "placement_stats": {"type": "object"},
    "poi_decor": {"type": "array", "items": {"type": "object"}},
    "navigation_report": {
      "type": "object",
      "required": ["passed", "issues"],
      "properties": {
        "passed": {"type": "boolean"},
        "critical_count": {"type": "integer"},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "message"],
            "properties": {
              "code": {"type": "string"},
              "severity": {"enum": ["critical", "major", "minor"]},
              "message": {"type": "string"},
              "fix": {"type": "string"}
            }
          }
        },
        "metrics": {"type": "object"}
      }
    },
    "repair_history": {"type": "object"},
    "luau_files": {"type": "array", "items": {"type": "string"}},
    "luau_bytes": {"type": "integer"}
  }
}
